# Copy to .env (and optionally .env.local / .env.dev). Do not commit real env files.
# This repository tracks only .env.example; .env, .env.dev, and .env*.local are ignored.

###> symfony/framework-bundle ###
# APP_ENV=dev
# APP_SECRET=change-me-to-a-random-string-min-32-chars
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="postgresql://app:pass@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
# DATABASE_URL="mysql://app:pass@127.0.0.1:3306/app?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# MAILER_DSN=null://null
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
# From address for storefront emails (order confirmation, contact form notifications).
# MAILER_FROM=noreply@example.com
###< symfony/mailer ###

###> symfony/application ###
# Inbound address for contact form messages (defaults to MAILER_FROM if unset).
# CONTACT_NOTIFY_EMAIL=support@example.com
###< symfony/application ###

###> symfony/messenger ###
# MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
###< symfony/messenger ###

###> payment ###
# Default provider (dev | stripe | paypal | klarna). Omit to use dev.
# PAYMENT_PROVIDER=dev

# Stripe (when PAYMENT_PROVIDER=stripe). Get keys from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # required for POST /webhook/stripe (signing)

# PayPal (when PAYMENT_PROVIDER=paypal). Use sandbox first: https://developer.paypal.com/
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
# Optional API host (default: sandbox). Live: https://api-m.paypal.com
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
###< payment ###

###> checkout (local testing) ###
# Nur mit APP_ENV=dev oder test: 1 = keine Zahlungsseite, Bestellung wird sofort abgeschlossen (nur zum lokalen Testen).
# CHECKOUT_SKIP_PAYMENT=0
###< checkout (local testing) ###

###> sentry/sentry-symfony ###
# Loaded when APP_ENV=prod. Leave empty to disable client-side reporting.
# SENTRY_DSN=
###< sentry/sentry-symfony ###

###> application (optional) ###
# INVOICE_STORAGE_PATH=var/invoices
# RESERVATION_TIMEOUT_MINUTES=15
###< application (optional) ###
