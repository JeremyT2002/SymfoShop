{# Newsletter - settings: title, placeholder #}
<section class="bg-gradient-to-r from-primary-600 to-primary-700 text-white py-16">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold mb-4">
            {{ settings.title|default('Subscribe to our newsletter') }}
        </h2>
        <p class="text-primary-100 mb-6">
            {{ settings.subtitle|default('Get the latest updates on new products and upcoming sales.') }}
        </p>
        <form action="#" method="post" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
            <input type="email" name="email" placeholder="{{ settings.placeholder|default('Enter your email') }}" 
                   class="flex-1 px-4 py-3 rounded-lg text-gray-900 focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary-600">
            <button type="submit" class="px-6 py-3 bg-white text-primary-600 font-semibold rounded-lg hover:bg-primary-50 transition-colors">
                {{ settings.buttonLabel|default('Subscribe') }}
            </button>
        </form>
    </div>
</section>
