{# Category grid - settings: columns. Context: categories #}
<section id="categories" class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
                {{ settings.title|default('category.shop_by_category'|trans)|default('Shop by Category') }}
            </h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                {{ 'category.browse_description'|trans|default('Explore our wide range of product categories') }}
            </p>
        </div>
        {% if categories is defined and categories|length > 0 %}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">
                {% for category in categories %}
                    <a href="{{ path('catalog_category', {slug: category.slug}) }}" 
                       class="group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 animate-slide-up" 
                       style="animation-delay: {{ loop.index0 * 0.1 }}s">
                        <div class="h-48 bg-gradient-to-br from-primary-500 via-primary-600 to-primary-700 flex items-center justify-center relative overflow-hidden">
                            <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
                            <i class="fas fa-folder text-6xl text-white opacity-90 group-hover:scale-125 transition-transform duration-300 relative z-10"></i>
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-primary-600 transition-colors">
                                {{ category.name|escape }}
                            </h3>
                            {% set childCount = categoryChildrenCounts[category.id]|default(0) %}
                            {% if childCount > 0 %}
                                <div class="flex items-center text-sm text-gray-500 mb-4">
                                    <i class="fas fa-layer-group mr-2 text-primary-500"></i>
                                    <span>{{ childCount }} {{ childCount == 1 ? 'category.subcategory'|trans : 'category.subcategories'|trans }}</span>
                                </div>
                            {% endif %}
                            <div class="flex items-center text-primary-600 font-medium text-sm group-hover:translate-x-1 transition-transform">
                                <span>{{ 'category.explore'|trans|default('Explore') }}</span>
                                <i class="fas fa-arrow-right ml-2"></i>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-white rounded-2xl shadow-lg p-16 text-center">
                <i class="fas fa-inbox text-8xl text-gray-300 mb-6"></i>
                <h2 class="text-2xl font-bold text-gray-900 mb-3">{{ 'category.no_categories_available'|trans|default('No Categories Available') }}</h2>
                <p class="text-gray-600">{{ 'category.check_back_soon'|trans|default('Check back soon for new categories') }}</p>
            </div>
        {% endif %}
    </div>
</section>
