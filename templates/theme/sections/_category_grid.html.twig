{# Category grid. Settings: title. Context: categories, categoryChildrenCounts #}
{%- set categories = categories|default([]) -%}
{% if categories is not empty %}
    <section id="categories" class="container-page scroll-mt-24 py-16 sm:py-20">
        <div class="flex items-end justify-between gap-4">
            <div>
                <h2 class="text-2xl font-semibold sm:text-3xl">{{ settings.title|default('category.shop_by_category'|trans) }}</h2>
                <p class="mt-2 text-fg-muted">{{ 'category.browse_description'|trans }}</p>
            </div>
            <a href="{{ path('catalog_products') }}" class="hidden shrink-0 items-center gap-1 text-sm font-semibold text-fg hover:text-primary-600 sm:inline-flex">
                {{ 'ui.nav.all_products'|trans }}{{ ux_icon('lucide:arrow-right', {class: 'size-4'}) }}
            </a>
        </div>

        {%- set lg_cols = {1: 'lg:grid-cols-1', 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3'}[categories|length]|default('lg:grid-cols-4') -%}
        <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 {{ lg_cols }}">
            {% for category in categories %}
                {%- set children = (categoryChildrenCounts|default({}))[category.id]|default(0) -%}
                <a href="{{ path('catalog_category', {slug: category.slug}) }}"
                   class="group relative flex min-h-36 flex-col justify-between overflow-hidden rounded-2xl border border-line bg-panel p-5 transition hover:-translate-y-0.5 hover:border-line-strong hover:shadow-lg hover:shadow-black/5 sm:min-h-44 sm:p-6">
                    <span class="flex size-10 items-center justify-center rounded-full bg-subtle text-fg-muted transition group-hover:bg-primary-600 group-hover:text-white">
                        {{ ux_icon('lucide:layout-grid', {class: 'size-5'}) }}
                    </span>
                    <span>
                        <span class="block text-base font-semibold sm:text-lg">{{ category|tr('name') }}</span>
                        <span class="mt-1 flex items-center gap-1 text-sm text-fg-muted">
                            {% if children > 0 %}
                                {{ children }} {{ children == 1 ? 'category.subcategory'|trans : 'category.subcategories'|trans }}
                            {% else %}
                                {{ 'category.explore'|trans }}
                            {% endif %}
                            {{ ux_icon('lucide:arrow-right', {class: 'size-3.5 transition group-hover:translate-x-0.5'}) }}
                        </span>
                    </span>
                </a>
            {% endfor %}
        </div>
    </section>
{% endif %}
