{#
  Testimonials. Settings: title, items [{author, text, rating}].
  Renders nothing until real quotes are configured — no placeholder reviews on a live shop.
#}
{%- set items = settings.items|default([]) -%}
{% if items is not empty %}
    <section class="container-page py-16 sm:py-20">
        <h2 class="text-center text-2xl font-semibold sm:text-3xl">{{ settings.title|default('ui.testimonials.title'|trans) }}</h2>
        <div class="mt-10 grid gap-4 md:grid-cols-3">
            {% for item in items %}
                <figure class="card card-body flex flex-col">
                    <div class="flex gap-0.5 text-amber-400" aria-label="{{ 'ui.reviews.rating_aria'|trans({'%rating%': item.rating|default(5)}) }}">
                        {% for i in 1..5 %}
                            {{ ux_icon('lucide:star', {class: 'size-4 ' ~ (i <= item.rating|default(5) ? 'fill-current' : 'text-line-strong')}) }}
                        {% endfor %}
                    </div>
                    <blockquote class="mt-4 flex-1 text-fg-muted">“{{ item.text|default('') }}”</blockquote>
                    <figcaption class="mt-6 text-sm font-semibold">{{ item.author|default('') }}</figcaption>
                </figure>
            {% endfor %}
        </div>
    </section>
{% endif %}
