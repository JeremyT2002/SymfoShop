{# Service promises strip. Settings: title (optional) #}
<section class="border-y border-line bg-panel">
    <div class="container-page grid grid-cols-2 gap-6 py-10 lg:grid-cols-4">
        {% for item in [
            {icon: 'lucide:truck', title: 'home.benefits.fast_shipping', text: 'home.benefits.fast_shipping_desc'},
            {icon: 'lucide:shield-check', title: 'home.benefits.secure_payment', text: 'home.benefits.secure_payment_desc'},
            {icon: 'lucide:rotate-ccw', title: 'home.benefits.easy_returns', text: 'home.benefits.easy_returns_desc'},
            {icon: 'lucide:headphones', title: 'home.benefits.support', text: 'home.benefits.support_desc'},
        ] %}
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-subtle">{{ ux_icon(item.icon, {class: 'size-5'}) }}</span>
                <div>
                    <p class="text-sm font-semibold">{{ item.title|trans }}</p>
                    <p class="mt-0.5 text-sm text-fg-muted">{{ item.text|trans }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
</section>
