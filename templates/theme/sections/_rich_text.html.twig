{# Rich text (HTML from the theme editor, admin-authored). Settings: title, content #}
<section class="container-page py-16">
    <div class="mx-auto max-w-3xl">
        {% if settings.title|default(false) %}
            <h2 class="mb-6 text-2xl font-semibold sm:text-3xl">{{ settings.title }}</h2>
        {% endif %}
        <div class="prose prose-zinc max-w-none dark:prose-invert prose-a:text-primary-600 dark:prose-a:text-primary-400">
            {{ (settings.content|default(''))|raw }}
        </div>
    </div>
</section>
