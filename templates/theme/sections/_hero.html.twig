{#
  Hero. Settings: title, subtitle, ctaUrl, ctaLabel, backgroundImage
  Without a background image the right column shows up to three product images.
#}
{%- set title = settings.title|default('home.hero.title'|trans) -%}
{%- set subtitle = settings.subtitle|default('home.hero.subtitle'|trans) -%}
{%- set cta_url = settings.ctaUrl|default(path('catalog_products')) -%}
{%- set cta_label = settings.ctaLabel|default('home.cta.start_shopping'|trans) -%}
{%- set background = settings.backgroundImage|default(null) -%}
{%- set collage = (featuredProducts|default([]))|filter(p => p.media|length > 0)|slice(0, 3) -%}

{% if background %}
    <section class="relative isolate overflow-hidden">
        <img src="{{ background }}" alt="" class="absolute inset-0 -z-10 size-full object-cover" fetchpriority="high">
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/70 via-black/40 to-black/10"></div>
        <div class="container-page flex min-h-[28rem] flex-col justify-center py-20 text-white lg:min-h-[36rem]">
            <h1 class="max-w-2xl text-4xl font-semibold sm:text-5xl lg:text-6xl">{{ title }}</h1>
            <p class="mt-5 max-w-xl text-lg text-white/85">{{ subtitle }}</p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a href="{{ cta_url }}" class="btn btn-lg btn-inverse">{{ cta_label }}{{ ux_icon('lucide:arrow-right', {class: 'size-4'}) }}</a>
            </div>
        </div>
    </section>
{% else %}
    <section class="relative overflow-hidden border-b border-line">
        <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60rem_30rem_at_80%_-10%,var(--color-primary-100),transparent)] opacity-70 dark:opacity-20"></div>
        <div class="container-page grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:py-28">
            <div class="lg:col-span-6">
                {% if theme_config().brand.tagline|default(false) %}
                    <p class="eyebrow">{{ theme_config().brand.tagline }}</p>
                {% endif %}
                <h1 class="mt-3 text-4xl font-semibold sm:text-5xl lg:text-6xl">{{ title }}</h1>
                <p class="mt-6 max-w-xl text-lg leading-8 text-fg-muted">{{ subtitle }}</p>
                <div class="mt-10 flex flex-wrap gap-3">
                    <a href="{{ cta_url }}" class="btn btn-lg btn-primary">{{ cta_label }}{{ ux_icon('lucide:arrow-right', {class: 'size-4'}) }}</a>
                    {% if (categories|default([])) is not empty %}
                        <a href="#categories" class="btn btn-lg btn-secondary">{{ 'home.hero.browse_categories'|trans }}</a>
                    {% endif %}
                </div>
            </div>

            {% if collage is not empty %}
                <div class="relative hidden lg:col-span-6 lg:block" aria-hidden="true">
                    <div class="grid grid-cols-6 grid-rows-6 gap-4" style="height: 30rem">
                        {% for product in collage %}
                            {%- set placement = collage|length == 1 ? 'col-span-6 row-span-6' : ['col-span-4 row-span-6', 'col-span-2 row-span-3', 'col-span-2 row-span-3'][loop.index0] -%}
                            <a href="{{ path('catalog_product', {slug: product.slug}) }}" tabindex="-1"
                               class="{{ placement }} overflow-hidden rounded-2xl bg-subtle">
                                <img src="{{ (product.media|first).path }}" alt="" class="size-full object-cover transition duration-700 hover:scale-105"
                                     {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
{% endif %}
