{# Featured products. Settings: title, limit. Context: featuredProducts #}
{%- set products = (featuredProducts|default([]))|slice(0, settings.limit|default(8)) -%}
{% if products is not empty %}
    <section id="featured" class="container-page scroll-mt-24 py-16 sm:py-20">
        <div class="flex items-end justify-between gap-4">
            <div>
                <h2 class="text-2xl font-semibold sm:text-3xl">{{ settings.title|default('home.featured.title'|trans) }}</h2>
                <p class="mt-2 text-fg-muted">{{ 'home.featured.subtitle'|trans }}</p>
            </div>
            <a href="{{ path('catalog_products') }}" class="hidden shrink-0 items-center gap-1 text-sm font-semibold text-fg hover:text-primary-600 sm:inline-flex">
                {{ 'home.featured.view_all'|trans }}{{ ux_icon('lucide:arrow-right', {class: 'size-4'}) }}
            </a>
        </div>

        <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 lg:grid-cols-4">
            {% for product in products %}
                {% include 'components/product_card.html.twig' with {product: product, eager: loop.index <= 4} only %}
            {% endfor %}
        </div>

        <div class="mt-10 text-center sm:hidden">
            <a href="{{ path('catalog_products') }}" class="btn btn-secondary">{{ 'home.featured.view_all'|trans }}</a>
        </div>
    </section>
{% endif %}
