{# Rechnung PDF – Farben & Name aus Shop-Theme (pdf_brand), Dompdf-tauglich #}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <style type="text/css">
        * {
            box-sizing: border-box;
        }
        body {
            font-family: DejaVu Sans, Arial, Helvetica, sans-serif;
            font-size: 11px;
            line-height: 1.45;
            margin: 0;
            padding: 0;
            color: {{ pdf_brand.text_primary }};
            background: {{ pdf_brand.background }};
        }
        .page {
            padding: 0;
        }
        .hero {
            background: {{ pdf_brand.primary }};
            color: #ffffff;
            padding: 22px 28px 20px;
            margin: 0 0 24px 0;
        }
        .hero-inner {
            width: 100%;
        }
        .hero-logo {
            max-height: 44px;
            max-width: 200px;
            vertical-align: middle;
            margin-right: 16px;
        }
        .hero-title {
            font-size: 22px;
            font-weight: bold;
            letter-spacing: 0.02em;
            margin: 0 0 4px 0;
            color: #ffffff;
        }
        .hero-brand {
            font-size: 13px;
            font-weight: bold;
            margin: 0;
            color: #ffffff;
            opacity: 0.95;
        }
        .hero-tagline {
            font-size: 9px;
            margin: 6px 0 0 0;
            color: #ffffff;
            opacity: 0.85;
        }
        .content {
            padding: 0 28px 28px;
        }
        .meta-grid {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 22px;
        }
        .meta-grid td {
            width: 50%;
            vertical-align: top;
            padding: 0 12px 0 0;
        }
        .meta-grid td:last-child {
            padding: 0 0 0 12px;
        }
        .panel {
            background: {{ pdf_brand.surface }};
            border: 1px solid {{ pdf_brand.text_muted }};
            border-radius: 4px;
            padding: 14px 16px;
        }
        .panel-title {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: {{ pdf_brand.primary }};
            font-weight: bold;
            margin: 0 0 10px 0;
            padding-bottom: 6px;
            border-bottom: 2px solid {{ pdf_brand.primary_soft }};
        }
        .panel p {
            margin: 0 0 5px 0;
            color: {{ pdf_brand.text_secondary }};
        }
        .panel strong {
            color: {{ pdf_brand.text_primary }};
            font-weight: bold;
        }
        .invoice-number-badge {
            display: inline-block;
            background: {{ pdf_brand.primary_soft }};
            color: {{ pdf_brand.primary }};
            font-weight: bold;
            font-size: 11px;
            padding: 4px 10px;
            border-radius: 3px;
            margin-bottom: 8px;
        }
        table.items {
            width: 100%;
            border-collapse: collapse;
            margin: 8px 0 20px;
            font-size: 10px;
        }
        table.items thead th {
            background: {{ pdf_brand.primary }};
            color: #ffffff;
            font-weight: bold;
            text-align: left;
            padding: 10px 8px;
            border: none;
        }
        table.items thead th.text-right {
            text-align: right;
        }
        table.items tbody td {
            padding: 9px 8px;
            border-bottom: 1px solid {{ pdf_brand.text_muted }};
            vertical-align: top;
        }
        table.items tbody tr:nth-child(even) td {
            background: {{ pdf_brand.background }};
        }
        .text-right {
            text-align: right;
        }
        .totals-wrap {
            width: 100%;
            margin-top: 8px;
        }
        .totals-wrap td {
            vertical-align: top;
        }
        .totals-spacer {
            width: 55%;
        }
        .totals-box {
            width: 45%;
            background: {{ pdf_brand.surface }};
            border: 1px solid {{ pdf_brand.text_muted }};
            border-left: 4px solid {{ pdf_brand.accent }};
            border-radius: 4px;
            padding: 12px 16px;
        }
        table.totals-inner {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }
        table.totals-inner td {
            padding: 4px 0;
            border: none;
        }
        table.totals-inner tr.grand td {
            font-weight: bold;
            font-size: 13px;
            color: {{ pdf_brand.primary }};
            padding-top: 10px;
            margin-top: 6px;
            border-top: 2px solid {{ pdf_brand.primary }};
        }
        .footer {
            margin-top: 36px;
            padding: 16px 28px 24px;
            border-top: 1px solid {{ pdf_brand.text_muted }};
            font-size: 8px;
            color: {{ pdf_brand.text_muted }};
            text-align: center;
            line-height: 1.5;
        }
        .footer strong {
            color: {{ pdf_brand.text_secondary }};
        }
        .thankyou {
            margin: 18px 28px 0;
            padding: 12px 16px;
            background: {{ pdf_brand.primary_soft }};
            border-radius: 4px;
            font-size: 10px;
            color: {{ pdf_brand.text_secondary }};
        }
        .thankyou strong {
            color: {{ pdf_brand.primary }};
        }
    </style>
</head>
<body>
<div class="page">
    {% set latestPayment = order.payments|last %}
    {% set paymentProvider = latestPayment ? latestPayment.provider : null %}
    {% set paymentMethodLabelMap = {
        'stripe': 'invoice_pdf.payment_method.stripe'|trans,
        'paypal': 'invoice_pdf.payment_method.paypal'|trans,
        'testbank': 'invoice_pdf.payment_method.testbank'|trans,
        'dev': 'invoice_pdf.payment_method.testbank'|trans
    } %}
    {% set paymentMethodLabel = paymentProvider and paymentMethodLabelMap[paymentProvider] is defined
        ? paymentMethodLabelMap[paymentProvider]
        : (paymentProvider ? paymentProvider|upper : 'invoice_pdf.payment_method.unavailable'|trans)
    %}

    <div class="hero">
        <table class="hero-inner" cellpadding="0" cellspacing="0">
            <tr>
                <td style="vertical-align: middle; width: 1%; white-space: nowrap;">
                    {% if pdf_brand.logo_src %}
                        <img src="{{ pdf_brand.logo_src }}" alt="" class="hero-logo"/>
                    {% endif %}
                </td>
                <td style="vertical-align: middle;">
                    <p class="hero-title">{{ 'invoice_pdf.title'|trans }}</p>
                    <p class="hero-brand">{{ pdf_brand.site_name }}</p>
                    {% if pdf_brand.tagline %}
                        <p class="hero-tagline">{{ pdf_brand.tagline }}</p>
                    {% endif %}
                </td>
            </tr>
        </table>
    </div>

    <div class="content">
        <table class="meta-grid" cellpadding="0" cellspacing="0">
            <tr>
                <td>
                    <div class="panel">
                        <p class="panel-title">{{ 'invoice_pdf.recipient'|trans }}</p>
                        <p><strong>{{ 'invoice_pdf.email'|trans }}</strong><br>{{ order.email }}</p>
                        <p><strong>{{ 'invoice_pdf.order_number'|trans }}</strong><br>{{ order.orderNumber }}</p>
                    </div>
                </td>
                <td>
                    <div class="panel">
                        <p class="panel-title">{{ 'invoice_pdf.invoice_details'|trans }}</p>
                        <p>
                            <span class="invoice-number-badge">{{ invoice.invoiceNumber }}</span>
                        </p>
                        <p><strong>{{ 'invoice_pdf.invoice_date'|trans }}</strong><br>{{ invoice.createdAt|date('d.m.Y') }}</p>
                        <p><strong>{{ 'invoice_pdf.order_date'|trans }}</strong><br>{{ order.createdAt|date('d.m.Y') }}</p>
                        <p><strong>{{ 'invoice_pdf.currency'|trans }}</strong><br>{{ order.currency }}</p>
                        <p><strong>{{ 'invoice_pdf.payment_method.label'|trans }}</strong><br>{{ paymentMethodLabel }}</p>
                    </div>
                </td>
            </tr>
        </table>

        <p class="panel-title" style="margin-bottom: 6px;">{{ 'invoice_pdf.items'|trans }}</p>
        <table class="items">
            <thead>
            <tr>
                <th>{{ 'invoice_pdf.table.item'|trans }}</th>
                <th>{{ 'invoice_pdf.table.sku'|trans }}</th>
                <th class="text-right">{{ 'invoice_pdf.table.quantity'|trans }}</th>
                <th class="text-right">{{ 'invoice_pdf.table.unit_price'|trans }}</th>
                <th class="text-right">{{ 'invoice_pdf.table.vat'|trans }}</th>
                <th class="text-right">{{ 'invoice_pdf.table.total'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for item in order.items %}
                <tr>
                    <td>{{ item.nameSnapshot }}</td>
                    <td>{{ item.sku }}</td>
                    <td class="text-right">{{ item.quantity }}</td>
                    <td class="text-right">{{ (item.unitPriceAmount / 100)|number_format(2, ',', '.') }}&nbsp;{{ order.currency }}</td>
                    <td class="text-right">{{ (item.taxRate * 100)|number_format(1, ',', '.') }}&nbsp;%</td>
                    <td class="text-right">{{ (item.totalAmount / 100)|number_format(2, ',', '.') }}&nbsp;{{ order.currency }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <table class="totals-wrap" cellpadding="0" cellspacing="0">
            <tr>
                <td class="totals-spacer"></td>
                <td class="totals-box">
                    <table class="totals-inner">
                        <tr>
                            <td>{{ 'invoice_pdf.subtotal'|trans }}</td>
                            <td class="text-right">{{ (order.subtotal / 100)|number_format(2, ',', '.') }}&nbsp;{{ order.currency }}</td>
                        </tr>
                        <tr>
                            <td>{{ 'invoice_pdf.tax_included'|trans }}</td>
                            <td class="text-right">{{ (order.taxTotal / 100)|number_format(2, ',', '.') }}&nbsp;{{ order.currency }}</td>
                        </tr>
                        <tr class="grand">
                            <td>{{ 'invoice_pdf.grand_total'|trans }}</td>
                            <td class="text-right">{{ (order.grandTotal / 100)|number_format(2, ',', '.') }}&nbsp;{{ order.currency }}</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>

    <div class="thankyou">
        <strong>{{ 'invoice_pdf.thank_you_strong'|trans({'%shop%': pdf_brand.site_name}) }}</strong>
        {{ 'invoice_pdf.thank_you_text'|trans }}
    </div>

    <div class="footer">
        <p><strong>{{ pdf_brand.site_name }}</strong></p>
        <p>{{ 'invoice_pdf.footer.generated'|trans({'%datetime%': "now"|date('d.m.Y, H:i')}) }}</p>
        <p>{{ 'invoice_pdf.footer.tax_note'|trans({'%currency%': order.currency}) }}</p>
    </div>
</div>
</body>
</html>
