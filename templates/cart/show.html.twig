{% extends 'base.html.twig' %}

{% block title %}Shopping Cart - SymfoShop{% endblock %}
{% block meta_description %}Review your shopping cart{% endblock %}
{% block js_page %}cart{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto" 
     data-cart-update-url="{{ path('cart_update') }}" 
     data-cart-remove-url="{{ path('cart_remove') }}"
     data-cart-coupon-apply-url="{{ path('cart_coupon_apply') }}"
     data-cart-coupon-remove-url="{{ path('cart_coupon_remove') }}">
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">{{ 'cart.title'|trans }}</h1>
        <p class="text-gray-600">{{ 'cart.review_items'|trans }}</p>
    </div>

    {% if items|length > 0 %}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Cart Items -->
            <div class="lg:col-span-2 space-y-4">
                {% for item in items %}
                    <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow duration-200 overflow-hidden animate-slide-up" style="animation-delay: {{ loop.index0 * 0.1 }}s">
                        <div class="p-6">
                            <div class="flex gap-6">
                                <!-- Product Image -->
                                <div class="flex-shrink-0">
                                    <a href="{{ path('catalog_product', {slug: item.variant.product.slug}) }}" class="block group">
                                        {% if item.variant.product.media|length > 0 %}
                                            {% set firstMedia = item.variant.product.media|first %}
                                            <div class="w-32 h-32 rounded-lg overflow-hidden bg-gray-100 group-hover:scale-105 transition-transform duration-200">
                                                <img src="{{ firstMedia.path|escape }}" 
                                                     alt="{{ firstMedia.alt|default(item.variant.product.name)|escape }}" 
                                                     class="w-full h-full object-cover">
                                            </div>
                                        {% else %}
                                            <div class="w-32 h-32 rounded-lg bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center group-hover:scale-105 transition-transform duration-200">
                                                <i class="fas fa-image text-4xl text-gray-400"></i>
                                            </div>
                                        {% endif %}
                                    </a>
                                </div>

                                <!-- Product Details -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex justify-between items-start">
                                        <div class="flex-1">
                                            <h3 class="text-lg font-semibold text-gray-900 mb-2 group">
                                                <a href="{{ path('catalog_product', {slug: item.variant.product.slug}) }}" class="hover:text-primary-600 transition-colors">
                                                    {{ item.variant.product.name|escape }}
                                                </a>
                                            </h3>
                                            
                                            <div class="space-y-1 text-sm text-gray-600 mb-4">
                                                <p class="flex items-center">
                                                    <i class="fas fa-barcode mr-2 text-gray-400"></i>
                                                    SKU: <span class="font-mono ml-1">{{ item.variant.sku|escape }}</span>
                                                </p>
                                                {% if item.variant.attributes|length > 0 %}
                                                    <div class="flex flex-wrap gap-2 mt-2">
                                                        {% for key, value in item.variant.attributes %}
                                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-100 text-primary-800">
                                                                {{ key|escape }}: {{ value|escape }}
                                                            </span>
                                                        {% endfor %}
                                                    </div>
                                                {% endif %}
                                            </div>

                                            <!-- Quantity Controls -->
                                            <div class="flex items-center gap-4">
                                                <div class="flex items-center border border-gray-300 rounded-lg overflow-hidden">
                                                    <button type="button" 
                                                            class="quantity-decrease px-3 py-2 text-gray-600 hover:bg-gray-100 transition-colors"
                                                            data-js="cart-quantity-decrease"
                                                            data-variant-id="{{ item.variant.id }}">
                                                        <i class="fas fa-minus text-xs"></i>
                                                    </button>
                                                    <input type="number" 
                                                           id="quantity-{{ item.variant.id }}" 
                                                           value="{{ item.quantity }}" 
                                                           min="1" 
                                                           data-variant-id="{{ item.variant.id }}"
                                                           class="w-16 text-center border-0 focus:ring-0 focus:outline-none py-2 text-sm font-medium">
                                                    <button type="button" 
                                                            class="quantity-increase px-3 py-2 text-gray-600 hover:bg-gray-100 transition-colors"
                                                            data-js="cart-quantity-increase"
                                                            data-variant-id="{{ item.variant.id }}">
                                                        <i class="fas fa-plus text-xs"></i>
                                                    </button>
                                                </div>
                                                <button type="button" 
                                                        class="update-quantity-btn hidden px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors text-sm font-medium"
                                                        data-js="cart-update-quantity"
                                                        data-variant-id="{{ item.variant.id }}">
                                                    <i class="fas fa-sync-alt mr-1"></i>{{ 'cart.update'|trans }}
                                                </button>
                                                <button type="button" 
                                                        class="remove-item-btn ml-auto px-4 py-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors text-sm font-medium"
                                                        data-js="cart-remove-item"
                                                        data-variant-id="{{ item.variant.id }}">
                                                    <i class="fas fa-trash mr-1"></i>{{ 'cart.remove'|trans }}
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Price -->
                                        <div class="text-right ml-4">
                                            <div class="text-2xl font-bold text-primary-600 mb-1" 
                                                 id="item-total-{{ item.variant.id }}"
                                                 data-unit-price="{{ item.variant.priceAmount }}"
                                                 data-currency="{{ item.variant.currency|escape }}">
                                                {{ (item.itemTotal / 100)|number_format(2, '.', ',') }} {{ item.variant.currency|escape }}
                                            </div>
                                            <div class="text-sm text-gray-500">
                                                {{ (item.variant.priceAmount / 100)|number_format(2, '.', ',') }} {{ item.variant.currency|escape }} {{ 'cart.each'|trans }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Order Summary -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-xl shadow-lg p-6 sticky top-24">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                        <i class="fas fa-receipt mr-2 text-primary-600"></i>
                        {{ 'cart.order_summary'|trans }}
                    </h2>
                    
                    {# Coupon Code Input #}
                    <div class="mb-6 pb-6 border-b border-gray-200">
                        {% if coupon %}
                            <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-3">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center gap-2">
                                        <i class="fas fa-check-circle text-green-600"></i>
                                        <span class="text-sm font-semibold text-green-800">{{ 'coupon.applied'|trans }}: {{ coupon.code|escape }}</span>
                                    </div>
                                    <button type="button" 
                                            id="remove-coupon-btn"
                                            data-js="cart-remove-coupon"
                                            class="text-green-700 hover:text-green-900 text-sm font-medium">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                <div class="text-xs text-green-700">
                                    {% if coupon.type.value == 'percentage' %}
                                        {{ coupon.value }}% {{ 'coupon.off'|trans }}
                                    {% else %}
                                        {{ (coupon.value / 100)|number_format(2, '.', ',') }} {{ totals.currency|escape }} {{ 'coupon.off'|trans }}
                                    {% endif %}
                                </div>
                            </div>
                        {% else %}
                            <form id="coupon-form" data-js="cart-coupon-form" class="space-y-2">
                                <label for="coupon-code" class="block text-sm font-medium text-gray-700 mb-1">
                                    {{ 'coupon.code'|trans }}
                                </label>
                                <div class="flex gap-2">
                                    <input type="text" 
                                           id="coupon-code" 
                                           name="code"
                                           placeholder="{{ 'coupon.enter_code'|trans }}"
                                           class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm"
                                           autocomplete="off">
                                    <button type="submit" 
                                            id="apply-coupon-btn"
                                            class="px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors text-sm font-medium whitespace-nowrap">
                                        {{ 'coupon.apply'|trans }}
                                    </button>
                                </div>
                                <div id="coupon-error" class="text-sm text-red-600 hidden"></div>
                            </form>
                        {% endif %}
                    </div>
                    
                    <div class="space-y-4 mb-6">
                        <div class="flex justify-between text-gray-600">
                            <span id="summary-items-label">{{ 'cart.items'|trans }} ({{ totals.totalQuantity }}):</span>
                            <span class="font-medium" id="summary-items-total">{{ (totals.subtotal / 100)|number_format(2, '.', ',') }} {{ totals.currency|escape }}</span>
                        </div>
                        
                        {# Discount Line #}
                        {% if totals.discount > 0 %}
                            <div class="flex justify-between text-green-600" id="discount-line">
                                <span class="flex items-center gap-1">
                                    <i class="fas fa-tag text-sm"></i>
                                    <span>{{ 'coupon.discount'|trans }} {% if coupon %}({{ coupon.code|escape }}){% endif %}:</span>
                                </span>
                                <span class="font-semibold" id="summary-discount">-{{ (totals.discount / 100)|number_format(2, '.', ',') }} {{ totals.currency|escape }}</span>
                            </div>
                        {% endif %}
                    </div>

                    <div class="border-t-2 border-gray-200 pt-4 mb-6">
                        <div class="flex justify-between items-center">
                            <span class="text-lg font-semibold text-gray-900">{{ 'cart.subtotal'|trans }}:</span>
                            <span class="text-2xl font-bold text-primary-600" id="summary-subtotal">{{ ((totals.subtotal - totals.discount) / 100)|number_format(2, '.', ',') }} {{ totals.currency|escape }}</span>
                        </div>
                    </div>

                    <a href="{{ path('checkout') }}" id="checkout-link" class="w-full bg-gradient-to-r from-primary-600 to-primary-700 text-white py-4 px-6 rounded-lg font-semibold text-center block hover:from-primary-700 hover:to-primary-800 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 mb-4">
                        <i class="fas fa-lock mr-2 checkout-icon"></i>
                        <span class="checkout-text">{{ 'cart.proceed_to_checkout'|trans }}</span>
                    </a>

                    <form method="POST" action="{{ path('cart_clear') }}" id="clearCartForm" class="mt-4">
                        <button type="button" 
                                id="clearCartBtn"
                                class="w-full bg-gray-100 text-gray-700 py-3 px-6 rounded-lg font-medium text-center hover:bg-gray-200 transition-colors">
                            <i class="fas fa-trash-alt mr-2"></i>
                            <span class="clear-cart-text">{{ 'cart.clear_cart'|trans }}</span>
                        </button>
                    </form>

                    <div class="mt-6 pt-6 border-t border-gray-200">
                        <div class="flex items-center text-sm text-gray-600">
                            <i class="fas fa-shield-alt text-primary-600 mr-2"></i>
                            <span>{{ 'cart.secure_checkout'|trans }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="bg-white rounded-xl shadow-md p-16 text-center animate-fade-in">
            <div class="max-w-md mx-auto">
                <div class="mb-6">
                    <i class="fas fa-shopping-cart text-8xl text-gray-300"></i>
                </div>
                <h2 class="text-3xl font-bold text-gray-900 mb-3">{{ 'cart.empty'|trans }}</h2>
                <p class="text-gray-600 mb-8 text-lg">{{ 'cart.start_shopping'|trans }}</p>
                <a href="{{ path('catalog_home') }}" class="inline-flex items-center px-6 py-3 bg-primary-600 text-white rounded-lg font-semibold hover:bg-primary-700 transition-colors shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
                    <i class="fas fa-arrow-left mr-2"></i>
                    {{ 'cart.browse_products'|trans }}
                </a>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
