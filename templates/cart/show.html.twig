{% extends 'base.html.twig' %}

{% block page_title %}{{ 'cart.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'cart.review_items'|trans }}{% endblock %}
{% block js_page %}cart{% endblock %}
{% block robots_meta %}<meta name="robots" content="noindex,nofollow">{% endblock %}

{% block body %}
<div class="container-page py-8 lg:py-12"
     data-cart
     data-update-url="{{ path('cart_update') }}"
     data-remove-url="{{ path('cart_remove') }}"
     data-clear-url="{{ path('cart_clear') }}"
     data-coupon-apply-url="{{ path('cart_coupon_apply') }}"
     data-coupon-remove-url="{{ path('cart_coupon_remove') }}">

    <h1 class="text-3xl font-semibold sm:text-4xl">{{ 'cart.title'|trans }}</h1>

    {% if items is empty %}
        <div class="mt-8">
            {% include 'components/empty_state.html.twig' with {
                icon: 'lucide:shopping-bag',
                title: 'cart.empty'|trans,
                text: 'cart.start_shopping'|trans,
                action: {label: 'cart.browse_products'|trans, url: path('catalog_products')},
            } only %}
        </div>
    {% else %}
        <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:items-start">
            {# Lines #}
            <section class="lg:col-span-7 xl:col-span-8" aria-labelledby="cart-items-heading">
                <h2 id="cart-items-heading" class="sr-only">{{ 'cart.items'|trans }}</h2>
                <ul class="divide-y divide-line border-y border-line" role="list">
                    {% for item in items %}
                        {%- set variant = item.variant -%}
                        {%- set product = variant.product -%}
                        {%- set image = product.media|first -%}
                        {%- set available = variant.stockItem ? variant.stockItem.available : 0 -%}
                        <li class="flex gap-4 py-6 transition-opacity aria-busy:opacity-60 sm:gap-6" data-cart-line="{{ variant.id }}">
                            <a href="{{ path('catalog_product', {slug: product.slug}) }}" class="size-24 shrink-0 overflow-hidden rounded-xl bg-subtle sm:size-32">
                                {% if image %}
                                    <img src="{{ image.path }}" alt="{{ image.alt|default(product.name) }}" class="size-full object-cover">
                                {% else %}
                                    <span class="flex size-full items-center justify-center text-fg-subtle">{{ ux_icon('lucide:image', {class: 'size-8 opacity-50'}) }}</span>
                                {% endif %}
                            </a>

                            <div class="flex min-w-0 flex-1 flex-col">
                                <div class="flex justify-between gap-4">
                                    <div class="min-w-0">
                                        <h3 class="font-medium">
                                            <a href="{{ path('catalog_product', {slug: product.slug}) }}" class="hover:underline">{{ product.name }}</a>
                                        </h3>
                                        {% if variant.attributes is not empty %}
                                            <p class="mt-1 text-sm text-fg-muted">{{ variant.attributes|map((v, k) => k|capitalize ~ ': ' ~ v)|join(' · ') }}</p>
                                        {% endif %}
                                        <p class="mt-1 text-sm text-fg-subtle">{{ variant.priceAmount|money(variant.currency) }} {{ 'cart.each'|trans }}</p>
                                    </div>
                                    <p class="shrink-0 font-semibold tabular-nums" data-line-total="{{ variant.id }}">{{ item.itemTotal|money(variant.currency) }}</p>
                                </div>

                                <div class="mt-auto flex items-center justify-between gap-4 pt-4">
                                    <div class="flex items-center rounded-lg border border-line-strong">
                                        <button type="button" class="btn btn-ghost btn-icon h-9 rounded-r-none" data-quantity-step="-1" aria-label="{{ 'ui.quantity.decrease'|trans }}">{{ ux_icon('lucide:minus', {class: 'size-3.5'}) }}</button>
                                        <label for="qty-{{ variant.id }}" class="sr-only">{{ 'cart.quantity'|trans }}: {{ product.name }}</label>
                                        <input id="qty-{{ variant.id }}" type="number" min="1" {% if available > 0 %}max="{{ available }}"{% endif %} value="{{ item.quantity }}" data-quantity-input
                                               class="h-9 w-10 border-0 bg-transparent p-0 text-center text-sm font-semibold tabular-nums focus:ring-0 focus:outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none">
                                        <button type="button" class="btn btn-ghost btn-icon h-9 rounded-l-none" data-quantity-step="1" aria-label="{{ 'ui.quantity.increase'|trans }}">{{ ux_icon('lucide:plus', {class: 'size-3.5'}) }}</button>
                                    </div>
                                    <button type="button" class="btn btn-ghost btn-sm text-fg-muted" data-remove-line>
                                        {{ ux_icon('lucide:trash-2', {class: 'size-4'}) }}<span class="hidden sm:inline">{{ 'cart.remove'|trans }}</span>
                                        <span class="sr-only sm:hidden">{{ 'cart.remove'|trans }}: {{ product.name }}</span>
                                    </button>
                                </div>
                                {% if available < item.quantity %}
                                    <p class="mt-2 text-sm text-amber-700 dark:text-amber-400">{{ available > 0 ? 'ui.cart.only_n_available'|trans({'%count%': available}) : 'ui.cart.out_of_stock'|trans }}</p>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>

                <div class="mt-4 flex items-center justify-between">
                    <a href="{{ path('catalog_products') }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-fg-muted hover:text-fg">
                        {{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }}{{ 'cart.continue_shopping'|trans }}
                    </a>
                    <button type="button" class="btn btn-ghost btn-sm text-fg-muted" data-cart-clear>{{ 'cart.clear_cart'|trans }}</button>
                </div>
            </section>

            {# Summary #}
            <section class="card card-body lg:sticky lg:top-28 lg:col-span-5 xl:col-span-4" aria-labelledby="summary-heading">
                <h2 id="summary-heading" class="text-lg font-semibold">{{ 'cart.order_summary'|trans }}</h2>

                <dl class="mt-6 space-y-3 text-sm">
                    <div class="flex justify-between">
                        <dt class="text-fg-muted">{{ 'cart.subtotal'|trans }} (<span data-cart-total-quantity>{{ totals.totalQuantity }}</span>)</dt>
                        <dd class="font-medium tabular-nums" data-cart-total="subtotal">{{ totals.subtotal|money(totals.currency) }}</dd>
                    </div>
                    <div class="flex justify-between text-emerald-700 dark:text-emerald-400" data-discount-row {% if totals.discount <= 0 %}hidden{% endif %}>
                        <dt>{{ 'coupon.discount'|trans }}{% if coupon %} ({{ coupon.code }}){% endif %}</dt>
                        <dd class="font-medium tabular-nums" data-cart-total="discount">−{{ totals.discount|money(totals.currency) }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-fg-muted">{{ 'checkout.shipping_amount'|trans }}</dt>
                        <dd class="text-fg-muted">{{ 'ui.cart.calculated_at_checkout'|trans }}</dd>
                    </div>
                    <div class="flex justify-between border-t border-line pt-4 text-base font-semibold">
                        <dt>{{ 'checkout.total'|trans }}</dt>
                        <dd class="tabular-nums" data-cart-total="grand">{{ (totals.subtotal - totals.discount)|money(totals.currency) }}</dd>
                    </div>
                </dl>
                <p class="mt-1 text-xs text-fg-subtle">{{ 'ui.cart.tax_note'|trans }}</p>

                {# Coupon #}
                <div class="mt-6 border-t border-line pt-6">
                    {% if coupon %}
                        <div class="flex items-center justify-between gap-3 rounded-lg bg-emerald-50 px-3 py-2.5 text-sm text-emerald-800 dark:bg-emerald-500/10 dark:text-emerald-300">
                            <span class="flex items-center gap-2">{{ ux_icon('lucide:ticket-percent', {class: 'size-4'}) }}<span class="font-semibold">{{ coupon.code }}</span>
                                · {{ coupon.type.value == 'percentage' ? coupon.value ~ '%' : coupon.value|money(totals.currency) }} {{ 'coupon.off'|trans }}</span>
                            <button type="button" class="rounded p-1 hover:bg-emerald-100 dark:hover:bg-emerald-500/20" data-coupon-remove aria-label="{{ 'ui.coupon.remove'|trans }}">{{ ux_icon('lucide:x', {class: 'size-4'}) }}</button>
                        </div>
                    {% else %}
                        <form data-coupon-form x-data="{ open: false }">
                            <button type="button" class="flex w-full items-center justify-between text-sm font-medium" @click="open = !open; $nextTick(() => open && $refs.code.focus())" :aria-expanded="open">
                                {{ 'ui.coupon.have_code'|trans }}<span class="inline-flex shrink-0 transition" :class="open && 'rotate-180'">{{ ux_icon('lucide:chevron-down', {class: 'size-4 transition'}) }}</span>
                            </button>
                            <div x-show="open" x-collapse x-cloak>
                                <div class="mt-3 flex gap-2">
                                    <label for="coupon-code" class="sr-only">{{ 'coupon.code'|trans }}</label>
                                    <input id="coupon-code" x-ref="code" name="code" autocomplete="off" class="input uppercase" placeholder="{{ 'coupon.enter_code'|trans }}">
                                    <button type="submit" class="btn btn-secondary">{{ 'coupon.apply'|trans }}</button>
                                </div>
                                <p class="form-error" data-coupon-error hidden></p>
                            </div>
                        </form>
                    {% endif %}
                </div>

                <a href="{{ path('checkout') }}" class="btn btn-primary btn-lg mt-6 w-full">
                    {{ ux_icon('lucide:lock', {class: 'size-4'}) }}{{ 'cart.proceed_to_checkout'|trans }}
                </a>
                <p class="mt-4 flex items-center justify-center gap-2 text-xs text-fg-subtle">{{ ux_icon('lucide:shield-check', {class: 'size-4'}) }}{{ 'cart.secure_checkout'|trans }}</p>
            </section>
        </div>
    {% endif %}
</div>
{% endblock %}
