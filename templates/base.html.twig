{%- set site_name = theme_config().brand.siteName|default('SymfoShop') -%}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#fafafa">
    <script>
        {# Apply the colour scheme before first paint (no flash). Mirrors assets/js/components/color-scheme.js. #}
        (function () {
            try {
                var stored = localStorage.getItem('symfoshop-color-scheme');
                var dark = stored === 'dark' || (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.classList.toggle('dark', dark);
            } catch (e) {}
        })();
    </script>

    {#- block() returns already-escaped template output, hence |raw -#}
    {%- set page_title = block('page_title') is defined ? block('page_title')|trim : '' %}
    <title>{% block title %}{% if page_title %}{{ page_title|raw }} · {% endif %}{{ site_name }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}{{ theme_config().brand.tagline|default(site_name) }}{% endblock %}">
    {%- set alternates = locale_alternates() %}
    <link rel="canonical" href="{{ app.request.query.has('lang') ? alternates[app.request.locale] : alternates['x-default'] }}">
    {% block hreflang %}
        {%- for hreflang, href in alternates %}
        <link rel="alternate" hreflang="{{ hreflang }}" href="{{ href }}">
        {%- endfor %}
    {% endblock %}

    {% block robots_meta %}
        {%- set noIndex = theme_config().seo.defaultNoIndex|default(false) or seo_noindex|default(false) -%}
        <meta name="robots" content="{{ noIndex ? 'noindex,nofollow' : 'index,follow' }}">
    {% endblock %}

    <meta property="og:site_name" content="{{ site_name }}">
    {% block meta_tags %}{% endblock %}

    {% if theme_config().brand.faviconUrl|default(false) %}
        <link rel="icon" href="{{ theme_config().brand.faviconUrl }}">
    {% endif %}

    {% block importmap %}{{ importmap('app') }}{% endblock %}

    {# Theme editor tokens after the stylesheet: unlayered :root vars override the defaults #}
    {% include 'theme/_tokens.css.twig' %}
    {% if theme_config().customCss|default(false) %}
        <style id="theme-custom-css">{{ theme_config().customCss|raw }}</style>
    {% endif %}

    {% block stylesheets %}{% endblock %}
</head>
<body class="flex min-h-screen flex-col"
      data-page="{% block js_page %}{% endblock %}"
      data-cart-url="{{ path('cart_show') }}"
      data-cart-add-url="{{ path('cart_add') }}"
      data-wishlist-toggle-url="{{ path('account_wishlist_toggle') }}">
    <a href="#main" class="sr-only z-[100] rounded-lg bg-panel px-4 py-2 font-medium focus:not-sr-only focus:fixed focus:top-3 focus:left-3">
        {{ 'ui.a11y.skip_to_content'|trans }}
    </a>

    {% include 'partials/_header.html.twig' %}
    {% include 'partials/_flashes.html.twig' %}

    <main id="main" class="flex flex-1 flex-col">
        {% block body %}{% endblock %}
    </main>

    {% include 'partials/_footer.html.twig' %}
    {% include 'partials/_support_widgets.html.twig' %}
    {% include 'partials/_cookie_banner.html.twig' %}

    <div id="toast-region" aria-live="polite" role="status"></div>

    <script type="application/json" id="app-i18n">
        {{- {
            'common.loading': 'common.loading'|trans,
            'cart.item_added': 'cart.item_added'|trans,
            'cart.error_occurred': 'cart.error_occurred'|trans,
            'cart.clear_cart_confirm': 'cart.clear_cart_confirm'|trans,
            'product.error_adding': 'product.error_adding'|trans,
            'wishlist.added': 'wishlist.added'|trans,
            'wishlist.removed': 'wishlist.removed'|trans,
            'wishlist.error': 'wishlist.error'|trans,
            'checkout.shipping_free': 'checkout.shipping_free'|trans,
            'support.sender.you': 'support.sender.you'|trans,
            'support.sender.support': 'support.sender.support'|trans,
            'ui.cart.view_cart': 'ui.cart.view_cart'|trans,
            'ui.cart.added': 'ui.cart.added'|trans,
            'ui.checkout.placing_order': 'ui.checkout.placing_order'|trans,
            'ui.payment.processing': 'ui.payment.processing'|trans,
            'ui.payment.failed': 'ui.payment.failed'|trans,
        }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE'))|raw -}}
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>
