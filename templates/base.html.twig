<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SymfoShop{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}SymfoShop - Your online shopping destination{% endblock %}">
    
    <!-- Theme tokens (CSS variables) -->
    {% include 'theme/_tokens.css.twig' %}
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    
    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    
    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: 'var(--color-primary-50)',
                            100: 'var(--color-primary-100)',
                            200: 'var(--color-primary-200)',
                            300: 'var(--color-primary-300)',
                            400: 'var(--color-primary-400)',
                            500: 'var(--color-primary-500)',
                            600: 'var(--color-primary-600)',
                            700: 'var(--color-primary-700)',
                            800: 'var(--color-primary-800)',
                            900: 'var(--color-primary-900)',
                        },
                        surface: 'var(--color-surface, #ffffff)',
                        accent: 'var(--color-accent, #22c55e)',
                    },
                    fontFamily: {
                        sans: ['var(--font-sans)', 'Inter', 'system-ui', 'sans-serif'],
                    },
                    borderRadius: {
                        'theme-sm': 'var(--radius-sm)',
                        'theme-md': 'var(--radius-md)',
                        'theme-lg': 'var(--radius-lg)',
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.3s ease-in-out',
                        'slide-up': 'slideUp 0.3s ease-out',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { transform: 'translateY(20px)', opacity: '0' },
                            '100%': { transform: 'translateY(0)', opacity: '1' },
                        },
                    },
                },
            },
        }
    </script>
    
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-gray-50 antialiased smooth-scroll flex flex-col min-h-screen" 
      data-js-page="{% block js_page %}{% endblock %}"
      data-cart-add-url="{{ path('cart_add') }}"
      data-wishlist-toggle-url="{{ path('account_wishlist_toggle') }}"
      data-wishlist-check-url="{{ path('account_wishlist_check') }}">
    <!-- Navigation -->
    <nav class="bg-white border-b border-gray-200 shadow-sm sticky top-0 z-50" role="navigation" aria-label="Main navigation">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16 lg:h-20">
                <!-- Logo & Desktop Navigation -->
                <div class="flex items-center space-x-8 lg:space-x-12">
                    <!-- Logo -->
                    <a href="{{ path('catalog_home') }}" 
                       class="flex items-center space-x-2.5 group focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 rounded-lg p-1 -ml-1"
                       aria-label="SymfoShop Home">
                        <div class="w-9 h-9 lg:w-10 lg:h-10 bg-gradient-to-br from-primary-600 to-primary-700 rounded-xl flex items-center justify-center group-hover:from-primary-700 group-hover:to-primary-800 transition-all duration-200 shadow-md group-hover:shadow-lg">
                            <i class="fas fa-shopping-bag text-white text-sm lg:text-base"></i>
                        </div>
                        <span class="text-xl lg:text-2xl font-bold text-gray-900 group-hover:text-primary-600 transition-colors">
                            SymfoShop
                        </span>
                    </a>
                    
                    <!-- Desktop Navigation Links -->
                    <div class="hidden lg:flex items-center space-x-1">
                        <a href="{{ path('catalog_home') }}" 
                           class="flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 transition-all duration-200 {% if app.request.get('_route') == 'catalog_home' %}text-primary-600 bg-primary-50{% endif %}">
                            <i class="fas fa-home text-sm"></i>
                            <span>{{ 'nav.home'|trans }}</span>
                        </a>
                        {% if app.user %}
                            <a href="{{ path('account_wishlist_show') }}" 
                               class="flex items-center space-x-2 px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 transition-all duration-200 {% if app.request.get('_route') == 'account_wishlist_show' %}text-primary-600 bg-primary-50{% endif %}">
                                <i class="fas fa-heart text-sm"></i>
                                <span>{{ 'footer.wishlist'|trans }}</span>
                            </a>
                        {% endif %}
                    </div>
                </div>
                
                <!-- Right Side Actions -->
                <div class="flex items-center space-x-2 lg:space-x-4">
                    <!-- Cart Icon -->
                    <a href="{{ path('cart_show') }}" 
                       class="relative flex items-center justify-center w-10 h-10 rounded-lg text-gray-700 hover:text-primary-600 hover:bg-gray-50 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
                       aria-label="{{ 'nav.cart'|trans }}">
                        <i class="fas fa-shopping-cart text-lg"></i>
                        {% set cartCount = cart_items_count() %}
                        {% if cartCount > 0 %}
                            <span class="cart-badge absolute -top-1 -right-1 bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center shadow-lg animate-pulse">
                                {{ cartCount > 99 ? '99+' : cartCount }}
                            </span>
                        {% endif %}
                    </a>
                    
                    <!-- Language Switcher (Desktop) -->
                    <div class="hidden lg:block relative">
                        <select id="language-switcher" 
                                class="appearance-none bg-gray-50 border border-gray-300 text-gray-700 rounded-lg px-3 py-2 pr-8 text-sm font-medium hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors cursor-pointer"
                                aria-label="{{ 'nav.language'|trans }}">
                            <option value="en" {% if app.request.locale == 'en' %}selected{% endif %}>🇬🇧 EN</option>
                            <option value="de" {% if app.request.locale == 'de' %}selected{% endif %}>🇩🇪 DE</option>
                            <option value="fr" {% if app.request.locale == 'fr' %}selected{% endif %}>🇫🇷 FR</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2">
                            <i class="fas fa-chevron-down text-gray-400 text-xs"></i>
                        </div>
                    </div>
                    
                    {% if app.user %}
                        <!-- User Menu Dropdown (Desktop) -->
                        <div class="hidden lg:block relative" x-data="{ open: false }" @click.away="open = false" @keydown.escape="open = false">
                            <button @click="open = !open"
                                    class="flex items-center space-x-2 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
                                    aria-expanded="false"
                                    :aria-expanded="open"
                                    aria-haspopup="true"
                                    aria-label="User menu">
                                <div class="w-8 h-8 bg-gradient-to-br from-primary-500 to-primary-600 rounded-full flex items-center justify-center shadow-sm">
                                    <i class="fas fa-user text-white text-xs"></i>
                                </div>
                                <span class="hidden xl:block max-w-[120px] truncate">{{ app.user.email }}</span>
                                <i class="fas fa-chevron-down text-xs text-gray-400 transition-transform duration-200" :class="open ? 'rotate-180' : ''"></i>
                            </button>
                            
                            <!-- Dropdown Menu -->
                            <div x-show="open"
                                 x-transition:enter="transition ease-out duration-100"
                                 x-transition:enter-start="transform opacity-0 scale-95"
                                 x-transition:enter-end="transform opacity-100 scale-100"
                                 x-transition:leave="transition ease-in duration-75"
                                 x-transition:leave-start="transform opacity-100 scale-100"
                                 x-transition:leave-end="transform opacity-0 scale-95"
                                 class="absolute right-0 mt-2 w-56 rounded-xl shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none z-50"
                                 style="display: none;">
                                <div class="py-2">
                                    <div class="px-4 py-3 border-b border-gray-100">
                                        <p class="text-sm font-semibold text-gray-900 truncate">{{ app.user.email }}</p>
                                        {% if app.user.firstName or app.user.lastName %}
                                            <p class="text-xs text-gray-500 mt-0.5">{{ app.user.fullName }}</p>
                                        {% endif %}
                                    </div>
                                    <a href="{{ path('account_wishlist_show') }}" 
                                       class="flex items-center space-x-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-primary-600 transition-colors">
                                        <i class="fas fa-heart w-5 text-center"></i>
                                        <span>{{ 'footer.wishlist'|trans }}</span>
                                    </a>
                                    <a href="{{ path('admin') }}" 
                                       class="flex items-center space-x-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-primary-600 transition-colors">
                                        <i class="fas fa-cog w-5 text-center"></i>
                                        <span>{{ 'nav.admin'|trans }}</span>
                                    </a>
                                    <div class="border-t border-gray-100 my-1"></div>
                                    <a href="{{ path('logout') }}" 
                                       class="flex items-center space-x-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors">
                                        <i class="fas fa-sign-out-alt w-5 text-center"></i>
                                        <span>{{ 'nav.logout'|trans }}</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <!-- Login/Register Buttons (Desktop) -->
                        <div class="hidden lg:flex items-center space-x-3">
                            <a href="{{ path('login') }}" 
                               class="px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 transition-all duration-200">
                                {{ 'nav.login'|trans }}
                            </a>
                            <a href="{{ path('register') }}" 
                               class="px-4 py-2.5 rounded-lg text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 shadow-md hover:shadow-lg transition-all duration-200">
                                {{ 'nav.register'|trans }}
                            </a>
                        </div>
                    {% endif %}
                    
                    <!-- Mobile Menu Button -->
                    <button type="button"
                            class="lg:hidden p-2 rounded-lg text-gray-700 hover:text-primary-600 hover:bg-gray-50 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
                            aria-expanded="false"
                            aria-label="Open menu"
                            data-js="mobile-menu-toggle"
                            id="mobile-menu-button">
                        <i class="fas fa-bars text-xl" id="mobile-menu-icon"></i>
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Mobile Menu -->
        <div id="mobile-menu" class="lg:hidden hidden border-t border-gray-200 bg-white shadow-lg">
            <div class="px-4 py-4 space-y-1">
                <a href="{{ path('catalog_home') }}" 
                   class="flex items-center space-x-3 px-4 py-3 rounded-lg text-base font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 transition-colors {% if app.request.get('_route') == 'catalog_home' %}text-primary-600 bg-primary-50{% endif %}">
                    <i class="fas fa-home w-5 text-center"></i>
                    <span>{{ 'nav.home'|trans }}</span>
                </a>
                
                {% if app.user %}
                    <a href="{{ path('account_wishlist_show') }}" 
                       class="flex items-center space-x-3 px-4 py-3 rounded-lg text-base font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 transition-colors {% if app.request.get('_route') == 'account_wishlist_show' %}text-primary-600 bg-primary-50{% endif %}">
                        <i class="fas fa-heart w-5 text-center"></i>
                        <span>{{ 'footer.wishlist'|trans }}</span>
                    </a>
                    <a href="{{ path('cart_show') }}" 
                       class="flex items-center space-x-3 px-4 py-3 rounded-lg text-base font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 transition-colors">
                        <i class="fas fa-shopping-cart w-5 text-center"></i>
                        <span>{{ 'nav.cart'|trans }}</span>
                        {% set cartCount = cart_items_count() %}
                        {% if cartCount > 0 %}
                            <span class="ml-auto bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">
                                {{ cartCount > 99 ? '99+' : cartCount }}
                            </span>
                        {% endif %}
                    </a>
                    <a href="{{ path('admin') }}" 
                       class="flex items-center space-x-3 px-4 py-3 rounded-lg text-base font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 transition-colors">
                        <i class="fas fa-cog w-5 text-center"></i>
                        <span>{{ 'nav.admin'|trans }}</span>
                    </a>
                    <div class="border-t border-gray-200 my-2"></div>
                    <div class="px-4 py-2">
                        <p class="text-sm font-semibold text-gray-900">{{ app.user.email }}</p>
                        {% if app.user.firstName or app.user.lastName %}
                            <p class="text-xs text-gray-500 mt-0.5">{{ app.user.fullName }}</p>
                        {% endif %}
                    </div>
                    <a href="{{ path('logout') }}" 
                       class="flex items-center space-x-3 px-4 py-3 rounded-lg text-base font-medium text-red-600 hover:bg-red-50 transition-colors">
                        <i class="fas fa-sign-out-alt w-5 text-center"></i>
                        <span>{{ 'nav.logout'|trans }}</span>
                    </a>
                {% else %}
                    <a href="{{ path('cart_show') }}" 
                       class="flex items-center space-x-3 px-4 py-3 rounded-lg text-base font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 transition-colors">
                        <i class="fas fa-shopping-cart w-5 text-center"></i>
                        <span>{{ 'nav.cart'|trans }}</span>
                        {% set cartCount = cart_items_count() %}
                        {% if cartCount > 0 %}
                            <span class="ml-auto bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">
                                {{ cartCount > 99 ? '99+' : cartCount }}
                            </span>
                        {% endif %}
                    </a>
                    <div class="border-t border-gray-200 my-2"></div>
                    <a href="{{ path('login') }}" 
                       class="flex items-center space-x-3 px-4 py-3 rounded-lg text-base font-medium text-gray-700 hover:text-primary-600 hover:bg-gray-50 transition-colors">
                        <i class="fas fa-sign-in-alt w-5 text-center"></i>
                        <span>{{ 'nav.login'|trans }}</span>
                    </a>
                    <a href="{{ path('register') }}" 
                       class="flex items-center space-x-3 px-4 py-3 rounded-lg text-base font-medium text-white bg-primary-600 hover:bg-primary-700 transition-colors mx-4">
                        <i class="fas fa-user-plus w-5 text-center"></i>
                        <span>{{ 'nav.register'|trans }}</span>
                    </a>
                {% endif %}
                
                <!-- Mobile Language Switcher -->
                <div class="border-t border-gray-200 pt-4 mt-2">
                    <label for="mobile-language-switcher" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 mb-2">
                        {{ 'nav.language'|trans }}
                    </label>
                    <select id="mobile-language-switcher" 
                            class="w-full mx-4 bg-gray-50 border border-gray-300 text-gray-700 rounded-lg px-4 py-2.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                        <option value="en" {% if app.request.locale == 'en' %}selected{% endif %}>🇬🇧 English</option>
                        <option value="de" {% if app.request.locale == 'de' %}selected{% endif %}>🇩🇪 Deutsch</option>
                        <option value="fr" {% if app.request.locale == 'fr' %}selected{% endif %}>🇫🇷 Français</option>
                    </select>
                </div>
            </div>
        </div>
    </nav>
    
    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
                <div class="p-4 rounded-lg {% if label == 'success' %}bg-green-50 text-green-800 border border-green-200{% elseif label == 'error' %}bg-red-50 text-red-800 border border-red-200{% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %}">
                    <div class="flex items-center space-x-2">
                        <i class="fas {% if label == 'success' %}fa-check-circle{% elseif label == 'error' %}fa-exclamation-circle{% else %}fa-info-circle{% endif %}"></i>
                        <span>{{ message }}</span>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endfor %}
    
    <!-- Main Content -->
    <main class="flex-grow flex flex-col">
        {% block body %}{% endblock %}
    </main>
    
    <!-- Footer -->
    <footer class="bg-gray-900 text-white mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div>
                    <div class="flex items-center space-x-2 mb-4">
                        <i class="fas fa-shopping-bag text-2xl"></i>
                        <span class="text-xl font-bold">SymfoShop</span>
                    </div>
                    <p class="text-gray-400 text-sm">{{ 'footer.description'|trans }}</p>
                </div>
                
                <div>
                    <h3 class="font-semibold mb-4">{{ 'footer.shop'|trans }}</h3>
                    <ul class="space-y-2 text-sm text-gray-400">
                        <li><a href="{{ path('catalog_home') }}" class="hover:text-white transition-colors">{{ 'footer.categories'|trans }}</a></li>
                        <li><a href="{{ path('cart_show') }}" class="hover:text-white transition-colors">{{ 'footer.cart'|trans }}</a></li>
                    </ul>
                </div>
                
                <div>
                    <h3 class="font-semibold mb-4">{{ 'footer.account'|trans }}</h3>
                    <ul class="space-y-2 text-sm text-gray-400">
                        <li><a href="{{ path('login') }}" class="hover:text-white transition-colors">{{ 'footer.login'|trans }}</a></li>
                        <li><a href="{{ path('register') }}" class="hover:text-white transition-colors">{{ 'footer.register'|trans }}</a></li>
                    </ul>
                </div>
                
                <div>
                    <h3 class="font-semibold mb-4">{{ 'footer.support'|trans }}</h3>
                    <ul class="space-y-2 text-sm text-gray-400">
                        <li><a href="#" class="hover:text-white transition-colors">{{ 'footer.contact'|trans }}</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">{{ 'footer.faq'|trans }}</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">{{ 'footer.shipping'|trans }}</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="border-t border-gray-800 mt-8 pt-8 text-center text-sm text-gray-400">
                <p>&copy; {{ 'now'|date('Y') }} SymfoShop. {{ 'footer.rights'|trans }}</p>
            </div>
        </div>
    </footer>
    
    {% block javascripts %}
    <!-- Application JavaScript -->
    <script type="module" src="{{ asset('js/app.js') }}"></script>
    <style>
        @keyframes slide-in-right {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
        .animate-slide-in-right {
            animation: slide-in-right 0.3s ease-out;
        }
    </style>
    {% endblock %}
</body>
</html>
