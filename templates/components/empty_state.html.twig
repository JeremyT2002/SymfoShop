{#
  Empty state. Params: icon (lucide name), title, text (optional), action {label, url} (optional)
#}
<div class="flex flex-col items-center rounded-2xl border border-dashed border-line-strong px-6 py-16 text-center">
    <span class="flex size-14 items-center justify-center rounded-full bg-subtle text-fg-muted">
        {{ ux_icon(icon|default('lucide:inbox'), {class: 'size-6'}) }}
    </span>
    <h2 class="mt-5 text-lg font-semibold">{{ title }}</h2>
    {% if text|default(false) %}
        <p class="mt-2 max-w-md text-sm text-fg-muted">{{ text }}</p>
    {% endif %}
    {% if action|default(false) %}
        <a href="{{ action.url }}" class="btn btn-primary mt-6">{{ action.label }}</a>
    {% endif %}
</div>
