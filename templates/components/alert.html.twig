{#
  Alert Component
  ===============

  A flexible alert component for displaying notifications and messages.

  Parameters:
  - type: info|success|warning|error (default: info)
  - title: string
  - dismissible: boolean (default: false)
  - icon: boolean (default: true)
  - size: sm|md|lg (default: md)

  Usage:
  {% include 'components/alert.html.twig' with {
    type: 'success',
    title: 'Success!',
    dismissible: true
  } %}
    Your changes have been saved successfully.
  {% endinclude %}
#}

{# Default parameters #}
{% set type = type|default('info') %}
{% set dismissible = dismissible|default(false) %}
{% set icon = icon|default(true) %}
{% set size = size|default('md') %}

{# Type configuration #}
{% set typeConfig = {
  'info': {
    'bg': 'bg-blue-50',
    'border': 'border-blue-200',
    'text': 'text-blue-800',
    'icon': 'fa-info-circle',
    'iconColor': 'text-blue-500'
  },
  'success': {
    'bg': 'bg-green-50',
    'border': 'border-green-200',
    'text': 'text-green-800',
    'icon': 'fa-check-circle',
    'iconColor': 'text-green-500'
  },
  'warning': {
    'bg': 'bg-yellow-50',
    'border': 'border-yellow-200',
    'text': 'text-yellow-800',
    'icon': 'fa-exclamation-triangle',
    'iconColor': 'text-yellow-500'
  },
  'error': {
    'bg': 'bg-red-50',
    'border': 'border-red-200',
    'text': 'text-red-800',
    'icon': 'fa-exclamation-circle',
    'iconColor': 'text-red-500'
  }
} %}

{# Size classes #}
{% set sizeClasses = {
  'sm': 'p-3 text-sm gap-2',
  'md': 'p-4 text-sm gap-3',
  'lg': 'p-6 text-base gap-4'
} %}

{# Generate unique ID for dismissible alerts #}
{% set alertId = dismissible ? 'alert-' ~ random() : null %}

<div
  class="rounded-xl border {{ typeConfig[type].bg }} {{ typeConfig[type].border }} {{ sizeClasses[size] }} flex items-start"
  {% if alertId %}id="{{ alertId }}"{% endif %}
  role="alert"
>
  {# Icon #}
  {% if icon %}
    <div class="flex-shrink-0">
      <i class="fas {{ typeConfig[type].icon }} {{ typeConfig[type].iconColor }}" aria-hidden="true"></i>
    </div>
  {% endif %}

  <div class="flex-1 min-w-0">
    {# Title #}
    {% if title %}
      <h3 class="font-semibold {{ typeConfig[type].text }} mb-1">
        {{ title }}
      </h3>
    {% endif %}

    {# Content #}
    <div class="{{ typeConfig[type].text }}">
      {{ content|default(block('content')) }}
    </div>
  </div>

  {# Dismiss button #}
  {% if dismissible %}
    <div class="flex-shrink-0">
      <button
        type="button"
        class="inline-flex rounded-md {{ typeConfig[type].text }} hover:{{ typeConfig[type].bg }} focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-{{ typeConfig[type].bg }} focus:ring-{{ typeConfig[type].iconColor|replace('text-', '') }}-500 transition-colors"
        onclick="this.closest('[role=alert]').remove()"
        aria-label="Dismiss"
      >
        <i class="fas fa-times" aria-hidden="true"></i>
      </button>
    </div>
  {% endif %}
</div>