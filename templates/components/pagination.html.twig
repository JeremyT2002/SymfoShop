{#
  Pagination. Params: currentPage, totalPages, route, routeParams (optional), maxPages (optional, default 5)
#}
{%- set routeParams = routeParams|default({}) -%}
{%- set maxPages = maxPages|default(5) -%}
{% if totalPages > 1 %}
    {%- set start = max(1, currentPage - (maxPages // 2)) -%}
    {%- set end = min(totalPages, start + maxPages - 1) -%}
    {%- set start = max(1, end - maxPages + 1) -%}
    {%- set item = 'flex h-10 min-w-10 items-center justify-center rounded-lg px-3 text-sm font-medium transition-colors' -%}
    <nav aria-label="{{ 'ui.a11y.pagination'|trans }}" class="mt-12 flex items-center justify-center gap-1">
        {% if currentPage > 1 %}
            <a href="{{ path(route, routeParams|merge({page: currentPage - 1})) }}" rel="prev" class="{{ item }} text-fg-muted hover:bg-subtle hover:text-fg" aria-label="{{ 'pagination.previous'|trans }}">
                {{ ux_icon('lucide:chevron-left', {class: 'size-4'}) }}
            </a>
        {% endif %}

        {% if start > 1 %}
            <a href="{{ path(route, routeParams|merge({page: 1})) }}" class="{{ item }} text-fg-muted hover:bg-subtle hover:text-fg">1</a>
            {% if start > 2 %}<span class="px-1 text-fg-subtle" aria-hidden="true">…</span>{% endif %}
        {% endif %}

        {% for page in start..end %}
            {% if page == currentPage %}
                <span class="{{ item }} bg-fg text-canvas" aria-current="page">{{ page }}</span>
            {% else %}
                <a href="{{ path(route, routeParams|merge({page: page})) }}" class="{{ item }} text-fg-muted hover:bg-subtle hover:text-fg">{{ page }}</a>
            {% endif %}
        {% endfor %}

        {% if end < totalPages %}
            {% if end < totalPages - 1 %}<span class="px-1 text-fg-subtle" aria-hidden="true">…</span>{% endif %}
            <a href="{{ path(route, routeParams|merge({page: totalPages})) }}" class="{{ item }} text-fg-muted hover:bg-subtle hover:text-fg">{{ totalPages }}</a>
        {% endif %}

        {% if currentPage < totalPages %}
            <a href="{{ path(route, routeParams|merge({page: currentPage + 1})) }}" rel="next" class="{{ item }} text-fg-muted hover:bg-subtle hover:text-fg" aria-label="{{ 'pagination.next'|trans }}">
                {{ ux_icon('lucide:chevron-right', {class: 'size-4'}) }}
            </a>
        {% endif %}
    </nav>
{% endif %}
