{#
  Form Input Component
  ===================

  A flexible form input component with validation states and accessibility.

  Parameters:
  - type: text|email|password|number|tel|url|search (default: text)
  - name: string (required)
  - label: string
  - placeholder: string
  - value: string
  - required: boolean (default: false)
  - disabled: boolean (default: false)
  - readonly: boolean (default: false)
  - error: string (validation error message)
  - success: boolean (default: false)
  - size: sm|md|lg (default: md)
  - icon: string (FontAwesome icon class)
  - help: string (help text)
  - autocomplete: string

  Usage:
  {% include 'components/form/input.html.twig' with {
    name: 'email',
    type: 'email',
    label: 'Email Address',
    placeholder: 'Enter your email',
    required: true,
    error: form.email.vars.errors|length > 0 ? form.email.vars.errors[0].message : null
  } %}
#}

{# Default parameters #}
{% set type = type|default('text') %}
{% set required = required|default(false) %}
{% set disabled = disabled|default(false) %}
{% set readonly = readonly|default(false) %}
{% set success = success|default(false) %}
{% set size = size|default('md') %}

{# Generate unique IDs #}
{% set inputId = 'input-' ~ name ~ '-' ~ random() %}
{% set errorId = error ? inputId ~ '-error' : null %}
{% set helpId = help ? inputId ~ '-help' : null %}

{# Size classes #}
{% set sizeClasses = {
  'sm': 'px-3 py-2 text-sm',
  'md': 'px-4 py-3 text-sm',
  'lg': 'px-4 py-3.5 text-base'
} %}

{# Base input classes #}
{% set baseClasses = 'block w-full rounded-xl border transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed' %}

{# State classes #}
{% if error %}
  {% set stateClasses = 'border-red-300 text-red-900 placeholder-red-400 focus:border-red-500 focus:ring-red-500' %}
{% elseif success %}
  {% set stateClasses = 'border-green-300 text-green-900 placeholder-green-400 focus:border-green-500 focus:ring-green-500' %}
{% else %}
  {% set stateClasses = 'border-gray-300 text-gray-900 placeholder-gray-400 focus:border-primary-500 focus:ring-primary-500' %}
{% endif %}

{# Combine classes #}
{% set inputClasses = [
  baseClasses,
  sizeClasses[size],
  stateClasses
]|join(' ')|trim %}

<div class="space-y-2">
  {# Label #}
  {% if label %}
    <label for="{{ inputId }}" class="block text-sm font-medium text-gray-700 {{ required ? 'required' : '' }}">
      {{ label }}
      {% if required %}
        <span class="text-red-500 ml-1" aria-label="required">*</span>
      {% endif %}
    </label>
  {% endif %}

  {# Input wrapper #}
  <div class="relative">
    {% if icon %}
      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
        <i class="{{ icon }} text-gray-400" aria-hidden="true"></i>
      </div>
    {% endif %}

    <input
      type="{{ type }}"
      id="{{ inputId }}"
      name="{{ name }}"
      value="{{ value|default('') }}"
      placeholder="{{ placeholder|default('') }}"
      class="{{ inputClasses }} {{ icon ? 'pl-11' : '' }}"
      {% if required %}required{% endif %}
      {% if disabled %}disabled{% endif %}
      {% if readonly %}readonly{% endif %}
      {% if autocomplete %}autocomplete="{{ autocomplete }}"{% endif %}
      {% if errorId %}aria-describedby="{{ errorId }}"{% endif %}
      {% if helpId %}aria-describedby="{{ helpId }}"{% endif %}
      {% if error %}aria-invalid="true"{% endif %}
    />

    {# Success icon #}
    {% if success and not error %}
      <div class="absolute inset-y-0 right-0 pr-4 flex items-center">
        <i class="fas fa-check-circle text-green-500" aria-hidden="true"></i>
      </div>
    {% endif %}
  </div>

  {# Help text #}
  {% if help %}
    <p id="{{ helpId }}" class="text-sm text-gray-500">{{ help }}</p>
  {% endif %}

  {# Error message #}
  {% if error %}
    <p id="{{ errorId }}" class="text-sm text-red-600 flex items-center gap-1">
      <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
      {{ error }}
    </p>
  {% endif %}
</div>