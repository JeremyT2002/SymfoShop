{% if recentlyViewedProducts is defined and recentlyViewedProducts|length > 0 %}
    <section class="py-10" x-data="{ limit: 4 }">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100">
                    {{ 'recently_viewed.title'|trans }}
                </h2>
                <div class="hidden sm:flex gap-2">
                    <button type="button" class="px-3 py-1.5 rounded-lg border border-gray-300 text-sm" @click="limit = Math.max(4, limit - 2)">-</button>
                    <button type="button" class="px-3 py-1.5 rounded-lg border border-gray-300 text-sm" @click="limit = Math.min({{ recentlyViewedProducts|length }}, limit + 2)">+</button>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                {% for product in recentlyViewedProducts %}
                    <div x-show="{{ loop.index <= 4 ? 'true' : 'limit >= ' ~ loop.index }}" x-transition>
                        {% include 'components/product_card.html.twig' with { product: product } %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endif %}

