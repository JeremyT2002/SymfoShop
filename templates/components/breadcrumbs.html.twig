{#
  Breadcrumbs. Params: items — list of {label, url|null}. Labels are escaped here, pass them raw.
#}
{% if items is defined and items is not empty %}
    <nav aria-label="{{ 'ui.a11y.breadcrumb'|trans }}" class="mb-6">
        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-fg-subtle">
            {% for item in items %}
                <li class="flex items-center gap-1.5">
                    {% if not loop.first %}{{ ux_icon('lucide:chevron-right', {class: 'size-3.5'}) }}{% endif %}
                    {% if item.url and not loop.last %}
                        <a href="{{ item.url }}" class="transition-colors hover:text-fg">{{ item.label }}</a>
                    {% else %}
                        <span class="text-fg-muted" {% if loop.last %}aria-current="page"{% endif %}>{{ item.label }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </nav>
{% endif %}
