{#
  Card Component
  ==============

  A flexible card component for displaying content in a contained layout.

  Parameters:
  - padding: none|sm|md|lg (default: md)
  - shadow: none|sm|md|lg|xl (default: md)
  - rounded: none|sm|md|lg|xl|2xl (default: xl)
  - hover: boolean (default: false)
  - border: boolean (default: false)
  - class: additional CSS classes

  Usage:
  {% include 'components/card.html.twig' with {
    shadow: 'lg',
    hover: true
  } %}
    <div class="p-6">
      <h3>Card Title</h3>
      <p>Card content...</p>
    </div>
  {% endinclude %}
#}

{# Default parameters #}
{% set padding = padding|default('md') %}
{% set shadow = shadow|default('md') %}
{% set rounded = rounded|default('xl') %}
{% set hover = hover|default(false) %}
{% set border = border|default(false) %}

{# Base classes #}
{% set baseClasses = 'bg-white overflow-hidden transition-all duration-200' %}

{# Shadow classes #}
{% set shadowClasses = {
  'none': '',
  'sm': 'shadow-sm',
  'md': 'shadow-md',
  'lg': 'shadow-lg',
  'xl': 'shadow-xl'
} %}

{# Rounded classes #}
{% set roundedClasses = {
  'none': '',
  'sm': 'rounded-sm',
  'md': 'rounded-md',
  'lg': 'rounded-lg',
  'xl': 'rounded-xl',
  '2xl': 'rounded-2xl'
} %}

{# Hover classes #}
{% set hoverClasses = hover ? 'hover:shadow-lg hover:-translate-y-1' : '' %}

{# Border classes #}
{% set borderClasses = border ? 'border border-gray-200' : '' %}

{# Combine classes #}
{% set classes = [
  baseClasses,
  shadowClasses[shadow],
  roundedClasses[rounded],
  hoverClasses,
  borderClasses,
  class|default('')
]|filter|join(' ')|trim %}

<div class="{{ classes }}">
  {{ content|default(block('content')) }}
</div>