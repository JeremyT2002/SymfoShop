{#
  Modal Component
  ===============

  A flexible modal dialog component with accessibility features.

  Parameters:
  - id: string (required for accessibility)
  - title: string
  - size: sm|md|lg|xl|2xl (default: md)
  - closeButton: boolean (default: true)
  - backdrop: boolean (default: true)

  Usage:
  {% include 'components/modal.html.twig' with {
    id: 'confirm-modal',
    title: 'Confirm Action',
    size: 'md'
  } %}
    <p>Are you sure you want to proceed?</p>
    <div class="flex justify-end gap-3 mt-6">
      {% include 'components/button.html.twig' with {
        variant: 'secondary',
        content: 'Cancel',
        attributes: 'data-modal-close'
      } %}
      {% include 'components/button.html.twig' with {
        variant: 'primary',
        content: 'Confirm'
      } %}
    </div>
  {% endinclude %}
#}

{# Default parameters #}
{% set size = size|default('md') %}
{% set closeButton = closeButton|default(true) %}
{% set backdrop = backdrop|default(true) %}

{# Size classes #}
{% set sizeClasses = {
  'sm': 'max-w-md',
  'md': 'max-w-lg',
  'lg': 'max-w-2xl',
  'xl': 'max-w-4xl',
  '2xl': 'max-w-6xl'
} %}

{# Modal container - hidden by default #}
<div
  id="{{ id }}"
  class="fixed inset-0 z-50 overflow-y-auto hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="{{ id }}-title"
  aria-describedby="{{ id }}-content"
>
  {# Backdrop #}
  {% if backdrop %}
    <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity" aria-hidden="true"></div>
  {% endif %}

  {# Modal content #}
  <div class="flex min-h-full items-center justify-center p-4">
    <div class="relative w-full {{ sizeClasses[size] }} bg-white rounded-2xl shadow-2xl transform transition-all">
      {# Header #}
      {% if title or closeButton %}
        <div class="flex items-center justify-between p-6 border-b border-gray-200">
          {% if title %}
            <h2 id="{{ id }}-title" class="text-xl font-semibold text-gray-900">
              {{ title }}
            </h2>
          {% endif %}

          {% if closeButton %}
            <button
              type="button"
              class="text-gray-400 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 rounded-lg p-1 transition-colors"
              data-modal-close
              aria-label="Close modal"
            >
              <i class="fas fa-times text-lg" aria-hidden="true"></i>
            </button>
          {% endif %}
        </div>
      {% endif %}

      {# Body #}
      <div id="{{ id }}-content" class="p-6">
        {{ content|default(block('content')) }}
      </div>
    </div>
  </div>
</div>