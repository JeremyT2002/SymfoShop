{#
  Product card.
  Params: product (required), variant (optional, defaults to the first variant), eager (bool, load image eagerly)
#}
{%- set variant = variant|default(product.variants|first) -%}
{%- set images = product.media|slice(0, 2) -%}
{%- set url = path('catalog_product', {slug: product.slug}) -%}
{%- set prices = product.variants|map(v => v.priceAmount) -%}
{%- set min_price = prices is not empty ? min(prices) : null -%}
{%- set has_price_range = prices is not empty and min(prices) != max(prices) -%}
{%- set available = product.variants|reduce((sum, v) => sum + max(0, v.stockItem ? v.stockItem.available : 0), 0) -%}
{%- set single_variant = product.variants|length == 1 -%}
{%- set sale_variant = product.variants|filter(v => v.onSale)|sort((a, b) => b.discountPercent <=> a.discountPercent)|first -%}
{%- set cheapest = product.variants|sort((a, b) => a.priceAmount <=> b.priceAmount)|first -%}

<article class="group relative flex flex-col">
    <div class="relative aspect-[4/5] overflow-hidden rounded-xl bg-subtle">
        <a href="{{ url }}" class="absolute inset-0" tabindex="-1" aria-hidden="true">
            {% if images|length > 0 %}
                <img src="{{ image_url(images[0].path, 640) }}" srcset="{{ image_srcset(images[0].path, [320, 480, 640, 960]) }}" sizes="(min-width: 1280px) 300px, (min-width: 1024px) 25vw, 50vw" alt="" loading="{{ eager|default(false) ? 'eager' : 'lazy' }}" decoding="async"
                     class="size-full object-cover transition duration-500 ease-out group-hover:scale-[1.03] {{ images|length > 1 ? 'group-hover:opacity-0' : '' }}">
                {% if images|length > 1 %}
                    <img src="{{ image_url(images[1].path, 640) }}" srcset="{{ image_srcset(images[1].path, [320, 480, 640, 960]) }}" sizes="(min-width: 1280px) 300px, (min-width: 1024px) 25vw, 50vw" alt="" loading="lazy" decoding="async"
                         class="absolute inset-0 size-full object-cover opacity-0 transition duration-500 ease-out group-hover:scale-[1.03] group-hover:opacity-100">
                {% endif %}
            {% else %}
                <span class="flex size-full items-center justify-center text-fg-subtle">{{ ux_icon('lucide:image', {class: 'size-10 opacity-60'}) }}</span>
            {% endif %}
        </a>

        {% if available == 0 %}
            <span class="badge badge-neutral absolute top-3 left-3 bg-panel/90 backdrop-blur">{{ 'ui.product.sold_out'|trans }}</span>
        {% elseif sale_variant %}
            <span class="badge absolute top-3 left-3 bg-red-600 font-semibold text-white ring-0">{{ 'ui.product.sale_badge'|trans({'%percent%': sale_variant.discountPercent}) }}</span>
        {% endif %}

        {% if app.user %}
            {%- set wished = in_wishlist(product.id) -%}
            <button type="button" data-wishlist-toggle data-product-id="{{ product.id }}" aria-pressed="{{ wished ? 'true' : 'false' }}"
                    aria-label="{{ 'wishlist.toggle'|trans }}: {{ product.name }}"
                    class="group/wish absolute top-3 right-3 z-10 flex size-9 items-center justify-center rounded-full bg-panel/90 text-fg shadow-sm backdrop-blur transition hover:scale-105 aria-pressed:text-red-500">
                {{ ux_icon('lucide:heart', {class: 'size-[1.125rem] transition group-aria-pressed/wish:fill-current'}) }}
            </button>
        {% endif %}

        {# Quick add for single-variant products; others go to the product page to choose #}
        {% if variant and available > 0 %}
            <div class="absolute inset-x-3 bottom-3 z-10 translate-y-2 opacity-0 transition duration-200 group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:translate-y-0 group-hover:opacity-100 max-lg:hidden">
                {% if single_variant %}
                    <button type="button" class="btn btn-primary w-full shadow-lg" data-add-to-cart data-variant-id="{{ variant.id }}">
                        {{ ux_icon('lucide:plus', {class: 'size-4'}) }}<span data-label>{{ 'product.add_to_cart'|trans }}</span>
                    </button>
                {% else %}
                    <a href="{{ url }}" class="btn w-full bg-panel/95 text-fg shadow-lg backdrop-blur hover:bg-panel">{{ 'ui.product.choose_options'|trans }}</a>
                {% endif %}
            </div>
        {% endif %}
    </div>

    <div class="mt-3 flex flex-1 flex-col">
        <h3 class="text-sm font-medium text-fg">
            <a href="{{ url }}" class="line-clamp-2 after:absolute after:inset-0 after:content-[''] focus:outline-none">{{ product.name }}</a>
        </h3>
        {% if product.averageRating is defined and product.averageRating %}
            <p class="mt-1 flex items-center gap-1 text-xs text-fg-muted">
                {{ ux_icon('lucide:star', {class: 'size-3.5 fill-amber-400 text-amber-400'}) }}
                {{ product.averageRating|number_format(1) }}
            </p>
        {% endif %}
        {% if min_price is not null %}
            <p class="mt-1 text-sm font-semibold text-fg tabular-nums">
                {% if has_price_range %}<span class="font-normal text-fg-muted">{{ 'ui.product.from'|trans }}</span> {% endif %}
                <span class="{{ cheapest and cheapest.onSale ? 'text-red-600 dark:text-red-400' }}">{{- min_price|money(variant.currency) -}}</span>
                {% if cheapest and cheapest.onSale %}
                    <s class="ml-1 text-xs font-normal text-fg-subtle" aria-label="{{ 'ui.product.was_price'|trans }}">{{ cheapest.compareAtPriceAmount|money(variant.currency) }}</s>
                {% endif %}
            </p>
        {% endif %}
        {% if product.variants|length > 1 %}
            <p class="mt-0.5 text-xs text-fg-subtle">{{ product.variants|length }} {{ 'product.variants_available'|trans }}</p>
        {% endif %}
    </div>
</article>
