{% extends 'account/_layout.html.twig' %}

{%- set account_section = 'support' -%}

{% block page_title %}{{ 'support.customer.chat_page_title'|trans }}{% endblock %}
{% block js_page %}support-chat{% endblock %}

{% block account_content %}
<a href="{{ path('account_support_index') }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-fg-muted hover:text-fg">
    {{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }}{{ 'support.customer.back_to_support'|trans }}
</a>

<section class="card mt-4 flex flex-col overflow-hidden" aria-labelledby="conversation-heading">
    <header class="flex items-start justify-between gap-4 border-b border-line px-5 py-4">
        <div class="min-w-0">
            <h2 id="conversation-heading" class="truncate font-semibold">{{ conversation.subject }}</h2>
            <p class="mt-0.5 text-xs text-fg-subtle">
                #{{ conversation.id }} · {{ ('support.category.' ~ conversation.category)|trans }}
                {% if conversation.relatedOrderNumber %} · {{ 'support.customer.order_label'|trans }} {{ conversation.relatedOrderNumber }}{% endif %}
            </p>
        </div>
        <span class="badge {{ conversation.status == 'open' ? 'badge-success' : 'badge-neutral' }}">{{ ('support.status.' ~ conversation.status)|trans }}</span>
    </header>

    <div class="max-h-[60vh] min-h-64 space-y-4 overflow-y-auto bg-canvas px-5 py-6" data-support-thread
         data-poll-url="{{ path('support_api_messages', {id: conversation.id}) }}"
         data-attachment-url="{{ path('support_attachment_download', {id: 0})|replace({'/0/': '/__ID__/'}) }}"
         aria-live="polite">
        {% for m in messages %}
            {%- set own = m.senderType == 'customer' -%}
            <article class="flex {{ own ? 'justify-end' : 'justify-start' }}" data-message-id="{{ m.id }}">
                <div class="max-w-[85%] px-4 py-3 {{ own ? 'rounded-2xl rounded-br-md bg-primary-600 text-white' : 'rounded-2xl rounded-bl-md border border-line bg-panel' }}">
                    <p class="mb-1 text-xs {{ own ? 'text-white/75' : 'text-fg-subtle' }}">
                        {{ own ? 'support.sender.you'|trans : 'support.sender.support'|trans }} · {{ m.createdAt|date('d.m.Y H:i') }}
                    </p>
                    <p class="text-sm whitespace-pre-wrap">{{ m.body }}</p>
                    {% for a in m.attachments %}
                        <a href="{{ path('support_attachment_download', {id: a.id}) }}" class="mt-2 flex items-center gap-1.5 text-xs underline {{ own ? 'text-white' : 'text-primary-600' }}">
                            {{ ux_icon('lucide:paperclip', {class: 'size-3.5'}) }}{{ a.originalName }}
                        </a>
                    {% endfor %}
                </div>
            </article>
        {% else %}
            <p class="text-center text-sm text-fg-subtle">{{ 'support.customer.no_messages'|trans }}</p>
        {% endfor %}
    </div>

    <form method="post" action="{{ path('account_support_show', {id: conversation.id}) }}" enctype="multipart/form-data" data-support-form
          class="border-t border-line bg-panel p-4">
        <input type="hidden" name="_token" value="{{ csrf_token('support_reply_' ~ conversation.id) }}">
        <label for="support-body" class="sr-only">{{ 'support.customer.write_message'|trans }}</label>
        <textarea id="support-body" name="body" rows="3" required class="textarea" placeholder="{{ 'support.customer.write_message'|trans }}"></textarea>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
            <label class="btn btn-ghost btn-sm cursor-pointer">
                {{ ux_icon('lucide:paperclip', {class: 'size-4'}) }}{{ 'ui.support.attach'|trans }}
                <input type="file" name="attachments[]" multiple class="sr-only" accept=".pdf,.png,.jpg,.jpeg,.txt">
            </label>
            <span class="min-w-0 flex-1 truncate text-xs text-fg-subtle" data-file-names></span>
            <button type="submit" class="btn btn-primary">{{ ux_icon('lucide:send-horizontal', {class: 'size-4'}) }}{{ 'support.customer.send'|trans }}</button>
        </div>
        <p class="mt-2 text-xs text-fg-subtle">{{ 'support.customer.attachment_hint'|trans }} · {{ 'support.customer.shortcut_hint'|trans }}</p>
    </form>
</section>
{% endblock %}
