{% extends 'account/_layout.html.twig' %}

{%- set account_section = 'support' -%}

{% block page_title %}{{ 'support.customer.page_title'|trans }}{% endblock %}

{% block account_content %}
<div class="grid gap-8 xl:grid-cols-5">
    <section class="xl:col-span-3" aria-labelledby="conversations-heading" x-data="{ q: '', status: 'all' }">
        <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
                <h2 id="conversations-heading" class="text-xl font-semibold">{{ 'support.customer.your_conversations'|trans }}</h2>
                <p class="mt-1 text-sm text-fg-muted">{{ 'support.customer.subtitle'|trans }}</p>
            </div>
        </div>

        {% if conversations is not empty %}
            <div class="mt-5 flex flex-col gap-2 sm:flex-row">
                <label class="sr-only" for="support-search">{{ 'support.customer.search_placeholder'|trans }}</label>
                <input id="support-search" type="search" x-model="q" class="input" placeholder="{{ 'support.customer.search_placeholder'|trans }}">
                <label class="sr-only" for="support-status">{{ 'support.form.category'|trans }}</label>
                <select id="support-status" x-model="status" class="select sm:w-44">
                    <option value="all">{{ 'support.customer.filter_all'|trans }}</option>
                    <option value="open">{{ 'support.status.open'|trans }}</option>
                    <option value="closed">{{ 'support.status.closed'|trans }}</option>
                </select>
            </div>

            <ul class="card mt-4 divide-y divide-line overflow-hidden" role="list">
                {% for c in conversations %}
                    {%- set haystack = (c.subject ~ ' ' ~ c.relatedOrderNumber|default(''))|lower -%}
                    <li x-show="(status === 'all' || status === '{{ c.status }}') && (q === '' || {{ haystack|json_encode }}.includes(q.toLowerCase()))">
                        <a href="{{ path('account_support_show', {id: c.id}) }}" class="flex items-center gap-4 px-5 py-4 transition hover:bg-subtle/60">
                            <span class="min-w-0 flex-1">
                                <span class="block truncate font-medium">{{ c.subject }}</span>
                                <span class="mt-0.5 block truncate text-xs text-fg-subtle">
                                    {{ c.updatedAt|date('d.m.Y H:i') }} · {{ ('support.category.' ~ c.category)|trans }}{% if c.relatedOrderNumber %} · {{ c.relatedOrderNumber }}{% endif %}
                                </span>
                            </span>
                            {% if c.customerUnreadCount > 0 %}
                                <span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-primary-600 px-1.5 text-xs font-semibold text-white">{{ c.customerUnreadCount }}</span>
                            {% endif %}
                            <span class="badge {{ c.status == 'open' ? 'badge-success' : 'badge-neutral' }}">{{ ('support.status.' ~ c.status)|trans }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <div class="mt-5">
                {% include 'components/empty_state.html.twig' with {icon: 'lucide:message-circle', title: 'support.customer.empty'|trans} only %}
            </div>
        {% endif %}
    </section>

    <section class="xl:col-span-2" aria-labelledby="new-conversation-heading">
        <form method="post" action="{{ path('account_support_index') }}" class="card card-body space-y-4" data-support-new>
            <h2 id="new-conversation-heading" class="font-semibold">{{ 'support.customer.new_conversation'|trans }}</h2>
            <input type="hidden" name="_token" value="{{ csrf_token('support_conversation') }}">
            <div>
                <label for="support-subject" class="label">{{ 'support.form.subject'|trans }}</label>
                <input id="support-subject" type="text" name="subject" maxlength="180" required class="input">
            </div>
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-1">
                <div>
                    <label for="support-category" class="label">{{ 'support.form.category'|trans }}</label>
                    <select id="support-category" name="category" class="select" required>
                        {% for key in ['order', 'payment', 'shipping', 'product', 'technical', 'other'] %}
                            <option value="{{ key }}" {{ key == 'other' ? 'selected' }}>{{ ('support.category.' ~ key)|trans }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="support-order" class="label">{{ 'support.form.related_order'|trans }}</label>
                    <select id="support-order" name="relatedOrderNumber" class="select">
                        <option value="">{{ 'support.form.related_order_none'|trans }}</option>
                        {% for order in orders %}
                            <option value="{{ order.orderNumber }}">{{ order.orderNumber }} · {{ order.createdAt|date('d.m.Y') }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div>
                <label for="support-message" class="label">{{ 'support.form.message'|trans }}</label>
                <textarea id="support-message" name="message" rows="5" required class="textarea"></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-full">{{ ux_icon('lucide:send-horizontal', {class: 'size-4'}) }}{{ 'support.customer.create_chat'|trans }}</button>
        </form>
    </section>
</div>
{% endblock %}
