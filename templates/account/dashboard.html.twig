{% extends 'account/_layout.html.twig' %}

{%- set tab = app.request.query.get('tab')|default('profile') -%}
{%- set account_section = tab in ['orders', 'invoices'] ? tab : 'profile' -%}
{%- set status_badges = {
    new: 'badge-neutral', payment_pending: 'badge-warning', paid: 'badge-success', processing: 'badge-info',
    shipped: 'badge-primary', completed: 'badge-success', cancelled: 'badge-danger',
} -%}

{% block page_title %}{{ 'account.dashboard.page_title'|trans }}{% endblock %}

{% block account_content %}
    {% if account_section == 'profile' %}
        {%- set checklist = [app.user.firstName, app.user.lastName, app.user.phone, app.user.addressLine1, app.user.postalCode, app.user.city, app.user.countryCode] -%}
        {%- set profile_pct = (checklist|filter(v => v)|length * 100 / checklist|length)|round -%}

        <div class="grid gap-4 sm:grid-cols-3">
            <a href="{{ path('account_dashboard', {tab: 'orders'}) }}" class="card p-5 transition hover:border-line-strong">
                <p class="text-sm text-fg-muted">{{ 'account.dashboard.stats.orders'|trans }}</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">{{ orders|length }}</p>
            </a>
            <a href="{{ path('account_dashboard', {tab: 'invoices'}) }}" class="card p-5 transition hover:border-line-strong">
                <p class="text-sm text-fg-muted">{{ 'account.dashboard.stats.invoices'|trans }}</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">{{ invoices|length }}</p>
            </a>
            <div class="card p-5">
                <p class="text-sm text-fg-muted">{{ 'account.dashboard.stats.profile'|trans }}</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">{{ profile_pct }}%</p>
                <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-subtle" role="progressbar" aria-valuenow="{{ profile_pct }}" aria-valuemin="0" aria-valuemax="100" aria-label="{{ 'account.dashboard.stats.profile'|trans }}">
                    <div class="h-full rounded-full bg-primary-600" style="width: {{ profile_pct }}%"></div>
                </div>
            </div>
        </div>

        <section class="card mt-8" aria-labelledby="profile-heading">
            <div class="border-b border-line px-5 py-4 sm:px-6">
                <h2 id="profile-heading" class="font-semibold">{{ 'account.dashboard.profile.title'|trans }}</h2>
                <p class="mt-1 text-sm text-fg-muted">
                    {{ profile_pct < 100 ? 'account.dashboard.profile.completion_hint'|trans({'%percent%': profile_pct}) : 'account.dashboard.profile.complete_badge'|trans }}
                </p>
            </div>

            {{ form_start(profileForm, {attr: {class: 'divide-y divide-line'}}) }}
                <fieldset class="grid gap-5 px-5 py-6 sm:grid-cols-2 sm:px-6">
                    <legend class="sr-only">{{ 'account.dashboard.profile.section_contact'|trans }}</legend>
                    <p class="text-sm font-semibold sm:col-span-2">{{ 'account.dashboard.profile.section_contact'|trans }}
                        <span class="mt-0.5 block font-normal text-fg-muted">{{ 'account.dashboard.profile.section_contact_hint'|trans }}</span></p>
                    {{ form_row(profileForm.firstName, {label: 'account.dashboard.profile.first_name'|trans, attr: {autocomplete: 'given-name'}}) }}
                    {{ form_row(profileForm.lastName, {label: 'account.dashboard.profile.last_name'|trans, attr: {autocomplete: 'family-name'}}) }}
                    <div class="sm:col-span-2">{{ form_row(profileForm.email, {label: 'account.dashboard.profile.email'|trans, attr: {autocomplete: 'email'}}) }}</div>
                    {{ form_row(profileForm.phone, {label: 'account.dashboard.profile.phone'|trans, attr: {autocomplete: 'tel'}}) }}
                    {{ form_row(profileForm.company, {label: 'account.dashboard.profile.company'|trans, attr: {autocomplete: 'organization'}}) }}
                </fieldset>

                <fieldset class="grid gap-5 px-5 py-6 sm:grid-cols-6 sm:px-6">
                    <legend class="sr-only">{{ 'account.dashboard.profile.section_address'|trans }}</legend>
                    <p class="text-sm font-semibold sm:col-span-6">{{ 'account.dashboard.profile.section_address'|trans }}
                        <span class="mt-0.5 block font-normal text-fg-muted">{{ 'account.dashboard.profile.section_address_hint'|trans }}</span></p>
                    <div class="sm:col-span-6">{{ form_row(profileForm.addressLine1, {label: 'account.dashboard.profile.address_line_1'|trans, attr: {autocomplete: 'address-line1'}}) }}</div>
                    <div class="sm:col-span-6">{{ form_row(profileForm.addressLine2, {label: 'account.dashboard.profile.address_line_2'|trans, attr: {autocomplete: 'address-line2'}}) }}</div>
                    <div class="sm:col-span-2">{{ form_row(profileForm.postalCode, {label: 'account.dashboard.profile.postal_code'|trans, attr: {autocomplete: 'postal-code'}}) }}</div>
                    <div class="sm:col-span-4">{{ form_row(profileForm.city, {label: 'account.dashboard.profile.city'|trans, attr: {autocomplete: 'address-level2'}}) }}</div>
                    <div class="sm:col-span-3">{{ form_row(profileForm.state, {label: 'account.dashboard.profile.state'|trans, attr: {autocomplete: 'address-level1'}}) }}</div>
                    <div class="sm:col-span-3">{{ form_row(profileForm.countryCode, {label: 'checkout.fields.country'|trans, attr: {autocomplete: 'country'}}) }}</div>
                </fieldset>

                <div class="flex justify-end px-5 py-4 sm:px-6">
                    <button type="submit" class="btn btn-primary">{{ 'account.dashboard.profile.save'|trans }}</button>
                </div>
            {{ form_end(profileForm) }}
        </section>

    {% elseif account_section == 'orders' %}
        <h2 class="text-xl font-semibold">{{ 'account.dashboard.orders.title'|trans }}</h2>
        {% if orders is empty %}
            <div class="mt-6">
                {% include 'components/empty_state.html.twig' with {
                    icon: 'lucide:package',
                    title: 'account.dashboard.orders.empty'|trans,
                    text: 'account.dashboard.orders.empty_hint'|trans,
                    action: {label: 'account.dashboard.continue_shopping'|trans, url: path('catalog_products')},
                } only %}
            </div>
        {% else %}
            <ul class="mt-6 space-y-3" role="list">
                {% for order in orders %}
                    <li class="card overflow-hidden" x-data="{ open: {{ loop.first ? 'true' : 'false' }} }">
                        <button type="button" class="flex w-full flex-wrap items-center gap-x-6 gap-y-2 px-5 py-4 text-left hover:bg-subtle/50" @click="open = !open" :aria-expanded="open">
                            <span class="min-w-0 flex-1">
                                <span class="block font-mono text-sm font-semibold">{{ order.orderNumber }}</span>
                                <span class="block text-xs text-fg-subtle">{{ order.createdAt|date('d.m.Y · H:i') }} · {{ 'ui.account.items_count'|trans({'%count%': order.items|length}) }}</span>
                            </span>
                            <span class="badge {{ status_badges[order.status]|default('badge-neutral') }}">{{ ('admin.orders.status.' ~ order.status)|trans }}</span>
                            <span class="w-24 text-right font-semibold tabular-nums">{{ order.grandTotal|money(order.currency) }}</span>
                            <span class="inline-flex shrink-0 transition" :class="open && 'rotate-180'">{{ ux_icon('lucide:chevron-down', {class: 'size-4 text-fg-subtle transition'}) }}</span>
                        </button>
                        <div x-show="open" x-collapse {% if not loop.first %}x-cloak{% endif %}>
                            <div class="border-t border-line px-5 py-4">
                                <ul class="divide-y divide-line text-sm" role="list">
                                    {% for item in order.items %}
                                        <li class="flex justify-between gap-4 py-2">
                                            <span><span class="text-fg-subtle tabular-nums">{{ item.quantity }} ×</span> {{ item.nameSnapshot }}</span>
                                            <span class="tabular-nums">{{ item.totalAmount|money(order.currency) }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>
                                {% if order.shippingStreet %}
                                    <p class="mt-3 text-sm leading-6 text-fg-muted"><span class="block text-xs font-medium text-fg-subtle">{{ 'ui.order.shipping_address'|trans }}</span>{% include 'components/_address.html.twig' with {order: order} only %}</p>
                                {% endif %}
                                <a href="{{ path('order_status', {number: order.orderNumber}) }}" class="link mt-3 inline-flex items-center gap-1 text-sm">{{ 'ui.order_status.view_status'|trans }}{{ ux_icon('lucide:arrow-right', {class: 'size-3.5'}) }}</a>
                                {% if order.trackingNumber %}
                                    <p class="mt-3 flex items-center gap-2 text-sm text-fg-muted">{{ ux_icon('lucide:truck', {class: 'size-4'}) }}{{ order.carrier }} · <span class="font-mono">{{ order.trackingNumber }}</span></p>
                                {% endif %}
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

    {% else %}
        <h2 class="text-xl font-semibold">{{ 'account.dashboard.invoices.title'|trans }}</h2>
        {% if invoices is empty %}
            <div class="mt-6">
                {% include 'components/empty_state.html.twig' with {
                    icon: 'lucide:file-text',
                    title: 'account.dashboard.invoices.empty'|trans,
                    text: 'account.dashboard.invoices.empty_hint'|trans,
                } only %}
            </div>
        {% else %}
            <div class="card mt-6 overflow-x-auto">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'account.dashboard.invoices.invoice_number'|trans }}</th>
                            <th scope="col">{{ 'account.dashboard.invoices.order_number'|trans }}</th>
                            <th scope="col">{{ 'account.dashboard.invoices.date'|trans }}</th>
                            <th scope="col" class="text-right">{{ 'account.dashboard.invoices.action'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for invoice in invoices %}
                            <tr>
                                <td class="font-mono font-medium whitespace-nowrap">{{ invoice.invoiceNumber }}</td>
                                <td class="font-mono text-fg-muted whitespace-nowrap">{{ invoice.order.orderNumber }}</td>
                                <td class="text-fg-muted whitespace-nowrap">{{ invoice.createdAt|date('d.m.Y') }}</td>
                                <td class="text-right">
                                    <form method="get" action="{{ path('account_invoice_download', {invoiceNumber: invoice.invoiceNumber}) }}" class="inline-flex items-center gap-2">
                                        <label for="invoice-lang-{{ invoice.id }}" class="sr-only">{{ 'account.dashboard.invoices.language'|trans }}</label>
                                        <select id="invoice-lang-{{ invoice.id }}" name="lang" class="select w-auto py-1.5 text-xs">
                                            {% for code in ['de', 'en', 'fr'] %}
                                                <option value="{{ code }}" {{ app.request.locale == code ? 'selected' }}>{{ ('account.dashboard.invoices.lang_' ~ code)|trans }}</option>
                                            {% endfor %}
                                        </select>
                                        <button type="submit" class="btn btn-secondary btn-sm">{{ ux_icon('lucide:download', {class: 'size-4'}) }}PDF</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
