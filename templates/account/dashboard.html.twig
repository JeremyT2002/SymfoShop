{% extends 'catalog/base.html.twig' %}

{% block page_title %}{{ 'account.dashboard.page_title'|trans }} - {{ theme_config().brand.siteName|default('SymfoShop') }}{% endblock %}

{% block catalog_body %}
<section class="bg-gray-50 py-10 lg:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h1 class="text-3xl lg:text-4xl font-bold text-gray-900">{{ 'account.dashboard.title'|trans }}</h1>
            <p class="mt-2 text-gray-600">{{ 'account.dashboard.subtitle'|trans }}</p>
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 lg:gap-8">
            <div class="xl:col-span-1">
                <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-5">{{ 'account.dashboard.profile.title'|trans }}</h2>

                    <form method="post" action="{{ path('account_profile_update') }}" class="space-y-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('account_profile_update') }}">

                        <div>
                            <label for="profile-firstName" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'account.dashboard.profile.first_name'|trans }}</label>
                            <input id="profile-firstName"
                                   name="firstName"
                                   type="text"
                                   value="{{ app.user.firstName|default('') }}"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                                   autocomplete="given-name">
                        </div>

                        <div>
                            <label for="profile-lastName" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'account.dashboard.profile.last_name'|trans }}</label>
                            <input id="profile-lastName"
                                   name="lastName"
                                   type="text"
                                   value="{{ app.user.lastName|default('') }}"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                                   autocomplete="family-name">
                        </div>

                        <div>
                            <label for="profile-email" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'account.dashboard.profile.email'|trans }}</label>
                            <input id="profile-email"
                                   name="email"
                                   type="email"
                                   required
                                   value="{{ app.user.email }}"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                                   autocomplete="email">
                        </div>

                        <div>
                            <label for="profile-phone" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'account.dashboard.profile.phone'|trans }}</label>
                            <input id="profile-phone"
                                   name="phone"
                                   type="text"
                                   value="{{ app.user.phone|default('') }}"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                                   autocomplete="tel">
                        </div>

                        <div>
                            <label for="profile-company" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'account.dashboard.profile.company'|trans }}</label>
                            <input id="profile-company"
                                   name="company"
                                   type="text"
                                   value="{{ app.user.company|default('') }}"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                                   autocomplete="organization">
                        </div>

                        <div>
                            <label for="profile-addressLine1" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'account.dashboard.profile.address_line_1'|trans }}</label>
                            <input id="profile-addressLine1"
                                   name="addressLine1"
                                   type="text"
                                   value="{{ app.user.addressLine1|default('') }}"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                                   autocomplete="address-line1">
                        </div>

                        <div>
                            <label for="profile-addressLine2" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'account.dashboard.profile.address_line_2'|trans }}</label>
                            <input id="profile-addressLine2"
                                   name="addressLine2"
                                   type="text"
                                   value="{{ app.user.addressLine2|default('') }}"
                                   class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                                   autocomplete="address-line2">
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label for="profile-postalCode" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'account.dashboard.profile.postal_code'|trans }}</label>
                                <input id="profile-postalCode"
                                       name="postalCode"
                                       type="text"
                                       value="{{ app.user.postalCode|default('') }}"
                                       class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                                       autocomplete="postal-code">
                            </div>
                            <div>
                                <label for="profile-city" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'account.dashboard.profile.city'|trans }}</label>
                                <input id="profile-city"
                                       name="city"
                                       type="text"
                                       value="{{ app.user.city|default('') }}"
                                       class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                                       autocomplete="address-level2">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label for="profile-state" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'account.dashboard.profile.state'|trans }}</label>
                                <input id="profile-state"
                                       name="state"
                                       type="text"
                                       value="{{ app.user.state|default('') }}"
                                       class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                                       autocomplete="address-level1">
                            </div>
                            <div>
                                <label for="profile-countryCode" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'account.dashboard.profile.country_code'|trans }}</label>
                                <input id="profile-countryCode"
                                       name="countryCode"
                                       type="text"
                                       maxlength="2"
                                       placeholder="DE"
                                       value="{{ app.user.countryCode|default('') }}"
                                       class="w-full uppercase rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                                       autocomplete="country">
                            </div>
                        </div>

                        <button type="submit"
                                class="w-full inline-flex items-center justify-center rounded-lg bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-700 transition-colors">
                            {{ 'account.dashboard.profile.save'|trans }}
                        </button>
                    </form>
                </div>
            </div>

            <div class="xl:col-span-2 space-y-6">
                <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                        <h2 class="text-xl font-semibold text-gray-900">{{ 'account.dashboard.orders.title'|trans }}</h2>
                        <span class="text-sm text-gray-500">{{ orders|length }} {{ 'account.dashboard.entries'|trans }}</span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-semibold tracking-wider text-gray-500 uppercase">{{ 'account.dashboard.orders.order_number'|trans }}</th>
                                    <th class="px-6 py-3 text-left text-xs font-semibold tracking-wider text-gray-500 uppercase">{{ 'account.dashboard.orders.date'|trans }}</th>
                                    <th class="px-6 py-3 text-left text-xs font-semibold tracking-wider text-gray-500 uppercase">{{ 'account.dashboard.orders.status'|trans }}</th>
                                    <th class="px-6 py-3 text-right text-xs font-semibold tracking-wider text-gray-500 uppercase">{{ 'account.dashboard.orders.total'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 bg-white">
                                {% for order in orders %}
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-6 py-4 text-sm font-medium text-gray-900">{{ order.orderNumber }}</td>
                                        <td class="px-6 py-4 text-sm text-gray-600">{{ order.createdAt|date('d.m.Y H:i') }}</td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-700">{{ order.status|replace({'_': ' '})|title }}</span>
                                        </td>
                                        <td class="px-6 py-4 text-sm font-semibold text-gray-900 text-right">{{ (order.grandTotal / 100)|number_format(2, '.', ',') }} {{ order.currency }}</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="px-6 py-8 text-center text-sm text-gray-500">{{ 'account.dashboard.orders.empty'|trans }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                        <h2 class="text-xl font-semibold text-gray-900">{{ 'account.dashboard.invoices.title'|trans }}</h2>
                        <span class="text-sm text-gray-500">{{ invoices|length }} {{ 'account.dashboard.entries'|trans }}</span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-semibold tracking-wider text-gray-500 uppercase">{{ 'account.dashboard.invoices.invoice_number'|trans }}</th>
                                    <th class="px-6 py-3 text-left text-xs font-semibold tracking-wider text-gray-500 uppercase">{{ 'account.dashboard.invoices.order_number'|trans }}</th>
                                    <th class="px-6 py-3 text-left text-xs font-semibold tracking-wider text-gray-500 uppercase">{{ 'account.dashboard.invoices.date'|trans }}</th>
                                    <th class="px-6 py-3 text-right text-xs font-semibold tracking-wider text-gray-500 uppercase">{{ 'account.dashboard.invoices.action'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 bg-white">
                                {% for invoice in invoices %}
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-6 py-4 text-sm font-medium text-gray-900">{{ invoice.invoiceNumber }}</td>
                                        <td class="px-6 py-4 text-sm text-gray-600">{{ invoice.order.orderNumber }}</td>
                                        <td class="px-6 py-4 text-sm text-gray-600">{{ invoice.createdAt|date('d.m.Y H:i') }}</td>
                                        <td class="px-6 py-4 text-right">
                                            <a href="{{ path('account_invoice_download', {invoiceNumber: invoice.invoiceNumber}) }}"
                                               class="inline-flex items-center rounded-lg bg-primary-600 px-3 py-2 text-xs font-semibold text-white hover:bg-primary-700 transition-colors">
                                                {{ 'account.dashboard.invoices.download_pdf'|trans }}
                                            </a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="px-6 py-8 text-center text-sm text-gray-500">{{ 'account.dashboard.invoices.empty'|trans }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

