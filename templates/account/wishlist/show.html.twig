{% extends 'account/_layout.html.twig' %}

{%- set account_section = 'wishlist' -%}

{% block page_title %}{{ 'wishlist.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'wishlist.meta_description'|trans }}{% endblock %}

{% block account_content %}
    <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-xl font-semibold">{{ 'wishlist.title'|trans }}</h2>
        <p class="text-sm text-fg-muted">{{ 'wishlist.subtitle'|trans({'%count%': wishlistCount}) }}</p>
    </div>

    {% if products is not empty %}
        <div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 xl:grid-cols-3">
            {% for product in products %}
                <div data-wishlist-item>
                    {% include 'components/product_card.html.twig' with {product: product} only %}
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="mt-6">
            {% include 'components/empty_state.html.twig' with {
                icon: 'lucide:heart',
                title: 'wishlist.empty.title'|trans,
                text: 'wishlist.empty.description'|trans,
                action: {label: 'wishlist.empty.browse_products'|trans, url: path('catalog_products')},
            } only %}
        </div>
    {% endif %}
{% endblock %}
