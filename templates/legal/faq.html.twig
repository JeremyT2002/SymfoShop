{% extends 'legal/_layout.html.twig' %}

{% block page_title %}{{ 'legal.faq.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'legal.faq.meta_description'|trans }}{% endblock %}

{% block legal_heading %}{{ 'legal.faq.heading'|trans }}{% endblock %}

{% block legal_content %}
    <div class="not-prose divide-y divide-line border-y border-line">
        {% for i in 1..5 %}
            <details class="group py-5" {{ loop.first ? 'open' }}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
                    {{ ('legal.faq.q' ~ i)|trans }}
                    {{ ux_icon('lucide:plus', {class: 'size-5 shrink-0 text-fg-subtle transition group-open:rotate-45'}) }}
                </summary>
                <p class="mt-3 leading-7 text-fg-muted">{{ ('legal.faq.a' ~ i)|trans }}</p>
            </details>
        {% endfor %}
    </div>
    <p class="mt-8">{{ 'ui.faq.more_questions'|trans }} <a href="{{ path('contact') }}">{{ 'footer.contact'|trans }}</a></p>
{% endblock %}
