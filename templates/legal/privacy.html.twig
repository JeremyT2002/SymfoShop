{% extends 'legal/_layout.html.twig' %}

{% block title %}{{ 'legal.privacy.meta_title'|trans }} · {{ theme_config().brand.siteName|default('SymfoShop') }}{% endblock %}
{% block meta_description %}{{ 'legal.privacy.meta_description'|trans }}{% endblock %}

{% block legal_heading %}{{ 'legal.privacy.heading'|trans }}{% endblock %}

{% block legal_content %}
    <div class="space-y-6 text-gray-700 dark:text-gray-300 text-base leading-relaxed">
        <p>{{ 'legal.privacy.p1'|trans }}</p>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 pt-2">{{ 'legal.privacy.h_controller'|trans }}</h2>
        <p>{{ 'legal.privacy.p_controller'|trans }}</p>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 pt-2">{{ 'legal.privacy.h_data'|trans }}</h2>
        <p>{{ 'legal.privacy.p_data'|trans }}</p>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 pt-2">{{ 'legal.privacy.h_checkout'|trans }}</h2>
        <p>{{ 'legal.privacy.p_checkout'|trans }}</p>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 pt-2">{{ 'legal.privacy.h_payments'|trans }}</h2>
        <p>{{ 'legal.privacy.p_payments'|trans }}</p>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 pt-2">{{ 'legal.privacy.h_rights'|trans }}</h2>
        <p>{{ 'legal.privacy.p_rights'|trans }}</p>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 pt-2">{{ 'legal.privacy.h_contact'|trans }}</h2>
        <p>{{ 'legal.privacy.p_contact'|trans }}</p>
    </div>
{% endblock %}
