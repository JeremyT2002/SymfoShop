{% extends 'legal/_layout.html.twig' %}

{% block title %}{{ 'legal.returns.meta_title'|trans }} · {{ theme_config().brand.siteName|default('SymfoShop') }}{% endblock %}
{% block meta_description %}{{ 'legal.returns.meta_description'|trans }}{% endblock %}

{% block legal_heading %}{{ 'legal.returns.heading'|trans }}{% endblock %}

{% block legal_content %}
    <div class="space-y-6 text-gray-700 dark:text-gray-300 text-base leading-relaxed">
        <p>{{ 'legal.returns.p1'|trans }}</p>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 pt-2">{{ 'legal.returns.h_period'|trans }}</h2>
        <p>{{ 'legal.returns.p_period'|trans }}</p>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 pt-2">{{ 'legal.returns.h_condition'|trans }}</h2>
        <p>{{ 'legal.returns.p_condition'|trans }}</p>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 pt-2">{{ 'legal.returns.h_process'|trans }}</h2>
        <p>{{ 'legal.returns.p_process'|trans }}</p>
        <p class="pt-2">
            <a href="{{ path('return_request') }}" class="text-primary-600 dark:text-primary-400 font-medium hover:underline">{{ 'legal.returns.cta_link'|trans }}</a>
            — {{ 'legal.returns.cta'|trans }}
        </p>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 pt-2">{{ 'legal.returns.h_refund'|trans }}</h2>
        <p>{{ 'legal.returns.p_refund'|trans }}</p>
    </div>
{% endblock %}
