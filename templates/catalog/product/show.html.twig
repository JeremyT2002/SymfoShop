{% extends 'base.html.twig' %}

{%- set seo_title = product.seoTitle|default(product.name) -%}
{%- set seo_description = product.seoDescription|default(product.description|default(product.name))|striptags|slice(0, 160) -%}
{%- set images = product.media|map(m => {src: m.path, alt: m.alt|default(product.name)}) -%}
{#- Image indexes per variant (key "v<id>" keeps Twig from renumbering) -#}
{%- set media_by_variant = {} -%}
{%- for m in product.media -%}
    {%- if m.variant -%}
        {%- set media_by_variant = media_by_variant|merge({('v' ~ m.variant.id): (media_by_variant['v' ~ m.variant.id]|default([]))|merge([loop.index0])}) -%}
    {%- endif -%}
{%- endfor -%}
{%- set variant_data = variants|map(v => {
    id: v.id,
    label: v.attributes is not empty ? v.attributes|map((value, key) => key|capitalize ~ ': ' ~ value)|join(' · ') : 'product.default_variant'|trans,
    price: v.priceAmount,
    compareAt: v.onSale ? v.compareAtPriceAmount : null,
    discountPercent: v.discountPercent,
    currency: v.currency,
    sku: v.sku,
    attributes: v.attributes is not empty ? v.attributes : {},
    images: media_by_variant['v' ~ v.id]|default([]),
    available: max(0, v.stockItem ? v.stockItem.available : 0),
}) -%}
{%- set default_available = defaultVariant and defaultVariant.stockItem ? defaultVariant.stockItem.available : 0 -%}

{% block page_title %}{{ seo_title }}{% endblock %}
{% block meta_description %}{{ seo_description }}{% endblock %}
{% block js_page %}product{% endblock %}

{% block robots_meta %}
    {%- set noIndex = theme_config().seo.defaultNoIndex|default(false) or product.seoNoIndex|default(false) -%}
    <meta name="robots" content="{{ noIndex ? 'noindex,nofollow' : 'index,follow' }}">
{% endblock %}

{% block meta_tags %}
    <meta property="og:type" content="product">
    <meta property="og:title" content="{{ seo_title }}">
    <meta property="og:description" content="{{ seo_description }}">
    <meta name="twitter:card" content="{{ images is not empty ? 'summary_large_image' : 'summary' }}">
    <meta name="twitter:title" content="{{ seo_title }}">
    <meta name="twitter:description" content="{{ seo_description }}">
    {% if images is not empty %}
        <meta property="og:image" content="{{ absolute_url(images[0].src) }}">
    {% endif %}
    {% if defaultVariant %}
        <meta property="product:price:amount" content="{{ (defaultVariant.priceAmount / 100)|number_format(2, '.', '') }}">
        <meta property="product:price:currency" content="{{ defaultVariant.currency }}">
    {% endif %}
    {# Structured data for rich results #}
    <script type="application/ld+json">
        {{- {
            '@context': 'https://schema.org',
            '@type': 'Product',
            name: product.name,
            description: seo_description,
            image: images|map(i => absolute_url(i.src)),
            sku: defaultVariant ? defaultVariant.sku : null,
            offers: variants|map(v => {
                '@type': 'Offer',
                sku: v.sku,
                price: (v.priceAmount / 100)|number_format(2, '.', ''),
                priceCurrency: v.currency,
                availability: (v.stockItem and v.stockItem.available > 0) ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
                url: url('catalog_product', {slug: product.slug}),
            }),
        }|merge(product.averageRating and reviewCount > 0 ? {aggregateRating: {'@type': 'AggregateRating', ratingValue: product.averageRating|round(1), reviewCount: reviewCount}} : {})
        |json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw -}}
    </script>
{% endblock %}

{% block body %}
<div class="container-page py-6 lg:py-10" x-data="productPage" data-initial-variant="{{ defaultVariant ? defaultVariant.id : '' }}"
     @keydown.escape.window="zoomOpen = false">
    <script type="application/json" data-variants>{{ variant_data|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>
    <script type="application/json" data-images>{{ images|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>

    {%- set crumbs = [{label: 'nav.home'|trans, url: path('catalog_home')}] -%}
    {%- if product.category -%}
        {%- set crumbs = crumbs|merge([{label: product.category.name, url: path('catalog_category', {slug: product.category.slug})}]) -%}
    {%- endif -%}
    {% include 'components/breadcrumbs.html.twig' with {items: crumbs|merge([{label: product.name, url: null}])} only %}

    <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
        {# Gallery #}
        <div class="lg:col-span-7">
            <div class="relative aspect-square overflow-hidden rounded-2xl bg-subtle sm:aspect-[4/5] lg:aspect-square">
                {% if images is not empty %}
                    {% for image in images %}
                        <img src="{{ image_url(image.src, 960) }}" srcset="{{ image_srcset(image.src, [480, 640, 960, 1280, 1600]) }}"
                             sizes="(min-width: 1024px) 58vw, 100vw" alt="{{ image.alt }}"
                             x-show="activeImage === {{ loop.index0 }}" {% if not loop.first %}x-cloak loading="lazy"{% else %}fetchpriority="high"{% endif %}
                             class="absolute inset-0 size-full cursor-zoom-in object-cover" @click="zoomOpen = true">
                    {% endfor %}
                    {% if images|length > 1 %}
                        <button type="button" class="btn btn-icon absolute top-1/2 left-3 -translate-y-1/2 rounded-full bg-panel/90 shadow backdrop-blur hover:bg-panel" @click="previous()" aria-label="{{ 'ui.gallery.previous'|trans }}">
                            {{ ux_icon('lucide:chevron-left', {class: 'size-5'}) }}
                        </button>
                        <button type="button" class="btn btn-icon absolute top-1/2 right-3 -translate-y-1/2 rounded-full bg-panel/90 shadow backdrop-blur hover:bg-panel" @click="next()" aria-label="{{ 'ui.gallery.next'|trans }}">
                            {{ ux_icon('lucide:chevron-right', {class: 'size-5'}) }}
                        </button>
                        <span class="absolute right-3 bottom-3 rounded-full bg-panel/90 px-2.5 py-1 text-xs font-medium tabular-nums backdrop-blur"
                              x-text="(activeImage + 1) + ' / {{ images|length }}'">1 / {{ images|length }}</span>
                    {% endif %}
                    <button type="button" class="btn btn-icon absolute top-3 right-3 rounded-full bg-panel/90 shadow backdrop-blur hover:bg-panel" @click="zoomOpen = true" aria-label="{{ 'ui.gallery.zoom'|trans }}">
                        {{ ux_icon('lucide:maximize-2', {class: 'size-4'}) }}
                    </button>
                {% else %}
                    <div class="flex size-full items-center justify-center text-fg-subtle">{{ ux_icon('lucide:image', {class: 'size-16 opacity-50'}) }}</div>
                {% endif %}
            </div>

            {% if images|length > 1 %}
                <div class="mt-3 grid grid-cols-5 gap-3 sm:grid-cols-6" role="tablist" aria-label="{{ 'ui.gallery.thumbnails'|trans }}">
                    {% for image in images %}
                        <button type="button" role="tab" @click="show({{ loop.index0 }})" :aria-selected="activeImage === {{ loop.index0 }}"
                                class="aspect-square overflow-hidden rounded-lg bg-subtle ring-2 ring-transparent ring-offset-2 ring-offset-canvas transition aria-selected:ring-fg">
                            <img src="{{ image_url(image.src, 320) }}" alt="" loading="lazy" class="size-full object-cover">
                        </button>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# Purchase panel #}
        <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-28">
                <div class="flex items-start justify-between gap-4">
                    <h1 class="text-2xl font-semibold sm:text-3xl">{{ product.name }}</h1>
                    {% if app.user %}
                        {%- set wished = in_wishlist(product.id) -%}
                        <button type="button" data-wishlist-toggle data-product-id="{{ product.id }}" aria-pressed="{{ wished ? 'true' : 'false' }}"
                                aria-label="{{ 'wishlist.toggle'|trans }}"
                                class="group/wish btn btn-secondary btn-icon shrink-0 rounded-full aria-pressed:text-red-500">
                            {{ ux_icon('lucide:heart', {class: 'size-5 group-aria-pressed/wish:fill-current'}) }}
                        </button>
                    {% endif %}
                </div>

                {% if product.averageRating %}
                    <a href="#reviews" class="mt-2 inline-flex items-center gap-2 text-sm text-fg-muted hover:text-fg">
                        <span class="flex text-amber-400">
                            {% for i in 1..5 %}{{ ux_icon('lucide:star', {class: 'size-4 ' ~ (i <= product.averageRating|round ? 'fill-current' : 'text-line-strong')}) }}{% endfor %}
                        </span>
                        {{ 'review.summary'|trans({'%rating%': product.averageRating|number_format(1), '%count%': reviewCount}) }}
                    </a>
                {% endif %}

                {% if defaultVariant %}
                    <p class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <span class="text-2xl font-semibold tabular-nums" :class="variant?.compareAt && 'text-red-600 dark:text-red-400'" x-text="price">{{ defaultVariant.priceAmount|money(defaultVariant.currency) }}</span>
                        <s class="text-base text-fg-subtle tabular-nums" x-show="variant?.compareAt" x-text="compareAtPrice" {{ defaultVariant.onSale ? '' : 'x-cloak' }} aria-label="{{ 'ui.product.was_price'|trans }}">{{ defaultVariant.onSale ? defaultVariant.compareAtPriceAmount|money(defaultVariant.currency) }}</s>
                        <span class="badge bg-red-600 font-semibold text-white ring-0" x-show="variant?.compareAt" {{ defaultVariant.onSale ? '' : 'x-cloak' }}
                              x-text="'{{ 'ui.product.sale_badge'|trans({'%percent%': '__P__'})|e('js') }}'.replace('__P__', variant?.discountPercent)">{{ defaultVariant.onSale ? 'ui.product.sale_badge'|trans({'%percent%': defaultVariant.discountPercent}) }}</span>
                    </p>
                    <p class="mt-1 text-xs text-fg-subtle">{{ 'ui.product.price_note'|trans }}</p>

                    {# Variant picker #}
                    {% if variants|length > 1 %}
                        {% include 'catalog/product/_option_picker.html.twig' %}
                    {% endif %}

                    {# Stock state #}
                    <p class="mt-6 flex items-center gap-2 text-sm font-medium">
                        <span class="size-2 rounded-full" :class="inStock ? (lowStock ? 'bg-amber-500' : 'bg-emerald-500') : 'bg-red-500'"></span>
                        <span x-show="inStock && !lowStock" {{ default_available > 5 ? '' : 'x-cloak' }}>{{ 'product.in_stock'|trans }}</span>
                        <span x-show="lowStock" x-cloak x-text="'{{ 'ui.product.only_n_left'|trans({'%count%': '__N__'})|e('js') }}'.replace('__N__', variant.available)"></span>
                        <span x-show="!inStock" {{ default_available > 0 ? 'x-cloak' : '' }}>{{ 'product.out_of_stock'|trans }}</span>
                    </p>

                    {# Add to cart #}
                    <div class="mt-4 flex gap-3" x-show="inStock" {{ default_available > 0 ? '' : 'x-cloak' }}>
                        <div class="flex items-center rounded-lg border border-line-strong" x-data="{ qty: 1 }">
                            <button type="button" class="btn btn-ghost btn-icon h-12 rounded-r-none" @click="qty = Math.max(1, qty - 1)" aria-label="{{ 'ui.quantity.decrease'|trans }}">{{ ux_icon('lucide:minus', {class: 'size-4'}) }}</button>
                            <label for="product-qty" class="sr-only">{{ 'cart.quantity'|trans }}</label>
                            <input id="product-qty" type="number" min="1" :max="variant?.available || 1" x-model.number="qty"
                                   class="h-12 w-12 border-0 bg-transparent text-center text-sm font-semibold tabular-nums focus:ring-0 focus:outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none" value="1">
                            <button type="button" class="btn btn-ghost btn-icon h-12 rounded-l-none" @click="qty = Math.min(variant?.available || 1, qty + 1)" aria-label="{{ 'ui.quantity.increase'|trans }}">{{ ux_icon('lucide:plus', {class: 'size-4'}) }}</button>
                        </div>
                        <button type="button" class="btn btn-primary btn-lg h-12 flex-1" data-add-to-cart data-quantity-input="#product-qty"
                                data-variant-id="{{ defaultVariant.id }}" :data-variant-id="selectedId">
                            {{ ux_icon('lucide:shopping-bag', {class: 'size-5'}) }}<span data-label>{{ 'product.add_to_cart'|trans }}</span>
                        </button>
                    </div>

                    {# Back-in-stock notification, one form per variant (CSRF token is per variant) #}
                    {% for v in variants %}
                        <form method="post" action="{{ path('stock_notification_subscribe') }}" class="card mt-4 space-y-3 p-4"
                              x-show="!inStock && selectedId === {{ v.id }}" {{ v.id == defaultVariant.id and default_available == 0 ? '' : 'x-cloak' }}>
                            <p class="flex items-center gap-2 text-sm font-semibold">{{ ux_icon('lucide:bell', {class: 'size-4'}) }}{{ 'stock_notification.cta'|trans }}</p>
                            <input type="hidden" name="_token" value="{{ csrf_token('stock_notification_' ~ v.id) }}">
                            <input type="hidden" name="variant_id" value="{{ v.id }}">
                            {% if app.user %}
                                <p class="text-sm text-fg-muted">{{ 'ui.stock.notify_account'|trans({'%email%': app.user.email}) }}</p>
                            {% else %}
                                <label for="stock-email-{{ v.id }}" class="sr-only">{{ 'checkout.fields.email'|trans }}</label>
                                <input id="stock-email-{{ v.id }}" type="email" name="email" required autocomplete="email" class="input" placeholder="{{ 'stock_notification.email_placeholder'|trans }}">
                                <label class="flex items-start gap-2 text-xs text-fg-muted">
                                    <input type="checkbox" name="privacy_consent" value="1" required class="checkbox mt-0.5">
                                    <span>{{ 'stock_notification.privacy_consent'|trans }}</span>
                                </label>
                            {% endif %}
                            <button type="submit" class="btn btn-secondary w-full">{{ 'stock_notification.cta'|trans }}</button>
                        </form>
                    {% endfor %}

                    <dl class="mt-8 divide-y divide-line border-y border-line text-sm">
                        <div class="flex items-center gap-3 py-3">{{ ux_icon('lucide:truck', {class: 'size-5 text-fg-muted'}) }}<dt class="sr-only">{{ 'home.benefits.fast_shipping'|trans }}</dt><dd>{{ 'ui.product.shipping_note'|trans }}</dd></div>
                        <div class="flex items-center gap-3 py-3">{{ ux_icon('lucide:rotate-ccw', {class: 'size-5 text-fg-muted'}) }}<dt class="sr-only">{{ 'home.benefits.easy_returns'|trans }}</dt><dd><a href="{{ path('legal_returns') }}" class="hover:underline">{{ 'ui.product.returns_note'|trans }}</a></dd></div>
                        <div class="flex items-center gap-3 py-3">{{ ux_icon('lucide:shield-check', {class: 'size-5 text-fg-muted'}) }}<dt class="sr-only">{{ 'product.secure_payment'|trans }}</dt><dd>{{ 'ui.product.payment_note'|trans }}</dd></div>
                    </dl>
                {% else %}
                    <div class="alert alert-warning mt-6">{{ ux_icon('lucide:triangle-alert', {class: 'mt-0.5 size-4'}) }}<p>{{ 'product.no_variants'|trans }}</p></div>
                {% endif %}

                {# Details accordion #}
                <div class="mt-8 divide-y divide-line border-b border-line">
                    {% if product.description %}
                        <div x-data="{ open: true }">
                            <h2>
                                <button type="button" class="flex w-full items-center justify-between py-4 text-left font-semibold" @click="open = !open" :aria-expanded="open">
                                    {{ 'product.description'|trans }}
                                    <span class="inline-flex shrink-0 transition" :class="open && 'rotate-180'">{{ ux_icon('lucide:chevron-down', {class: 'size-5 transition'}) }}</span>
                                </button>
                            </h2>
                            <div x-show="open" x-collapse>
                                <div class="pb-6 text-sm leading-7 text-fg-muted">{{ product.description|nl2br }}</div>
                            </div>
                        </div>
                    {% endif %}
                    {% if defaultVariant %}
                        <div x-data="{ open: false }">
                            <h2>
                                <button type="button" class="flex w-full items-center justify-between py-4 text-left font-semibold" @click="open = !open" :aria-expanded="open">
                                    {{ 'product.details'|trans }}
                                    <span class="inline-flex shrink-0 transition" :class="open && 'rotate-180'">{{ ux_icon('lucide:chevron-down', {class: 'size-5 transition'}) }}</span>
                                </button>
                            </h2>
                            <div x-show="open" x-collapse x-cloak>
                                <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 pb-6 text-sm">
                                    <dt class="text-fg-subtle">{{ 'product.sku'|trans }}</dt>
                                    <dd class="font-mono text-fg-muted" x-text="variant?.sku">{{ defaultVariant.sku }}</dd>
                                    {% for key, value in defaultVariant.attributes %}
                                        <dt class="text-fg-subtle">{{ key|capitalize }}</dt><dd class="text-fg-muted">{{ value }}</dd>
                                    {% endfor %}
                                    {% if product.category %}
                                        <dt class="text-fg-subtle">{{ 'ui.product.category'|trans }}</dt>
                                        <dd><a href="{{ path('catalog_category', {slug: product.category.slug}) }}" class="link">{{ product.category.name }}</a></dd>
                                    {% endif %}
                                </dl>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% include 'catalog/product/_reviews.html.twig' %}

    {# Image zoom #}
    {% if images is not empty %}
        <div x-cloak x-show="zoomOpen" x-transition.opacity class="fixed inset-0 z-[70] flex items-center justify-center bg-black/90 p-4"
             role="dialog" aria-modal="true" aria-label="{{ 'ui.gallery.zoom'|trans }}" x-trap.noscroll="zoomOpen" @click.self="zoomOpen = false">
            <img :src="images[activeImage]?.src" :alt="images[activeImage]?.alt" class="max-h-full max-w-full object-contain">
            <button type="button" class="btn btn-icon absolute top-4 right-4 rounded-full bg-white/10 text-white hover:bg-white/20" @click="zoomOpen = false" aria-label="{{ 'common.close'|trans }}">{{ ux_icon('lucide:x', {class: 'size-6'}) }}</button>
            {% if images|length > 1 %}
                <button type="button" class="btn btn-icon absolute left-4 rounded-full bg-white/10 text-white hover:bg-white/20" @click="previous()" aria-label="{{ 'ui.gallery.previous'|trans }}">{{ ux_icon('lucide:chevron-left', {class: 'size-6'}) }}</button>
                <button type="button" class="btn btn-icon absolute right-4 rounded-full bg-white/10 text-white hover:bg-white/20" @click="next()" aria-label="{{ 'ui.gallery.next'|trans }}">{{ ux_icon('lucide:chevron-right', {class: 'size-6'}) }}</button>
            {% endif %}
        </div>
    {% endif %}
</div>

{% include 'components/recently_viewed_products.html.twig' with {recentlyViewedProducts: recentlyViewedProducts|default([])} only %}
{% endblock %}
