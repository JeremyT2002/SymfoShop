{% extends 'catalog/base.html.twig' %}

{% block title %}{{ product.name|escape }} - SymfoShop{% endblock %}
{% block meta_description %}{{ product.description|default(product.name)|escape|slice(0, 160) }}{% endblock %}
{% block js_page %}product{% endblock %}

{% block meta_tags %}
    <meta property="og:title" content="{{ product.name|escape }} - SymfoShop">
    <meta property="og:description" content="{{ product.description|default(product.name)|escape|slice(0, 160) }}">
    {% if product.media|length > 0 %}
        {% set firstMedia = product.media|first %}
        <meta property="og:image" content="{{ firstMedia.path|escape }}">
    {% endif %}
{% endblock %}

{% block catalog_body %}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {# Breadcrumbs #}
        {% include 'components/breadcrumbs.html.twig' with {
            items: [
                {label: 'nav.home'|trans, url: path('catalog_home')},
                {label: product.name|escape, url: null}
            ]
        } %}
        
        {# Product Layout #}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 mb-12">
            {# Product Images #}
            <div class="space-y-4">
                {# Main Image #}
                <div class="bg-white rounded-2xl shadow-lg overflow-hidden aspect-square">
                    {% if product.media|length > 0 %}
                        {% set firstMedia = product.media|first %}
                        <img id="main-product-image" 
                             src="{{ firstMedia.path|escape }}" 
                             alt="{{ firstMedia.alt|default(product.name)|escape }}"
                             class="w-full h-full object-cover cursor-zoom-in"
                             data-js="product-image-modal">
                    {% else %}
                        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200">
                            <i class="fas fa-image text-8xl text-gray-400"></i>
                        </div>
                    {% endif %}
                </div>
                
                {# Thumbnail Gallery #}
                {% if product.media|length > 1 %}
                    <div class="grid grid-cols-4 sm:grid-cols-5 gap-3">
                        {% for media in product.media %}
                            <button type="button"
                                    class="aspect-square rounded-xl overflow-hidden border-2 transition-all duration-200 {% if loop.first %}border-primary-600 ring-2 ring-primary-200{% else %}border-gray-200 hover:border-primary-400{% endif %}"
                                    data-js="product-thumbnail"
                                    data-image-src="{{ media.path|escape }}">
                                <img src="{{ media.path|escape }}" 
                                     alt="{{ media.alt|default(product.name)|escape }}"
                                     class="w-full h-full object-cover">
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            
            {# Product Info #}
            <div class="space-y-6">
                {# Title & Status #}
                <div class="flex items-start justify-between">
                    <div>
                        <h1 class="text-4xl font-bold text-gray-900 mb-3">{{ product.name|escape }}</h1>
                        {% if product.status.value == 'active' %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                <i class="fas fa-check-circle mr-1.5"></i>
                                {{ 'product.status.active'|trans }}
                            </span>
                        {% endif %}
                    </div>
                    {# Wishlist Heart Icon #}
                    {% if app.user %}
                        <button type="button"
                                class="wishlist-toggle bg-white border-2 border-gray-200 hover:border-red-400 p-3 rounded-full shadow-md transition-all duration-200 ml-4"
                                data-js="wishlist-toggle"
                                data-product-id="{{ product.id }}"
                                aria-label="{{ 'wishlist.toggle'|trans }}">
                            <i class="fas fa-heart text-gray-400 wishlist-icon transition-colors duration-200" data-in-wishlist="false"></i>
                        </button>
                    {% endif %}
                </div>
                
                {# Price & Variant Selection #}
                {% if variants|length > 0 %}
                    <div class="bg-white rounded-2xl shadow-lg p-6 space-y-6">
                        {# Variant Selector #}
                        {% if variants|length > 1 %}
                            <div>
                                <label for="variant-select" class="block text-sm font-semibold text-gray-700 mb-2">
                                    {{ 'product.select_variant'|trans }}
                                </label>
                                <select id="variant-select" 
                                        name="variant"
                                        data-js="product-variant-select"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-gray-900 bg-white transition-colors">
                                    {% for variant in variants %}
                                        <option value="{{ variant.id }}" 
                                                data-price="{{ variant.priceAmount }}" 
                                                data-currency="{{ variant.currency|escape }}"
                                                data-sku="{{ variant.sku|escape }}"
                                                {% if variant == defaultVariant %}selected{% endif %}>
                                            {% if variant.attributes|length > 0 %}
                                                {{ variant.attributes|map((v, k) => "#{k}: #{v}")|join(', ')|escape }} - 
                                            {% endif %}
                                            {{ (variant.priceAmount / 100)|number_format(2, '.', ',') }} {{ variant.currency|escape }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}
                        
                        {# Price Display #}
                        <div class="border-t border-gray-200 pt-6">
                            <div class="mb-2">
                                <div class="text-4xl font-bold text-primary-600" id="price-display">
                                    {{ (defaultVariant.priceAmount / 100)|number_format(2, '.', ',') }} {{ defaultVariant.currency|escape }}
                                </div>
                            </div>
                            <div class="text-sm text-gray-500 font-mono" id="sku-display">
                                SKU: {{ defaultVariant.sku|escape }}
                            </div>
                        </div>
                        
                        {# Add to Cart #}
                        <div class="space-y-3">
                            <button type="button" 
                                    id="add-to-cart-btn"
                                    class="w-full bg-primary-600 hover:bg-primary-700 text-white font-bold py-4 px-6 rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 flex items-center justify-center gap-3 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none"
                                    data-js="add-to-cart"
                                    data-variant-id="{{ defaultVariant.id }}">
                                <i class="fas fa-shopping-cart"></i>
                                <span>{{ 'product.add_to_cart'|trans }}</span>
                            </button>
                            
                            <div class="flex items-center justify-center gap-6 text-sm text-gray-600">
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-shield-alt text-primary-600"></i>
                                    <span>{{ 'product.secure_payment'|trans }}</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-truck text-primary-600"></i>
                                    <span>{{ 'product.fast_shipping'|trans }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4">
                        <p class="text-yellow-800">{{ 'product.no_variants'|trans }}</p>
                    </div>
                {% endif %}
                
                {# Description #}
                {% if product.description %}
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <h2 class="text-xl font-bold text-gray-900 mb-4">{{ 'product.description'|trans }}</h2>
                        <div class="prose prose-gray max-w-none text-gray-700 leading-relaxed">
                            {{ product.description|escape|nl2br|raw }}
                        </div>
                    </div>
                {% endif %}
                
                {# Product Details #}
                <div class="bg-gray-50 rounded-2xl p-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">{{ 'product.details'|trans }}</h3>
                    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                        <div>
                            <dt class="font-medium text-gray-500">{{ 'product.status'|trans }}</dt>
                            <dd class="mt-1 text-gray-900 capitalize">{{ product.status.value|escape }}</dd>
                        </div>
                        <div>
                            <dt class="font-medium text-gray-500">{{ 'product.tax_class'|trans }}</dt>
                            <dd class="mt-1 text-gray-900">{{ product.taxClass|escape }}</dd>
                        </div>
                        {% if variants|length > 0 %}
                            <div>
                                <dt class="font-medium text-gray-500">{{ 'product.variants_count'|trans }}</dt>
                                <dd class="mt-1 text-gray-900">{{ variants|length }}</dd>
                            </div>
                        {% endif %}
                    </dl>
                </div>
            </div>
        </div>
        
        {# All Variants Table (if multiple) #}
        {% if variants|length > 1 %}
            <div class="bg-white rounded-2xl shadow-lg p-6 mt-12">
                <h2 class="text-2xl font-bold text-gray-900 mb-6">{{ 'product.all_variants'|trans }}</h2>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">{{ 'product.variant'|trans }}</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">{{ 'product.sku'|trans }}</th>
                                <th class="px-4 py-3 text-right text-sm font-semibold text-gray-700">{{ 'product.price'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            {% for variant in variants %}
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-4 py-3 text-sm text-gray-900">
                                        {% if variant.attributes|length > 0 %}
                                            {{ variant.attributes|map((v, k) => "#{k}: #{v}")|join(', ')|escape }}
                                        {% else %}
                                            {{ 'product.default_variant'|trans }}
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-3 text-sm font-mono text-gray-600">{{ variant.sku|escape }}</td>
                                    <td class="px-4 py-3 text-sm font-bold text-primary-600 text-right">
                                        {{ (variant.priceAmount / 100)|number_format(2, '.', ',') }} {{ variant.currency|escape }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    </div>
    
    {# Image Modal #}
    <div id="image-modal" class="fixed inset-0 bg-black bg-opacity-90 z-50 hidden items-center justify-center p-4" onclick="closeImageModal()">
        <button type="button" class="absolute top-4 right-4 text-white hover:text-gray-300 text-3xl" onclick="closeImageModal()" aria-label="Close">
            <i class="fas fa-times"></i>
        </button>
        <img id="modal-image" src="" alt="" class="max-w-full max-h-full object-contain">
    </div>
{% endblock %}
