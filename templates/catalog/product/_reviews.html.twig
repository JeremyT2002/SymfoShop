{# Reviews block of the product page #}
<section id="reviews" class="mt-16 scroll-mt-24 border-t border-line pt-12 lg:mt-24" aria-labelledby="reviews-heading">
    <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
            <h2 id="reviews-heading" class="text-2xl font-semibold">{{ 'review.section_title'|trans }}</h2>
            {% if product.averageRating %}
                <div class="mt-4 flex items-center gap-3">
                    <span class="text-4xl font-semibold tabular-nums">{{ product.averageRating|number_format(1) }}</span>
                    <div>
                        <div class="flex text-amber-400" aria-label="{{ 'ui.reviews.rating_aria'|trans({'%rating%': product.averageRating|number_format(1)}) }}">
                            {% for i in 1..5 %}{{ ux_icon('lucide:star', {class: 'size-4 ' ~ (i <= product.averageRating|round ? 'fill-current' : 'text-line-strong')}) }}{% endfor %}
                        </div>
                        <p class="mt-0.5 text-sm text-fg-muted">{{ 'ui.reviews.count'|trans({'%count%': reviewCount}) }}</p>
                    </div>
                </div>
            {% else %}
                <p class="mt-3 text-sm text-fg-muted">{{ 'review.no_reviews_yet'|trans }}</p>
            {% endif %}

            <div class="mt-8">
                {% if not app.user %}
                    <p class="text-sm text-fg-muted">{{ 'review.form.login_to_review'|trans }}</p>
                    <a href="{{ path('login') }}" class="btn btn-secondary mt-3">{{ 'nav.login'|trans }}</a>
                {% elseif hasExistingReview %}
                    <p class="text-sm text-fg-muted">{{ 'review.form.already_reviewed'|trans }}</p>
                {% elseif not canReview %}
                    <p class="text-sm text-fg-muted">{{ 'review.form.verified_purchase_only'|trans }}</p>
                {% else %}
                    <form method="post" action="{{ path('catalog_product', {slug: product.slug}) }}" class="card card-body space-y-4"
                          x-data="{ rating: 5 }">
                        <input type="hidden" name="_token" value="{{ csrf_token('product_review_' ~ product.id) }}">
                        <fieldset>
                            <legend class="label">{{ 'review.form.rating'|trans }}</legend>
                            <div class="flex gap-1">
                                {% for r in 1..5 %}
                                    <label class="cursor-pointer text-amber-400">
                                        <input type="radio" name="rating" value="{{ r }}" class="peer sr-only" x-model.number="rating" {{ r == 5 ? 'checked' }} required>
                                        <span class="block rounded peer-focus-visible:outline-2 peer-focus-visible:outline-primary-500" :class="rating >= {{ r }} ? '' : 'text-line-strong'">
                                            {{ ux_icon('lucide:star', {class: 'size-7 fill-current'}) }}
                                        </span>
                                        <span class="sr-only">{{ r }}/5</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </fieldset>
                        <div>
                            <label for="review_title" class="label">{{ 'review.form.title'|trans }}</label>
                            <input id="review_title" name="title" class="input" maxlength="120" required>
                        </div>
                        <div>
                            <label for="review_body" class="label">{{ 'review.form.body'|trans }}</label>
                            <textarea id="review_body" name="body" class="textarea" rows="4" maxlength="2000" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-full">{{ 'review.form.submit'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>

        <div class="lg:col-span-8">
            {% for review in approvedReviews %}
                <article class="border-b border-line py-6 first:pt-0">
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex text-amber-400" aria-label="{{ 'ui.reviews.rating_aria'|trans({'%rating%': review.rating}) }}">
                            {% for i in 1..5 %}{{ ux_icon('lucide:star', {class: 'size-4 ' ~ (i <= review.rating ? 'fill-current' : 'text-line-strong')}) }}{% endfor %}
                        </div>
                        <time class="text-xs text-fg-subtle" datetime="{{ review.createdAt|date('Y-m-d') }}">{{ review.createdAt|date('d.m.Y') }}</time>
                    </div>
                    <h3 class="mt-3 font-semibold">{{ review.title }}</h3>
                    <p class="mt-2 text-sm leading-6 text-fg-muted">{{ review.body|nl2br }}</p>
                    <p class="mt-3 flex items-center gap-2 text-xs text-fg-subtle">
                        <span class="font-medium text-fg-muted">{{ review.user|public_name('ui.reviews.anonymous'|trans) }}</span>
                        {% if review.verifiedPurchase %}
                            <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400">{{ ux_icon('lucide:badge-check', {class: 'size-3.5'}) }}{{ 'review.verified_purchase'|trans }}</span>
                        {% endif %}
                    </p>
                </article>
            {% else %}
                {% if product.averageRating %}<p class="text-sm text-fg-muted">{{ 'review.no_reviews_yet'|trans }}</p>{% endif %}
            {% endfor %}

            {% if reviewPages > 1 %}
                <nav class="mt-6 flex items-center justify-between text-sm" aria-label="{{ 'ui.a11y.pagination'|trans }}">
                    <span class="text-fg-muted">{{ 'review.pagination'|trans({'%page%': reviewPage, '%pages%': reviewPages}) }}</span>
                    <div class="flex gap-2">
                        {% if reviewPage > 1 %}
                            <a href="{{ path('catalog_product', {slug: product.slug, reviewPage: reviewPage - 1}) }}#reviews" class="btn btn-secondary btn-sm">{{ 'common.previous'|trans }}</a>
                        {% endif %}
                        {% if reviewPage < reviewPages %}
                            <a href="{{ path('catalog_product', {slug: product.slug, reviewPage: reviewPage + 1}) }}#reviews" class="btn btn-secondary btn-sm">{{ 'common.next'|trans }}</a>
                        {% endif %}
                    </div>
                </nav>
            {% endif %}
        </div>
    </div>
</section>
