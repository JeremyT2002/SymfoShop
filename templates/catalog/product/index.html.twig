{% extends 'catalog/base.html.twig' %}

{% block page_title %}{{ 'catalog.all_products.title'|trans }} - SymfoShop{% endblock %}
{% block page_meta_description %}{{ 'catalog.all_products.meta'|trans }}{% endblock %}

{% block catalog_body %}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {% include 'components/breadcrumbs.html.twig' with {
            items: [
                {label: 'nav.home'|trans, url: path('catalog_home')},
                {label: 'catalog.all_products.title'|trans|default('All products'), url: null}
            ]
        } %}

        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-2">{{ 'catalog.all_products.title'|trans }}</h1>
            <p class="text-gray-600">{{ 'category.showing'|trans }} {{ products|length }} {{ 'category.of'|trans }} {{ totalProducts }} {{ totalProducts != 1 ? 'category.products'|trans : 'category.product'|trans }}</p>
        </div>

        {% if products|length > 0 %}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8">
                {% for product in products %}
                    {% include 'components/product_card.html.twig' with { product: product, variant: product.variants|first } %}
                {% endfor %}
            </div>
            {% if totalPages > 1 %}
                {% include 'components/pagination.html.twig' with {
                    currentPage: currentPage,
                    totalPages: totalPages,
                    route: 'catalog_products',
                    routeParams: {}
                } %}
            {% endif %}
        {% else %}
            <div class="bg-white rounded-2xl shadow-lg p-16 text-center text-gray-600">
                {{ 'catalog.all_products.empty'|trans }}
            </div>
        {% endif %}
    </div>
{% endblock %}
