{% extends 'base.html.twig' %}

{% block page_title %}{{ search ? 'ui.search.results_for'|trans({'%query%': search}) : 'catalog.all_products.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'catalog.all_products.meta'|trans }}{% endblock %}

{% block robots_meta %}
    <meta name="robots" content="{{ search or theme_config().seo.defaultNoIndex|default(false) ? 'noindex,follow' : 'index,follow' }}">
{% endblock %}

{% block body %}
<div class="container-page py-8 lg:py-12">
    {% include 'components/breadcrumbs.html.twig' with {items: [
        {label: 'nav.home'|trans, url: path('catalog_home')},
        {label: 'catalog.all_products.title'|trans, url: search ? path('catalog_products') : null},
    ]|merge(search ? [{label: 'ui.search.label'|trans, url: null}] : [])} only %}

    <header class="flex flex-col gap-6 border-b border-line pb-8 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="text-3xl font-semibold sm:text-4xl">
                {% if search %}{{ 'ui.search.results_for'|trans({'%query%': search}) }}{% else %}{{ 'catalog.all_products.title'|trans }}{% endif %}
            </h1>
            <p class="mt-2 text-sm text-fg-muted">{{ totalProducts }} {{ totalProducts == 1 ? 'category.product'|trans : 'category.products'|trans }}</p>
        </div>
        <form action="{{ path('catalog_products') }}" method="get" role="search" class="relative w-full sm:w-80">
            <label for="listing-search" class="sr-only">{{ 'ui.search.label'|trans }}</label>
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-fg-subtle">{{ ux_icon('lucide:search', {class: 'size-4'}) }}</span>
            <input id="listing-search" type="search" name="q" value="{{ search }}" placeholder="{{ 'ui.search.placeholder'|trans }}" class="input pl-9">
        </form>
    </header>

    {% if products is not empty %}
        <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 lg:grid-cols-4">
            {% for product in products %}
                {% include 'components/product_card.html.twig' with {product: product, eager: loop.index <= 4} only %}
            {% endfor %}
        </div>
        {% include 'components/pagination.html.twig' with {
            currentPage: currentPage, totalPages: totalPages, route: 'catalog_products', routeParams: search ? {q: search} : {}
        } only %}
    {% else %}
        <div class="mt-8">
            {% include 'components/empty_state.html.twig' with {
                icon: search ? 'lucide:search-x' : 'lucide:package-open',
                title: search ? 'ui.search.no_results'|trans({'%query%': search}) : 'catalog.all_products.empty'|trans,
                text: search ? 'ui.search.no_results_hint'|trans : false,
                action: search ? {label: 'catalog.all_products.title'|trans, url: path('catalog_products')} : false,
            } only %}
        </div>
    {% endif %}
</div>
{% endblock %}
