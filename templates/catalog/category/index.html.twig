{% extends 'catalog/base.html.twig' %}

{% block page_title %}SymfoShop - Your Modern Shopping Destination{% endblock %}
{% block page_meta_description %}Discover amazing products across multiple categories. Shop with confidence and enjoy fast shipping.{% endblock %}

{% block catalog_body %}
    {# Hero Section #}
    <section class="relative bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800 text-white overflow-hidden">
        <div class="absolute inset-0 bg-black opacity-10"></div>
        <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23ffffff" fill-opacity="0.05"%3E%3Cpath d="M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
        
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
            <div class="text-center">
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6 animate-fade-in">
                    {{ 'home.hero.title'|trans|default('Welcome to SymfoShop') }}
                </h1>
                <p class="text-xl sm:text-2xl text-primary-100 mb-8 max-w-3xl mx-auto animate-slide-up" style="animation-delay: 0.1s">
                    {{ 'home.hero.subtitle'|trans|default('Discover amazing products, shop with confidence, and enjoy fast shipping. Your one-stop shop for everything you need.') }}
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-slide-up" style="animation-delay: 0.2s">
                    <a href="#categories" 
                       class="bg-white text-primary-600 px-8 py-4 rounded-xl font-bold text-lg hover:bg-primary-50 transition-all duration-200 shadow-xl hover:shadow-2xl transform hover:-translate-y-1">
                        <i class="fas fa-shopping-bag mr-2"></i>
                        {{ 'home.hero.browse_categories'|trans|default('Browse Categories') }}
                    </a>
                    <a href="#featured" 
                       class="bg-primary-500 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-primary-400 transition-all duration-200 shadow-xl hover:shadow-2xl transform hover:-translate-y-1 border-2 border-white">
                        <i class="fas fa-star mr-2"></i>
                        {{ 'home.hero.view_featured'|trans|default('Featured Products') }}
                    </a>
                </div>
            </div>
        </div>
        
        {# Decorative wave #}
        <div class="absolute bottom-0 left-0 right-0">
            <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-12 lg:h-20">
                <path d="M0 120L60 105C120 90 240 60 360 45C480 30 600 30 720 37.5C840 45 960 60 1080 67.5C1200 75 1320 75 1380 75L1440 75V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="white"/>
            </svg>
        </div>
    </section>
    
    {# Trust Signals / Benefits #}
    <section class="bg-white py-12 border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="flex items-center gap-4 text-center sm:text-left">
                    <div class="flex-shrink-0 w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center">
                        <i class="fas fa-shipping-fast text-2xl text-primary-600"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-900">{{ 'home.benefits.fast_shipping'|trans|default('Fast Shipping') }}</h3>
                        <p class="text-sm text-gray-600">{{ 'home.benefits.fast_shipping_desc'|trans|default('Free shipping on orders over $50') }}</p>
                    </div>
                </div>
                
                <div class="flex items-center gap-4 text-center sm:text-left">
                    <div class="flex-shrink-0 w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                        <i class="fas fa-shield-alt text-2xl text-green-600"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-900">{{ 'home.benefits.secure_payment'|trans|default('Secure Payment') }}</h3>
                        <p class="text-sm text-gray-600">{{ 'home.benefits.secure_payment_desc'|trans|default('100% secure checkout') }}</p>
                    </div>
                </div>
                
                <div class="flex items-center gap-4 text-center sm:text-left">
                    <div class="flex-shrink-0 w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                        <i class="fas fa-undo text-2xl text-blue-600"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-900">{{ 'home.benefits.easy_returns'|trans|default('Easy Returns') }}</h3>
                        <p class="text-sm text-gray-600">{{ 'home.benefits.easy_returns_desc'|trans|default('30-day return policy') }}</p>
                    </div>
                </div>
                
                <div class="flex items-center gap-4 text-center sm:text-left">
                    <div class="flex-shrink-0 w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center">
                        <i class="fas fa-headset text-2xl text-purple-600"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-900">{{ 'home.benefits.support'|trans|default('24/7 Support') }}</h3>
                        <p class="text-sm text-gray-600">{{ 'home.benefits.support_desc'|trans|default('We\'re here to help') }}</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    {# Featured Products #}
    {% if featuredProducts is defined and featuredProducts|length > 0 %}
        <section id="featured" class="bg-gray-50 py-16">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
                        {{ 'home.featured.title'|trans|default('Featured Products') }}
                    </h2>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                        {{ 'home.featured.subtitle'|trans|default('Discover our handpicked selection of best-selling products') }}
                    </p>
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                    {% for product in featuredProducts %}
                        {% include 'components/product_card.html.twig' with {
                            product: product,
                            variant: product.variants|first
                        } %}
                    {% endfor %}
                </div>
                
                <div class="text-center">
                    <a href="{{ path('catalog_category', {slug: categories|first.slug}) }}" 
                       class="inline-flex items-center px-8 py-4 bg-primary-600 text-white rounded-xl font-semibold hover:bg-primary-700 transition-colors shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
                        {{ 'home.featured.view_all'|trans|default('View All Products') }}
                        <i class="fas fa-arrow-right ml-2"></i>
                    </a>
                </div>
            </div>
        </section>
    {% endif %}
    
    {# Categories Section #}
    <section id="categories" class="bg-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
                    {{ 'category.shop_by_category'|trans|default('Shop by Category') }}
                </h2>
                <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                    {{ 'category.browse_description'|trans|default('Explore our wide range of product categories') }}
                </p>
            </div>
            
            {% if categories|length > 0 %}
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">
                    {% for category in categories %}
                        <a href="{{ path('catalog_category', {slug: category.slug}) }}" 
                           class="group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 animate-slide-up" 
                           style="animation-delay: {{ loop.index0 * 0.1 }}s">
                            {# Category Image/Icon #}
                            <div class="h-48 bg-gradient-to-br from-primary-500 via-primary-600 to-primary-700 flex items-center justify-center relative overflow-hidden">
                                <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
                                <i class="fas fa-folder text-6xl text-white opacity-90 group-hover:scale-125 transition-transform duration-300 relative z-10"></i>
                                <div class="absolute bottom-0 left-0 right-0 h-1 bg-white transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300"></div>
                            </div>
                            
                            {# Category Info #}
                            <div class="p-6">
                                <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-primary-600 transition-colors">
                                    {{ category.name|escape }}
                                </h3>
                                
                                {% if category.children|length > 0 %}
                                    <div class="flex items-center text-sm text-gray-500 mb-4">
                                        <i class="fas fa-layer-group mr-2 text-primary-500"></i>
                                        <span>{{ category.children|length }} {{ category.children|length == 1 ? 'category.subcategory'|trans : 'category.subcategories'|trans }}</span>
                                    </div>
                                {% endif %}
                                
                                <div class="flex items-center text-primary-600 font-medium text-sm group-hover:translate-x-1 transition-transform">
                                    <span>{{ 'category.explore'|trans|default('Explore') }}</span>
                                    <i class="fas fa-arrow-right ml-2"></i>
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                {# Empty State #}
                <div class="bg-white rounded-2xl shadow-lg p-16 text-center animate-fade-in">
                    <div class="max-w-md mx-auto">
                        <i class="fas fa-inbox text-8xl text-gray-300 mb-6"></i>
                        <h2 class="text-2xl font-bold text-gray-900 mb-3">{{ 'category.no_categories_available'|trans|default('No Categories Available') }}</h2>
                        <p class="text-gray-600">{{ 'category.check_back_soon'|trans|default('Check back soon for new categories') }}</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
    
    {# CTA Section #}
    <section class="bg-gradient-to-r from-primary-600 to-primary-700 text-white py-16">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-3xl sm:text-4xl font-bold mb-4">
                {{ 'home.cta.title'|trans|default('Ready to Start Shopping?') }}
            </h2>
            <p class="text-xl text-primary-100 mb-8">
                {{ 'home.cta.subtitle'|trans|default('Join thousands of satisfied customers and discover amazing products today.') }}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                {% if categories|length > 0 %}
                    <a href="{{ path('catalog_category', {slug: categories|first.slug}) }}" 
                       class="bg-white text-primary-600 px-8 py-4 rounded-xl font-bold text-lg hover:bg-primary-50 transition-all duration-200 shadow-xl hover:shadow-2xl transform hover:-translate-y-1">
                        <i class="fas fa-shopping-bag mr-2"></i>
                        {{ 'home.cta.start_shopping'|trans|default('Start Shopping') }}
                    </a>
                {% endif %}
                {% if not app.user %}
                    <a href="{{ path('register') }}" 
                       class="bg-primary-500 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-primary-400 transition-all duration-200 shadow-xl hover:shadow-2xl transform hover:-translate-y-1 border-2 border-white">
                        <i class="fas fa-user-plus mr-2"></i>
                        {{ 'home.cta.create_account'|trans|default('Create Account') }}
                    </a>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
