{% extends 'base.html.twig' %}

{% block meta_description %}{{ theme_config().brand.tagline|default('home.hero.subtitle'|trans) }}{% endblock %}

{% block body %}
    {%- set section_context = {
        categories: categories|default([]),
        categoryChildrenCounts: categoryChildrenCounts|default({}),
        featuredProducts: featuredProducts|default([]),
    } -%}
    {%- set theme_sections = theme_config().homepage.sections|default([]) -%}

    {% if theme_sections is not empty %}
        {# Layout configured in the admin theme editor #}
        {% for section in theme_sections %}
            {{ render_section(section, section_context) }}
        {% endfor %}
    {% else %}
        {{ render_section({type: 'hero', settings: {}}, section_context) }}
        {{ render_section({type: 'category_grid', settings: {}}, section_context) }}
        {{ render_section({type: 'featured_products', settings: {limit: 8}}, section_context) }}
        {% if not app.user %}
            {{ render_section({type: 'newsletter', settings: {}}, section_context) }}
        {% endif %}
    {% endif %}

    {% include 'components/recently_viewed_products.html.twig' with {recentlyViewedProducts: recentlyViewedProducts|default([])} %}
{% endblock %}
