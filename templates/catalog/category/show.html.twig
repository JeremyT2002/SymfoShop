{% extends 'catalog/base.html.twig' %}

{% block page_title %}{{ category.name|escape }} - SymfoShop{% endblock %}
{% block page_meta_description %}Browse products in {{ category.name|escape }}{% endblock %}

{% block meta_tags %}
    <meta property="og:title" content="{{ category.name|escape }} - SymfoShop">
    <meta property="og:description" content="Browse products in {{ category.name|escape }}">
{% endblock %}

{% block catalog_body %}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {# Breadcrumbs #}
        {% include 'components/breadcrumbs.html.twig' with {
            items: [
                {label: 'nav.home'|trans, url: path('catalog_home')},
                {label: category.name|escape, url: null}
            ]
        } %}
        
        {# Category Header #}
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-4">{{ category.name|escape }}</h1>
            
            {% if category.parent %}
                <div class="inline-flex items-center px-4 py-2 bg-primary-50 border border-primary-200 rounded-xl text-sm text-primary-700 mb-4">
                    <i class="fas fa-arrow-up mr-2"></i>
                    <span>{{ 'category.parent_category'|trans }}:</span>
                    <a href="{{ path('catalog_category', {slug: category.parent.slug}) }}" 
                       class="ml-2 font-semibold hover:text-primary-800 transition-colors">
                        {{ category.parent.name|escape }}
                    </a>
                </div>
            {% endif %}
            
            {% if category.children|length > 0 %}
                <div class="mt-4">
                    <h2 class="text-sm font-semibold text-gray-700 mb-2">{{ 'category.subcategories'|trans }}</h2>
                    <div class="flex flex-wrap gap-2">
                        {% for child in category.children %}
                            <a href="{{ path('catalog_category', {slug: child.slug}) }}" 
                               class="px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-primary-50 hover:border-primary-300 hover:text-primary-700 transition-colors">
                                {{ child.name|escape }}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
        
        {# Filters & Sort Bar #}
        <div class="bg-white rounded-xl shadow-md p-4 mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <span class="text-sm font-medium text-gray-700">{{ 'category.showing'|trans }} {{ products|length }} {{ 'category.of'|trans }} {{ totalProducts }} {{ totalProducts != 1 ? 'category.products'|trans : 'category.product'|trans }}</span>
            </div>
            
            {# Sort Options (placeholder for future implementation) #}
            <div class="flex items-center gap-2">
                <label for="sort-select" class="text-sm text-gray-600">{{ 'category.sort_by'|trans }}:</label>
                <select id="sort-select" 
                        class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white">
                    <option value="default">{{ 'category.sort.default'|trans }}</option>
                    <option value="price-asc">{{ 'category.sort.price_low'|trans }}</option>
                    <option value="price-desc">{{ 'category.sort.price_high'|trans }}</option>
                    <option value="name-asc">{{ 'category.sort.name_az'|trans }}</option>
                    <option value="name-desc">{{ 'category.sort.name_za'|trans }}</option>
                </select>
            </div>
        </div>
        
        {# Products Grid #}
        {% if products|length > 0 %}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8">
                {% for product in products %}
                    {% include 'components/product_card.html.twig' with {
                        product: product,
                        variant: product.variants|first
                    } %}
                {% endfor %}
            </div>
            
            {# Pagination #}
            {% if totalPages > 1 %}
                {% include 'components/pagination.html.twig' with {
                    currentPage: currentPage,
                    totalPages: totalPages,
                    route: 'catalog_category',
                    routeParams: {slug: category.slug}
                } %}
            {% endif %}
        {% else %}
            {# Empty State #}
            <div class="bg-white rounded-2xl shadow-lg p-16 text-center">
                <div class="max-w-md mx-auto">
                    <i class="fas fa-box-open text-8xl text-gray-300 mb-6"></i>
                    <h2 class="text-2xl font-bold text-gray-900 mb-3">{{ 'category.no_products'|trans }}</h2>
                    <p class="text-gray-600 mb-6">{{ 'category.check_back_soon'|trans }}</p>
                    <a href="{{ path('catalog_home') }}" 
                       class="inline-flex items-center px-6 py-3 bg-primary-600 text-white rounded-xl font-semibold hover:bg-primary-700 transition-colors">
                        <i class="fas fa-arrow-left mr-2"></i>
                        {{ 'category.back_to_categories'|trans }}
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
