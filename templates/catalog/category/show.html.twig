{% extends 'base.html.twig' %}

{%- set seo_title = category|tr('seoTitle')|default(category|tr('name')) -%}
{%- set seo_description = category|tr('seoDescription')|default('ui.category.meta_description'|trans({'%category%': category|tr('name')}))|slice(0, 160) -%}

{% block page_title %}{{ seo_title }}{% endblock %}
{% block meta_description %}{{ seo_description }}{% endblock %}

{% block robots_meta %}
    {%- set noIndex = theme_config().seo.defaultNoIndex|default(false) or category.seoNoIndex|default(false) -%}
    {# Filtered listings are near-duplicates: keep them out of the index but let crawlers follow product links #}
    <meta name="robots" content="{{ noIndex ? 'noindex,nofollow' : (filters.hasAnyFilter ? 'noindex,follow' : 'index,follow') }}">
{% endblock %}

{% block meta_tags %}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ seo_title }}">
    <meta property="og:description" content="{{ seo_description }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ seo_title }}">
    <meta name="twitter:description" content="{{ seo_description }}">
{% endblock %}

{% block body %}
<div class="container-page py-8 lg:py-12" x-data="{ filtersOpen: false }" @keydown.escape.window="filtersOpen = false">
    {%- set crumbs = [{label: 'nav.home'|trans, url: path('catalog_home')}] -%}
    {%- if category.parent -%}
        {%- set crumbs = crumbs|merge([{label: category.parent|tr('name'), url: path('catalog_category', {slug: category.parent.slug})}]) -%}
    {%- endif -%}
    {% include 'components/breadcrumbs.html.twig' with {items: crumbs|merge([{label: category|tr('name'), url: null}])} %}

    <header class="flex flex-col gap-6 border-b border-line pb-8">
        <div>
            <h1 class="text-3xl font-semibold sm:text-4xl">{{ category|tr('name') }}</h1>
            <p class="mt-2 text-sm text-fg-muted">
                {{ totalProducts }} {{ totalProducts == 1 ? 'category.product'|trans : 'category.products'|trans }}
            </p>
        </div>

        {% if category.children is not empty %}
            <nav class="-mx-4 flex gap-2 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:px-0" aria-label="{{ 'category.subcategories'|trans }}">
                {% for child in category.children %}
                    <a href="{{ path('catalog_category', {slug: child.slug}) }}"
                       class="shrink-0 rounded-full border border-line-strong px-4 py-1.5 text-sm font-medium text-fg-muted transition hover:border-fg hover:text-fg">{{ child|tr('name') }}</a>
                {% endfor %}
            </nav>
        {% endif %}
    </header>

    {# Toolbar #}
    <div class="flex flex-wrap items-center justify-between gap-3 py-5">
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-secondary btn-sm lg:hidden" @click="filtersOpen = true">
                {{ ux_icon('lucide:sliders-horizontal', {class: 'size-4'}) }}{{ 'category.filters.title'|trans }}
            </button>

            {# Active filters #}
            {% if filters.minPrice is not null or filters.maxPrice is not null %}
                <a href="{{ path('catalog_category', routeParams|merge({min_price: null, max_price: null, page: null})) }}" class="badge badge-neutral py-1 hover:ring-line-strong">
                    {{ (filters.minPrice ?? filterOptions.price_min)|money }} – {{ (filters.maxPrice ?? filterOptions.price_max)|money }}
                    {{ ux_icon('lucide:x', {class: 'size-3'}) }}<span class="sr-only">{{ 'ui.filters.remove'|trans }}</span>
                </a>
            {% endif %}
            {% if filters.inStockOnly %}
                <a href="{{ path('catalog_category', routeParams|merge({in_stock: null, page: null})) }}" class="badge badge-neutral py-1 hover:ring-line-strong">
                    {{ 'category.filters.in_stock'|trans }}{{ ux_icon('lucide:x', {class: 'size-3'}) }}<span class="sr-only">{{ 'ui.filters.remove'|trans }}</span>
                </a>
            {% endif %}
            {% for badge in attributeBadges %}
                <a href="{{ badge.removeUrl }}" class="badge badge-neutral py-1 hover:ring-line-strong">
                    {{ badge.label }}{{ ux_icon('lucide:x', {class: 'size-3'}) }}<span class="sr-only">{{ 'ui.filters.remove'|trans }}</span>
                </a>
            {% endfor %}
            {% if filters.hasAnyFilter %}
                <a href="{{ path('catalog_category', {slug: category.slug}) }}" class="text-sm font-medium text-fg-muted underline-offset-4 hover:text-fg hover:underline">{{ 'category.filters.clear_all'|trans }}</a>
            {% endif %}
        </div>

        <form method="get" action="{{ path('catalog_category', {slug: category.slug}) }}" class="flex items-center gap-2">
            {% for key, value in routeParams %}
                {% if key not in ['slug', 'sort', 'page'] and value is not null and value is not same as('') %}
                    {% if value is iterable %}
                        {% for v in value %}<input type="hidden" name="{{ key }}[]" value="{{ v }}">{% endfor %}
                    {% else %}
                        <input type="hidden" name="{{ key }}" value="{{ value }}">
                    {% endif %}
                {% endif %}
            {% endfor %}
            <label for="sort-select" class="text-sm text-fg-muted">{{ 'category.sort_by'|trans }}</label>
            <select name="sort" id="sort-select" class="select w-auto py-2" onchange="this.form.requestSubmit()">
                {% for value, label in {
                    'default': 'category.sort.default', 'price-asc': 'category.sort.price_low', 'price-desc': 'category.sort.price_high',
                    'name-asc': 'category.sort.name_az', 'name-desc': 'category.sort.name_za'
                } %}
                    <option value="{{ value }}" {{ filters.sort == value ? 'selected' }}>{{ label|trans }}</option>
                {% endfor %}
            </select>
            <noscript><button class="btn btn-secondary btn-sm">{{ 'category.filters.apply'|trans }}</button></noscript>
        </form>
    </div>

    <div class="grid gap-10 lg:grid-cols-[15rem_1fr]">
        <aside class="hidden lg:block" aria-label="{{ 'category.filters.title'|trans }}">
            <div class="sticky top-28">
                {% include 'catalog/category/_filter_form.html.twig' with {id_prefix: 'sidebar'} %}
            </div>
        </aside>

        <div>
            {% if products is not empty %}
                <div class="grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 xl:grid-cols-3">
                    {% for product in products %}
                        {% include 'components/product_card.html.twig' with {product: product, eager: loop.index <= 3} only %}
                    {% endfor %}
                </div>
                {% include 'components/pagination.html.twig' with {currentPage: currentPage, totalPages: totalPages, route: 'catalog_category', routeParams: routeParams} only %}
            {% else %}
                {% include 'components/empty_state.html.twig' with {
                    icon: 'lucide:search-x',
                    title: 'category.no_products_match'|trans,
                    text: 'category.try_adjust_filters'|trans,
                    action: filters.hasAnyFilter ? {label: 'category.filters.clear_all'|trans, url: path('catalog_category', {slug: category.slug})} : false,
                } only %}
            {% endif %}
        </div>
    </div>

    {# Mobile filter drawer #}
    <div x-cloak x-show="filtersOpen" class="fixed inset-0 z-50 lg:hidden" role="dialog" aria-modal="true" aria-labelledby="filter-drawer-title">
        <div x-show="filtersOpen" x-transition.opacity class="absolute inset-0 bg-black/40" @click="filtersOpen = false"></div>
        <div x-show="filtersOpen" x-trap.inert.noscroll="filtersOpen"
             x-transition:enter="transition duration-200 ease-out" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
             x-transition:leave="transition duration-150 ease-in" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
             class="absolute inset-y-0 right-0 flex w-[90%] max-w-sm flex-col bg-panel shadow-xl">
            <div class="flex h-16 items-center justify-between border-b border-line px-5">
                <h2 id="filter-drawer-title" class="font-semibold">{{ 'category.filters.title'|trans }}</h2>
                <button type="button" class="btn btn-ghost btn-icon -mr-2" @click="filtersOpen = false" aria-label="{{ 'common.close'|trans }}">{{ ux_icon('lucide:x', {class: 'size-5'}) }}</button>
            </div>
            <div class="flex-1 overflow-y-auto p-5">
                {% include 'catalog/category/_filter_form.html.twig' with {id_prefix: 'drawer'} %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
