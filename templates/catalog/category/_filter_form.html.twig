{#
  Category filters (GET form, used in the desktop sidebar and the mobile drawer).
  Prices are entered in currency units and submitted in cents (min_price/max_price), which the backend expects.
#}
{%- set min_cents = filters.minPrice ?? null -%}
{%- set max_cents = filters.maxPrice ?? null -%}
<form method="get" action="{{ path('catalog_category', {slug: category.slug}) }}" class="space-y-8"
      x-data="{
          min: '{{ min_cents is not null ? (min_cents / 100)|round : '' }}',
          max: '{{ max_cents is not null ? (max_cents / 100)|round : '' }}',
          cents(v) { return v === '' || v === null ? '' : Math.round(parseFloat(String(v).replace(',', '.')) * 100) }
      }">
    {% if filters.sort != 'default' %}
        <input type="hidden" name="sort" value="{{ filters.sort }}">
    {% endif %}

    <fieldset>
        <legend class="text-sm font-semibold">{{ 'category.filters.price_range'|trans }}</legend>
        <div class="mt-3 flex items-center gap-2">
            <label class="sr-only" for="{{ id_prefix }}-min-price">{{ 'category.filters.min_price'|trans }}</label>
            <input id="{{ id_prefix }}-min-price" type="number" min="0" step="1" inputmode="numeric" x-model="min"
                   placeholder="{{ (filterOptions.price_min / 100)|round(0, 'floor') }}" class="input">
            <span class="text-fg-subtle">–</span>
            <label class="sr-only" for="{{ id_prefix }}-max-price">{{ 'category.filters.max_price'|trans }}</label>
            <input id="{{ id_prefix }}-max-price" type="number" min="0" step="1" inputmode="numeric" x-model="max"
                   placeholder="{{ (filterOptions.price_max / 100)|round(0, 'ceil') }}" class="input">
        </div>
        <input type="hidden" name="min_price" :value="cents(min)" :disabled="min === ''">
        <input type="hidden" name="max_price" :value="cents(max)" :disabled="max === ''">
    </fieldset>

    <fieldset>
        <legend class="sr-only">{{ 'category.filters.in_stock'|trans }}</legend>
        <label class="flex cursor-pointer items-center justify-between gap-3 text-sm font-semibold">
            {{ 'category.filters.in_stock_only'|trans }}
            <input type="checkbox" name="in_stock" value="1" class="peer sr-only" {{ filters.inStockOnly ? 'checked' }}>
            <span class="relative h-6 w-10 rounded-full bg-line-strong transition peer-checked:bg-primary-600 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary-500 after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-4"></span>
        </label>
    </fieldset>

    {% for attrKey, valueCounts in filterOptions.attributes %}
        {%- set current = filters.attributeFilters[attrKey] ?? [] -%}
        <fieldset x-data="{ open: {{ current is not empty or loop.index <= 3 ? 'true' : 'false' }} }" class="border-t border-line pt-6">
            <legend class="w-full">
                <button type="button" class="flex w-full items-center justify-between text-sm font-semibold" @click="open = !open" :aria-expanded="open">
                    {{ attrKey|capitalize }}
                    <span class="inline-flex shrink-0 transition" :class="open && 'rotate-180'">{{ ux_icon('lucide:chevron-down', {class: 'size-4 transition'}) }}</span>
                </button>
            </legend>
            <div x-show="open" x-collapse class="mt-3 max-h-56 space-y-2.5 overflow-y-auto">
                {% for value, count in valueCounts|sort %}
                    <label class="flex cursor-pointer items-center gap-3 text-sm">
                        <input type="checkbox" name="attr_{{ attrKey }}[]" value="{{ value }}" class="checkbox" {{ value in current ? 'checked' }}>
                        <span class="flex-1 text-fg-muted">{{ value }}</span>
                        <span class="text-xs text-fg-subtle tabular-nums">{{ count }}</span>
                    </label>
                {% endfor %}
            </div>
        </fieldset>
    {% endfor %}

    <div class="flex gap-2 border-t border-line pt-6">
        <button type="submit" class="btn btn-primary flex-1">{{ 'category.filters.apply'|trans }}</button>
        {% if filters.hasAnyFilter %}
            <a href="{{ path('catalog_category', {slug: category.slug}) }}" class="btn btn-ghost">{{ 'category.filters.clear_all'|trans }}</a>
        {% endif %}
    </div>
</form>
