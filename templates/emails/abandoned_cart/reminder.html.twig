<h2>{{ 'email.abandoned_cart.title'|trans }}</h2>
<p>{{ 'email.abandoned_cart.intro'|trans }}</p>
<ul>
    {% for item in cart.items %}
        <li>{{ item.productVariant.product|tr('name') }} ({{ item.quantity }})</li>
    {% endfor %}
</ul>
<p>
    <a href="{{ url('cart_show') }}">{{ 'email.abandoned_cart.cta'|trans }}</a>
</p>
<p>
    <a href="{{ optOutUrl }}">{{ 'email.abandoned_cart.opt_out'|trans }}</a>
</p>

