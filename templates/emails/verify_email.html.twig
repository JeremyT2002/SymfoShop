<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<body style="margin:0;padding:24px;background:#f4f4f5;font-family:Inter,Arial,sans-serif;color:#18181b;">
    <div style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:16px;padding:32px;">
        <h1 style="margin:0 0 16px;font-size:22px;">{{ 'ui.verify.mail_heading'|trans }}</h1>
        <p style="margin:0 0 24px;line-height:1.6;color:#52525b;">
            {{ 'ui.verify.mail_text'|trans({'%name%': user.firstName ?: user.email}) }}
        </p>
        <p style="margin:0 0 24px;">
            <a href="{{ verifyUrl }}" style="display:inline-block;background:#18181b;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:8px;font-weight:600;">
                {{ 'ui.verify.mail_button'|trans }}
            </a>
        </p>
        <p style="margin:0;font-size:13px;line-height:1.6;color:#71717a;">{{ 'ui.verify.mail_footer'|trans }}</p>
    </div>
</body>
</html>
