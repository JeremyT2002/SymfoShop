<!DOCTYPE html>
<html lang="{{ locale }}">
<body style="margin:0;padding:24px;background:#f4f4f5;font-family:Inter,Arial,sans-serif;color:#18181b;">
    <div style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:16px;padding:32px;">
        <h1 style="margin:0 0 12px;font-size:22px;">{{ 'ui.refund.mail_heading'|trans({}, null, locale) }}</h1>
        <p style="margin:0 0 20px;line-height:1.6;color:#52525b;">
            {{ 'ui.refund.mail_text'|trans({
                '%name%': order.firstName ?: order.email,
                '%amount%': refund.amount|money(refund.currency, locale),
                '%number%': order.orderNumber,
            }, null, locale) }}
        </p>

        <p style="margin:0 0 20px;padding:16px;background:#f4f4f5;border-radius:12px;line-height:1.6;">
            <strong>{{ 'ui.refund.credit_note_number'|trans({}, null, locale) }}:</strong> {{ refund.creditNoteNumber }}<br>
            <strong>{{ 'ui.refund.amount'|trans({}, null, locale) }}:</strong> {{ refund.amount|money(refund.currency, locale) }}
            {% if refund.reason %}<br><strong>{{ 'ui.refund.reason'|trans({}, null, locale) }}:</strong> {{ refund.reason }}{% endif %}
        </p>

        <p style="margin:0;font-size:13px;line-height:1.6;color:#71717a;">
            {{ (refund.provider == 'manual' ? 'ui.refund.mail_manual' : 'ui.refund.mail_provider')|trans({}, null, locale) }}
        </p>
    </div>
</body>
</html>
