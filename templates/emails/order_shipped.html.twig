<!DOCTYPE html>
<html lang="{{ locale }}">
<body style="margin:0;padding:24px;background:#f4f4f5;font-family:Inter,Arial,sans-serif;color:#18181b;">
    <div style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:16px;padding:32px;">
        <h1 style="margin:0 0 12px;font-size:22px;">{{ 'ui.order_mail.shipped_heading'|trans({}, null, locale) }}</h1>
        <p style="margin:0 0 20px;line-height:1.6;color:#52525b;">
            {{ 'ui.order_mail.shipped_text'|trans({'%name%': order.firstName ?: order.email, '%number%': order.orderNumber}, null, locale) }}
        </p>

        {% if order.trackingNumber %}
            <p style="margin:0 0 20px;padding:16px;background:#f4f4f5;border-radius:12px;line-height:1.6;">
                <strong>{{ 'ui.order_status.tracking'|trans({}, null, locale) }}:</strong>
                {{ order.carrier ? order.carrier ~ ' · ' : '' }}{{ order.trackingNumber }}
            </p>
            {% if trackingUrl %}
                <p style="margin:0 0 24px;">
                    <a href="{{ trackingUrl }}" style="display:inline-block;background:#18181b;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:8px;font-weight:600;">
                        {{ 'ui.order_status.track_parcel'|trans({}, null, locale) }}
                    </a>
                </p>
            {% endif %}
        {% endif %}

        <table style="width:100%;border-collapse:collapse;font-size:14px;margin:0 0 20px;">
            {% for item in order.items %}
                <tr>
                    <td style="padding:8px 0;border-bottom:1px solid #e4e4e7;">{{ item.quantity }} × {{ item.nameSnapshot }}</td>
                </tr>
            {% endfor %}
        </table>

        {% if order.shippingStreet %}
            <p style="margin:0 0 20px;line-height:1.6;color:#52525b;font-size:14px;">
                <strong style="color:#18181b;">{{ 'ui.order.shipping_address'|trans({}, null, locale) }}</strong><br>
                {% include 'components/_address.html.twig' with {order: order} only %}
            </p>
        {% endif %}

        <p style="margin:0;font-size:13px;color:#71717a;">
            <a href="{{ url('order_status', {number: order.orderNumber}) }}" style="color:#52525b;">{{ 'ui.order_status.view_status'|trans({}, null, locale) }}</a>
        </p>
    </div>
</body>
</html>
