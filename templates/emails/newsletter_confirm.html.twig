{%- set locale = subscriber.locale -%}
<!DOCTYPE html>
<html lang="{{ locale }}">
<body style="margin:0;padding:24px;background:#f4f4f5;font-family:Inter,Arial,sans-serif;color:#18181b;">
    <div style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:16px;padding:32px;">
        <h1 style="margin:0 0 16px;font-size:22px;">{{ 'ui.newsletter.mail_heading'|trans({}, null, locale) }}</h1>
        <p style="margin:0 0 24px;line-height:1.6;color:#52525b;">{{ 'ui.newsletter.mail_text'|trans({}, null, locale) }}</p>
        <p style="margin:0 0 24px;">
            <a href="{{ url('newsletter_confirm', {token: subscriber.token}) }}" style="display:inline-block;background:#18181b;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:8px;font-weight:600;">
                {{ 'ui.newsletter.mail_button'|trans({}, null, locale) }}
            </a>
        </p>
        <p style="margin:0;font-size:13px;line-height:1.6;color:#71717a;">{{ 'ui.newsletter.mail_footer'|trans({}, null, locale) }}</p>
    </div>
</body>
</html>
