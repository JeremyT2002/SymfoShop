{#
  Modern Base Layout Template
  ===========================

  A clean, accessible, and modern base layout with:
  - Mobile-first responsive design
  - Accessibility features (ARIA, skip links, focus management)
  - Clean component structure
  - Alpine.js for lightweight interactions
  - Modern color palette and typography
#}

<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}" class="h-full scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% block meta_description %}SymfoShop - Your modern e-commerce destination{% endblock %}">

    <!-- SEO Meta Tags -->
    <meta name="robots" content="index, follow">
    <meta name="author" content="SymfoShop">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
    <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/og-default.jpg')) }}{% endblock %}">

    <title>{% block title %}SymfoShop{% endblock %}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Custom Tailwind Config -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                        },
                        neutral: {
                            50: '#fafafa',
                            100: '#f5f5f5',
                            200: '#e5e5e5',
                            300: '#d4d4d4',
                            400: '#a3a3a3',
                            500: '#737373',
                            600: '#525252',
                            700: '#404040',
                            800: '#262626',
                            900: '#171717',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    },
                    spacing: {
                        '18': '4.5rem',
                        '88': '22rem',
                    },
                    borderRadius: {
                        '4xl': '2rem',
                    },
                    boxShadow: {
                        'soft': '0 2px 15px -3px rgba(0, 0, 0, 0.07), 0 10px 20px -2px rgba(0, 0, 0, 0.04)',
                        'medium': '0 4px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)',
                        'large': '0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)',
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-out',
                        'slide-up': 'slideUp 0.6s ease-out',
                        'slide-in-right': 'slideInRight 0.4s ease-out',
                        'bounce-subtle': 'bounceSubtle 2s infinite',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { transform: 'translateY(20px)', opacity: '0' },
                            '100%': { transform: 'translateY(0)', opacity: '1' },
                        },
                        slideInRight: {
                            '0%': { transform: 'translateX(20px)', opacity: '0' },
                            '100%': { transform: 'translateX(0)', opacity: '1' },
                        },
                        bounceSubtle: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-5px)' },
                        },
                    },
                },
            },
        }
    </script>

    {% block stylesheets %}{% endblock %}
</head>
<body class="min-h-screen bg-neutral-50 text-neutral-900 antialiased">
    <!-- Skip to main content (accessibility) -->
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-primary-600 text-white px-4 py-2 rounded-lg z-50 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">
        Skip to main content
    </a>

    <!-- Header -->
    <header class="bg-white border-b border-neutral-200 sticky top-0 z-40 shadow-soft">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 lg:h-20">
                <!-- Logo -->
                <div class="flex items-center">
                    <a href="{{ path('catalog_home') }}"
                       class="flex items-center space-x-3 group focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 rounded-lg p-1"
                       aria-label="SymfoShop Home">
                        <div class="w-8 h-8 lg:w-10 lg:h-10 bg-primary-600 rounded-xl flex items-center justify-center group-hover:bg-primary-700 transition-colors">
                            <i class="fas fa-shopping-bag text-white text-sm lg:text-base"></i>
                        </div>
                        <span class="text-xl lg:text-2xl font-bold text-neutral-900 group-hover:text-primary-600 transition-colors">
                            SymfoShop
                        </span>
                    </a>
                </div>

                <!-- Desktop Navigation -->
                <nav class="hidden lg:flex items-center space-x-8" role="navigation" aria-label="Main navigation">
                    <a href="{{ path('catalog_home') }}"
                       class="text-neutral-700 hover:text-primary-600 px-3 py-2 text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
                       {{ app.request.get('_route') == 'catalog_home' ? 'aria-current="page"' }}>
                        <i class="fas fa-home mr-2" aria-hidden="true"></i>
                        {{ 'nav.home'|trans }}
                    </a>

                    {% if app.user %}
                        <a href="{{ path('cart_show') }}"
                           class="text-neutral-700 hover:text-primary-600 px-3 py-2 text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">
                            <i class="fas fa-shopping-cart mr-2" aria-hidden="true"></i>
                            {{ 'nav.cart'|trans }}
                        </a>
                    {% endif %}
                </nav>

                <!-- Right side actions -->
                <div class="flex items-center space-x-3">
                    <!-- Language Switcher -->
                    <div class="hidden sm:block">
                        <select id="language-switcher"
                                class="bg-neutral-50 border border-neutral-300 text-neutral-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
                                aria-label="Select language">
                            <option value="en" {{ app.request.locale == 'en' ? 'selected' }}>🇬🇧 EN</option>
                            <option value="de" {{ app.request.locale == 'de' ? 'selected' }}>🇩🇪 DE</option>
                            <option value="fr" {{ app.request.locale == 'fr' ? 'selected' }}>🇫🇷 FR</option>
                        </select>
                    </div>

                    <!-- User Menu -->
                    {% if app.user %}
                        <div class="relative" x-data="{ open: false }" @keydown.escape="open = false">
                            <button @click="open = !open"
                                    class="flex items-center space-x-2 text-neutral-700 hover:text-primary-600 p-2 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
                                    aria-expanded="false"
                                    :aria-expanded="open"
                                    aria-haspopup="true">
                                <div class="w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center">
                                    <i class="fas fa-user text-primary-600 text-sm"></i>
                                </div>
                                <span class="hidden sm:block text-sm font-medium">{{ app.user.email }}</span>
                                <i class="fas fa-chevron-down text-xs transition-transform" :class="open ? 'rotate-180' : ''" aria-hidden="true"></i>
                            </button>

                            <div x-show="open"
                                 @click.away="open = false"
                                 x-transition:enter="transition ease-out duration-100"
                                 x-transition:enter-start="transform opacity-0 scale-95"
                                 x-transition:enter-end="transform opacity-100 scale-100"
                                 x-transition:leave="transition ease-in duration-75"
                                 x-transition:leave-start="transform opacity-100 scale-100"
                                 x-transition:leave-end="transform opacity-0 scale-95"
                                 class="absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-medium border border-neutral-200 py-1 z-50"
                                 role="menu"
                                 aria-orientation="vertical">
                                <a href="{{ path('admin') }}"
                                   class="flex items-center px-4 py-2 text-sm text-neutral-700 hover:bg-neutral-50 hover:text-primary-600 transition-colors"
                                   role="menuitem">
                                    <i class="fas fa-cog mr-3 text-neutral-400" aria-hidden="true"></i>
                                    {{ 'nav.admin'|trans }}
                                </a>
                                <hr class="my-1 border-neutral-200">
                                <a href="{{ path('logout') }}"
                                   class="flex items-center px-4 py-2 text-sm text-neutral-700 hover:bg-red-50 hover:text-red-600 transition-colors"
                                   role="menuitem">
                                    <i class="fas fa-sign-out-alt mr-3 text-neutral-400" aria-hidden="true"></i>
                                    {{ 'nav.logout'|trans }}
                                </a>
                            </div>
                        </div>
                    {% else %}
                        <div class="flex items-center space-x-2">
                            <a href="{{ path('login') }}"
                               class="text-neutral-700 hover:text-primary-600 px-3 py-2 text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">
                                {{ 'nav.login'|trans }}
                            </a>
                            <a href="{{ path('register') }}"
                               class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 shadow-sm">
                                {{ 'nav.register'|trans }}
                            </a>
                        </div>
                    {% endif %}

                    <!-- Mobile menu button -->
                    <button class="lg:hidden p-2 text-neutral-700 hover:text-primary-600 hover:bg-neutral-100 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
                            aria-expanded="false"
                            aria-label="Open main menu"
                            onclick="toggleMobileMenu()">
                        <i class="fas fa-bars text-lg" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile menu -->
        <div id="mobile-menu" class="lg:hidden hidden bg-white border-t border-neutral-200 shadow-medium">
            <div class="px-4 py-6 space-y-4">
                <a href="{{ path('catalog_home') }}"
                   class="flex items-center text-neutral-700 hover:text-primary-600 px-3 py-2 text-base font-medium rounded-lg transition-colors">
                    <i class="fas fa-home mr-3" aria-hidden="true"></i>
                    {{ 'nav.home'|trans }}
                </a>

                {% if app.user %}
                    <a href="{{ path('cart_show') }}"
                       class="flex items-center text-neutral-700 hover:text-primary-600 px-3 py-2 text-base font-medium rounded-lg transition-colors">
                        <i class="fas fa-shopping-cart mr-3" aria-hidden="true"></i>
                        {{ 'nav.cart'|trans }}
                    </a>
                {% endif %}

                <div class="border-t border-neutral-200 pt-4">
                    <select id="mobile-language-switcher"
                            class="w-full bg-neutral-50 border border-neutral-300 text-neutral-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                            aria-label="Select language">
                        <option value="en" {{ app.request.locale == 'en' ? 'selected' }}>🇬🇧 English</option>
                        <option value="de" {{ app.request.locale == 'de' ? 'selected' }}>🇩🇪 Deutsch</option>
                        <option value="fr" {{ app.request.locale == 'fr' ? 'selected' }}>🇫🇷 Français</option>
                    </select>
                </div>
            </div>
        </div>
    </header>

    <!-- Flash Messages -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6" x-data="{ show: true }" x-show="show" x-transition>
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                {% include 'components/alert.html.twig' with {
                    type: label == 'success' ? 'success' : (label == 'error' ? 'error' : 'info'),
                    dismissible: true,
                    content: message
                } %}
            {% endfor %}
        {% endfor %}
    </div>

    <!-- Main Content -->
    <main id="main-content" class="flex-1">
        {% block body %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="bg-neutral-900 text-neutral-300 mt-16" role="contentinfo">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
                <!-- Brand -->
                <div class="lg:col-span-1">
                    <div class="flex items-center space-x-3 mb-6">
                        <div class="w-10 h-10 bg-primary-600 rounded-xl flex items-center justify-center">
                            <i class="fas fa-shopping-bag text-white"></i>
                        </div>
                        <span class="text-xl font-bold text-white">SymfoShop</span>
                    </div>
                    <p class="text-neutral-400 text-sm leading-relaxed mb-6">
                        {{ 'footer.description'|trans }}
                    </p>
                    <div class="flex space-x-4">
                        <a href="#" class="text-neutral-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded-lg p-2" aria-label="Follow us on Twitter">
                            <i class="fab fa-twitter text-lg"></i>
                        </a>
                        <a href="#" class="text-neutral-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded-lg p-2" aria-label="Follow us on Facebook">
                            <i class="fab fa-facebook text-lg"></i>
                        </a>
                        <a href="#" class="text-neutral-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded-lg p-2" aria-label="Follow us on Instagram">
                            <i class="fab fa-instagram text-lg"></i>
                        </a>
                    </div>
                </div>

                <!-- Shop -->
                <div>
                    <h3 class="text-white font-semibold mb-6">{{ 'footer.shop'|trans }}</h3>
                    <ul class="space-y-3 text-sm">
                        <li>
                            <a href="{{ path('catalog_home') }}" class="text-neutral-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded px-2 py-1">
                                {{ 'footer.categories'|trans }}
                            </a>
                        </li>
                        {% if app.user %}
                            <li>
                                <a href="{{ path('cart_show') }}" class="text-neutral-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded px-2 py-1">
                                    {{ 'footer.cart'|trans }}
                                </a>
                            </li>
                        {% endif %}
                        <li>
                            <a href="#" class="text-neutral-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded px-2 py-1">
                                {{ 'footer.wishlist'|trans }}
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Account -->
                <div>
                    <h3 class="text-white font-semibold mb-6">{{ 'footer.account'|trans }}</h3>
                    <ul class="space-y-3 text-sm">
                        {% if app.user %}
                            <li>
                                <a href="{{ path('admin') }}" class="text-neutral-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded px-2 py-1">
                                    {{ 'footer.account_settings'|trans }}
                                </a>
                            </li>
                        {% else %}
                            <li>
                                <a href="{{ path('login') }}" class="text-neutral-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded px-2 py-1">
                                    {{ 'footer.login'|trans }}
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('register') }}" class="text-neutral-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded px-2 py-1">
                                    {{ 'footer.register'|trans }}
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>

                <!-- Support -->
                <div>
                    <h3 class="text-white font-semibold mb-6">{{ 'footer.support'|trans }}</h3>
                    <ul class="space-y-3 text-sm">
                        <li>
                            <a href="#" class="text-neutral-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded px-2 py-1">
                                {{ 'footer.contact'|trans }}
                            </a>
                        </li>
                        <li>
                            <a href="#" class="text-neutral-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded px-2 py-1">
                                {{ 'footer.faq'|trans }}
                            </a>
                        </li>
                        <li>
                            <a href="#" class="text-neutral-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded px-2 py-1">
                                {{ 'footer.shipping'|trans }}
                            </a>
                        </li>
                        <li>
                            <a href="#" class="text-neutral-400 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded px-2 py-1">
                                {{ 'footer.returns'|trans }}
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Bottom section -->
            <div class="border-t border-neutral-800 mt-12 pt-8">
                <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
                    <p class="text-neutral-400 text-sm">
                        &copy; {{ 'now'|date('Y') }} SymfoShop. {{ 'footer.rights'|trans }}
                    </p>
                    <div class="flex items-center space-x-6 text-sm text-neutral-400">
                        <a href="#" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded px-2 py-1">
                            {{ 'footer.privacy'|trans }}
                        </a>
                        <a href="#" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded px-2 py-1">
                            {{ 'footer.terms'|trans }}
                        </a>
                        <a href="#" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 focus:ring-offset-neutral-900 rounded px-2 py-1">
                            {{ 'footer.cookies'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Alpine.js for interactions -->
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>

    <!-- Custom JavaScript -->
    <script>
        // Language switcher functionality
        function setupLanguageSwitcher() {
            const switchers = ['language-switcher', 'mobile-language-switcher'];
            switchers.forEach(id => {
                const select = document.getElementById(id);
                if (select) {
                    select.addEventListener('change', function() {
                        const locale = this.value;
                        const currentPath = window.location.pathname;
                        const baseUrl = '{{ app.request.getBaseURL() }}';

                        // Remove current locale from path if present
                        let path = currentPath.replace(/^\/(en|de|fr)(\/|$)/, '/');
                        if (!path.startsWith('/')) {
                            path = '/' + path;
                        }

                        // Build new URL with selected locale
                        const newUrl = baseUrl + '/' + locale + path;
                        window.location.href = newUrl;
                    });
                }
            });
        }

        // Mobile menu functionality
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            const button = event.target.closest('button');
            const isOpen = !menu.classList.contains('hidden');

            if (isOpen) {
                menu.classList.add('hidden');
                button.setAttribute('aria-expanded', 'false');
            } else {
                menu.classList.remove('hidden');
                button.setAttribute('aria-expanded', 'true');
            }
        }

        // Close mobile menu when clicking outside
        document.addEventListener('click', function(event) {
            const menu = document.getElementById('mobile-menu');
            const button = document.querySelector('[onclick="toggleMobileMenu()"]');

            if (!menu.contains(event.target) && !button.contains(event.target)) {
                menu.classList.add('hidden');
                if (button) button.setAttribute('aria-expanded', 'false');
            }
        });

        // Initialize when DOM is ready
        document.addEventListener('DOMContentLoaded', function() {
            setupLanguageSwitcher();
        });

        // Focus management for accessibility
        document.addEventListener('keydown', function(event) {
            // Close mobile menu on Escape
            if (event.key === 'Escape') {
                const menu = document.getElementById('mobile-menu');
                const button = document.querySelector('[onclick="toggleMobileMenu()"]');
                if (!menu.classList.contains('hidden')) {
                    menu.classList.add('hidden');
                    if (button) button.setAttribute('aria-expanded', 'false');
                    if (button) button.focus();
                }
            }
        });
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>