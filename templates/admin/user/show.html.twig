{% extends 'admin/base.html.twig' %}

{% block page_title %}User: {{ user.email }}{% endblock %}

{% block body %}
    <div class="mb-6 flex items-center justify-between gap-3">
        <div>
            <a href="{{ path('admin_users_index') }}" class="mb-2 inline-flex items-center text-sm text-fg-subtle hover:text-slate-800">
                <span class="mr-1">←</span> Back to Users
            </a>
            <h2 class="text-2xl font-bold">{{ user.email }}</h2>
        </div>
        <div class="flex space-x-2">
            <a href="{{ path('admin_users_edit', {id: user.id}) }}" class="rounded-xl bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-700">
                Edit
            </a>
            {% if user.id != app.user.id %}
                <form method="post" action="{{ path('admin_users_delete', {id: user.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this user?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                    <button type="submit" class="rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">
                        Delete
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="mb-4 text-lg font-semibold">User Information</h3>
                <dl class="grid grid-cols-1 gap-4">
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">Email</dt>
                        <dd class="mt-1 text-sm">{{ user.email }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">Roles</dt>
                        <dd class="mt-1">
                            <div class="flex flex-wrap gap-2">
                                {% for role in user.roles %}
                                    <span class="rounded-full bg-primary-100 px-2 py-1 text-xs font-semibold text-primary-800 dark:bg-primary-900/40 dark:text-primary-200">
                                        {{ role }}
                                    </span>
                                {% endfor %}
                            </div>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">Status</dt>
                        <dd class="mt-1">
                            <span class="inline-flex rounded-full px-2 py-1 text-xs font-semibold 
                                {% if user.isActive %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                                {{ user.isActive ? 'Active' : 'Inactive' }}
                            </span>
                        </dd>
                    </div>
                </dl>
            </div>
        </div>
        
        <div class="space-y-6">
            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="mb-4 text-lg font-semibold">Quick Actions</h3>
                <form method="post" action="{{ path('admin_users_update_active', {id: user.id}) }}" class="space-y-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('update_user_active_' ~ user.id) }}">
                    <input type="hidden" name="active" value="{{ user.isActive ? '0' : '1' }}">
                    {% if user.id == app.user.id %}
                        <p class="text-xs text-fg-subtle">Your own account cannot be deactivated.</p>
                    {% endif %}
                    <button type="submit" class="w-full rounded-xl px-4 py-2 text-sm font-semibold text-white {% if user.isActive %}bg-amber-600 hover:bg-amber-700{% else %}bg-green-600 hover:bg-green-700{% endif %}" {% if user.id == app.user.id and user.isActive %}disabled{% endif %}>
                        {{ user.isActive ? 'Deactivate user' : 'Activate user' }}
                    </button>
                </form>
            </div>

            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="mb-4 text-lg font-semibold">{{ 'ui.two_factor.title'|trans }}</h3>
                {% if user.totpAuthenticationEnabled %}
                    <span class="badge badge-success">{{ 'ui.two_factor.status_on'|trans }}</span>
                    {% if user.id != app.user.id %}
                        <form method="post" action="{{ path('admin_users_reset_two_factor', {id: user.id}) }}" class="mt-4"
                              onsubmit="return confirm({{ 'ui.two_factor.reset_confirm'|trans|json_encode }})">
                            <input type="hidden" name="_token" value="{{ csrf_token('reset_two_factor_' ~ user.id) }}">
                            <button type="submit" class="btn btn-secondary w-full">{{ 'ui.two_factor.reset'|trans }}</button>
                            <p class="mt-2 text-xs text-fg-subtle">{{ 'ui.two_factor.reset_hint'|trans }}</p>
                        </form>
                    {% endif %}
                {% else %}
                    <span class="badge badge-neutral">{{ 'ui.two_factor.status_off'|trans }}</span>
                {% endif %}
            </div>

            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="mb-4 text-lg font-semibold">Metadata</h3>
                <dl class="space-y-3">
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">ID</dt>
                        <dd class="mt-1 text-sm">#{{ user.id }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">Created</dt>
                        <dd class="mt-1 text-sm">{{ user.createdAt|date('Y-m-d H:i') }}</dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>
{% endblock %}

