{% extends 'admin/base.html.twig' %}

{% block page_title %}Edit User: {{ user.email }}{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('admin_users_index') }}" class="text-gray-600 hover:text-gray-900 mb-2 inline-block">
            <i class="fas fa-arrow-left"></i> Back to Users
        </a>
        <h2 class="text-2xl font-bold text-gray-900">Edit User</h2>
    </div>
    
    <div class="admin-card admin-form-shell p-6">
        <form method="post" class="space-y-6">
            <div class="rounded-xl border border-gray-200 bg-gradient-to-br from-gray-50 to-white p-5">
                <h3 class="text-base font-semibold text-gray-900">Account profile</h3>
                <p class="mt-1 text-sm text-gray-600">Update login data, permissions and account status.</p>
            </div>

            <div class="admin-form-grid">
                <section class="admin-form-section">
                <div>
                    <label for="email" class="admin-form-label">Email address *</label>
                    <input type="email" id="email" name="email" required autocomplete="email" placeholder="user@example.com" class="admin-form-input" value="{{ user.email }}">
                    <p class="mt-1 text-xs text-gray-500">This will be used for login and account communication</p>
                </div>
                
                <div>
                    <label for="password" class="admin-form-label">New password</label>
                    <div class="relative">
                        <input type="password" id="password" name="password" minlength="6"
                               autocomplete="new-password"
                               placeholder="Leave empty to keep current password"
                               class="admin-form-input pr-10">
                        <button type="button" data-js="password-toggle" data-target-field-id="password" class="absolute inset-y-0 right-0 pr-3 flex items-center">
                            <i class="fas fa-eye text-gray-400 hover:text-gray-600" id="password-toggle-icon"></i>
                        </button>
                    </div>
                    <p class="mt-1 text-xs text-gray-500">
                        <i class="fas fa-info-circle mr-1"></i>
                        Leave empty to keep the current password. Minimum 6 characters if changing.
                    </p>
                </div>
                </section>
                
                <section class="admin-form-section">
                    <label class="admin-form-label">User roles</label>
                    <div class="space-y-3 bg-white p-4 rounded-lg border border-gray-200">
                        <label class="flex items-start cursor-pointer group">
                            <input type="checkbox" name="roles[]" value="ROLE_USER" {% if 'ROLE_USER' in user.roles %}checked{% endif %}
                                   class="mt-1 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            <div class="ml-3 flex-1">
                                <span class="text-sm font-medium text-gray-900">ROLE_USER</span>
                                <p class="text-xs text-gray-500 mt-0.5">Standard user access - can browse and purchase products</p>
                            </div>
                        </label>
                        <label class="flex items-start cursor-pointer group">
                            <input type="checkbox" name="roles[]" value="ROLE_ADMIN" {% if 'ROLE_ADMIN' in user.roles %}checked{% endif %}
                                   class="mt-1 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            <div class="ml-3 flex-1">
                                <span class="text-sm font-medium text-gray-900">ROLE_ADMIN</span>
                                <p class="text-xs text-gray-500 mt-0.5">Administrator access - full access to admin panel and system management</p>
                            </div>
                        </label>
                    </div>
                
                
                <div class="mt-4">
                    <label class="flex items-center cursor-pointer group">
                        <input type="checkbox" name="isActive" value="1" {% if user.isActive %}checked{% endif %}
                               class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 w-5 h-5">
                        <div class="ml-3 flex-1">
                            <span class="text-sm font-medium text-gray-900">Account Status: Active</span>
                            <p class="text-xs text-gray-500 mt-0.5">Uncheck to disable this user account</p>
                        </div>
                    </label>
                </div>
                </section>
            </div>
                
                
                <div class="flex items-center justify-end space-x-4 border-t border-gray-200 pt-5">
                    <a href="{{ path('admin_users_show', {id: user.id}) }}" class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50">
                        Cancel
                    </a>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                        Update User
                    </button>
                </div>
        </form>
    </div>
{% endblock %}

