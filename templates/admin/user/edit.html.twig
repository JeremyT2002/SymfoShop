{% extends 'admin/base.html.twig' %}

{% block page_title %}Edit User: {{ user.email }}{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('admin_users_index') }}" class="text-fg-muted hover:text-fg mb-2 inline-block">
            {{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }} Back to Users
        </a>
        <h2 class="text-2xl font-bold text-fg">Edit User</h2>
    </div>
    
    <div class="admin-card admin-form-shell p-6">
        <form method="post" class="space-y-6">
            <div class="rounded-xl border border-line bg-gradient-to-br from-gray-50 to-white p-5">
                <h3 class="text-base font-semibold text-fg">Account profile</h3>
                <p class="mt-1 text-sm text-fg-muted">Update login data, permissions and account status.</p>
            </div>

            <div class="admin-form-grid">
                <section class="admin-form-section">
                <div>
                    <label for="email" class="admin-form-label">Email address *</label>
                    <input type="email" id="email" name="email" required autocomplete="email" placeholder="user@example.com" class="admin-form-input" value="{{ user.email }}">
                    <p class="mt-1 text-xs text-fg-subtle">This will be used for login and account communication</p>
                </div>
                
                <div>
                    <label for="password" class="admin-form-label">New password</label>
                    <div class="relative" x-data="{ show: false }">
                        <input type="password" id="password" :type="show ? 'text' : 'password'" name="password" minlength="6"
                               autocomplete="new-password"
                               placeholder="Leave empty to keep current password"
                               class="admin-form-input pr-10">
                        <button type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center" @click="show = !show" :aria-pressed="show" aria-label="{{ 'ui.auth.show_password'|trans }}">
                            <span x-show="!show">{{ ux_icon('lucide:eye', {class: 'size-4 text-fg-subtle hover:text-fg'}) }}</span>
                            <span x-show="show" x-cloak>{{ ux_icon('lucide:eye-off', {class: 'size-4 text-fg-subtle hover:text-fg'}) }}</span>
                        </button>
                    </div>
                    <p class="mt-1 text-xs text-fg-subtle">
                        {{ ux_icon('lucide:info', {class: 'size-4 mr-1'}) }}
                        Leave empty to keep the current password. Minimum 6 characters if changing.
                    </p>
                </div>
                </section>
                
                <section class="admin-form-section">
                    <label class="admin-form-label">User roles</label>
                    {% include 'admin/user/_roles.html.twig' with {user: user} only %}
                
                
                <div class="mt-4">
                    <label class="flex items-center cursor-pointer group">
                        <input type="checkbox" name="isActive" value="1" {% if user.isActive %}checked{% endif %}
                               class="rounded border-line-strong text-primary-600 focus:ring-primary-500 w-5 h-5">
                        <div class="ml-3 flex-1">
                            <span class="text-sm font-medium text-fg">Account Status: Active</span>
                            <p class="text-xs text-fg-subtle mt-0.5">Uncheck to disable this user account</p>
                        </div>
                    </label>
                </div>
                </section>
            </div>
                
                
                <div class="flex items-center justify-end space-x-4 border-t border-line pt-5">
                    <a href="{{ path('admin_users_show', {id: user.id}) }}" class="px-4 py-2 text-fg-muted border border-line-strong rounded-lg hover:bg-subtle">
                        Cancel
                    </a>
                    <button type="submit" class="px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
                        Update User
                    </button>
                </div>
        </form>
    </div>
{% endblock %}

