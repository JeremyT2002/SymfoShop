<div id="chart-sales-{{ random(10000, 99999) }}" class="chart-container" style="min-height: 220px;"></div>
<script>
(function() {
    const el = document.currentScript.previousElementSibling;
    const options = {
        chart: { type: 'line', height: 220, toolbar: { show: false }, zoom: { enabled: false } },
        series: [
            { name: 'Orders', data: {{ orderCounts|json_encode|raw }}, color: '#3b82f6' },
            { name: 'Revenue', data: {{ revenueFormatted|default(revenue)|json_encode|raw }}, color: '#22c55e' }
        ],
        xaxis: { categories: {{ labels|json_encode|raw }}, labels: { rotate: -45 } },
        yaxis: [
            { title: { text: 'Orders' }, labels: { formatter: v => Math.round(v) } },
            { opposite: true, title: { text: 'Revenue' } }
        ],
        stroke: { curve: 'smooth', width: 2 },
        fill: { type: 'gradient', gradient: { opacityFrom: 0.4, opacityTo: 0.05 } },
        legend: { position: 'top' },
        tooltip: { shared: true, intersect: false }
    };
    const chart = new ApexCharts(el, options);
    chart.render();
})();
</script>
