<div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.widgets.recent_orders.order_number'|trans }}</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.widgets.recent_orders.customer'|trans }}</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.widgets.recent_orders.total'|trans }}</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.widgets.recent_orders.status'|trans }}</th>
                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.widgets.recent_orders.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            {% for order in orders|default([]) %}
                <tr>
                    <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-900">{{ order.orderNumber }}</td>
                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">{{ order.email }}</td>
                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">{{ (order.grandTotal / 100)|number_format(2, '.', ',') }} {{ order.currency }}</td>
                    <td class="px-4 py-3 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">{{ order.status|title }}</span>
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap text-right text-sm font-medium">
                        <a href="{{ path('admin_orders_show', {id: order.id}) }}" class="text-blue-600 hover:text-blue-900">{{ 'common.view'|trans }}</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="px-4 py-4 text-center text-sm text-gray-500">{{ 'admin.widgets.recent_orders.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
