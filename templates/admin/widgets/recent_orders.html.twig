<div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-line dark:divide-gray-600">
        <thead class="bg-subtle">
            <tr>
                <th class="px-4 py-2 text-left text-xs font-medium text-fg-subtle uppercase tracking-wider">{{ 'admin.widgets.recent_orders.order_number'|trans }}</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-fg-subtle uppercase tracking-wider">{{ 'admin.widgets.recent_orders.customer'|trans }}</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-fg-subtle uppercase tracking-wider">{{ 'admin.widgets.recent_orders.total'|trans }}</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-fg-subtle uppercase tracking-wider">{{ 'admin.widgets.recent_orders.status'|trans }}</th>
                <th class="px-4 py-2 text-right text-xs font-medium text-fg-subtle uppercase tracking-wider">{{ 'admin.widgets.recent_orders.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody class="bg-panel divide-y divide-line dark:divide-gray-600">
            {% for order in orders|default([]) %}
                <tr>
                    <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-fg">{{ order.orderNumber }}</td>
                    <td class="px-4 py-3 whitespace-nowrap text-sm text-fg-subtle">{{ order.email }}</td>
                    <td class="px-4 py-3 whitespace-nowrap text-sm text-fg">{{ (order.grandTotal / 100)|number_format(2, '.', ',') }} {{ order.currency }}</td>
                    <td class="px-4 py-3 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-subtle text-fg">{{ order.status|title }}</span>
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap text-right text-sm font-medium">
                        <a href="{{ path('admin_orders_show', {id: order.id}) }}" class="text-primary-600 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-300">{{ 'common.view'|trans }}</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="px-4 py-4 text-center text-sm text-fg-subtle">{{ 'admin.widgets.recent_orders.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
