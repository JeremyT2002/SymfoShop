{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'admin.reviews.title'|trans }}{% endblock %}

{% block body %}
    <section class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 class="text-2xl font-bold">{{ 'admin.reviews.title'|trans }}</h2>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{{ 'admin.reviews.subtitle'|trans({'%count%': pendingCount}) }}</p>
        </div>
        <div class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-medium text-amber-700 dark:border-amber-900/40 dark:bg-amber-900/20 dark:text-amber-200">
            {{ 'admin.reviews.pending_title'|trans }}: {{ pendingCount }}
        </div>
    </section>

    <form method="get" class="mb-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-admin dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-wrap items-center gap-3">
            <label for="filter" class="text-sm text-slate-700 dark:text-slate-200">{{ 'admin.reviews.filter'|trans }}</label>
            <select id="filter" name="filter" class="admin-form-input max-w-xs">
                <option value="pending" {% if filter == 'pending' %}selected{% endif %}>{{ 'admin.reviews.filters.pending'|trans }}</option>
                <option value="approved" {% if filter == 'approved' %}selected{% endif %}>{{ 'admin.reviews.filters.approved'|trans }}</option>
                <option value="all" {% if filter == 'all' %}selected{% endif %}>{{ 'admin.reviews.filters.all'|trans }}</option>
            </select>
            <button class="rounded-xl bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700">{{ 'common.filter'|trans }}</button>
        </div>
    </form>

    <div x-data="{ selectedIds: [], clearSelection(){ this.selectedIds=[]; } }" class="space-y-4">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-admin dark:border-slate-800 dark:bg-slate-900">
        <table class="min-w-full text-sm">
            <thead class="bg-slate-50 text-slate-600 uppercase tracking-wide text-xs dark:bg-slate-950/60 dark:text-slate-400">
                <tr>
                    <th class="px-4 py-3 text-left"></th>
                    <th class="px-4 py-3 text-left">{{ 'admin.reviews.table.product'|trans }}</th>
                    <th class="px-4 py-3 text-left">{{ 'admin.reviews.table.user'|trans }}</th>
                    <th class="px-4 py-3 text-left">{{ 'admin.reviews.table.rating'|trans }}</th>
                    <th class="px-4 py-3 text-left">{{ 'admin.reviews.table.status'|trans }}</th>
                    <th class="px-4 py-3 text-left">{{ 'admin.reviews.table.created_at'|trans }}</th>
                    <th class="px-4 py-3 text-right">{{ 'admin.reviews.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white dark:divide-slate-800 dark:bg-slate-900">
            {% for review in reviews %}
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/70">
                    <td class="px-4 py-3"><input type="checkbox" @change="$event.target.checked ? selectedIds.push({{ review.id }}) : selectedIds = selectedIds.filter(id => id !== {{ review.id }})" class="h-4 w-4 rounded border-gray-300"></td>
                    <td class="px-4 py-3">
                        <div class="font-medium text-slate-900 dark:text-slate-100">{{ review.product.name }}</div>
                        <div class="text-xs text-slate-500">{{ review.title }}</div>
                        <div class="mt-1 line-clamp-2 text-xs text-slate-500">{{ review.body }}</div>
                    </td>
                    <td class="px-4 py-3 text-slate-700 dark:text-slate-300">{{ review.user.email }}</td>
                    <td class="px-4 py-3 font-semibold text-amber-600">{{ review.rating }}/5</td>
                    <td class="px-4 py-3">
                        {% if review.isApproved %}
                            <span class="px-2 py-1 rounded bg-green-100 text-green-700 text-xs">{{ 'admin.reviews.status.approved'|trans }}</span>
                        {% else %}
                            <span class="px-2 py-1 rounded bg-amber-100 text-amber-700 text-xs">{{ 'admin.reviews.status.pending'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="px-4 py-3 text-slate-500">{{ review.createdAt|date('Y-m-d H:i') }}</td>
                    <td class="px-4 py-3">
                        <div class="flex justify-end gap-2">
                            <form method="post" action="{{ path('admin_reviews_approve', {'id': review.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_review_approve_' ~ review.id) }}">
                                <input type="hidden" name="filter" value="{{ filter }}">
                                <input type="hidden" name="page" value="{{ page }}">
                                <button class="rounded-lg bg-green-600 px-3 py-1 text-xs font-semibold text-white hover:bg-green-700">{{ 'admin.reviews.actions.approve'|trans }}</button>
                            </form>
                            <form method="post" action="{{ path('admin_reviews_reject', {'id': review.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_review_reject_' ~ review.id) }}">
                                <input type="hidden" name="filter" value="{{ filter }}">
                                <input type="hidden" name="page" value="{{ page }}">
                                <button class="rounded-lg bg-amber-600 px-3 py-1 text-xs font-semibold text-white hover:bg-amber-700">{{ 'admin.reviews.actions.reject'|trans }}</button>
                            </form>
                            <form method="post" action="{{ path('admin_reviews_delete', {'id': review.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_review_delete_' ~ review.id) }}">
                                <input type="hidden" name="filter" value="{{ filter }}">
                                <input type="hidden" name="page" value="{{ page }}">
                                <button class="rounded-lg bg-red-600 px-3 py-1 text-xs font-semibold text-white hover:bg-red-700">{{ 'common.delete'|trans }}</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="px-4 py-6 text-center text-gray-500">{{ 'admin.reviews.empty'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div x-show="selectedIds.length > 0" class="sticky bottom-4">
        <div class="flex items-center justify-between rounded-2xl border border-primary-200 bg-primary-50 p-3">
            <p class="text-sm font-medium text-primary-700"><span x-text="selectedIds.length"></span> {{ 'admin.table.selected'|trans }}</p>
            <form method="post" action="{{ path('admin_reviews_bulk') }}" class="flex items-center gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('bulk_reviews') }}">
                <input type="hidden" name="filter" value="{{ filter }}">
                <input type="hidden" name="page" value="{{ page }}">
                <input type="hidden" name="ids" :value="selectedIds.join(',')">
                <select name="action" class="rounded-xl border border-gray-300 bg-white px-3 py-2 text-xs font-semibold">
                    <option value="approve">{{ 'admin.reviews.actions.approve'|trans }}</option>
                    <option value="reject">{{ 'admin.reviews.actions.reject'|trans }}</option>
                </select>
                <button type="submit" class="rounded-xl bg-white px-3 py-2 text-xs font-semibold">{{ 'admin.table.bulk_apply'|trans }}</button>
                <button type="button" @click="clearSelection()" class="rounded-xl border border-gray-300 px-3 py-2 text-xs font-semibold">{{ 'admin.table.clear_selection'|trans }}</button>
            </form>
        </div>
    </div>
    </div>

    <div class="mt-4 flex justify-between items-center text-sm text-slate-600 dark:text-slate-400">
        <span>{{ 'admin.reviews.pagination'|trans({'%page%': page, '%pages%': totalPages}) }}</span>
        <div class="flex gap-2">
            {% if page > 1 %}
                <a href="{{ path('admin_reviews_index', {filter: filter, page: page - 1}) }}" class="px-3 py-2 rounded border border-gray-300">{{ 'common.previous'|trans }}</a>
            {% endif %}
            {% if page < totalPages %}
                <a href="{{ path('admin_reviews_index', {filter: filter, page: page + 1}) }}" class="px-3 py-2 rounded border border-gray-300">{{ 'common.next'|trans }}</a>
            {% endif %}
        </div>
    </div>
{% endblock %}

