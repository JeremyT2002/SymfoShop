{% extends 'admin/base.html.twig' %}

{% block page_title %}Product: {{ product.name }}{% endblock %}

{% block body %}
    <div class="admin-page-header">
        <div>
            <a href="{{ path('admin_products_index') }}" class="text-gray-600 hover:text-gray-900 mb-2 inline-block">
                <i class="fas fa-arrow-left"></i> Back to Products
            </a>
            <h2 class="text-2xl font-bold text-gray-900">{{ product.name }}</h2>
        </div>
        <div class="flex space-x-2">
            <a href="{{ path('admin_products_edit', {id: product.id}) }}" class="bg-yellow-600 text-white px-4 py-2 rounded-lg hover:bg-yellow-700 transition-colors">
                <i class="fas fa-edit"></i> Edit
            </a>
            <form method="post" action="{{ path('admin_products_delete', {id: product.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ product.id) }}">
                <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </form>
        </div>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Info -->
        <div class="lg:col-span-2 space-y-6">
            <div class="admin-card p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Product Information</h3>
                <dl class="grid grid-cols-1 gap-4">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Name</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ product.name }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Slug</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ product.slug }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Status</dt>
                        <dd class="mt-1">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                {% if product.status.value == 'active' %}bg-green-100 text-green-800
                                {% elseif product.status.value == 'draft' %}bg-yellow-100 text-yellow-800
                                {% else %}bg-gray-100 text-gray-800{% endif %}">
                                {{ product.status.value|title }}
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Category</dt>
                        <dd class="mt-1 text-sm text-gray-900">
                            {% if product.category %}
                                <a href="{{ path('catalog_category', {slug: product.category.slug}) }}" class="text-blue-600 hover:underline">
                                    {{ product.category.name }}
                                </a>
                            {% else %}
                                <span class="text-gray-400">No category assigned</span>
                            {% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Tax Class</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ product.taxClass }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Stock (Available / On hand)</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ product.stockAvailable }} / {{ product.stockOnHand }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Description</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ product.description|default('No description')|nl2br }}</dd>
                    </div>
                </dl>
            </div>
            
            <!-- Images -->
            <div class="admin-card p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Product Images ({{ product.media|length }})</h3>
                {% if product.media|length > 0 %}
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                        {% for media in product.media %}
                            <div class="relative group">
                                <img src="{{ media.path }}" alt="{{ media.alt|default(product.name) }}" 
                                     class="w-full h-32 object-cover rounded-lg border border-gray-300">
                                <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-50 transition-opacity rounded-lg flex items-center justify-center">
                                    <form method="post" action="{{ path('admin_products_media_delete', {id: product.id, mediaId: media.id}) }}" 
                                          class="opacity-0 group-hover:opacity-100 transition-opacity"
                                          onsubmit="return confirm('Are you sure you want to delete this image?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_media_' ~ media.id) }}">
                                        <button type="submit" class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </form>
                                </div>
                                <div class="absolute top-2 left-2 bg-black bg-opacity-50 text-white text-xs px-2 py-1 rounded">
                                    #{{ media.sort + 1 }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-sm text-gray-500">No images uploaded for this product. <a href="{{ path('admin_products_edit', {id: product.id}) }}" class="text-blue-600 hover:underline">Add images</a></p>
                {% endif %}
            </div>
            
            <!-- Variants -->
            <div class="admin-card p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Product Variants ({{ product.variants|length }})</h3>

                <form method="post" action="{{ path('admin_products_variants', {id: product.id}) }}" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 mb-5 p-4 rounded-lg border border-gray-200">
                    <input type="hidden" name="_token" value="{{ csrf_token('create_variant_' ~ product.id) }}">
                    <div class="lg:col-span-2">
                        <label class="block text-xs font-medium text-gray-600 mb-1">SKU *</label>
                        <input type="text" name="sku" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="e.g. TSHIRT-BLACK-M">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Price (minor units) *</label>
                        <input type="number" name="price_amount" min="0" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="1999">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Currency *</label>
                        <input type="text" name="currency" value="EUR" maxlength="3" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">On hand *</label>
                        <input type="number" name="on_hand" min="0" value="0" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Reserved *</label>
                        <input type="number" name="reserved" min="0" value="0" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                    </div>
                    <div class="md:col-span-2 lg:col-span-2">
                        <label class="block text-xs font-medium text-gray-600 mb-1">Attributes (JSON or key:value lines)</label>
                        <textarea name="attributes" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder='{"size":"M","color":"black"}'></textarea>
                    </div>
                    <div class="md:col-span-2 lg:col-span-4">
                        <button type="submit" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-blue-600 text-white text-sm hover:bg-blue-700">
                            <i class="fas fa-plus"></i> Add variant
                        </button>
                    </div>
                </form>

                {% if product.variants|length > 0 %}
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">SKU</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Price</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Stock</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Attributes</th>
                                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                {% for variant in product.variants %}
                                    <tr>
                                        <td class="px-4 py-3 align-top">
                                            <input form="variant-edit-{{ variant.id }}" type="text" name="sku" value="{{ variant.sku }}" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                                        </td>
                                        <td class="px-4 py-3 align-top">
                                            <div class="grid grid-cols-2 gap-2">
                                                <input form="variant-edit-{{ variant.id }}" type="number" name="price_amount" min="0" value="{{ variant.priceAmount }}" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                                                <input form="variant-edit-{{ variant.id }}" type="text" name="currency" maxlength="3" value="{{ variant.currency }}" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                                            </div>
                                        </td>
                                        <td class="px-4 py-3 align-top">
                                            <div class="grid grid-cols-2 gap-2">
                                                <input form="variant-edit-{{ variant.id }}" type="number" name="on_hand" min="0" value="{{ variant.stockItem ? variant.stockItem.onHand : 0 }}" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                                                <input form="variant-edit-{{ variant.id }}" type="number" name="reserved" min="0" value="{{ variant.stockItem ? variant.stockItem.reserved : 0 }}" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                                            </div>
                                            <p class="mt-1 text-xs text-gray-500">Available: {{ variant.stockItem ? variant.stockItem.available : 0 }}</p>
                                        </td>
                                        <td class="px-4 py-3 align-top">
                                            <textarea form="variant-edit-{{ variant.id }}" name="attributes" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">{{ variant.attributes ? variant.attributes|json_encode(constant('JSON_PRETTY_PRINT')) : '' }}</textarea>
                                        </td>
                                        <td class="px-4 py-3 align-top text-right space-y-2">
                                            <form id="variant-edit-{{ variant.id }}" method="post" action="{{ path('admin_products_variant_edit', {id: product.id, variantId: variant.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('edit_variant_' ~ variant.id) }}">
                                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">
                                                    <i class="fas fa-save"></i> Save
                                                </button>
                                            </form>
                                            <form method="post" action="{{ path('admin_products_variant_delete', {id: product.id, variantId: variant.id}) }}" onsubmit="return confirm('Delete this variant?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_variant_' ~ variant.id) }}">
                                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-2 bg-red-600 text-white text-sm rounded-lg hover:bg-red-700">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-sm text-gray-500">No variants defined for this product.</p>
                {% endif %}
            </div>
        </div>
        
        <!-- Sidebar -->
        <div class="space-y-6">
            <div class="admin-card p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Metadata</h3>
                <dl class="space-y-3">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">ID</dt>
                        <dd class="mt-1 text-sm text-gray-900">#{{ product.id }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Created</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ product.createdAt|date('Y-m-d H:i') }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Updated</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ product.updatedAt|date('Y-m-d H:i') }}</dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>
{% endblock %}

