{% extends 'admin/base.html.twig' %}

{% block page_title %}Product: {{ product.name }}{% endblock %}

{% block body %}
    <div class="mb-6 flex items-center justify-between gap-3">
        <div>
            <a href="{{ path('admin_products_index') }}" class="mb-2 inline-flex items-center text-sm text-fg-subtle hover:text-slate-800">
                <span class="mr-1">←</span> Back to Products
            </a>
            <h2 class="text-2xl font-bold">{{ product.name }}</h2>
        </div>
        <div class="flex space-x-2">
            <a href="{{ path('admin_products_edit', {id: product.id}) }}" class="rounded-xl bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-700">
                Edit
            </a>
            <form method="post" action="{{ path('admin_products_delete', {id: product.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ product.id) }}">
                <button type="submit" class="rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">
                    Delete
                </button>
            </form>
        </div>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Info -->
        <div class="lg:col-span-2 space-y-6">
            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="text-lg font-semibold text-fg mb-4">Product Information</h3>
                <dl class="grid grid-cols-1 gap-4">
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">Name</dt>
                        <dd class="mt-1 text-sm text-fg">{{ product.name }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">Slug</dt>
                        <dd class="mt-1 text-sm text-fg">{{ product.slug }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">Status</dt>
                        <dd class="mt-1">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                {% if product.status.value == 'active' %}bg-green-100 text-green-800
                                {% elseif product.status.value == 'draft' %}bg-yellow-100 text-yellow-800
                                {% else %}bg-gray-100 text-gray-800{% endif %}">
                                {{ product.status.value|title }}
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">Category</dt>
                        <dd class="mt-1 text-sm text-fg">
                            {% if product.category %}
                                <a href="{{ path('catalog_category', {slug: product.category.slug}) }}" class="text-primary-600 hover:underline">
                                    {{ product.category.name }}
                                </a>
                            {% else %}
                                <span class="text-fg-subtle">No category assigned</span>
                            {% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">Tax Class</dt>
                        <dd class="mt-1 text-sm text-fg">{{ product.taxClass }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">Stock (Available / On hand)</dt>
                        <dd class="mt-1 text-sm text-fg">{{ product.stockAvailable }} / {{ product.stockOnHand }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">Description</dt>
                        <dd class="mt-1 text-sm text-fg">{{ product.description|default('No description')|nl2br }}</dd>
                    </div>
                </dl>
            </div>
            
            <!-- Images -->
            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="text-lg font-semibold text-fg mb-4">Product Images ({{ product.media|length }})</h3>
                {% if product.media|length > 0 %}
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                        {% for media in product.media %}
                            <div class="relative group">
                                <img src="{{ media.path }}" alt="{{ media.alt|default(product.name) }}" 
                                     class="w-full h-32 object-cover rounded-lg border border-line-strong">
                                <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-50 transition-opacity rounded-lg flex items-center justify-center">
                                    <form method="post" action="{{ path('admin_products_media_delete', {id: product.id, mediaId: media.id}) }}" 
                                          class="opacity-0 group-hover:opacity-100 transition-opacity"
                                          onsubmit="return confirm('Are you sure you want to delete this image?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_media_' ~ media.id) }}">
                                        <button type="submit" class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700">
                                            {{ ux_icon('lucide:trash-2', {class: 'size-4'}) }} Delete
                                        </button>
                                    </form>
                                </div>
                                <div class="absolute top-2 left-2 bg-black bg-opacity-50 text-white text-xs px-2 py-1 rounded">
                                    #{{ media.sort + 1 }}
                                </div>
                                {% if product.variants|length > 1 %}
                                    <form method="post" action="{{ path('admin_products_media_variant', {id: product.id, mediaId: media.id}) }}" class="mt-2">
                                        <input type="hidden" name="_token" value="{{ csrf_token('media_variant_' ~ media.id) }}">
                                        <label class="sr-only" for="media-variant-{{ media.id }}">Variant</label>
                                        <select id="media-variant-{{ media.id }}" name="variant_id" class="select py-1.5 text-xs" onchange="this.form.requestSubmit()">
                                            <option value="0">All variants</option>
                                            {% for variant in product.variants %}
                                                <option value="{{ variant.id }}" {{ media.variant and media.variant.id == variant.id ? 'selected' }}>{{ variant.attributes ? variant.attributes|join(' / ') : variant.sku }}</option>
                                            {% endfor %}
                                        </select>
                                    </form>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-sm text-fg-subtle">No images uploaded for this product. <a href="{{ path('admin_products_edit', {id: product.id}) }}" class="text-primary-600 hover:underline">Add images</a></p>
                {% endif %}
            </div>
            
            <!-- Variants -->
            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="text-lg font-semibold text-fg mb-4">Product Variants ({{ product.variants|length }})</h3>

                <form method="post" action="{{ path('admin_products_variants', {id: product.id}) }}" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 mb-5 p-4 rounded-lg border border-line">
                    <input type="hidden" name="_token" value="{{ csrf_token('create_variant_' ~ product.id) }}">
                    <div class="lg:col-span-2">
                        <label class="block text-xs font-medium text-fg-muted mb-1">SKU *</label>
                        <input type="text" name="sku" required class="w-full px-3 py-2 border border-line-strong rounded-lg text-sm" placeholder="e.g. TSHIRT-BLACK-M">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-fg-muted mb-1">Gross price incl. VAT, in cents *</label>
                        <input type="number" name="price_amount" min="0" required class="w-full px-3 py-2 border border-line-strong rounded-lg text-sm" placeholder="1999">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-fg-muted mb-1">Compare-at price (struck through, optional)</label>
                        <input type="number" name="compare_at_price_amount" min="0" class="w-full px-3 py-2 border border-line-strong rounded-lg text-sm" placeholder="2499">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-fg-muted mb-1">Currency *</label>
                        <input type="text" name="currency" value="EUR" maxlength="3" required class="w-full px-3 py-2 border border-line-strong rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-fg-muted mb-1">On hand *</label>
                        <input type="number" name="on_hand" min="0" value="0" required class="w-full px-3 py-2 border border-line-strong rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-fg-muted mb-1">Reserved *</label>
                        <input type="number" name="reserved" min="0" value="0" required class="w-full px-3 py-2 border border-line-strong rounded-lg text-sm">
                    </div>
                    <div class="md:col-span-2 lg:col-span-2">
                        <label class="block text-xs font-medium text-fg-muted mb-1">Attributes (JSON or key:value lines)</label>
                        <textarea name="attributes" rows="2" class="w-full px-3 py-2 border border-line-strong rounded-lg text-sm" placeholder='{"size":"M","color":"black"}'></textarea>
                    </div>
                    <div class="md:col-span-2 lg:col-span-4">
                        <button type="submit" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-primary-600 text-white text-sm hover:bg-primary-700">
                            {{ ux_icon('lucide:plus', {class: 'size-4'}) }} Add variant
                        </button>
                    </div>
                </form>

                {% if product.variants|length > 0 %}
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-line">
                            <thead class="bg-subtle">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-fg-subtle uppercase">SKU</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-fg-subtle uppercase">Price</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-fg-subtle uppercase">Stock</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-fg-subtle uppercase">Attributes</th>
                                    <th class="px-4 py-3 text-right text-xs font-medium text-fg-subtle uppercase">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="bg-panel divide-y divide-line">
                                {% for variant in product.variants %}
                                    <tr>
                                        <td class="px-4 py-3 align-top">
                                            <input form="variant-edit-{{ variant.id }}" type="text" name="sku" value="{{ variant.sku }}" required class="w-full px-3 py-2 border border-line-strong rounded-lg text-sm">
                                        </td>
                                        <td class="px-4 py-3 align-top">
                                            <div class="grid grid-cols-2 gap-2">
                                                <input form="variant-edit-{{ variant.id }}" type="number" name="price_amount" min="0" value="{{ variant.priceAmount }}" required class="w-full px-3 py-2 border border-line-strong rounded-lg text-sm">
                                                <input form="variant-edit-{{ variant.id }}" type="text" name="currency" maxlength="3" value="{{ variant.currency }}" required class="w-full px-3 py-2 border border-line-strong rounded-lg text-sm">
                                            </div>
                                            <input form="variant-edit-{{ variant.id }}" type="number" name="compare_at_price_amount" min="0" value="{{ variant.compareAtPriceAmount }}" placeholder="Compare-at" title="Compare-at price (struck through)" class="mt-2 w-full px-3 py-2 border border-line-strong rounded-lg text-sm">
                                        </td>
                                        <td class="px-4 py-3 align-top">
                                            <div class="grid grid-cols-2 gap-2">
                                                <input form="variant-edit-{{ variant.id }}" type="number" name="on_hand" min="0" value="{{ variant.stockItem ? variant.stockItem.onHand : 0 }}" required class="w-full px-3 py-2 border border-line-strong rounded-lg text-sm">
                                                <input form="variant-edit-{{ variant.id }}" type="number" name="reserved" min="0" value="{{ variant.stockItem ? variant.stockItem.reserved : 0 }}" required class="w-full px-3 py-2 border border-line-strong rounded-lg text-sm">
                                            </div>
                                            <p class="mt-1 text-xs text-fg-subtle">Available: {{ variant.stockItem ? variant.stockItem.available : 0 }}</p>
                                        </td>
                                        <td class="px-4 py-3 align-top">
                                            <textarea form="variant-edit-{{ variant.id }}" name="attributes" rows="2" class="w-full px-3 py-2 border border-line-strong rounded-lg text-sm">{{ variant.attributes ? variant.attributes|json_encode(constant('JSON_PRETTY_PRINT')) : '' }}</textarea>
                                        </td>
                                        <td class="px-4 py-3 align-top text-right space-y-2">
                                            <form id="variant-edit-{{ variant.id }}" method="post" action="{{ path('admin_products_variant_edit', {id: product.id, variantId: variant.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('edit_variant_' ~ variant.id) }}">
                                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-2 bg-primary-600 text-white text-sm rounded-lg hover:bg-primary-700">
                                                    {{ ux_icon('lucide:save', {class: 'size-4'}) }} Save
                                                </button>
                                            </form>
                                            <form method="post" action="{{ path('admin_products_variant_delete', {id: product.id, variantId: variant.id}) }}" onsubmit="return confirm('Delete this variant?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_variant_' ~ variant.id) }}">
                                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-2 bg-red-600 text-white text-sm rounded-lg hover:bg-red-700">
                                                    {{ ux_icon('lucide:trash-2', {class: 'size-4'}) }} Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-sm text-fg-subtle">No variants defined for this product.</p>
                {% endif %}
            </div>
        </div>
        
        <!-- Sidebar -->
        <div class="space-y-6">
            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="text-lg font-semibold text-fg mb-4">Quick Actions</h3>
                <form method="post" action="{{ path('admin_products_update_status', {id: product.id}) }}" class="space-y-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('update_product_status_' ~ product.id) }}">
                    <label for="product-status" class="block text-xs font-semibold uppercase tracking-wide text-fg-subtle">Status</label>
                    <select id="product-status" name="status" class="w-full rounded-xl border border-line-strong bg-panel px-3 py-2 text-sm">
                        {% for status in ['active', 'draft', 'archived'] %}
                            <option value="{{ status }}" {% if product.status.value == status %}selected{% endif %}>{{ status|title }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="w-full rounded-xl bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700">
                        Update status
                    </button>
                </form>
            </div>

            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="text-lg font-semibold text-fg mb-4">Metadata</h3>
                <dl class="space-y-3">
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">ID</dt>
                        <dd class="mt-1 text-sm text-fg">#{{ product.id }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">Created</dt>
                        <dd class="mt-1 text-sm text-fg">{{ product.createdAt|date('Y-m-d H:i') }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">Updated</dt>
                        <dd class="mt-1 text-sm text-fg">{{ product.updatedAt|date('Y-m-d H:i') }}</dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>
{% endblock %}

