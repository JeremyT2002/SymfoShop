{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'ui.product_csv.import_title'|trans }}{% endblock %}

{% block body %}
<div class="mb-6">
    <a href="{{ path('admin_products_index') }}" class="mb-2 inline-flex items-center gap-1 text-sm text-fg-muted hover:text-fg">
        {{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }} {{ 'admin.products.heading'|trans }}
    </a>
    <h2 class="text-2xl font-bold">{{ 'ui.product_csv.import_title'|trans }}</h2>
    <p class="mt-1 max-w-2xl text-sm text-fg-muted">{{ 'ui.product_csv.import_intro'|trans }}</p>
</div>

<div class="grid gap-6 lg:grid-cols-3">
    <div class="space-y-6 lg:col-span-2">
        {% if result %}
            {% if result.hasErrors %}
                <div class="alert alert-error">
                    {{ ux_icon('lucide:circle-x', {class: 'mt-0.5 size-4'}) }}
                    <div>
                        <p class="font-semibold">{{ 'ui.product_csv.errors'|trans }}</p>
                        <ul class="mt-2 space-y-1 text-sm">
                            {% for error in result.errors %}
                                <li>{% if error.line > 0 %}<span class="font-mono">{{ 'ui.product_csv.line'|trans({'%line%': error.line}) }}</span> – {% endif %}{{ error.message }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% else %}
                <div class="alert {{ result.applied ? 'alert-success' : 'alert-info' }}">
                    {{ ux_icon(result.applied ? 'lucide:circle-check' : 'lucide:eye', {class: 'mt-0.5 size-4'}) }}
                    <div>
                        <p class="font-semibold">{{ (result.applied ? 'ui.product_csv.applied' : 'ui.product_csv.preview')|trans }}</p>
                        <p class="mt-1 text-sm">{{ 'ui.product_csv.summary'|trans({
                            '%products%': result.productsCreated,
                            '%created%': result.variantsCreated,
                            '%updated%': result.variantsUpdated,
                        }) }}</p>
                        {% if not result.applied %}<p class="mt-1 text-sm">{{ 'ui.product_csv.preview_hint'|trans }}</p>{% endif %}
                    </div>
                </div>
            {% endif %}
        {% endif %}

        <form method="post" enctype="multipart/form-data" class="card space-y-4 p-6">
            <input type="hidden" name="_token" value="{{ csrf_token('product_import') }}">
            <div>
                <label for="import-file" class="label">{{ 'ui.product_csv.file'|trans }}</label>
                <input type="file" id="import-file" name="file" accept=".csv,text/csv" required class="input py-2">
            </div>
            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="apply" value="1" class="rounded border-line-strong">
                {{ 'ui.product_csv.apply'|trans }}
            </label>
            <button type="submit" class="btn btn-primary">{{ ux_icon('lucide:upload', {class: 'size-4'}) }}{{ 'ui.product_csv.submit'|trans }}</button>
        </form>
    </div>

    <aside class="card h-fit p-6 text-sm">
        <h3 class="font-semibold">{{ 'ui.product_csv.format'|trans }}</h3>
        <p class="mt-2 text-fg-muted">{{ 'ui.product_csv.format_intro'|trans }}</p>
        <ul class="mt-3 space-y-1 font-mono text-xs">
            {% for column in columns %}<li>{{ column }}</li>{% endfor %}
        </ul>
        <p class="mt-3 text-fg-muted">{{ 'ui.product_csv.format_rules'|trans }}</p>
        <a href="{{ path('admin_products_export') }}" class="btn btn-secondary btn-sm mt-4">{{ ux_icon('lucide:download', {class: 'size-4'}) }}{{ 'ui.product_csv.export'|trans }}</a>
    </aside>
</div>
{% endblock %}
