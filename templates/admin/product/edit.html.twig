{% extends 'admin/base.html.twig' %}

{% block page_title %}Edit Product: {{ product.name }}{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('admin_products_index') }}" class="text-gray-600 hover:text-gray-900 mb-2 inline-block">
            <i class="fas fa-arrow-left"></i> Back to Products
        </a>
        <h2 class="text-2xl font-bold text-gray-900">Edit Product</h2>
    </div>
    
    <div class="admin-card admin-form-shell p-6">
        <form method="post" enctype="multipart/form-data" class="space-y-6">
            <div class="rounded-xl border border-gray-200 bg-gradient-to-br from-gray-50 to-white p-5">
                <h3 class="text-base font-semibold text-gray-900">Product setup</h3>
                <p class="mt-1 text-sm text-gray-600">Maintain core product data and add additional media.</p>
            </div>

            <div class="admin-form-grid">
                <section class="admin-form-section space-y-4">
                <div>
                    <label for="name" class="admin-form-label">Product name *</label>
                    <input type="text" id="name" name="name" required placeholder="e.g., Wireless Headphones" class="admin-form-input" value="{{ product.name }}">
                    <p class="mt-1 text-xs text-gray-500">Enter a descriptive name for your product</p>
                </div>
                
                <div>
                    <label for="description" class="admin-form-label">Description</label>
                    <textarea id="description" name="description" rows="5"
                              placeholder="Describe your product in detail. Include key features, benefits, and any important information customers should know..."
                              class="admin-form-input resize-y">{{ product.description }}</textarea>
                    <p class="mt-1 text-xs text-gray-500">Optional: Add a detailed description to help customers understand your product</p>
                </div>
                </section>
                
                <section class="admin-form-section space-y-4">
                <div>
                    <label for="status" class="admin-form-label">Status *</label>
                        <select id="status" name="status" required
                                class="admin-form-input">
                            {% for status in statuses %}
                                <option value="{{ status.value }}" {% if product.status == status %}selected{% endif %}>
                                    {{ status.value|title }}
                                </option>
                            {% endfor %}
                        </select>
                    <p class="mt-1 text-xs text-gray-500">
                        <span class="font-medium">Active:</span> Visible to customers | 
                        <span class="font-medium">Draft:</span> Hidden from customers | 
                        <span class="font-medium">Archived:</span> Discontinued
                    </p>
                </div>
                
                <div>
                    <label for="category_id" class="admin-form-label">Category</label>
                        <select id="category_id" name="category_id"
                                class="admin-form-input">
                            <option value="">-- Select Category --</option>
                            {% for category in categories %}
                                <option value="{{ category.id }}" {% if product.category and product.category.id == category.id %}selected{% endif %}>
                                    {{ category.name }}
                                </option>
                            {% endfor %}
                        </select>
                    <p class="mt-1 text-xs text-gray-500">Optional: Assign this product to a category</p>
                </div>
                
                <div>
                    <label for="tax_class" class="admin-form-label">Tax class *</label>
                        <select id="tax_class" name="tax_class" required
                                class="admin-form-input">
                            <option value="standard" {% if product.taxClass == 'standard' %}selected{% endif %}>Standard</option>
                            <option value="reduced" {% if product.taxClass == 'reduced' %}selected{% endif %}>Reduced</option>
                            <option value="zero" {% if product.taxClass == 'zero' %}selected{% endif %}>Zero</option>
                            <option value="exempt" {% if product.taxClass == 'exempt' %}selected{% endif %}>Exempt</option>
                        </select>
                    <p class="mt-1 text-xs text-gray-500">Select the tax class for this product</p>
                </div>
                </section>
            </div>
                
                <section class="admin-form-section">
                    <label for="images" class="admin-form-label">Add more images</label>
                    <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-lg hover:border-gray-400 transition-colors">
                        <div class="space-y-1 text-center">
                            <i class="fas fa-cloud-upload-alt text-4xl text-gray-400 mb-2"></i>
                            <div class="flex text-sm text-gray-600">
                                <label for="images" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-blue-500">
                                    <span>Upload images</span>
                                    <input id="images" name="images[]" type="file" multiple accept="image/jpeg,image/png,image/gif,image/webp" class="sr-only">
                                </label>
                                <p class="pl-1">or drag and drop</p>
                            </div>
                            <p class="text-xs text-gray-500">PNG, JPG, GIF, WebP up to 5MB each</p>
                        </div>
                    </div>
                    <div id="image-preview" class="mt-4 grid grid-cols-4 gap-4 hidden"></div>
                    <p class="mt-1 text-xs text-gray-500">Optional: Upload additional product images.</p>
                </section>
                
                <div class="flex items-center justify-end space-x-4 border-t border-gray-200 pt-5">
                    <a href="{{ path('admin_products_show', {id: product.id}) }}" class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50">
                        Cancel
                    </a>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                        Update Product
                    </button>
                </div>
        </form>
    </div>
    
    <script>
        // Image preview functionality
        document.getElementById('images')?.addEventListener('change', function(e) {
            const preview = document.getElementById('image-preview');
            preview.innerHTML = '';
            preview.classList.remove('hidden');
            
            Array.from(e.target.files).forEach((file, index) => {
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const div = document.createElement('div');
                        div.className = 'relative';
                        div.innerHTML = `
                            <img src="${e.target.result}" alt="Preview ${index + 1}" class="w-full h-24 object-cover rounded-lg border border-gray-300">
                            <span class="absolute top-1 right-1 bg-black bg-opacity-50 text-white text-xs px-2 py-1 rounded">${index + 1}</span>
                        `;
                        preview.appendChild(div);
                    };
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>
{% endblock %}

