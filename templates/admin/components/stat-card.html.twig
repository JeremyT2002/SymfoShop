{# Params: title, value, iconName, trend (number, %), trendLabel #}
{% from 'admin/components/_icons.html.twig' import icon %}
<article class="card p-5">
    <div class="flex items-start justify-between gap-3">
        <p class="text-sm font-medium text-fg-muted">{{ title|default('') }}</p>
        {% if iconName is defined %}
            <span class="flex size-8 items-center justify-center rounded-lg bg-subtle text-fg-muted">{{ icon(iconName, 'size-4') }}</span>
        {% endif %}
    </div>
    <p class="mt-2 text-2xl font-semibold tracking-tight tabular-nums">{{ value|default('—') }}</p>
    {% if trend is defined %}
        <p class="mt-2 inline-flex items-center gap-1 text-xs font-medium {{ trend >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400' }}">
            {{ ux_icon(trend >= 0 ? 'lucide:trending-up' : 'lucide:trending-down', {class: 'size-3.5'}) }}{{ trendLabel|default(trend ~ '%') }}
        </p>
    {% endif %}
</article>
