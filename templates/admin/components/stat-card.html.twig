{% from 'admin/components/_icons.html.twig' import icon %}
<article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-admin dark:border-slate-800 dark:bg-slate-900">
    <div class="flex items-start justify-between gap-3">
        <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{{ title|default('') }}</p>
            <p class="mt-2 text-2xl font-semibold text-slate-900 dark:text-slate-100">{{ value|default('—') }}</p>
        </div>
        {% if iconName is defined %}
            <span class="rounded-lg bg-primary-50 p-2 text-primary-600 dark:bg-primary-900/40 dark:text-primary-300">{{ icon(iconName, 'h-5 w-5') }}</span>
        {% endif %}
    </div>
    {% if trend is defined %}
        <p class="mt-3 text-xs {{ trend >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400' }}">{{ trendLabel|default(trend ~ '%') }}</p>
    {% endif %}
</article>
