{# Params: title, description, iconName, cta, ctaUrl #}
{% from 'admin/components/_icons.html.twig' import icon %}
<div class="rounded-2xl border border-dashed border-line-strong px-6 py-12 text-center">
    <span class="mx-auto flex size-12 items-center justify-center rounded-full bg-subtle text-fg-muted">{{ icon(iconName|default('magnifying-glass'), 'size-5') }}</span>
    <h3 class="mt-4 text-sm font-semibold">{{ title|default('admin.layout.empty_title'|trans) }}</h3>
    {% if description is defined %}
        <p class="mx-auto mt-1 max-w-md text-sm text-fg-muted">{{ description }}</p>
    {% endif %}
    {% if cta is defined and ctaUrl is defined %}
        <a href="{{ ctaUrl }}" class="btn btn-primary mt-5">{{ cta }}</a>
    {% endif %}
</div>
