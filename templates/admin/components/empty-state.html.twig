{% from 'admin/components/_icons.html.twig' import icon %}
<div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center dark:border-slate-700 dark:bg-slate-900/40">
    <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-full bg-white text-slate-500 shadow-admin dark:bg-slate-800 dark:text-slate-300">
        {{ icon(iconName|default('magnifying-glass'), 'h-5 w-5') }}
    </div>
    <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ title|default('admin.layout.empty_title'|trans) }}</h3>
    {% if description is defined %}
        <p class="mx-auto mt-2 max-w-md text-sm text-slate-500 dark:text-slate-400">{{ description }}</p>
    {% endif %}
    {% if cta is defined and ctaUrl is defined %}
        <a href="{{ ctaUrl }}" class="focus-ring mt-4 inline-flex rounded-xl bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700">{{ cta }}</a>
    {% endif %}
</div>
