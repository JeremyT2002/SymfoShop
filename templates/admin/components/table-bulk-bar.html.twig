<div x-cloak x-show="selectedCount > 0" class="sticky bottom-4 z-10 mb-4">
    <div class="rounded-2xl border border-primary-200 bg-primary-50 p-3 shadow-xs dark:border-primary-800 dark:bg-primary-900/30">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-sm font-medium text-primary-700 dark:text-primary-200">
                {{ 'admin.table.selected_count'|trans({'%count%': "' + selectedCount + '"})|raw }}
            </p>
            <div class="flex flex-wrap gap-2">
                {% for action in actions %}
                    <button type="button" class="focus-ring rounded-xl bg-panel px-3 py-2 text-xs font-semibold text-fg-muted hover:bg-subtle">
                        {{ action }}
                    </button>
                {% endfor %}
                <button type="button" @click="clearSelection()" class="focus-ring rounded-xl border border-line-strong px-3 py-2 text-xs font-semibold hover:bg-subtle">
                    {{ 'admin.table.clear_selection'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>
