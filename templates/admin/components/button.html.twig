{#
  Params: label, variant (primary|secondary|danger|ghost), type, href, attrs (raw HTML attributes)
#}
{%- set variant = variant|default('primary') -%}
{%- set css = 'btn ' ~ ({primary: 'btn-primary', secondary: 'btn-secondary', danger: 'btn-danger', ghost: 'btn-ghost'}[variant]|default('btn-primary')) -%}
{% if href|default(null) %}
    <a href="{{ href }}" class="{{ css }}" {{ attrs|default('')|raw }}>{{ label|default('') }}</a>
{% else %}
    <button type="{{ type|default('button') }}" class="{{ css }}" {{ attrs|default('')|raw }}>{{ label|default('') }}</button>
{% endif %}
