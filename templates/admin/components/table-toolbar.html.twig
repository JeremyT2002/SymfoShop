<form method="get" class="mb-4 grid grid-cols-1 gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-admin dark:border-slate-800 dark:bg-slate-900 md:grid-cols-12">
    <div class="md:col-span-5">
        <label class="sr-only" for="table-search">{{ searchLabel|default('Search') }}</label>
        <input id="table-search" type="search" name="search" value="{{ search|default('') }}"
               placeholder="{{ searchPlaceholder|default('Search...') }}"
               class="admin-form-input">
    </div>

    {% if filters is defined %}
        {% for filter in filters %}
            <div class="md:col-span-2">
                <label class="sr-only" for="filter-{{ filter.name }}">{{ filter.label }}</label>
                <select id="filter-{{ filter.name }}" name="{{ filter.name }}" class="admin-form-input">
                    {% for option in filter.options %}
                        <option value="{{ option.value }}" {% if option.value == filter.value %}selected{% endif %}>{{ option.label }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endfor %}
    {% endif %}

    <div class="md:col-span-2">
        <label class="sr-only" for="per-page">{{ 'admin.table.per_page'|trans }}</label>
        <select id="per-page" name="perPage" class="admin-form-input">
            {% for size in [25, 50, 100] %}
                <option value="{{ size }}" {% if perPage == size %}selected{% endif %}>{{ size }} / {{ 'admin.table.page'|trans }}</option>
            {% endfor %}
        </select>
    </div>

    <input type="hidden" name="sortBy" value="{{ sortBy|default('createdAt') }}">
    <input type="hidden" name="sortDir" value="{{ sortDir|default('DESC') }}">

    <div class="md:col-span-3 flex items-center justify-end gap-2">
        <button type="submit" class="focus-ring rounded-xl bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700">
            {{ 'admin.table.apply_filters'|trans }}
        </button>
        {% if hasActiveFilters|default(false) %}
            <a href="{{ clearUrl }}" class="focus-ring rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">
                {{ 'admin.table.clear_filters'|trans }}
            </a>
        {% endif %}
    </div>
</form>
