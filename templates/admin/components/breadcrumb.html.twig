{% if items is defined and items is not empty %}
    {% from 'admin/components/_icons.html.twig' import icon %}
    <nav class="mb-4" aria-label="{{ 'admin.layout.breadcrumb_aria'|trans }}">
        <ol class="flex flex-wrap items-center gap-1 text-sm text-slate-500 dark:text-slate-400">
            {% for item in items %}
                <li class="inline-flex items-center gap-1">
                    {% if not loop.first %}
                        <span aria-hidden="true">{{ icon('chevron-down', 'h-3 w-3 -rotate-90') }}</span>
                    {% endif %}
                    {% if item.url is defined and item.url %}
                        <a href="{{ item.url }}" class="focus-ring rounded px-1 py-0.5 hover:text-slate-700 dark:hover:text-slate-200">{{ item.label }}</a>
                    {% else %}
                        <span class="font-medium text-slate-700 dark:text-slate-200">{{ item.label }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </nav>
{% endif %}
