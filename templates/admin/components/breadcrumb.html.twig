{% if items is defined and items is not empty %}
    <nav class="mb-4" aria-label="{{ 'admin.layout.breadcrumb_aria'|trans }}">
        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-fg-subtle">
            {% for item in items %}
                <li class="inline-flex items-center gap-1.5">
                    {% if not loop.first %}{{ ux_icon('lucide:chevron-right', {class: 'size-3.5'}) }}{% endif %}
                    {% if item.url is defined and item.url %}
                        <a href="{{ item.url }}" class="hover:text-fg">{{ item.label }}</a>
                    {% else %}
                        <span class="font-medium text-fg-muted" aria-current="page">{{ item.label }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </nav>
{% endif %}
