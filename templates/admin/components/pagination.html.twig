{% if page is defined and totalPages is defined and totalPages > 1 %}
    <nav class="mt-4 flex items-center justify-between text-sm" aria-label="{{ 'admin.layout.pagination_aria'|trans }}">
        <span class="text-fg-subtle">{{ 'admin.layout.page_of'|trans({'%page%': page, '%total%': totalPages}) }}</span>
        <div class="flex items-center gap-2">
            {% if page > 1 and prevUrl is defined %}
                <a href="{{ prevUrl }}" class="focus-ring rounded-xl border border-line-strong px-3 py-2 hover:bg-subtle">{{ 'common.previous'|trans }}</a>
            {% endif %}
            {% if page < totalPages and nextUrl is defined %}
                <a href="{{ nextUrl }}" class="focus-ring rounded-xl border border-line-strong px-3 py-2 hover:bg-subtle">{{ 'common.next'|trans }}</a>
            {% endif %}
        </div>
    </nav>
{% endif %}
