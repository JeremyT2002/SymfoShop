{% set cardClass = cardClass|default('') %}
<section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-admin dark:border-slate-800 dark:bg-slate-900 {{ cardClass }}">
    {% if title is defined or subtitle is defined %}
        <header class="mb-3">
            {% if title is defined %}<h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ title }}</h3>{% endif %}
            {% if subtitle is defined %}<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{{ subtitle }}</p>{% endif %}
        </header>
    {% endif %}
    {{ content|default('')|raw }}
</section>
