{# Params: title, subtitle, content (raw HTML), cardClass #}
<section class="card p-5 {{ cardClass|default('') }}">
    {% if title is defined or subtitle is defined %}
        <header class="mb-4">
            {% if title is defined %}<h3 class="text-sm font-semibold">{{ title }}</h3>{% endif %}
            {% if subtitle is defined %}<p class="mt-1 text-sm text-fg-muted">{{ subtitle }}</p>{% endif %}
        </header>
    {% endif %}
    {{ content|default('')|raw }}
</section>
