{% macro icon(name, classes = 'h-5 w-5') %}
    {% if name == 'home' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 9.5V20h13V9.5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'box' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M3.75 7.5 12 3l8.25 4.5L12 12 3.75 7.5Z" stroke-width="1.8" stroke-linejoin="round"/><path d="M3.75 7.5V16.5L12 21l8.25-4.5V7.5" stroke-width="1.8" stroke-linejoin="round"/></svg>
    {% elseif name == 'tag' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M20.25 13.5 13.5 20.25 3.75 10.5V3.75H10.5l9.75 9.75Z" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7.5" cy="7.5" r="1.25" fill="currentColor"/></svg>
    {% elseif name == 'shopping-cart' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M2.25 3.75h2l2.4 11.25h10.8l2.4-8.25H6.15" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="19.5" r="1.5" fill="currentColor"/><circle cx="17.25" cy="19.5" r="1.5" fill="currentColor"/></svg>
    {% elseif name == 'ticket' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M3.75 8.25h16.5v7.5h-16.5a2.25 2.25 0 0 0 0-4.5Z" stroke-width="1.8" stroke-linejoin="round"/><path d="M12 8.25v7.5" stroke-width="1.8" stroke-dasharray="2 2"/></svg>
    {% elseif name == 'users' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="9" cy="8.25" r="3" stroke-width="1.8"/><path d="M3.75 19.5c0-3 2.4-5.25 5.25-5.25s5.25 2.25 5.25 5.25" stroke-width="1.8" stroke-linecap="round"/><circle cx="17.25" cy="9" r="2.25" stroke-width="1.8"/><path d="M14.25 19.5c.3-2.1 1.95-3.75 4.5-3.75 1.05 0 1.95.3 2.55.75" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif name == 'star' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="m12 3.75 2.73 5.52 6.09.89-4.41 4.29 1.05 6.06L12 17.64l-5.46 2.87 1.05-6.06-4.41-4.29 6.09-.89L12 3.75Z" stroke-width="1.8" stroke-linejoin="round"/></svg>
    {% elseif name == 'life-buoy' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="8.25" stroke-width="1.8"/><circle cx="12" cy="12" r="3" stroke-width="1.8"/><path d="M6.3 6.3 9.9 9.9m4.2 4.2 3.6 3.6m0-11.4-3.6 3.6m-4.2 4.2-3.6 3.6" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif name == 'settings' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="m10.2 3 .6 2.1a7.8 7.8 0 0 1 2.4 0L13.8 3h2.4l.57 2.04a7.9 7.9 0 0 1 2.07 1.2l1.8-1.14 1.2 2.07-1.8 1.14c.18.78.18 1.59 0 2.37l1.8 1.14-1.2 2.07-1.8-1.14a7.9 7.9 0 0 1-2.07 1.2L16.2 21h-2.4l-.6-2.1a7.8 7.8 0 0 1-2.4 0L10.2 21H7.8l-.57-2.04a7.9 7.9 0 0 1-2.07-1.2l-1.8 1.14-1.2-2.07 1.8-1.14a7.8 7.8 0 0 1 0-2.37l-1.8-1.14 1.2-2.07 1.8 1.14a7.9 7.9 0 0 1 2.07-1.2L7.8 3h2.4Z" stroke-width="1.2"/><circle cx="12" cy="12" r="2.4" stroke-width="1.8"/></svg>
    {% elseif name == 'chart-line' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M3.75 19.5h16.5" stroke-width="1.8" stroke-linecap="round"/><path d="m5.25 15 4.5-4.5 3.75 3.75 5.25-6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'book-open' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M3.75 5.25A2.25 2.25 0 0 1 6 3h5.25v18H6a2.25 2.25 0 0 0-2.25 2.25V5.25Zm16.5 0A2.25 2.25 0 0 0 18 3h-5.25v18H18a2.25 2.25 0 0 1 2.25 2.25V5.25Z" stroke-width="1.8" stroke-linejoin="round"/></svg>
    {% elseif name == 'shopping-bag' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M6.75 8.25A5.25 5.25 0 0 1 12 3a5.25 5.25 0 0 1 5.25 5.25" stroke-width="1.8"/><path d="M4.5 8.25h15l-1.2 12h-12.6l-1.2-12Z" stroke-width="1.8" stroke-linejoin="round"/></svg>
    {% elseif name == 'x-mark' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif name == 'bars-3' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4.5 7.5h15m-15 4.5h15m-15 4.5h15" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif name == 'magnifying-glass' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="11" cy="11" r="6" stroke-width="1.8"/><path d="m16 16 4.25 4.25" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif name == 'moon' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M20.25 14.25A8.25 8.25 0 1 1 9.75 3.75a6.75 6.75 0 1 0 10.5 10.5Z" stroke-width="1.8" stroke-linejoin="round"/></svg>
    {% elseif name == 'sun' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke-width="1.8"/><path d="M12 2.25v2.5M12 19.25v2.5M4.75 4.75l1.77 1.77m10.96 10.96 1.77 1.77M2.25 12h2.5m14.5 0h2.5M4.75 19.25l1.77-1.77m10.96-10.96 1.77-1.77" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif name == 'bell' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M14.25 18.75a2.25 2.25 0 0 1-4.5 0m8.25-1.5H6l1.5-2.25v-3a4.5 4.5 0 1 1 9 0v3l1.5 2.25Z" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'check-circle' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="1.8"/><path d="m8.25 12.25 2.25 2.25 5.25-5.25" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'chevron-down' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'arrow-top-right-on-square' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M13.5 4.5h6v6m0-6-9.75 9.75" stroke-width="1.8" stroke-linecap="round"/><path d="M19.5 13.5v4.5a1.5 1.5 0 0 1-1.5 1.5H6a1.5 1.5 0 0 1-1.5-1.5V6A1.5 1.5 0 0 1 6 4.5h4.5" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif name == 'arrow-left-on-rectangle' %}
        <svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M14.25 8.25 10.5 12l3.75 3.75M3.75 12h6.75" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M12.75 4.5H18a2.25 2.25 0 0 1 2.25 2.25v10.5A2.25 2.25 0 0 1 18 19.5h-5.25" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% endif %}
{% endmacro %}
