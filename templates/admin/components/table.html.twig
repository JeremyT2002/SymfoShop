{% set columns = columns|default([]) %}
{% set rows = rows|default([]) %}
<div class="overflow-x-auto rounded-2xl border border-line bg-panel shadow-xs">
    <table class="min-w-full text-sm">
        <thead class="bg-subtle">
        <tr>
            {% for column in columns %}
                <th class="px-4 py-3 text-left font-semibold text-fg-subtle">{{ column }}</th>
            {% endfor %}
        </tr>
        </thead>
        <tbody class="divide-y divide-line">
            {% for row in rows %}
                <tr class="hover:bg-subtle">
                    {% for cell in row %}
                        <td class="px-4 py-3 text-fg-muted">{{ cell|raw }}</td>
                    {% endfor %}
                </tr>
            {% else %}
                <tr>
                    <td class="px-4 py-6 text-fg-subtle" colspan="{{ columns|length }}">{{ 'admin.layout.table_empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
