{% set columns = columns|default([]) %}
{% set rows = rows|default([]) %}
<div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-admin dark:border-slate-800 dark:bg-slate-900">
    <table class="min-w-full text-sm">
        <thead class="bg-slate-50 dark:bg-slate-800">
        <tr>
            {% for column in columns %}
                <th class="px-4 py-3 text-left font-semibold text-slate-500 dark:text-slate-300">{{ column }}</th>
            {% endfor %}
        </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
            {% for row in rows %}
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/70">
                    {% for cell in row %}
                        <td class="px-4 py-3 text-slate-700 dark:text-slate-200">{{ cell|raw }}</td>
                    {% endfor %}
                </tr>
            {% else %}
                <tr>
                    <td class="px-4 py-6 text-slate-500 dark:text-slate-400" colspan="{{ columns|length }}">{{ 'admin.layout.table_empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
