{%- set styles = {
    success: {class: 'alert-success', icon: 'lucide:circle-check'},
    error: {class: 'alert-error', icon: 'lucide:circle-alert'},
    danger: {class: 'alert-error', icon: 'lucide:circle-alert'},
    warning: {class: 'alert-warning', icon: 'lucide:triangle-alert'},
} -%}
{% for label, messages in app.flashes %}
    {%- set style = styles[label]|default({class: 'alert-info', icon: 'lucide:info'}) -%}
    {% for message in messages %}
        <div class="alert {{ style.class }} mb-4" role="status" x-data="{ show: true }" x-show="show">
            {{ ux_icon(style.icon, {class: 'mt-0.5 size-4'}) }}
            <p class="flex-1">{{ message|trans }}</p>
            <button type="button" class="-m-1 rounded-md p-1 opacity-60 hover:opacity-100" @click="show = false" aria-label="{{ 'common.close'|trans }}">{{ ux_icon('lucide:x', {class: 'size-4'}) }}</button>
        </div>
    {% endfor %}
{% endfor %}
