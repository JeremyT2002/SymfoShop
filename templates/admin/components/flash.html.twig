{% from 'admin/components/_icons.html.twig' import icon %}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        {% set tone = label == 'success' ? 'border-green-200 bg-green-50 text-green-800 dark:border-green-900/60 dark:bg-green-950/50 dark:text-green-300' : (label == 'error' ? 'border-red-200 bg-red-50 text-red-800 dark:border-red-900/60 dark:bg-red-950/50 dark:text-red-300' : 'border-primary-200 bg-primary-50 text-primary-800 dark:border-primary-900/60 dark:bg-primary-950/50 dark:text-primary-300') %}
        <div class="mb-4 rounded-xl border px-4 py-3 {{ tone }}">
            <div class="flex items-start gap-2 text-sm">
                <span class="mt-0.5">{{ label == 'success' ? icon('check-circle', 'h-4 w-4') : (label == 'error' ? icon('x-mark', 'h-4 w-4') : icon('bell', 'h-4 w-4')) }}</span>
                <span>{{ message|trans }}</span>
            </div>
        </div>
    {% endfor %}
{% endfor %}
