{% set id = id|default('admin-modal') %}
<div x-cloak x-show="{{ id }}Open" class="fixed inset-0 z-50 flex items-end justify-center bg-slate-900/60 p-4 sm:items-center" role="dialog" aria-modal="true" aria-labelledby="{{ id }}-title">
    <div @click.outside="{{ id }}Open = false" class="w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-5 shadow-admin dark:border-slate-700 dark:bg-slate-900">
        {% if title is defined %}<h3 id="{{ id }}-title" class="text-lg font-semibold">{{ title }}</h3>{% endif %}
        <div class="mt-2 text-sm text-slate-600 dark:text-slate-300">{{ content|default('')|raw }}</div>
        <div class="mt-4 flex justify-end gap-2">
            {{ actions|default('')|raw }}
        </div>
    </div>
</div>
