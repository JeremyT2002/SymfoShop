{% set tabs = tabs|default([]) %}
{% set active = active|default(tabs|first.id|default('')) %}
<div class="border-b border-line">
    <nav class="-mb-px flex flex-wrap gap-2">
        {% for tab in tabs %}
            <a
                href="{{ tab.url|default('#') }}"
                class="focus-ring inline-flex items-center border-b-2 px-3 py-2 text-sm font-medium {{ tab.id == active ? 'border-primary-600 text-primary-600 dark:text-primary-300' : 'border-transparent text-fg-subtle hover:text-fg ' }}"
            >
                {{ tab.label }}
            </a>
        {% endfor %}
    </nav>
</div>
