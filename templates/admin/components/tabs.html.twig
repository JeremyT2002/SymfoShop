{% set tabs = tabs|default([]) %}
{% set active = active|default(tabs|first.id|default('')) %}
<div class="border-b border-slate-200 dark:border-slate-800">
    <nav class="-mb-px flex flex-wrap gap-2">
        {% for tab in tabs %}
            <a
                href="{{ tab.url|default('#') }}"
                class="focus-ring inline-flex items-center border-b-2 px-3 py-2 text-sm font-medium {{ tab.id == active ? 'border-primary-600 text-primary-600 dark:text-primary-300' : 'border-transparent text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200' }}"
            >
                {{ tab.label }}
            </a>
        {% endfor %}
    </nav>
</div>
