{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'ui.two_factor.title'|trans }}{% endblock %}

{% block body %}
<div class="max-w-2xl">
    <h2 class="text-2xl font-bold">{{ 'ui.two_factor.title'|trans }}</h2>
    <p class="mt-1 text-sm text-fg-muted">{{ 'ui.two_factor.intro'|trans }}</p>

    {% if enabled %}
        <div class="card mt-6 p-6">
            <p class="flex items-center gap-2 font-medium">
                <span class="badge badge-success">{{ ux_icon('lucide:shield-check', {class: 'size-3.5'}) }}{{ 'ui.two_factor.status_on'|trans }}</span>
            </p>
            <p class="mt-3 text-sm text-fg-muted">{{ 'ui.two_factor.on_hint'|trans }}</p>

            <form method="post" action="{{ path('admin_two_factor_disable') }}" class="mt-6 flex flex-wrap items-end gap-3">
                <input type="hidden" name="_token" value="{{ csrf_token('two_factor_disable') }}">
                <div>
                    <label for="disable-code" class="label">{{ 'ui.two_factor.code'|trans }}</label>
                    <input id="disable-code" name="code" type="text" required autocomplete="one-time-code" inputmode="numeric" pattern="[0-9 ]*" maxlength="7" class="input w-40 font-mono">
                </div>
                <button type="submit" class="btn btn-danger">{{ 'ui.two_factor.disable'|trans }}</button>
            </form>
        </div>
    {% else %}
        <div class="card mt-6 p-6">
            <span class="badge badge-warning">{{ 'ui.two_factor.status_off'|trans }}</span>
            <ol class="mt-4 list-decimal space-y-4 pl-5 text-sm">
                <li>{{ 'ui.two_factor.step_app'|trans }}</li>
                <li>
                    {{ 'ui.two_factor.step_scan'|trans }}
                    <div class="mt-3 flex flex-wrap items-center gap-6">
                        <img src="{{ qrCode }}" alt="{{ 'ui.two_factor.qr_alt'|trans }}" width="180" height="180" class="rounded-lg bg-white p-3">
                        <div class="min-w-0">
                            <p class="text-xs text-fg-subtle">{{ 'ui.two_factor.manual_key'|trans }}</p>
                            <p class="mt-1 break-all font-mono text-sm select-all">{{ secret|split('', 4)|join(' ') }}</p>
                        </div>
                    </div>
                </li>
                <li>
                    {{ 'ui.two_factor.step_confirm'|trans }}
                    <form method="post" action="{{ path('admin_two_factor_enable') }}" class="mt-3 flex flex-wrap items-end gap-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('two_factor_enable') }}">
                        <div>
                            <label for="enable-code" class="label">{{ 'ui.two_factor.code'|trans }}</label>
                            <input id="enable-code" name="code" type="text" required autofocus autocomplete="one-time-code" inputmode="numeric" pattern="[0-9 ]*" maxlength="7" class="input w-40 font-mono">
                        </div>
                        <button type="submit" class="btn btn-primary">{{ 'ui.two_factor.enable'|trans }}</button>
                    </form>
                </li>
            </ol>
        </div>
    {% endif %}
</div>
{% endblock %}
