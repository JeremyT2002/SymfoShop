{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'admin.search.title'|trans }}{% endblock %}

{% block body %}
    <div class="mb-6">
        <h2 class="text-2xl font-bold">{{ 'admin.search.title'|trans }}</h2>
        <p class="mt-1 text-sm text-fg-subtle">{{ 'admin.search.subtitle'|trans }}</p>
    </div>

    <div class="rounded-2xl border border-line bg-panel p-4 shadow-xs">
        <form method="get" class="flex flex-col gap-2 sm:flex-row">
            <input type="search" name="q" value="{{ query }}" class="admin-form-input" placeholder="{{ 'admin.search.placeholder'|trans }}">
            <select name="type" class="admin-form-input sm:max-w-48">
                <option value="all" {% if type == 'all' %}selected{% endif %}>{{ 'admin.search.type.all'|trans }}</option>
                <option value="products" {% if type == 'products' %}selected{% endif %}>{{ 'admin.search.type.products'|trans }}</option>
                <option value="orders" {% if type == 'orders' %}selected{% endif %}>{{ 'admin.search.type.orders'|trans }}</option>
                <option value="users" {% if type == 'users' %}selected{% endif %}>{{ 'admin.search.type.users'|trans }}</option>
            </select>
            <button type="submit" class="rounded-xl bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700">{{ 'admin.search.submit'|trans }}</button>
        </form>
    </div>

    {% if query != '' %}
        <div class="mt-4 flex flex-wrap items-center gap-2">
            <a href="{{ path('admin_search', {q: query, type: 'all'}) }}" class="rounded-full px-3 py-1.5 text-xs font-semibold {{ type == 'all' ? 'bg-primary-600 text-white' : 'border border-line-strong text-fg-muted ' }}">
                {{ 'admin.search.type.all'|trans }} ({{ productsCount + ordersCount + usersCount }})
            </a>
            <a href="{{ path('admin_search', {q: query, type: 'products'}) }}" class="rounded-full px-3 py-1.5 text-xs font-semibold {{ type == 'products' ? 'bg-primary-600 text-white' : 'border border-line-strong text-fg-muted ' }}">
                {{ 'admin.search.type.products'|trans }} ({{ productsCount }})
            </a>
            <a href="{{ path('admin_search', {q: query, type: 'orders'}) }}" class="rounded-full px-3 py-1.5 text-xs font-semibold {{ type == 'orders' ? 'bg-primary-600 text-white' : 'border border-line-strong text-fg-muted ' }}">
                {{ 'admin.search.type.orders'|trans }} ({{ ordersCount }})
            </a>
            <a href="{{ path('admin_search', {q: query, type: 'users'}) }}" class="rounded-full px-3 py-1.5 text-xs font-semibold {{ type == 'users' ? 'bg-primary-600 text-white' : 'border border-line-strong text-fg-muted ' }}">
                {{ 'admin.search.type.users'|trans }} ({{ usersCount }})
            </a>
        </div>

        {% if type == 'all' %}
        <div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-3">
            <section class="rounded-2xl border border-line bg-panel p-4 shadow-xs">
                <h3 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">{{ 'admin.search.type.products'|trans }} ({{ products|length }})</h3>
                <div class="mt-3 space-y-2">
                    {% for product in products %}
                        <a href="{{ path('admin_products_show', {id: product.id}) }}" class="block rounded-lg border border-line px-3 py-2 text-sm hover:bg-subtle">
                            <div class="font-medium">{{ product.name }}</div>
                            <div class="text-xs text-fg-subtle">{{ product.slug }}</div>
                        </a>
                    {% else %}
                        <p class="text-sm text-fg-subtle">{{ 'admin.search.empty.products'|trans }}</p>
                    {% endfor %}
                </div>
            </section>

            <section class="rounded-2xl border border-line bg-panel p-4 shadow-xs">
                <h3 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">{{ 'admin.search.type.orders'|trans }} ({{ orders|length }})</h3>
                <div class="mt-3 space-y-2">
                    {% for order in orders %}
                        <a href="{{ path('admin_orders_show', {id: order.id}) }}" class="block rounded-lg border border-line px-3 py-2 text-sm hover:bg-subtle">
                            <div class="font-medium">{{ order.orderNumber }}</div>
                            <div class="text-xs text-fg-subtle">{{ order.email }}</div>
                        </a>
                    {% else %}
                        <p class="text-sm text-fg-subtle">{{ 'admin.search.empty.orders'|trans }}</p>
                    {% endfor %}
                </div>
            </section>

            <section class="rounded-2xl border border-line bg-panel p-4 shadow-xs">
                <h3 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">{{ 'admin.search.type.users'|trans }} ({{ users|length }})</h3>
                <div class="mt-3 space-y-2">
                    {% for user in users %}
                        <a href="{{ path('admin_users_show', {id: user.id}) }}" class="block rounded-lg border border-line px-3 py-2 text-sm hover:bg-subtle">
                            <div class="font-medium">{{ user.email }}</div>
                            <div class="text-xs text-fg-subtle">#{{ user.id }}</div>
                        </a>
                    {% else %}
                        <p class="text-sm text-fg-subtle">{{ 'admin.search.empty.users'|trans }}</p>
                    {% endfor %}
                </div>
            </section>
        </div>
        {% else %}
            <section class="mt-6 rounded-2xl border border-line bg-panel p-4 shadow-xs">
                {% if type == 'products' %}
                    <h3 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">{{ 'admin.search.type.products'|trans }} ({{ productsCount }})</h3>
                    <div class="mt-3 space-y-2">
                        {% for product in products %}
                            <a href="{{ path('admin_products_show', {id: product.id}) }}" class="block rounded-lg border border-line px-3 py-2 text-sm hover:bg-subtle">
                                <div class="font-medium">{{ product.name }}</div>
                                <div class="text-xs text-fg-subtle">{{ product.slug }}</div>
                            </a>
                        {% else %}
                            <p class="text-sm text-fg-subtle">{{ 'admin.search.empty.products'|trans }}</p>
                        {% endfor %}
                    </div>
                {% elseif type == 'orders' %}
                    <h3 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">{{ 'admin.search.type.orders'|trans }} ({{ ordersCount }})</h3>
                    <div class="mt-3 space-y-2">
                        {% for order in orders %}
                            <a href="{{ path('admin_orders_show', {id: order.id}) }}" class="block rounded-lg border border-line px-3 py-2 text-sm hover:bg-subtle">
                                <div class="font-medium">{{ order.orderNumber }}</div>
                                <div class="text-xs text-fg-subtle">{{ order.email }}</div>
                            </a>
                        {% else %}
                            <p class="text-sm text-fg-subtle">{{ 'admin.search.empty.orders'|trans }}</p>
                        {% endfor %}
                    </div>
                {% else %}
                    <h3 class="text-sm font-semibold uppercase tracking-wide text-fg-subtle">{{ 'admin.search.type.users'|trans }} ({{ usersCount }})</h3>
                    <div class="mt-3 space-y-2">
                        {% for user in users %}
                            <a href="{{ path('admin_users_show', {id: user.id}) }}" class="block rounded-lg border border-line px-3 py-2 text-sm hover:bg-subtle">
                                <div class="font-medium">{{ user.email }}</div>
                                <div class="text-xs text-fg-subtle">#{{ user.id }}</div>
                            </a>
                        {% else %}
                            <p class="text-sm text-fg-subtle">{{ 'admin.search.empty.users'|trans }}</p>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            {% if totalPages > 1 %}
                <div class="mt-4 flex items-center justify-between rounded-xl border border-line bg-panel px-4 py-2 text-sm">
                    <span class="text-fg-subtle">{{ 'admin.layout.page_of'|trans({'%page%': page, '%total%': totalPages}) }}</span>
                    <div class="flex items-center gap-2">
                        {% if page > 1 %}
                            <a href="{{ path('admin_search', {q: query, type: type, page: page - 1}) }}" class="rounded-lg border border-line-strong px-3 py-1.5 hover:bg-subtle">{{ 'admin.search.pagination.previous'|trans }}</a>
                        {% endif %}
                        {% if page < totalPages %}
                            <a href="{{ path('admin_search', {q: query, type: type, page: page + 1}) }}" class="rounded-lg border border-line-strong px-3 py-1.5 hover:bg-subtle">{{ 'admin.search.pagination.next'|trans }}</a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endif %}
    {% else %}
        <div class="mt-6 rounded-2xl border border-dashed border-line-strong bg-panel p-8 text-center">
            <p class="text-sm font-medium text-fg-muted">{{ 'admin.search.empty.initial_title'|trans }}</p>
            <p class="mt-1 text-sm text-fg-subtle">{{ 'admin.search.empty.initial_hint'|trans }}</p>
        </div>
    {% endif %}
{% endblock %}

