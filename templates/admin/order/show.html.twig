{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'admin.orders.show.page_title'|trans({'%number%': order.orderNumber}) }}{% endblock %}

{% block body %}
    <div class="mb-6 flex items-center justify-between gap-3">
        <div>
            <a href="{{ path('admin_orders_index') }}" class="mb-2 inline-flex items-center text-sm text-fg-subtle hover:text-slate-800">
                <span class="mr-1">←</span> {{ 'admin.orders.show.back'|trans }}
            </a>
            <h2 class="text-2xl font-bold">{{ 'admin.orders.show.heading'|trans({'%number%': order.orderNumber}) }}</h2>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="text-lg font-semibold text-fg mb-4">{{ 'admin.orders.show.items_title'|trans }}</h3>
                {% if order.items|length > 0 %}
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-line">
                            <thead class="bg-subtle">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-fg-subtle uppercase">{{ 'admin.orders.show.product'|trans }}</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-fg-subtle uppercase">{{ 'admin.orders.show.sku'|trans }}</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-fg-subtle uppercase">{{ 'admin.orders.show.quantity'|trans }}</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-fg-subtle uppercase">{{ 'admin.orders.show.price'|trans }}</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-fg-subtle uppercase">{{ 'admin.orders.table.total'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody class="bg-panel divide-y divide-line">
                                {% for item in order.items %}
                                    <tr>
                                        <td class="px-4 py-3 text-sm text-fg">{{ item.nameSnapshot }}</td>
                                        <td class="px-4 py-3 text-sm text-fg-subtle">{{ item.sku }}</td>
                                        <td class="px-4 py-3 text-sm text-fg-subtle">{{ item.quantity }}</td>
                                        <td class="px-4 py-3 text-sm text-fg-subtle">
                                            {{ (item.unitPriceAmount / 100)|number_format(2, '.', ',') }} {{ order.currency }}
                                        </td>
                                        <td class="px-4 py-3 text-sm font-medium text-fg">
                                            {{ (item.totalAmount / 100)|number_format(2, '.', ',') }} {{ order.currency }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-sm text-fg-subtle">{{ 'admin.orders.show.items_empty'|trans }}</p>
                {% endif %}
            </div>

            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="text-lg font-semibold text-fg mb-4">{{ 'admin.orders.show.summary_title'|trans }}</h3>
                <dl class="space-y-3">
                    <div class="flex justify-between">
                        <dt class="text-sm text-fg-muted">{{ 'admin.orders.show.subtotal'|trans }}</dt>
                        <dd class="text-sm font-medium text-fg">
                            {{ (order.subtotal / 100)|number_format(2, '.', ',') }} {{ order.currency }}
                        </dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-sm text-fg-muted">{{ 'admin.orders.show.tax'|trans }}</dt>
                        <dd class="text-sm font-medium text-fg">
                            {{ (order.taxTotal / 100)|number_format(2, '.', ',') }} {{ order.currency }}
                        </dd>
                    </div>
                    <div class="flex justify-between pt-3 border-t border-line">
                        <dt class="text-sm font-semibold text-fg">{{ 'admin.orders.show.grand_total'|trans }}</dt>
                        <dd class="text-sm font-semibold text-fg">
                            {{ (order.grandTotal / 100)|number_format(2, '.', ',') }} {{ order.currency }}
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="space-y-6">
            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="text-lg font-semibold text-fg mb-4">{{ 'admin.orders.show.info_title'|trans }}</h3>
                <dl class="space-y-3">
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">{{ 'admin.orders.show.order_number_label'|trans }}</dt>
                        <dd class="mt-1 text-sm text-fg">{{ order.orderNumber }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">{{ 'admin.orders.show.customer_email'|trans }}</dt>
                        <dd class="mt-1 text-sm text-fg">{{ order.email }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">{{ 'ui.order.shipping_address'|trans }}</dt>
                        <dd class="mt-1 text-sm leading-6 text-fg">{% include 'components/_address.html.twig' with {order: order} only %}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">{{ 'admin.orders.show.status_label'|trans }}</dt>
                        <dd class="mt-1">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                                {% if order.status == 'completed' %}bg-green-100 text-green-800
                                {% elseif order.status == 'shipped' %}bg-blue-100 text-primary-800
                                {% elseif order.status == 'processing' %}bg-yellow-100 text-yellow-800
                                {% elseif order.status == 'cancelled' %}bg-red-100 text-red-800
                                {% else %}bg-gray-100 text-gray-800{% endif %}">
                                {{ ('admin.orders.status.' ~ order.status)|trans }}
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">{{ 'admin.orders.show.created'|trans }}</dt>
                        <dd class="mt-1 text-sm text-fg">{{ order.createdAt|date('Y-m-d H:i') }}</dd>
                    </div>
                    {% if order.trackingNumber %}
                        <div>
                            <dt class="text-sm font-medium text-fg-subtle">{{ 'admin.orders.show.tracking_number'|trans }}</dt>
                            <dd class="mt-1 text-sm text-fg">{{ order.trackingNumber }}</dd>
                        </div>
                    {% endif %}
                    {% if order.carrier %}
                        <div>
                            <dt class="text-sm font-medium text-fg-subtle">{{ 'admin.orders.show.carrier'|trans }}</dt>
                            <dd class="mt-1 text-sm text-fg">{{ order.carrier }}</dd>
                        </div>
                    {% endif %}
                </dl>
            </div>

            {% if invoice %}
            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="text-lg font-semibold text-fg mb-4">{{ 'admin.orders.show.invoice_title'|trans }}</h3>
                <dl class="space-y-3 mb-4">
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">{{ 'admin.orders.show.invoice_number'|trans }}</dt>
                        <dd class="mt-1 text-sm text-fg font-mono">{{ invoice.invoiceNumber }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-fg-subtle">{{ 'admin.orders.show.invoice_created'|trans }}</dt>
                        <dd class="mt-1 text-sm text-fg">{{ invoice.createdAt|date('Y-m-d H:i') }}</dd>
                    </div>
                </dl>
                <div class="space-y-2">
                        <a href="{{ path('account_invoice_download', { invoiceNumber: invoice.invoiceNumber }) }}"
                       class="block w-full text-center bg-subtle text-fg px-4 py-2 rounded-lg hover:bg-line transition-colors text-sm font-medium">
                        {{ ux_icon('lucide:file-text', {class: 'size-4 mr-1'}) }} {{ 'admin.orders.show.download_pdf'|trans }}
                    </a>
                </div>
                <p class="mt-3 text-xs text-fg-subtle">{{ 'admin.orders.show.invoice_hint_html'|trans({'%url%': path('admin_orders_index')})|raw }}</p>
            </div>
            {% endif %}

            {% if refunds is not empty or refundable > 0 %}
            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="text-lg font-semibold text-fg mb-4">{{ 'ui.refund.title'|trans }}</h3>

                {% if refunds is not empty %}
                    <ul class="mb-4 divide-y divide-line text-sm">
                        {% for refund in refunds %}
                            <li class="flex items-start justify-between gap-3 py-2">
                                <div class="min-w-0">
                                    <a href="{{ path('account_credit_note_download', {number: refund.creditNoteNumber}) }}" class="link font-mono">{{ refund.creditNoteNumber }}</a>
                                    <p class="text-xs text-fg-subtle">
                                        {{ refund.createdAt|date('Y-m-d H:i') }} · {{ refund.provider == 'manual' ? 'ui.refund.manual'|trans : refund.provider|capitalize }}
                                        {% if refund.status == 'pending' %} · <span class="badge badge-warning">{{ 'ui.refund.pending'|trans }}</span>{% endif %}
                                        {% if refund.restocked %} · {{ 'ui.refund.restocked'|trans }}{% endif %}
                                    </p>
                                    {% if refund.reason %}<p class="mt-0.5 text-xs text-fg-muted">{{ refund.reason }}</p>{% endif %}
                                </div>
                                <span class="shrink-0 font-medium tabular-nums">&minus;{{ refund.amount|money(refund.currency) }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if refundable > 0 and is_granted('ROLE_SUPPORT') %}
                    <form method="post" action="{{ path('admin_orders_refund', {id: order.id}) }}" class="space-y-3"
                          onsubmit="return confirm({{ 'ui.refund.confirm'|trans|json_encode }})">
                        <input type="hidden" name="_token" value="{{ csrf_token('refund_' ~ order.id) }}">
                        <div>
                            <label for="refund-amount" class="label">{{ 'ui.refund.amount'|trans }} ({{ order.currency }})</label>
                            <input type="text" inputmode="decimal" id="refund-amount" name="amount" required class="input"
                                   value="{{ (refundable / 100)|number_format(2, '.', '') }}" pattern="[0-9]+([.,][0-9]{1,2})?">
                            <p class="mt-1 text-xs text-fg-subtle">{{ 'ui.refund.max'|trans({'%amount%': refundable|money(order.currency)}) }}</p>
                        </div>
                        <div>
                            <label for="refund-reason" class="label">{{ 'ui.refund.reason'|trans }}</label>
                            <input type="text" id="refund-reason" name="reason" maxlength="500" class="input">
                        </div>
                        {% if returnRequests is not empty %}
                            <div>
                                <label for="refund-return" class="label">{{ 'ui.refund.return_request'|trans }}</label>
                                <select id="refund-return" name="return_request" class="select">
                                    <option value="">—</option>
                                    {% for r in returnRequests %}
                                        <option value="{{ r.id }}" {{ loop.first and r.status != 'refunded' ? 'selected' }}>{{ r.createdAt|date('Y-m-d') }} · {{ r.reason|length > 40 ? r.reason|slice(0, 40) ~ '…' : r.reason }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}
                        <label class="flex items-center gap-2 text-sm">
                            <input type="checkbox" name="restock" value="1" class="rounded border-line-strong">
                            {{ 'ui.refund.restock'|trans }}
                        </label>
                        <p class="text-xs text-fg-subtle">{{ (refundsAutomatically ? 'ui.refund.hint_provider' : 'ui.refund.hint_manual')|trans }}</p>
                        <button type="submit" class="btn btn-danger w-full">{{ ux_icon('lucide:undo-2', {class: 'size-4'}) }}{{ 'ui.refund.submit'|trans }}</button>
                    </form>
                {% endif %}
            </div>
            {% endif %}

            <div class="rounded-2xl border border-line bg-panel p-6 shadow-xs">
                <h3 class="text-lg font-semibold text-fg mb-4">{{ 'admin.orders.show.update_status_title'|trans }}</h3>
                {{ form_start(statusForm) }}
                    {{ form_widget(statusForm.status, {
                        attr: {
                            class: 'w-full px-4 py-2 border border-line-strong rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent mb-3'
                        }
                    }) }}
                    <div class="mb-3 space-y-3">
                        {{ form_row(statusForm.carrier) }}
                        {{ form_row(statusForm.trackingNumber, {help: 'ui.order_status.tracking_hint'|trans}) }}
                    </div>
                    <datalist id="carrier-suggestions"><option value="DHL"><option value="DPD"><option value="UPS"><option value="Hermes"><option value="GLS"><option value="FedEx"></datalist>
                    <button type="submit" class="w-full rounded-xl bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700">
                        {{ 'admin.orders.show.update_status_submit'|trans }}
                    </button>
                {{ form_end(statusForm) }}
            </div>
        </div>
    </div>
{% endblock %}
