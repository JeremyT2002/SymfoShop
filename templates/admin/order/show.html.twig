{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'admin.orders.show.page_title'|trans({'%number%': order.orderNumber}) }}{% endblock %}

{% block body %}
    <div class="mb-6 flex items-center justify-between">
        <div>
            <a href="{{ path('admin_orders_index') }}" class="text-gray-600 hover:text-gray-900 mb-2 inline-block">
                <i class="fas fa-arrow-left"></i> {{ 'admin.orders.show.back'|trans }}
            </a>
            <h2 class="text-2xl font-bold text-gray-900">{{ 'admin.orders.show.heading'|trans({'%number%': order.orderNumber}) }}</h2>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">{{ 'admin.orders.show.items_title'|trans }}</h3>
                {% if order.items|length > 0 %}
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ 'admin.orders.show.product'|trans }}</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ 'admin.orders.show.sku'|trans }}</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ 'admin.orders.show.quantity'|trans }}</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ 'admin.orders.show.price'|trans }}</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ 'admin.orders.table.total'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                {% for item in order.items %}
                                    <tr>
                                        <td class="px-4 py-3 text-sm text-gray-900">{{ item.nameSnapshot }}</td>
                                        <td class="px-4 py-3 text-sm text-gray-500">{{ item.sku }}</td>
                                        <td class="px-4 py-3 text-sm text-gray-500">{{ item.quantity }}</td>
                                        <td class="px-4 py-3 text-sm text-gray-500">
                                            {{ (item.unitPriceAmount / 100)|number_format(2, '.', ',') }} {{ order.currency }}
                                        </td>
                                        <td class="px-4 py-3 text-sm font-medium text-gray-900">
                                            {{ (item.totalAmount / 100)|number_format(2, '.', ',') }} {{ order.currency }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-sm text-gray-500">{{ 'admin.orders.show.items_empty'|trans }}</p>
                {% endif %}
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">{{ 'admin.orders.show.summary_title'|trans }}</h3>
                <dl class="space-y-3">
                    <div class="flex justify-between">
                        <dt class="text-sm text-gray-600">{{ 'admin.orders.show.subtotal'|trans }}</dt>
                        <dd class="text-sm font-medium text-gray-900">
                            {{ (order.subtotal / 100)|number_format(2, '.', ',') }} {{ order.currency }}
                        </dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-sm text-gray-600">{{ 'admin.orders.show.tax'|trans }}</dt>
                        <dd class="text-sm font-medium text-gray-900">
                            {{ (order.taxTotal / 100)|number_format(2, '.', ',') }} {{ order.currency }}
                        </dd>
                    </div>
                    <div class="flex justify-between pt-3 border-t border-gray-200">
                        <dt class="text-sm font-semibold text-gray-900">{{ 'admin.orders.show.grand_total'|trans }}</dt>
                        <dd class="text-sm font-semibold text-gray-900">
                            {{ (order.grandTotal / 100)|number_format(2, '.', ',') }} {{ order.currency }}
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">{{ 'admin.orders.show.info_title'|trans }}</h3>
                <dl class="space-y-3">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">{{ 'admin.orders.show.order_number_label'|trans }}</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ order.orderNumber }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">{{ 'admin.orders.show.customer_email'|trans }}</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ order.email }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">{{ 'admin.orders.show.status_label'|trans }}</dt>
                        <dd class="mt-1">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                                {% if order.status == 'completed' %}bg-green-100 text-green-800
                                {% elseif order.status == 'shipped' %}bg-blue-100 text-blue-800
                                {% elseif order.status == 'processing' %}bg-yellow-100 text-yellow-800
                                {% elseif order.status == 'cancelled' %}bg-red-100 text-red-800
                                {% else %}bg-gray-100 text-gray-800{% endif %}">
                                {{ ('admin.orders.status.' ~ order.status)|trans }}
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">{{ 'admin.orders.show.created'|trans }}</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ order.createdAt|date('Y-m-d H:i') }}</dd>
                    </div>
                    {% if order.trackingNumber %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">{{ 'admin.orders.show.tracking_number'|trans }}</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ order.trackingNumber }}</dd>
                        </div>
                    {% endif %}
                    {% if order.carrier %}
                        <div>
                            <dt class="text-sm font-medium text-gray-500">{{ 'admin.orders.show.carrier'|trans }}</dt>
                            <dd class="mt-1 text-sm text-gray-900">{{ order.carrier }}</dd>
                        </div>
                    {% endif %}
                </dl>
            </div>

            {% if invoice %}
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">{{ 'admin.orders.show.invoice_title'|trans }}</h3>
                <dl class="space-y-3 mb-4">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">{{ 'admin.orders.show.invoice_number'|trans }}</dt>
                        <dd class="mt-1 text-sm text-gray-900 font-mono">{{ invoice.invoiceNumber }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">{{ 'admin.orders.show.invoice_created'|trans }}</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ invoice.createdAt|date('Y-m-d H:i') }}</dd>
                    </div>
                </dl>
                <div class="space-y-2">
                    <a href="{{ path('invoice_download', { invoiceNumber: invoice.invoiceNumber }) }}"
                       class="block w-full text-center bg-gray-100 text-gray-800 px-4 py-2 rounded-lg hover:bg-gray-200 transition-colors text-sm font-medium">
                        <i class="fas fa-file-pdf mr-1"></i> {{ 'admin.orders.show.download_pdf'|trans }}
                    </a>
                </div>
                <p class="mt-3 text-xs text-gray-500">{{ 'admin.orders.show.invoice_hint_html'|trans({'%url%': path('admin_orders_index')})|raw }}</p>
            </div>
            {% endif %}

            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">{{ 'admin.orders.show.update_status_title'|trans }}</h3>
                {{ form_start(statusForm) }}
                    {{ form_widget(statusForm.status, {
                        attr: {
                            class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent mb-3'
                        }
                    }) }}
                    <button type="submit" class="w-full bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
                        {{ 'admin.orders.show.update_status_submit'|trans }}
                    </button>
                {{ form_end(statusForm) }}
            </div>
        </div>
    </div>
{% endblock %}
