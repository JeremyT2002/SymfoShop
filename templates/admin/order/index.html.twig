{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'admin.orders.page_title'|trans }}{% endblock %}

{% block body %}
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900">{{ 'admin.orders.heading'|trans }}</h2>
            <p class="text-gray-600 mt-1">{{ 'admin.orders.subtitle'|trans }}</p>
        </div>
        <form method="post" action="{{ path('admin_orders_regenerate_all_invoices') }}"
              class="shrink-0"
              onsubmit="return confirm({{ 'admin.orders.regenerate_all_confirm'|trans|json_encode|raw }});">
            <input type="hidden" name="_token" value="{{ csrf_token('regenerate_all_invoices') }}">
            <button type="submit" class="inline-flex items-center justify-center gap-2 bg-amber-600 text-white px-4 py-2.5 rounded-lg hover:bg-amber-700 transition-colors text-sm font-medium whitespace-nowrap">
                <i class="fas fa-sync-alt"></i>
                {{ 'admin.orders.regenerate_all_invoices'|trans }}
            </button>
        </form>
    </div>

    <div class="bg-white rounded-lg shadow p-4 mb-6">
        {{ form_start(filterForm, { method: 'get', attr: { class: 'flex items-center space-x-4' } }) }}
            <div class="flex-1">
                {{ form_widget(filterForm.search, {
                    attr: {
                        placeholder: 'admin.orders.search_placeholder'|trans,
                        class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent'
                    }
                }) }}
            </div>
            <div>
                {{ form_widget(filterForm.status, {
                    attr: {
                        class: 'px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent'
                    }
                }) }}
            </div>
            <button type="submit" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition-colors">
                <i class="fas fa-filter"></i> {{ 'admin.orders.filter'|trans }}
            </button>
            {% if search or status %}
                <a href="{{ path('admin_orders_index') }}" class="text-gray-600 hover:text-gray-900 px-4 py-2">
                    {{ 'admin.orders.clear'|trans }}
                </a>
            {% endif %}
        {{ form_end(filterForm) }}
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.orders.table.order_number'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.orders.table.customer'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.orders.table.total'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.orders.table.status'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.orders.table.date'|trans }}</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.orders.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% if orders|length > 0 %}
                    {% for order in orders %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                {{ order.orderNumber }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                {{ order.email }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                {{ (order.grandTotal / 100)|number_format(2, '.', ',') }} {{ order.currency }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                                    {% if order.status == 'completed' %}bg-green-100 text-green-800
                                    {% elseif order.status == 'shipped' %}bg-blue-100 text-blue-800
                                    {% elseif order.status == 'processing' %}bg-yellow-100 text-yellow-800
                                    {% elseif order.status == 'cancelled' %}bg-red-100 text-red-800
                                    {% else %}bg-gray-100 text-gray-800{% endif %}">
                                    {{ ('admin.orders.status.' ~ order.status)|trans }}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                {{ order.createdAt|date('Y-m-d H:i') }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a href="{{ path('admin_orders_show', {id: order.id}) }}" class="text-blue-600 hover:text-blue-900">
                                    <i class="fas fa-eye"></i> {{ 'admin.orders.view'|trans }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                            <i class="fas fa-shopping-cart text-4xl mb-4 text-gray-300"></i>
                            <p class="text-lg font-medium">{{ 'admin.orders.empty'|trans }}</p>
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>

    {% if totalPages > 1 %}
        <div class="mt-6 flex items-center justify-between">
            <div class="text-sm text-gray-700">
                {{ 'admin.orders.pagination.showing'|trans({'%page%': currentPage, '%total%': totalPages}) }}
            </div>
            <div class="flex space-x-2">
                {% if currentPage > 1 %}
                    <a href="{{ path('admin_orders_index', {page: currentPage - 1, status: status, search: search}) }}"
                       class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">
                        {{ 'admin.orders.pagination.previous'|trans }}
                    </a>
                {% endif %}
                {% if currentPage < totalPages %}
                    <a href="{{ path('admin_orders_index', {page: currentPage + 1, status: status, search: search}) }}"
                       class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">
                        {{ 'admin.orders.pagination.next'|trans }}
                    </a>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}
