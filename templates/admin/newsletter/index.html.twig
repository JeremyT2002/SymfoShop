{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'ui.newsletter.admin_title'|trans }}{% endblock %}

{% block body %}
<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-semibold">{{ 'ui.newsletter.admin_title'|trans }}</h1>
        <p class="mt-1 text-sm text-fg-muted">{{ 'ui.newsletter.admin_summary'|trans({'%active%': activeCount, '%total%': subscribers|length}) }}</p>
    </div>
    <a href="{{ path('admin_newsletter_export') }}" class="btn btn-secondary">{{ ux_icon('lucide:download', {class: 'size-4'}) }}CSV</a>
</div>

{% if subscribers is empty %}
    <div class="mt-6">
        {% include 'admin/components/empty-state.html.twig' with {title: 'ui.newsletter.admin_empty'|trans, iconName: 'mail'} %}
    </div>
{% else %}
    <div class="card mt-6 overflow-x-auto">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">{{ 'checkout.fields.email'|trans }}</th>
                    <th scope="col">{{ 'ui.newsletter.admin_status'|trans }}</th>
                    <th scope="col">{{ 'nav.language'|trans }}</th>
                    <th scope="col">{{ 'ui.newsletter.admin_signed_up'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for subscriber in subscribers %}
                    <tr>
                        <td class="font-medium">{{ subscriber.email }}</td>
                        <td>
                            {% if subscriber.active %}
                                <span class="badge badge-success">{{ 'ui.newsletter.status_active'|trans }}</span>
                            {% elseif subscriber.unsubscribedAt %}
                                <span class="badge badge-neutral">{{ 'ui.newsletter.status_unsubscribed'|trans }}</span>
                            {% else %}
                                <span class="badge badge-warning">{{ 'ui.newsletter.status_pending'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="uppercase text-fg-muted">{{ subscriber.locale }}</td>
                        <td class="text-fg-muted">{{ subscriber.createdAt|date('d.m.Y H:i') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}
