<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <meta name="theme-color" content="#fafafa">
    <title>{% block title %}{{ block('page_title') }} · {{ 'admin.brand.name'|trans }}{% endblock %}</title>
    <script>
        {# Same storage key as the storefront; migrates the old admin-only key once. #}
        (function () {
            try {
                var key = 'symfoshop-color-scheme';
                var stored = localStorage.getItem(key);
                if (stored !== 'dark' && stored !== 'light') {
                    var legacy = localStorage.getItem('symfoshop_admin_theme');
                    if (legacy === 'dark' || legacy === 'light') {
                        stored = legacy;
                        localStorage.setItem(key, legacy);
                    }
                }
                var dark = stored === 'dark' || (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.classList.toggle('dark', dark);
            } catch (e) {}
        })();
    </script>
    {% block importmap %}{{ importmap('admin') }}{% endblock %}
    {% block stylesheets %}{% endblock %}
</head>
<body class="admin min-h-screen" data-page="{% block js_page %}{% endblock %}"
      x-data="{ sidebarOpen: false }" @keydown.escape.window="sidebarOpen = false">
    {% from 'admin/components/_icons.html.twig' import icon %}
    {%- set adminNotifications = admin_notifications() -%}
    {%- set currentRoute = app.request.attributes.get('_route')|default('') -%}
    {%- set navGroups = [
        {label: null, items: [
            {route: 'admin', key: 'admin.nav.dashboard', icon: 'home'},
        ]},
        {label: 'admin.nav.catalog', items: [
            {route: 'admin_products_index', key: 'admin.nav.products', icon: 'box'},
            {route: 'admin_categories_index', key: 'admin.nav.categories', icon: 'tag'},
            {route: 'admin_reviews_index', key: 'admin.nav.reviews', icon: 'star'},
        ]},
        {label: 'admin.nav.sales', items: [
            {route: 'admin_orders_index', key: 'admin.nav.orders', icon: 'shopping-cart'},
            {route: 'admin_return_requests_index', key: 'admin.return_requests.page_title', icon: 'undo'},
            {route: 'admin_coupons_index', key: 'admin.nav.coupons', icon: 'ticket'},
            {route: 'admin_newsletter_index', key: 'ui.newsletter.admin_title', icon: 'mail'},
            {route: 'admin_users_index', key: 'admin.nav.users', icon: 'users'},
            {route: 'admin_support_index', key: 'admin.nav.support_inbox', icon: 'life-buoy'},
        ]},
        {label: 'admin.nav.system', items: [
            {route: 'admin_settings', key: 'admin.settings.nav', icon: 'settings'},
            {route: 'admin_theme_editor', key: 'admin.nav.theme_editor', icon: 'palette'},
            {route: 'admin_payment_methods_index', key: 'admin.payment_methods.title', icon: 'credit-card'},
            {route: 'admin_shipping_methods_index', key: 'admin.shipping_methods.title', icon: 'truck'},
            {route: 'admin_api_keys_index', key: 'admin.nav.api_keys', icon: 'key'},
            {route: 'admin_audit_log', key: 'admin.nav.audit_log', icon: 'history'},
            {route: 'admin_api_docs', key: 'admin.nav.api_documentation', icon: 'book-open'},
        ]},
    ] -%}

    {# Mobile backdrop #}
    <div x-cloak x-show="sidebarOpen" x-transition.opacity class="fixed inset-0 z-40 bg-black/40 lg:hidden" @click="sidebarOpen = false" aria-hidden="true"></div>

    <aside class="fixed inset-y-0 left-0 z-50 flex w-64 flex-col border-r border-line bg-panel transition-transform duration-200 lg:translate-x-0"
           :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'"
           aria-label="{{ 'admin.layout.navigation_aria'|trans }}">
        <div class="flex h-16 shrink-0 items-center justify-between gap-2 border-b border-line px-4">
            <a href="{{ path('admin') }}" class="flex items-center gap-2.5 rounded-lg">
                <span class="flex size-8 items-center justify-center rounded-lg bg-fg text-canvas">{{ icon('shopping-bag', 'size-4') }}</span>
                <span class="leading-tight">
                    <span class="block text-sm font-semibold">{{ 'admin.brand.name'|trans }}</span>
                    <span class="block text-xs text-fg-subtle">{{ 'admin.layout.panel_subtitle'|trans }}</span>
                </span>
            </a>
            <button type="button" class="btn btn-ghost btn-icon lg:hidden" @click="sidebarOpen = false" aria-label="{{ 'admin.layout.close_sidebar'|trans }}">{{ icon('x-mark', 'size-5') }}</button>
        </div>

        <nav class="flex-1 space-y-6 overflow-y-auto px-3 py-4">
            {% for group in navGroups %}
                <div>
                    {% if group.label %}
                        <p class="mb-1 px-3 text-[0.6875rem] font-semibold tracking-wider text-fg-subtle uppercase">{{ group.label|trans }}</p>
                    {% endif %}
                    <ul class="space-y-0.5" role="list">
                        {% for item in group.items %}
                            {%- set isActive = currentRoute == item.route or (item.route != 'admin' and currentRoute starts with (item.route|replace({'_index': ''}))) -%}
                            <li>
                                <a href="{{ path(item.route) }}" {% if isActive %}aria-current="page"{% endif %}
                                   class="group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors {{ isActive ? 'bg-subtle text-fg' : 'text-fg-muted hover:bg-subtle hover:text-fg' }}">
                                    <span class="{{ isActive ? 'text-primary-600 dark:text-primary-400' : 'text-fg-subtle group-hover:text-fg' }}">{{ icon(item.icon, 'size-[1.125rem]') }}</span>
                                    {{ item.key|trans }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </nav>

        <div class="shrink-0 border-t border-line p-3">
            <a href="{{ path('catalog_home') }}" target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-fg-muted hover:bg-subtle hover:text-fg">
                {{ icon('arrow-top-right-on-square', 'size-[1.125rem]') }}{{ 'admin.layout.view_storefront'|trans }}
            </a>
        </div>
    </aside>

    <div class="lg:pl-64">
        <header class="sticky top-0 z-30 flex h-16 items-center gap-3 border-b border-line bg-panel/85 px-4 backdrop-blur-lg sm:px-6 lg:px-8">
            <button type="button" class="btn btn-ghost btn-icon -ml-2 lg:hidden" @click="sidebarOpen = true" aria-label="{{ 'admin.layout.open_sidebar'|trans }}">{{ icon('bars-3', 'size-5') }}</button>

            <form action="{{ path('admin_search') }}" method="get" role="search" class="relative max-w-md flex-1">
                <label for="admin-search" class="sr-only">{{ 'admin.layout.search_aria'|trans }}</label>
                <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-fg-subtle">{{ icon('magnifying-glass', 'size-4') }}</span>
                <input id="admin-search" name="q" type="search" autocomplete="off" value="{{ app.request.query.get('q')|default('') }}"
                       placeholder="{{ 'admin.layout.search_placeholder'|trans }}"
                       class="h-10 w-full rounded-lg border border-transparent bg-subtle pr-3 pl-9 text-sm placeholder:text-fg-subtle focus:border-primary-500 focus:bg-panel focus:outline-none">
            </form>

            <div class="ml-auto flex items-center gap-1">
                {# Language #}
                <div class="relative" x-data="{ open: false }" @click.outside="open = false" @keydown.escape="open = false">
                    <button type="button" class="btn btn-ghost h-10 px-2.5 text-xs uppercase" @click="open = !open" :aria-expanded="open" aria-haspopup="true" aria-label="{{ 'nav.language'|trans }}">
                        {{ ux_icon('lucide:globe', {class: 'size-4'}) }}{{ app.request.locale }}
                    </button>
                    <div x-cloak x-show="open" x-transition.origin.top.right class="absolute right-0 mt-2 w-36 rounded-xl border border-line bg-panel p-1 shadow-lg shadow-black/5">
                        {% for code, label in {en: 'English', de: 'Deutsch', fr: 'Français'} %}
                            <a href="{{ path('locale_switch', {locale: code}) }}" lang="{{ code }}"
                               class="block rounded-lg px-3 py-2 text-sm hover:bg-subtle {{ app.request.locale == code ? 'font-semibold text-fg' : 'text-fg-muted' }}">{{ label }}</a>
                        {% endfor %}
                    </div>
                </div>

                <button type="button" class="btn btn-ghost btn-icon" data-color-scheme-toggle aria-pressed="false" aria-label="{{ 'admin.layout.theme_toggle_aria'|trans }}">
                    <span class="dark:hidden">{{ icon('moon', 'size-5') }}</span>
                    <span class="hidden dark:inline">{{ icon('sun', 'size-5') }}</span>
                </button>

                {# Notifications #}
                <div class="relative" x-data="{ open: false }" @click.outside="open = false" @keydown.escape="open = false">
                    <button type="button" class="btn btn-ghost btn-icon relative" @click="open = !open" :aria-expanded="open" aria-haspopup="true" aria-label="{{ 'admin.layout.notifications_aria'|trans }}">
                        {{ icon('bell', 'size-5') }}
                        {% if adminNotifications.unreadCount > 0 %}
                            <span class="absolute top-1 right-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-danger px-1 text-[0.625rem] font-semibold text-white">
                                {{- adminNotifications.unreadCount > 9 ? '9+' : adminNotifications.unreadCount -}}
                            </span>
                        {% endif %}
                    </button>
                    <div x-cloak x-show="open" x-transition.origin.top.right
                         class="absolute right-0 mt-2 w-80 overflow-hidden rounded-xl border border-line bg-panel shadow-lg shadow-black/5">
                        <div class="flex items-center justify-between border-b border-line px-4 py-3">
                            <p class="text-sm font-semibold">{{ 'admin.layout.notifications_title'|trans }}</p>
                            <div class="flex items-center gap-3">
                                {% if adminNotifications.unreadCount > 0 %}
                                    <form action="{{ path('admin_notifications_mark_seen') }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_notifications_mark_seen') }}">
                                        <input type="hidden" name="redirect_to" value="{{ app.request.uri }}">
                                        <button type="submit" class="text-xs font-medium text-fg-muted hover:text-fg">{{ 'admin.layout.notifications_mark_read'|trans }}</button>
                                    </form>
                                {% endif %}
                                <a href="{{ path('admin_audit_log') }}" class="text-xs font-medium text-primary-600 hover:underline dark:text-primary-400">{{ 'admin.layout.notifications_view_all'|trans }}</a>
                            </div>
                        </div>
                        <div class="max-h-80 divide-y divide-line overflow-y-auto">
                            {% for item in adminNotifications.items %}
                                <a href="{{ path(item.url, item.routeParams|default({})) }}" class="block px-4 py-3 hover:bg-subtle {{ item.isRead ? 'opacity-70' : '' }}">
                                    <p class="flex items-center gap-2 text-sm font-medium">
                                        {% if not item.isRead %}<span class="size-1.5 rounded-full bg-primary-600"></span>{% endif %}
                                        {{ item.title }}
                                    </p>
                                    <p class="mt-0.5 text-xs text-fg-muted">{{ item.detail }}</p>
                                    <p class="mt-1 text-[0.6875rem] text-fg-subtle">{{ item.at|date('d.m.Y H:i') }}</p>
                                </a>
                            {% else %}
                                <p class="px-4 py-6 text-center text-sm text-fg-subtle">{{ 'admin.layout.notifications_empty'|trans }}</p>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                {# User #}
                <div class="relative ml-1" x-data="{ open: false }" @click.outside="open = false" @keydown.escape="open = false">
                    <button type="button" class="flex items-center gap-2 rounded-lg p-1 hover:bg-subtle" @click="open = !open" :aria-expanded="open" aria-haspopup="true" aria-label="{{ 'ui.nav.account_menu'|trans }}">
                        <span class="flex size-8 items-center justify-center rounded-full bg-fg text-xs font-semibold text-canvas">
                            {{- app.user and app.user.email ? app.user.email|first|upper : 'A' -}}
                        </span>
                        <span class="hidden max-w-40 truncate text-sm font-medium xl:inline">{{ app.user ? app.user.email : 'admin.layout.guest'|trans }}</span>
                        {{ icon('chevron-down', 'hidden size-4 text-fg-subtle xl:inline') }}
                    </button>
                    <div x-cloak x-show="open" x-transition.origin.top.right class="absolute right-0 mt-2 w-56 rounded-xl border border-line bg-panel p-1 shadow-lg shadow-black/5">
                        <p class="truncate border-b border-line px-3 py-2 text-xs text-fg-subtle">{{ app.user ? app.user.email : 'admin.layout.guest'|trans }}</p>
                        <a href="{{ path('catalog_home') }}" target="_blank" rel="noopener noreferrer" class="mt-1 flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-fg-muted hover:bg-subtle hover:text-fg">
                            {{ icon('arrow-top-right-on-square', 'size-4') }}{{ 'admin.layout.view_storefront'|trans }}
                        </a>
                        <a href="{{ path('logout') }}" class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-500/10">
                            {{ icon('arrow-left-on-rectangle', 'size-4') }}{{ 'admin.layout.logout'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <main class="px-4 py-6 sm:px-6 lg:px-8">
            {% include 'admin/components/breadcrumb.html.twig' with {
                items: breadcrumbs|default([
                    {label: 'admin.nav.dashboard'|trans, url: path('admin')},
                    {label: block('page_title')}
                ])
            } %}
            {% include 'admin/components/flash.html.twig' %}
            {% block body %}{% endblock %}
        </main>
    </div>

    {% block javascripts %}{% endblock %}
</body>
</html>
