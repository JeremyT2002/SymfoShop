<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin Panel - SymfoShop{% endblock %}</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd',
                            400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8',
                            800: '#1e40af', 900: '#1e3a8a',
                        }
                    },
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                },
            },
        }
    </script>
    
    <!-- ApexCharts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.45.1/dist/apexcharts.min.js"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    
    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .admin-page-header {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        @media (min-width: 768px) {
            .admin-page-header {
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
            }
        }

        .admin-card {
            border-radius: 0.75rem;
            border: 1px solid #e5e7eb;
            background: #fff;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
        }

        .admin-table-wrap {
            overflow-x: auto;
        }

        .admin-table thead th {
            position: sticky;
            top: 0;
            z-index: 1;
            background: #f9fafb;
        }

        .admin-form-shell {
            max-width: 72rem;
        }

        .admin-form-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        @media (min-width: 1024px) {
            .admin-form-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        .admin-form-section {
            border: 1px solid #e5e7eb;
            border-radius: 0.75rem;
            background: linear-gradient(180deg, rgba(249, 250, 251, 0.75), #ffffff);
            padding: 1rem;
        }

        .admin-form-label {
            display: block;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: #6b7280;
            margin-bottom: 0.35rem;
        }

        .admin-form-input {
            width: 100%;
            border: 1px solid #d1d5db;
            border-radius: 0.625rem;
            background: #fff;
            padding: 0.65rem 0.875rem;
            font-size: 0.875rem;
            color: #111827;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        .admin-form-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
        }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-gray-50 admin font-sans">
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <aside class="w-64 bg-gray-900 text-white flex flex-col">
            <!-- Logo -->
            <div class="p-6 border-b border-gray-800">
                <a href="{{ path('admin') }}" class="flex items-center gap-2">
                    <i class="fas fa-shopping-bag text-2xl text-blue-400"></i>
                    <span class="text-xl font-bold">SymfoShop</span>
                </a>
                <p class="text-sm text-gray-400 mt-1">Admin Panel</p>
            </div>
            
            <!-- Navigation -->
            <nav class="flex-1 p-4 space-y-2 overflow-y-auto">
                <a href="{{ path('admin') }}" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors {% if app.request.get('_route') == 'admin' %}bg-gray-800{% endif %}">
                    <i class="fas fa-home w-5"></i>
                    <span>Dashboard</span>
                </a>
                
                <div class="pt-4">
                    <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Catalog</p>
                    <a href="{{ path('admin_products_index') }}" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors {% if 'admin_products' in app.request.get('_route') %}bg-gray-800{% endif %}">
                        <i class="fas fa-box w-5"></i>
                        <span>Products</span>
                    </a>
                    <a href="{{ path('admin_categories_index') }}" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors {% if 'admin_categories' in app.request.get('_route') %}bg-gray-800{% endif %}">
                        <i class="fas fa-tags w-5"></i>
                        <span>Categories</span>
                    </a>
                </div>
                
                <div class="pt-4">
                    <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Sales</p>
                    <a href="{{ path('admin_orders_index') }}" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors {% if 'admin_orders' in app.request.get('_route') %}bg-gray-800{% endif %}">
                        <i class="fas fa-shopping-cart w-5"></i>
                        <span>Orders</span>
                    </a>
                    <a href="{{ path('admin_coupons_index') }}" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors {% if 'admin_coupons' in app.request.get('_route') %}bg-gray-800{% endif %}">
                        <i class="fas fa-gift w-5"></i>
                        <span>Coupons</span>
                    </a>
                    <a href="{{ path('admin_payment_methods_index') }}" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors {% if 'admin_payment_methods' in app.request.get('_route') %}bg-gray-800{% endif %}">
                        <i class="fas fa-credit-card w-5"></i>
                        <span>{{ 'admin.payment_methods.nav'|trans }}</span>
                    </a>
                    <a href="{{ path('admin_shipping_methods_index') }}" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors {% if 'admin_shipping_methods' in app.request.get('_route') %}bg-gray-800{% endif %}">
                        <i class="fas fa-truck w-5"></i>
                        <span>{{ 'admin.shipping_methods.nav'|trans }}</span>
                    </a>
                    <a href="{{ path('admin_return_requests_index') }}" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors {% if 'admin_return_requests' in app.request.get('_route') %}bg-gray-800{% endif %}">
                        <i class="fas fa-undo-alt w-5"></i>
                        <span>{{ 'admin.return_requests.nav'|trans }}</span>
                    </a>
                </div>
                
                <div class="pt-4">
                    <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Users</p>
                    <a href="{{ path('admin_users_index') }}" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors {% if 'admin_users' in app.request.get('_route') %}bg-gray-800{% endif %}">
                        <i class="fas fa-users w-5"></i>
                        <span>Users</span>
                    </a>
                    <a href="{{ path('admin_api_keys_index') }}" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors {% if 'admin_api_keys' in app.request.get('_route') %}bg-gray-800{% endif %}">
                        <i class="fas fa-key w-5"></i>
                        <span>API Keys</span>
                    </a>
                </div>
                
                <div class="pt-4">
                    <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Appearance</p>
                    <a href="{{ path('admin_theme_editor') }}" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors {% if 'admin_theme' in app.request.get('_route') %}bg-gray-800{% endif %}">
                        <i class="fas fa-palette w-5"></i>
                        <span>Theme Editor</span>
                    </a>
                </div>
                
                <div class="pt-4">
                    <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">System</p>
                    <a href="{{ path('admin_api_docs') }}" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors {% if 'admin_api_docs' in app.request.get('_route') %}bg-gray-800{% endif %}">
                        <i class="fas fa-book w-5"></i>
                        <span>API Documentation</span>
                    </a>
                </div>
            </nav>
            
            <!-- User Section -->
            <div class="p-4 border-t border-gray-800">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center shrink-0">
                        <i class="fas fa-user text-white"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium truncate">
                            {% if app.user %}
                                {{ app.user.email }}
                            {% else %}
                                Guest
                            {% endif %}
                        </p>
                        <p class="text-xs text-gray-400 truncate">Administrator</p>
                    </div>
                </div>
                <a href="{{ path('logout') }}" class="mt-3 flex items-center space-x-2 text-sm text-gray-400 hover:text-white transition-colors">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </div>
        </aside>
        
        <!-- Main Content -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Top Bar -->
            <header class="bg-white border-b border-gray-200 px-6 py-4">
                <div class="flex items-center justify-between">
                    <h1 class="text-2xl font-bold text-gray-900">{% block page_title %}Dashboard{% endblock %}</h1>
                    <div class="flex items-center space-x-4">
                        <a href="{{ path('catalog_home') }}" class="text-gray-600 hover:text-gray-900 transition-colors" title="View Site">
                            <i class="fas fa-external-link-alt"></i>
                        </a>
                    </div>
                </div>
            </header>
            
            <!-- Page Content -->
            <main class="flex-1 overflow-y-auto p-6">
                <!-- Flash Messages -->
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="mb-4 p-4 rounded-lg {% if label == 'success' %}bg-green-50 text-green-800 border border-green-200{% elseif label == 'error' %}bg-red-50 text-red-800 border border-red-200{% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %}">
                            <div class="flex items-center gap-2">
                                <i class="fas {% if label == 'success' %}fa-check-circle{% elseif label == 'error' %}fa-exclamation-circle{% else %}fa-info-circle{% endif %}"></i>
                                <span>{{ message|trans }}</span>
                            </div>
                        </div>
                    {% endfor %}
                {% endfor %}
                {% block body %}{% endblock %}
            </main>
        </div>
    </div>
    
    {% block javascripts %}
    <!-- Application JavaScript -->
    <script type="module" src="{{ asset('js/app.js') }}"></script>
    {% endblock %}
</body>
</html>

