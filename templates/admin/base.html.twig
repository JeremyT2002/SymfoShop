<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ block('page_title') }} · {{ 'admin.brand.name'|trans }}{% endblock %}</title>
    <script>
        (function () {
            var key = 'symfoshop-color-scheme';
            var legacyKey = 'symfoshop_admin_theme';
            var stored = localStorage.getItem(key);
            if (stored !== 'dark' && stored !== 'light') {
                var legacy = localStorage.getItem(legacyKey);
                if (legacy === 'dark' || legacy === 'light') {
                    stored = legacy;
                    localStorage.setItem(key, legacy);
                }
            }
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.classList.toggle('dark', stored === 'dark' || (stored !== 'light' && prefersDark));
        })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            200: '#c7d2fe',
                            300: '#a5b4fc',
                            400: '#818cf8',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            800: '#3730a3',
                            900: '#312e81',
                        },
                        surface: {
                            50: '#f8fafc',
                            100: '#f1f5f9',
                            200: '#e2e8f0',
                            800: '#1e293b',
                            900: '#0f172a',
                        },
                        success: '#16a34a',
                        warning: '#d97706',
                        danger: '#dc2626',
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    boxShadow: {
                        admin: '0 1px 2px rgba(2, 6, 23, 0.08), 0 8px 20px rgba(2, 6, 23, 0.06)',
                    },
                },
            },
        };
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        [x-cloak] { display: none !important; }
        .focus-ring:focus-visible {
            outline: 2px solid rgb(99, 102, 241);
            outline-offset: 2px;
        }
        .touch-target { min-height: 44px; min-width: 44px; }
        .admin-form-label {
            display: block;
            margin-bottom: 0.35rem;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: rgb(75 85 99);
        }
        .dark .admin-form-label { color: rgb(156 163 175); }
        .admin-form-input {
            width: 100%;
            border-radius: 0.75rem;
            border: 1px solid rgb(209 213 219);
            background: rgb(255 255 255);
            padding: 0.625rem 0.875rem;
            font-size: 0.875rem;
            color: rgb(17 24 39);
        }
        .admin-form-input:focus-visible {
            outline: 2px solid rgb(99 102 241);
            outline-offset: 1px;
            border-color: rgb(99 102 241);
        }
        .dark .admin-form-input {
            border-color: rgb(75 85 99);
            background: rgb(15 23 42);
            color: rgb(226 232 240);
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body
    class="admin font-sans antialiased bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100"
    x-data="{ sidebarOpen: false, sidebarCollapsed: false, userMenuOpen: false, notificationsOpen: false }"
    @keydown.escape.window="sidebarOpen = false; userMenuOpen = false; notificationsOpen = false"
>
    {% from 'admin/components/_icons.html.twig' import icon %}
    {% set adminNotifications = admin_notifications() %}
    {% set currentRoute = app.request.attributes.get('_route')|default('') %}
    {% set navItems = [
        { route: 'admin', key: 'admin.nav.dashboard', icon: 'home' },
        { route: 'admin_products_index', key: 'admin.nav.products', icon: 'box' },
        { route: 'admin_categories_index', key: 'admin.nav.categories', icon: 'tag' },
        { route: 'admin_orders_index', key: 'admin.nav.orders', icon: 'shopping-cart' },
        { route: 'admin_coupons_index', key: 'admin.nav.coupons', icon: 'ticket' },
        { route: 'admin_users_index', key: 'admin.nav.users', icon: 'users' },
        { route: 'admin_reviews_index', key: 'admin.nav.reviews', icon: 'star' },
        { route: 'admin_support_index', key: 'admin.nav.support_inbox', icon: 'life-buoy' },
        { route: 'admin_audit_log', key: 'admin.nav.audit_log', icon: 'book-open' },
        { route: 'admin_settings', key: 'admin.settings.nav', icon: 'settings' },
        { route: 'admin_api_docs', key: 'admin.nav.api_documentation', icon: 'book-open' }
    ] %}

    <div class="flex min-h-screen">
        <div
            x-cloak
            x-show="sidebarOpen"
            x-transition.opacity
            class="fixed inset-0 z-30 bg-slate-900/50 md:hidden"
            aria-hidden="true"
            @click="sidebarOpen = false"
        ></div>

        <aside
            class="fixed inset-y-0 left-0 z-40 w-72 border-r border-slate-200 bg-white p-4 transition-transform dark:border-slate-800 dark:bg-slate-900 md:sticky md:top-0 md:h-screen"
            :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full md:translate-x-0'"
            role="navigation"
            aria-label="{{ 'admin.layout.navigation_aria'|trans }}"
        >
            <div class="mb-4 flex items-center justify-between gap-2">
                <a href="{{ path('admin') }}" class="focus-ring inline-flex items-center gap-3 rounded-lg px-2 py-1">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary-600 text-white">
                        {{ icon('shopping-bag', 'h-5 w-5') }}
                    </span>
                    <span>
                        <span class="block text-sm font-semibold">{{ 'admin.brand.name'|trans }}</span>
                        <span class="block text-xs text-slate-500 dark:text-slate-400">{{ 'admin.layout.panel_subtitle'|trans }}</span>
                    </span>
                </a>
                <button
                    type="button"
                    class="touch-target focus-ring inline-flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 md:hidden"
                    @click="sidebarOpen = false"
                    aria-label="{{ 'admin.layout.close_sidebar'|trans }}"
                >
                    {{ icon('x-mark', 'h-5 w-5') }}
                </button>
            </div>

            <nav class="space-y-1 overflow-y-auto pb-4" style="max-height: calc(100vh - 180px);">
                {% for item in navItems %}
                    {% set isActive = currentRoute == item.route or currentRoute starts with (item.route|replace({'_index': ''})) %}
                    <a
                        href="{{ path(item.route) }}"
                        class="focus-ring touch-target group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition
                            {{ isActive
                                ? 'bg-primary-50 text-primary-700 dark:bg-primary-900/30 dark:text-primary-200'
                                : 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800' }}"
                    >
                        <span class="text-slate-500 dark:text-slate-400 group-hover:text-current">{{ icon(item.icon, 'h-5 w-5') }}</span>
                        <span>{{ item.key|trans }}</span>
                    </a>
                {% endfor %}
            </nav>

            <div class="mt-auto rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-800">
                <p class="text-xs text-slate-500 dark:text-slate-400">{{ app.user ? app.user.email : 'admin.layout.guest'|trans }}</p>
                <a href="{{ path('logout') }}" class="focus-ring mt-2 inline-flex items-center gap-2 rounded-lg px-2 py-1 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-700">
                    {{ icon('arrow-left-on-rectangle', 'h-4 w-4') }}
                    <span>{{ 'admin.layout.logout'|trans }}</span>
                </a>
            </div>
        </aside>

        <div class="min-w-0 flex-1">
            <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 px-4 py-3 backdrop-blur dark:border-slate-800 dark:bg-slate-900/90 sm:px-6">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                        <button
                            type="button"
                            class="touch-target focus-ring inline-flex items-center justify-center rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800 md:hidden"
                            @click="sidebarOpen = true"
                            aria-label="{{ 'admin.layout.open_sidebar'|trans }}"
                        >
                            {{ icon('bars-3', 'h-5 w-5') }}
                        </button>
                        <form action="{{ path('admin_search') }}" method="get" class="hidden items-center md:flex">
                            <label for="admin-search" class="sr-only">{{ 'admin.layout.search_aria'|trans }}</label>
                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                    {{ icon('magnifying-glass', 'h-4 w-4') }}
                                </span>
                                <input
                                    id="admin-search"
                                    name="q"
                                    type="search"
                                    class="focus-ring h-11 w-72 rounded-xl border border-slate-200 bg-slate-50 pl-9 pr-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                                    placeholder="{{ 'admin.layout.search_placeholder'|trans }}"
                                    value="{{ app.request.query.get('q')|default('') }}"
                                    autocomplete="off"
                                >
                            </div>
                        </form>
                    </div>

                    <div class="flex items-center gap-2 sm:gap-3">
                        <label for="admin-language-switcher" class="sr-only">{{ 'nav.language'|trans }}</label>
                        <select
                            id="admin-language-switcher"
                            class="focus-ring h-11 rounded-xl border border-slate-200 bg-white px-3 text-sm font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                            aria-label="{{ 'nav.language'|trans }}"
                        >
                            <option value="en" {% if app.request.locale == 'en' %}selected{% endif %}>EN</option>
                            <option value="de" {% if app.request.locale == 'de' %}selected{% endif %}>DE</option>
                            <option value="fr" {% if app.request.locale == 'fr' %}selected{% endif %}>FR</option>
                        </select>

                        <button
                            type="button"
                            id="admin-theme-toggle"
                            class="touch-target focus-ring inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                            aria-pressed="false"
                            aria-label="{{ 'admin.layout.theme_toggle_aria'|trans }}"
                        >
                            <span class="inline dark:hidden">{{ icon('moon', 'h-5 w-5') }}</span>
                            <span class="hidden dark:inline">{{ icon('sun', 'h-5 w-5') }}</span>
                        </button>

                        <div class="relative">
                            <button
                                type="button"
                                class="touch-target focus-ring inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                                aria-label="{{ 'admin.layout.notifications_aria'|trans }}"
                                @click="notificationsOpen = !notificationsOpen"
                                :aria-expanded="notificationsOpen.toString()"
                                aria-haspopup="true"
                            >
                                {{ icon('bell', 'h-5 w-5') }}
                                {% if adminNotifications.unreadCount > 0 %}
                                    <span class="absolute -right-1 -top-1 inline-flex min-h-[18px] min-w-[18px] items-center justify-center rounded-full bg-danger px-1 text-[10px] font-semibold text-white">
                                        {{ adminNotifications.unreadCount > 9 ? '9+' : adminNotifications.unreadCount }}
                                    </span>
                                {% endif %}
                            </button>
                            <div
                                x-cloak
                                x-show="notificationsOpen"
                                x-transition
                                @click.outside="notificationsOpen = false"
                                class="absolute right-0 z-30 mt-2 w-80 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-admin dark:border-slate-700 dark:bg-slate-800"
                            >
                                <div class="flex items-center justify-between border-b border-slate-200 px-3 py-2 dark:border-slate-700">
                                    <p class="text-sm font-semibold">{{ 'admin.layout.notifications_title'|trans }}</p>
                                    <div class="flex items-center gap-3">
                                        {% if adminNotifications.unreadCount > 0 %}
                                            <form action="{{ path('admin_notifications_mark_seen') }}" method="post">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin_notifications_mark_seen') }}">
                                                <input type="hidden" name="redirect_to" value="{{ app.request.uri }}">
                                                <button type="submit" class="text-xs font-medium text-slate-500 hover:text-slate-700 dark:text-slate-300 dark:hover:text-slate-100">
                                                    {{ 'admin.layout.notifications_mark_read'|trans }}
                                                </button>
                                            </form>
                                        {% endif %}
                                        <a href="{{ path('admin_audit_log') }}" class="text-xs font-medium text-primary-600 hover:text-primary-700">{{ 'admin.layout.notifications_view_all'|trans }}</a>
                                    </div>
                                </div>
                                <div class="max-h-80 overflow-y-auto">
                                    {% for item in adminNotifications.items %}
                                        <a href="{{ path(item.url, item.routeParams|default({})) }}" class="block border-b border-slate-100 px-3 py-2 last:border-0 hover:bg-slate-50 dark:border-slate-700/70 dark:hover:bg-slate-700/40 {{ item.isRead ? 'opacity-75' : '' }}">
                                            <p class="flex items-center gap-2 text-sm font-medium text-slate-900 dark:text-slate-100">
                                                {% if not item.isRead %}
                                                    <span class="inline-flex h-1.5 w-1.5 rounded-full bg-primary-600"></span>
                                                {% endif %}
                                                <span>{{ item.title }}</span>
                                            </p>
                                            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">{{ item.detail }}</p>
                                            <p class="mt-1 text-[11px] text-slate-400 dark:text-slate-500">{{ item.at|date('Y-m-d H:i') }}</p>
                                        </a>
                                    {% else %}
                                        <p class="px-3 py-4 text-sm text-slate-500 dark:text-slate-400">{{ 'admin.layout.notifications_empty'|trans }}</p>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>

                        <div class="relative">
                            <button
                                type="button"
                                class="focus-ring inline-flex h-11 items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                                @click="userMenuOpen = !userMenuOpen"
                                :aria-expanded="userMenuOpen.toString()"
                                aria-haspopup="true"
                            >
                                <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-primary-600 text-xs font-semibold text-white">
                                    {{ app.user and app.user.email ? app.user.email|slice(0, 1)|upper : 'A' }}
                                </span>
                                <span class="hidden sm:inline">{{ app.user ? app.user.email : 'admin.layout.guest'|trans }}</span>
                                {{ icon('chevron-down', 'h-4 w-4') }}
                            </button>
                            <div
                                x-cloak
                                x-show="userMenuOpen"
                                x-transition
                                @click.outside="userMenuOpen = false"
                                class="absolute right-0 z-30 mt-2 w-56 rounded-xl border border-slate-200 bg-white p-1 shadow-admin dark:border-slate-700 dark:bg-slate-800"
                            >
                                <a href="{{ path('catalog_home') }}" target="_blank" rel="noopener noreferrer" class="focus-ring flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-700">
                                    {{ icon('arrow-top-right-on-square', 'h-4 w-4') }}
                                    <span>{{ 'admin.layout.view_storefront'|trans }}</span>
                                </a>
                                <a href="{{ path('logout') }}" class="focus-ring flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-700">
                                    {{ icon('arrow-left-on-rectangle', 'h-4 w-4') }}
                                    <span>{{ 'admin.layout.logout'|trans }}</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <main class="px-4 py-5 sm:px-6">
                {% include 'admin/components/flash.html.twig' %}
                {% include 'admin/components/breadcrumb.html.twig' with {
                    items: breadcrumbs|default([
                        { label: 'admin.nav.dashboard'|trans, url: path('admin') },
                        { label: block('page_title') }
                    ])
                } %}
                {% block body %}{% endblock %}
            </main>
        </div>
    </div>

    {% block javascripts %}
        <script type="module" src="{{ asset('js/app.js') }}"></script>
        <script>
            (function () {
                var themeToggle = document.getElementById('admin-theme-toggle');
                var localeSelect = document.getElementById('admin-language-switcher');
                var storageKey = 'symfoshop-color-scheme';

                function syncPressed() {
                    if (!themeToggle) {
                        return;
                    }
                    themeToggle.setAttribute('aria-pressed', document.documentElement.classList.contains('dark') ? 'true' : 'false');
                }

                syncPressed();
                if (themeToggle) {
                    themeToggle.addEventListener('click', function () {
                        var next = !document.documentElement.classList.contains('dark');
                        document.documentElement.classList.toggle('dark', next);
                        localStorage.setItem(storageKey, next ? 'dark' : 'light');
                        syncPressed();
                    });
                }

                if (localeSelect) {
                    var routeUrlTemplate = '{{ path(app.request.attributes.get('_route') ?: 'admin', app.request.attributes.get('_route_params')|default({})|merge({'_locale': '__LOCALE__'})) }}';
                    localeSelect.addEventListener('change', function () {
                        window.location.href = routeUrlTemplate.replace('__LOCALE__', localeSelect.value);
                    });
                }
            })();
        </script>
    {% endblock %}
</body>
</html>

