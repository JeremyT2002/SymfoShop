{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'admin.nav.api_documentation'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14/swagger-ui.css">
    <style>.swagger-ui .topbar { display: none; } .swagger-ui .scheme-container { box-shadow: none; }</style>
{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-semibold">{{ 'ui.api.title'|trans }}</h1>
            <p class="mt-1 text-sm text-fg-muted">{{ 'ui.api.intro'|trans }}</p>
        </div>
        <a href="{{ path('api_docs') }}" target="_blank" rel="noopener" class="btn btn-secondary">
            {{ ux_icon('lucide:external-link', {class: 'size-4'}) }}{{ 'ui.api.open_full_page'|trans }}
        </a>
    </div>
    {# Swagger UI ships a light theme only #}
    <div id="swagger-ui" class="overflow-hidden rounded-2xl border border-line bg-white p-2 text-zinc-900"></div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14/swagger-ui-bundle.js" defer></script>
    <script type="application/json" id="openapi-spec">{{ openApiSpec|raw }}</script>
    <script>
        window.addEventListener('load', function () {
            window.ui = SwaggerUIBundle({
                spec: JSON.parse(document.getElementById('openapi-spec').textContent),
                dom_id: '#swagger-ui',
                deepLinking: true,
                persistAuthorization: true,
                tryItOutEnabled: true,
                filter: true,
                docExpansion: 'list',
                defaultModelsExpandDepth: 1,
            });
        });
    </script>
{% endblock %}
