{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'admin.dashboard.title'|trans }}{% endblock %}

{% block body %}
    <div class="mb-4">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900/40 border border-transparent dark:border-gray-700 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div class="min-w-0">
                <div class="text-sm font-semibold text-gray-800 dark:text-gray-100">{{ 'admin.dashboard.app_update_title'|trans }}</div>
                {% if app_update.ok %}
                    {% if app_update.updates_available %}
                        <div class="text-sm text-amber-700 dark:text-amber-400 mt-0.5">
                            {% if app_update.behind_by == 1 %}
                                {{ 'admin.dashboard.app_update_one_commit'|trans }}
                            {% else %}
                                {{ 'admin.dashboard.app_update_n_commits'|trans({'%count%': app_update.behind_by}) }}
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="text-sm text-gray-600 dark:text-gray-400 mt-0.5">{{ 'admin.dashboard.app_update_up_to_date'|trans }}</div>
                    {% endif %}
                {% else %}
                    <div class="text-sm text-red-700 dark:text-red-400 mt-0.5 truncate">
                        {{ 'admin.dashboard.app_update_failed'|trans }}{% if app_update.error %}: {{ app_update.error }}{% endif %}
                    </div>
                {% endif %}
            </div>

            <div class="flex items-center gap-2 shrink-0">
                <form method="post" action="{{ path('admin_system_update') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_system_update') }}">
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-white bg-primary-600 hover:bg-primary-700 disabled:opacity-60 disabled:cursor-not-allowed"
                            {% if not app_update.ok or not app_update.updates_available %}disabled{% endif %}>
                        <i class="fas fa-cloud-download-alt"></i>
                        {{ 'admin.dashboard.app_update_now'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900/40 border border-transparent dark:border-gray-700 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <div class="text-sm font-semibold text-gray-800 dark:text-gray-100">{{ 'admin.settings.title'|trans }}</div>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5">{{ 'admin.dashboard.settings_teaser'|trans }}</p>
            </div>
            <a href="{{ path('admin_settings') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-primary-700 dark:text-primary-400 border border-primary-200 dark:border-primary-800 hover:bg-primary-50 dark:hover:bg-primary-950/50 shrink-0">
                <i class="fas fa-cog"></i>
                {{ 'admin.settings.open'|trans }}
            </a>
        </div>
    </div>

    <div class="mb-4">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900/40 border border-transparent dark:border-gray-700 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <div class="text-sm font-semibold text-gray-800 dark:text-gray-100">{{ 'admin.reviews.pending_title'|trans }}</div>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5">{{ 'admin.reviews.pending_description'|trans({'%count%': pendingReviewsCount}) }}</p>
            </div>
            <a href="{{ path('admin_reviews_index') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-primary-700 dark:text-primary-400 border border-primary-200 dark:border-primary-800 hover:bg-primary-50 dark:hover:bg-primary-950/50 shrink-0">
                <i class="fas fa-star"></i>
                {{ 'admin.reviews.open'|trans }}
            </a>
        </div>
    </div>

    <div class="dashboard-grid" data-js="dashboard-grid" data-dashboard-widgets="{{ widgets|json_encode|e('html_attr') }}">
        <div class="grid grid-cols-1 md:grid-cols-6 gap-4" style="grid-auto-rows: minmax(120px, auto);">
            {% for widget in widgets %}
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900/40 border border-transparent dark:border-gray-700 p-6 min-w-0"
                     style="grid-column: span {{ widget.w|default(1) }}; grid-row: span {{ widget.h|default(1) }};"
                     data-widget-id="{{ widget.id|e }}"
                     data-widget-type="{{ widget.type|e }}">
                    <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">{{ widget.title|trans }}</h3>
                    <div class="widget-content">
                        {{ widget.html|raw }}
                    </div>
                </div>
            {% else %}
                <div class="col-span-full bg-white dark:bg-gray-800 rounded-lg shadow dark:shadow-gray-900/40 border border-transparent dark:border-gray-700 p-6 text-center text-gray-500 dark:text-gray-400">
                    <p>{{ 'admin.dashboard.no_widgets'|trans }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
