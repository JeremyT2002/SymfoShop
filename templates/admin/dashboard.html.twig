{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'admin.dashboard.title'|trans }}{% endblock %}

{% block body %}
    <div class="dashboard-grid" data-js="dashboard-grid" data-dashboard-widgets="{{ widgets|json_encode|e('html_attr') }}">
        <div class="grid grid-cols-1 md:grid-cols-6 gap-4" style="grid-auto-rows: minmax(120px, auto);">
            {% for widget in widgets %}
                <div class="bg-white rounded-lg shadow p-6 min-w-0"
                     style="grid-column: span {{ widget.w|default(1) }}; grid-row: span {{ widget.h|default(1) }};"
                     data-widget-id="{{ widget.id|e }}"
                     data-widget-type="{{ widget.type|e }}">
                    <h3 class="text-sm font-semibold text-gray-700 mb-3">{{ widget.title }}</h3>
                    <div class="widget-content">
                        {{ widget.html|raw }}
                    </div>
                </div>
            {% else %}
                <div class="col-span-full bg-white rounded-lg shadow p-6 text-center text-gray-500">
                    <p>{{ 'admin.dashboard.no_widgets'|trans }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
