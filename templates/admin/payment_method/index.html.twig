{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'admin.payment_methods.title'|trans }}{% endblock %}

{% block body %}
    <div class="admin-page-header">
        <div>
            <h2 class="text-2xl font-bold text-gray-900">{{ 'admin.payment_methods.title'|trans }}</h2>
            <p class="text-gray-600 mt-1">{{ 'admin.payment_methods.subtitle'|trans }}</p>
        </div>
        <a href="{{ path('admin_payment_methods_new') }}" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
            <i class="fas fa-plus mr-1"></i> {{ 'admin.payment_methods.new'|trans }}
        </a>
    </div>

    <div x-data="{ selectedIds: [], clearSelection(){ this.selectedIds=[]; } }" class="space-y-4">
    <div class="admin-card admin-table-wrap">
        <table class="admin-table min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3"><input type="checkbox" class="h-4 w-4 rounded border-gray-300"></th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.payment_methods.table.name'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.payment_methods.table.provider_code'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.payment_methods.table.sort'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.payment_methods.table.active'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.payment_methods.table.default'|trans }}</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.payment_methods.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for method in methods %}
                    <tr>
                        <td class="px-4 py-4"><input type="checkbox" @change="$event.target.checked ? selectedIds.push({{ method.id }}) : selectedIds = selectedIds.filter(id => id !== {{ method.id }})" class="h-4 w-4 rounded border-gray-300"></td>
                        <td class="px-6 py-4 text-sm text-gray-900">{{ method.name }}</td>
                        <td class="px-6 py-4 text-sm font-mono text-gray-700">{{ method.code }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ method.sortOrder }}</td>
                        <td class="px-6 py-4 text-sm">
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold {{ method.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}">
                                {{ method.isActive ? 'common.yes'|trans : 'common.no'|trans }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm">
                            {% if method.isDefault %}
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">{{ 'admin.payment_methods.default_badge'|trans }}</span>
                            {% else %}
                                <span class="text-gray-400">—</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-right text-sm">
                            <a href="{{ path('admin_payment_methods_edit', {id: method.id}) }}" class="text-blue-600 hover:text-blue-900 mr-3">{{ 'common.edit'|trans }}</a>
                            <form method="post" action="{{ path('admin_payment_methods_delete', {id: method.id}) }}" class="inline" onsubmit="return confirm({{ 'admin.payment_methods.confirm_delete'|trans|json_encode|raw }});">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_payment_method_' ~ method.id) }}">
                                <button type="submit" class="text-red-600 hover:text-red-900">{{ 'common.delete'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="px-6 py-8 text-center text-gray-500">{{ 'admin.payment_methods.empty'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div x-show="selectedIds.length > 0" class="sticky bottom-4">
        <div class="flex items-center justify-between rounded-2xl border border-primary-200 bg-primary-50 p-3">
            <p class="text-sm font-medium text-primary-700"><span x-text="selectedIds.length"></span> {{ 'admin.table.selected'|trans }}</p>
            <form method="post" action="{{ path('admin_payment_methods_bulk_active') }}" class="flex items-center gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('bulk_payment_methods_active') }}">
                <input type="hidden" name="ids" :value="selectedIds.join(',')">
                <select name="active" class="rounded-xl border border-gray-300 bg-white px-3 py-2 text-xs font-semibold">
                    <option value="1">{{ 'admin.table.bulk_activate'|trans }}</option>
                    <option value="0">{{ 'admin.table.bulk_deactivate'|trans }}</option>
                </select>
                <button type="submit" class="rounded-xl bg-white px-3 py-2 text-xs font-semibold">{{ 'admin.table.bulk_apply'|trans }}</button>
                <button type="button" @click="clearSelection()" class="rounded-xl border border-gray-300 px-3 py-2 text-xs font-semibold">{{ 'admin.table.clear_selection'|trans }}</button>
            </form>
        </div>
    </div>
    </div>
{% endblock %}

