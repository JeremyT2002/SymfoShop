{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'admin.payment_methods.new_title'|trans }}{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('admin_payment_methods_index') }}" class="text-fg-muted hover:text-fg mb-2 inline-block">
            {{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }} {{ 'admin.payment_methods.back'|trans }}
        </a>
        <h2 class="text-2xl font-bold text-fg">{{ 'admin.payment_methods.new_title'|trans }}</h2>
    </div>

    {% include 'admin/payment_method/_form.html.twig' with {
        method: method,
        availableProviderNames: availableProviderNames,
        submitLabel: 'admin.payment_methods.create_submit'|trans
    } %}
{% endblock %}

