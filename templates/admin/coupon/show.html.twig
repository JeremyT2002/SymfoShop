{% extends 'admin/base.html.twig' %}

{% block page_title %}Coupon Details{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('admin_coupons_index') }}" class="text-blue-600 hover:text-blue-900 flex items-center">
            <i class="fas fa-arrow-left mr-2"></i>
            Back to Coupons
        </a>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <div class="flex justify-between items-start mb-6">
            <div>
                <h2 class="text-2xl font-bold text-gray-900">{{ coupon.code }}</h2>
                <p class="text-gray-600 mt-1">Coupon ID: #{{ coupon.id }}</p>
            </div>
            <div class="flex space-x-2">
                <a href="{{ path('admin_coupons_edit', {id: coupon.id}) }}" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                    Edit
                </a>
                <form method="POST" action="{{ path('admin_coupons_delete', {id: coupon.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this coupon?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_coupon_' ~ coupon.id) }}">
                    <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">
                        Delete
                    </button>
                </form>
            </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <h3 class="text-sm font-medium text-gray-500 mb-2">Type</h3>
                <p class="text-lg">
                    <span class="px-2 py-1 rounded-full text-sm {% if coupon.type.value == 'percentage' %}bg-blue-100 text-blue-800{% else %}bg-green-100 text-green-800{% endif %}">
                        {{ coupon.type.value|title }}
                    </span>
                </p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-gray-500 mb-2">Value</h3>
                <p class="text-lg font-semibold">
                    {% if coupon.type.value == 'percentage' %}
                        {{ coupon.value }}%
                    {% else %}
                        {{ (coupon.value / 100)|number_format(2, '.', ',') }} EUR
                    {% endif %}
                </p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-gray-500 mb-2">Status</h3>
                <p>
                    <span class="px-2 py-1 rounded-full text-sm {% if coupon.isActive %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                        {{ coupon.isActive ? 'Active' : 'Inactive' }}
                    </span>
                </p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-gray-500 mb-2">Expiration</h3>
                <p class="text-lg">
                    {% if coupon.expiresAt %}
                        {{ coupon.expiresAt|date('Y-m-d H:i') }}
                        {% if coupon.isExpired() %}
                            <span class="text-red-600">(Expired)</span>
                        {% endif %}
                    {% else %}
                        <span class="text-gray-400">No expiration</span>
                    {% endif %}
                </p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-gray-500 mb-2">Total Usage Limit</h3>
                <p class="text-lg">
                    {% if coupon.usageLimit %}
                        {{ coupon.usageLimit }} uses
                    {% else %}
                        <span class="text-gray-400">Unlimited</span>
                    {% endif %}
                </p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-gray-500 mb-2">Per-User Usage Limit</h3>
                <p class="text-lg">
                    {% if coupon.perUserLimit %}
                        {{ coupon.perUserLimit }} uses per user
                    {% else %}
                        <span class="text-gray-400">Unlimited</span>
                    {% endif %}
                </p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-gray-500 mb-2">Total Usages</h3>
                <p class="text-lg font-semibold">{{ totalUsages }}</p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-gray-500 mb-2">Created</h3>
                <p class="text-lg">{{ coupon.createdAt|date('Y-m-d H:i') }}</p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-gray-500 mb-2">Last Updated</h3>
                <p class="text-lg">{{ coupon.updatedAt|date('Y-m-d H:i') }}</p>
            </div>
        </div>
    </div>
{% endblock %}

