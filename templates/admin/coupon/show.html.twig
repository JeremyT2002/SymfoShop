{% extends 'admin/base.html.twig' %}

{% block page_title %}Coupon: {{ coupon.code }}{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('admin_coupons_index') }}" class="inline-flex items-center text-sm text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200">
            <span class="mr-1">←</span>
            Back to Coupons
        </a>
    </div>
    
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-admin dark:border-slate-800 dark:bg-slate-900 mb-6">
        <div class="flex justify-between items-start mb-6">
            <div>
                <h2 class="text-2xl font-bold">{{ coupon.code }}</h2>
                <p class="mt-1 text-sm text-slate-500">Coupon ID: #{{ coupon.id }}</p>
            </div>
            <div class="flex space-x-2">
                <a href="{{ path('admin_coupons_edit', {id: coupon.id}) }}" class="rounded-xl bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-700">
                    Edit
                </a>
                <form method="post" action="{{ path('admin_coupons_update_active', {id: coupon.id}) }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('update_coupon_active_' ~ coupon.id) }}">
                    <input type="hidden" name="active" value="{{ coupon.isActive ? '0' : '1' }}">
                    <button type="submit" class="rounded-xl px-4 py-2 text-sm font-semibold text-white {% if coupon.isActive %}bg-amber-600 hover:bg-amber-700{% else %}bg-green-600 hover:bg-green-700{% endif %}">
                        {{ coupon.isActive ? 'Deactivate' : 'Activate' }}
                    </button>
                </form>
                <form method="POST" action="{{ path('admin_coupons_delete', {id: coupon.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this coupon?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_coupon_' ~ coupon.id) }}">
                    <button type="submit" class="rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">
                        Delete
                    </button>
                </form>
            </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <h3 class="text-sm font-medium text-slate-500 mb-2">Type</h3>
                <p class="text-lg">
                    <span class="px-2 py-1 rounded-full text-sm {% if coupon.type.value == 'percentage' %}bg-blue-100 text-blue-800{% else %}bg-green-100 text-green-800{% endif %}">
                        {{ coupon.type.value|title }}
                    </span>
                </p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-slate-500 mb-2">Value</h3>
                <p class="text-lg font-semibold">
                    {% if coupon.type.value == 'percentage' %}
                        {{ coupon.value }}%
                    {% else %}
                        {{ (coupon.value / 100)|number_format(2, '.', ',') }} EUR
                    {% endif %}
                </p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-slate-500 mb-2">Status</h3>
                <p>
                    <span class="px-2 py-1 rounded-full text-sm {% if coupon.isActive %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                        {{ coupon.isActive ? 'Active' : 'Inactive' }}
                    </span>
                </p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-slate-500 mb-2">Expiration</h3>
                <p class="text-lg">
                    {% if coupon.expiresAt %}
                        {{ coupon.expiresAt|date('Y-m-d H:i') }}
                        {% if coupon.isExpired() %}
                            <span class="text-red-600">(Expired)</span>
                        {% endif %}
                    {% else %}
                        <span class="text-gray-400">No expiration</span>
                    {% endif %}
                </p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-slate-500 mb-2">Total Usage Limit</h3>
                <p class="text-lg">
                    {% if coupon.usageLimit %}
                        {{ coupon.usageLimit }} uses
                    {% else %}
                        <span class="text-gray-400">Unlimited</span>
                    {% endif %}
                </p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-slate-500 mb-2">Per-User Usage Limit</h3>
                <p class="text-lg">
                    {% if coupon.perUserLimit %}
                        {{ coupon.perUserLimit }} uses per user
                    {% else %}
                        <span class="text-gray-400">Unlimited</span>
                    {% endif %}
                </p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-slate-500 mb-2">Total Usages</h3>
                <p class="text-lg font-semibold">{{ totalUsages }}</p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-slate-500 mb-2">Created</h3>
                <p class="text-lg">{{ coupon.createdAt|date('Y-m-d H:i') }}</p>
            </div>
            
            <div>
                <h3 class="text-sm font-medium text-slate-500 mb-2">Last Updated</h3>
                <p class="text-lg">{{ coupon.updatedAt|date('Y-m-d H:i') }}</p>
            </div>
        </div>
    </div>
{% endblock %}

