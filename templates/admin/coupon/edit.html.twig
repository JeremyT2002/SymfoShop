{% extends 'admin/base.html.twig' %}

{% block page_title %}Edit Coupon{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('admin_coupons_index') }}" class="text-blue-600 hover:text-blue-900 flex items-center">
            <i class="fas fa-arrow-left mr-2"></i>
            Back to Coupons
        </a>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Edit Coupon</h2>
        
        {{ form_start(form, { attr: { class: 'space-y-6' } }) }}
            {% if not form.vars.valid %}
                <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                    {{ form_errors(form) }}
                </div>
            {% endif %}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="{{ form.code.vars.id }}" class="block text-sm font-medium text-gray-700 mb-2">Code *</label>
                    {{ form_widget(form.code, {
                        attr: {
                            class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500'
                        }
                    }) }}
                    {{ form_errors(form.code) }}
                </div>

                <div>
                    <label for="{{ form.type.vars.id }}" class="block text-sm font-medium text-gray-700 mb-2">Type *</label>
                    {{ form_widget(form.type, {
                        attr: {
                            class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500'
                        }
                    }) }}
                    {{ form_errors(form.type) }}
                </div>

                <div>
                    <label for="{{ form.value.vars.id }}" class="block text-sm font-medium text-gray-700 mb-2">Value *</label>
                    {{ form_widget(form.value, {
                        attr: {
                            class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500'
                        }
                    }) }}
                    <p class="mt-1 text-xs text-gray-500">For percentage: 0-100. For fixed: amount in cents</p>
                    {{ form_errors(form.value) }}
                </div>

                <div>
                    <label for="{{ form.expiresAt.vars.id }}" class="block text-sm font-medium text-gray-700 mb-2">Expiration Date</label>
                    {{ form_widget(form.expiresAt, {
                        attr: {
                            class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500'
                        }
                    }) }}
                    {{ form_errors(form.expiresAt) }}
                </div>

                <div>
                    <label for="{{ form.usageLimit.vars.id }}" class="block text-sm font-medium text-gray-700 mb-2">Total Usage Limit</label>
                    {{ form_widget(form.usageLimit, {
                        attr: {
                            class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500',
                            placeholder: 'Leave empty for unlimited'
                        }
                    }) }}
                    {{ form_errors(form.usageLimit) }}
                </div>

                <div>
                    <label for="{{ form.perUserLimit.vars.id }}" class="block text-sm font-medium text-gray-700 mb-2">Per-User Usage Limit</label>
                    {{ form_widget(form.perUserLimit, {
                        attr: {
                            class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500',
                            placeholder: 'Leave empty for unlimited'
                        }
                    }) }}
                    {{ form_errors(form.perUserLimit) }}
                </div>
            </div>

            <div>
                <label class="flex items-center">
                    {{ form_widget(form.isActive, {
                        attr: {
                            class: 'rounded border-gray-300 text-blue-600 focus:ring-blue-500'
                        }
                    }) }}
                    <span class="ml-2 text-sm text-gray-700">Active</span>
                </label>
            </div>

            <div class="flex justify-end space-x-4">
                <a href="{{ path('admin_coupons_index') }}" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                    Cancel
                </a>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                    Update Coupon
                </button>
            </div>
        {{ form_end(form, { render_rest: false }) }}
    </div>
{% endblock %}

