{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'admin.coupons.page_title'|trans }}{% endblock %}

{% block body %}
    {% from 'admin/components/_icons.html.twig' import icon %}
    {% set activeCount = coupons|filter(c => c.isActive)|length %}
    {% set expiringSoonCount = coupons|filter(c => c.expiresAt and c.expiresAt < date('+14 days'))|length %}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 class="text-2xl font-bold">{{ 'admin.coupons.heading'|trans }}</h2>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{{ 'admin.coupons.subtitle'|trans }}</p>
        </div>
        <a href="{{ path('admin_coupons_new') }}" class="focus-ring inline-flex items-center gap-2 rounded-xl bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-700">
            {{ icon('plus', 'h-4 w-4') }}
            <span>{{ 'admin.coupons.new'|trans }}</span>
        </a>
    </div>

    <div class="mb-4 grid grid-cols-1 gap-3 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-admin dark:border-slate-800 dark:bg-slate-900">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ 'admin.coupons.kpi.total'|trans }}</p>
            <p class="mt-1 text-2xl font-bold">{{ coupons|length }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-admin dark:border-slate-800 dark:bg-slate-900">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ 'admin.coupons.kpi.active'|trans }}</p>
            <p class="mt-1 text-2xl font-bold text-green-600">{{ activeCount }}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-admin dark:border-slate-800 dark:bg-slate-900">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ 'admin.coupons.kpi.expiring_soon'|trans }}</p>
            <p class="mt-1 text-2xl font-bold text-amber-600">{{ expiringSoonCount }}</p>
        </div>
    </div>

    <div x-data="{ selectedIds: [], clearSelection(){ this.selectedIds=[]; } }" class="space-y-4">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-admin dark:border-slate-800 dark:bg-slate-900">
        <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
            <thead class="bg-slate-50 dark:bg-slate-950/60">
                <tr>
                    <th class="px-4 py-3"><input type="checkbox" class="h-4 w-4 rounded border-gray-300"></th>
                    <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">{{ 'admin.coupons.table.code'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">{{ 'admin.coupons.table.type'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">{{ 'admin.coupons.table.value'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">{{ 'admin.coupons.table.expires'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">{{ 'admin.coupons.table.status'|trans }}</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">{{ 'admin.coupons.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white dark:divide-slate-800 dark:bg-slate-900">
                {% if coupons|length > 0 %}
                    {% for coupon in coupons %}
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/70">
                            <td class="px-4 py-4"><input type="checkbox" @change="$event.target.checked ? selectedIds.push({{ coupon.id }}) : selectedIds = selectedIds.filter(id => id !== {{ coupon.id }})" class="h-4 w-4 rounded border-gray-300"></td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">{{ coupon.code }}</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full {% if coupon.type.value == 'percentage' %}bg-blue-100 text-blue-800{% else %}bg-green-100 text-green-800{% endif %}">
                                    {{ coupon.type.value|title }}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                {% if coupon.type.value == 'percentage' %}
                                    {{ coupon.value }}%
                                {% else %}
                                    {{ (coupon.value / 100)|number_format(2, '.', ',') }} EUR
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                                {% if coupon.expiresAt %}
                                    {{ coupon.expiresAt|date('Y-m-d') }}
                                    {% if coupon.isExpired() %}
                                        <span class="ml-1 text-red-600">({{ 'admin.coupons.expired'|trans }})</span>
                                    {% endif %}
                                {% else %}
                                    <span class="text-slate-400">{{ 'admin.coupons.no_expiration'|trans }}</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full {% if coupon.isActive %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                                    {{ coupon.isActive ? 'admin.users.active'|trans : 'admin.users.inactive'|trans }}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a href="{{ path('admin_coupons_show', {id: coupon.id}) }}" class="text-primary-600 hover:text-primary-700 mr-4">{{ 'common.view'|trans }}</a>
                                <a href="{{ path('admin_coupons_edit', {id: coupon.id}) }}" class="text-amber-600 hover:text-amber-700 mr-4">{{ 'common.edit'|trans }}</a>
                                <form method="POST" action="{{ path('admin_coupons_delete', {id: coupon.id}) }}" class="inline" onsubmit="return confirm({{ 'admin.coupons.delete_confirm'|trans|json_encode|raw }});">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_coupon_' ~ coupon.id) }}">
                                    <button type="submit" class="text-red-600 hover:text-red-700">{{ 'common.delete'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="7" class="px-6 py-4 text-center text-sm text-slate-500">
                            {{ 'admin.coupons.empty'|trans }} <a href="{{ path('admin_coupons_new') }}" class="text-primary-600 hover:text-primary-700">{{ 'admin.coupons.new'|trans }}</a>
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
    <div x-show="selectedIds.length > 0" class="sticky bottom-4">
        <div class="flex items-center justify-between rounded-2xl border border-primary-200 bg-primary-50 p-3">
            <p class="text-sm font-medium text-primary-700"><span x-text="selectedIds.length"></span> {{ 'admin.table.selected'|trans }}</p>
            <form method="post" action="{{ path('admin_coupons_bulk_active') }}" class="flex items-center gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('bulk_coupons_active') }}">
                <input type="hidden" name="ids" :value="selectedIds.join(',')">
                <select name="active" class="rounded-xl border border-gray-300 bg-white px-3 py-2 text-xs font-semibold">
                    <option value="1">{{ 'admin.table.bulk_activate'|trans }}</option>
                    <option value="0">{{ 'admin.table.bulk_deactivate'|trans }}</option>
                </select>
                <button type="submit" class="rounded-xl bg-white px-3 py-2 text-xs font-semibold">{{ 'admin.table.bulk_apply'|trans }}</button>
                <button type="button" @click="clearSelection()" class="rounded-xl border border-gray-300 px-3 py-2 text-xs font-semibold">{{ 'admin.table.clear_selection'|trans }}</button>
            </form>
        </div>
    </div>
    </div>
{% endblock %}

