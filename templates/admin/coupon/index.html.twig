{% extends 'admin/base.html.twig' %}

{% block page_title %}Coupons{% endblock %}

{% block body %}
    <div class="admin-page-header">
        <div>
            <h2 class="text-2xl font-bold text-gray-900">Coupons</h2>
            <p class="text-gray-600 mt-1">Manage discount codes and coupons</p>
        </div>
        <a href="{{ path('admin_coupons_new') }}" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors flex items-center space-x-2">
            <i class="fas fa-plus"></i>
            <span>New Coupon</span>
        </a>
    </div>
    
    <div class="admin-card admin-table-wrap">
        <table class="admin-table min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Code</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Value</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Expires</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% if coupons|length > 0 %}
                    {% for coupon in coupons %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900">{{ coupon.code }}</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full {% if coupon.type.value == 'percentage' %}bg-blue-100 text-blue-800{% else %}bg-green-100 text-green-800{% endif %}">
                                    {{ coupon.type.value|title }}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                {% if coupon.type.value == 'percentage' %}
                                    {{ coupon.value }}%
                                {% else %}
                                    {{ (coupon.value / 100)|number_format(2, '.', ',') }} EUR
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                {% if coupon.expiresAt %}
                                    {{ coupon.expiresAt|date('Y-m-d') }}
                                    {% if coupon.isExpired() %}
                                        <span class="text-red-600">(Expired)</span>
                                    {% endif %}
                                {% else %}
                                    <span class="text-gray-400">No expiration</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full {% if coupon.isActive %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                                    {{ coupon.isActive ? 'Active' : 'Inactive' }}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a href="{{ path('admin_coupons_show', {id: coupon.id}) }}" class="text-blue-600 hover:text-blue-900 mr-4">View</a>
                                <a href="{{ path('admin_coupons_edit', {id: coupon.id}) }}" class="text-indigo-600 hover:text-indigo-900 mr-4">Edit</a>
                                <form method="POST" action="{{ path('admin_coupons_delete', {id: coupon.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this coupon?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_coupon_' ~ coupon.id) }}">
                                    <button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="6" class="px-6 py-4 text-center text-sm text-gray-500">
                            No coupons found. <a href="{{ path('admin_coupons_new') }}" class="text-blue-600 hover:text-blue-900">Create one</a>
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
{% endblock %}

