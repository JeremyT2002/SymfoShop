{% extends 'admin/base.html.twig' %}

{% block page_title %}New Coupon{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('admin_coupons_index') }}" class="text-blue-600 hover:text-blue-900 flex items-center">
            <i class="fas fa-arrow-left mr-2"></i>
            Back to Coupons
        </a>
    </div>
    
    <div class="admin-card admin-form-shell p-6">
        {{ form_start(form, { attr: { class: 'space-y-6' } }) }}
            <div class="rounded-xl border border-gray-200 bg-gradient-to-br from-gray-50 to-white p-5">
                <h2 class="text-lg font-semibold text-gray-900">Coupon configuration</h2>
                <p class="mt-1 text-sm text-gray-600">Define discount logic, validity window and usage limits.</p>
            </div>

            {% if not form.vars.valid %}
                <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                    {{ form_errors(form) }}
                </div>
            {% endif %}
            <div class="admin-form-grid">
                <section class="admin-form-section space-y-4">
                <div>
                    <label for="{{ form.code.vars.id }}" class="admin-form-label">Code *</label>
                    {{ form_widget(form.code, {
                        attr: {
                            class: 'admin-form-input'
                        }
                    }) }}
                    {{ form_errors(form.code) }}
                </div>

                <div>
                    <label for="{{ form.type.vars.id }}" class="admin-form-label">Type *</label>
                    {{ form_widget(form.type, {
                        attr: {
                            class: 'admin-form-input'
                        }
                    }) }}
                    {{ form_errors(form.type) }}
                </div>

                <div>
                    <label for="{{ form.value.vars.id }}" class="admin-form-label">Value *</label>
                    {{ form_widget(form.value, {
                        attr: {
                            class: 'admin-form-input'
                        }
                    }) }}
                    <p class="mt-1 text-xs text-gray-500">For percentage: 0-100. For fixed: amount in cents (e.g., 1000 = 10.00 EUR)</p>
                    {{ form_errors(form.value) }}
                </div>
                </section>

                <section class="admin-form-section space-y-4">
                <div>
                    <label for="{{ form.expiresAt.vars.id }}" class="admin-form-label">Expiration date</label>
                    {{ form_widget(form.expiresAt, {
                        attr: {
                            class: 'admin-form-input'
                        }
                    }) }}
                    {{ form_errors(form.expiresAt) }}
                </div>

                <div>
                    <label for="{{ form.usageLimit.vars.id }}" class="admin-form-label">Total usage limit</label>
                    {{ form_widget(form.usageLimit, {
                        attr: {
                            class: 'admin-form-input',
                            placeholder: 'Leave empty for unlimited'
                        }
                    }) }}
                    {{ form_errors(form.usageLimit) }}
                </div>

                <div>
                    <label for="{{ form.perUserLimit.vars.id }}" class="admin-form-label">Per-user usage limit</label>
                    {{ form_widget(form.perUserLimit, {
                        attr: {
                            class: 'admin-form-input',
                            placeholder: 'Leave empty for unlimited'
                        }
                    }) }}
                    {{ form_errors(form.perUserLimit) }}
                </div>
                </section>
            </div>

            <div>
                <label class="flex items-center">
                    {{ form_widget(form.isActive, {
                        attr: {
                            class: 'rounded border-gray-300 text-blue-600 focus:ring-blue-500'
                        }
                    }) }}
                    <span class="ml-2 text-sm text-gray-700">Active</span>
                </label>
            </div>

            <div class="flex justify-end space-x-4">
                <a href="{{ path('admin_coupons_index') }}" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                    Cancel
                </a>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                    Create Coupon
                </button>
            </div>
        {{ form_end(form, { render_rest: false }) }}
    </div>
{% endblock %}

