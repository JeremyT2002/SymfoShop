{% extends 'admin/base.html.twig' %}

{% block page_title %}New Category{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('admin_categories_index') }}" class="text-fg-muted hover:text-fg mb-2 inline-block">
            {{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }} Back to Categories
        </a>
        <h2 class="text-2xl font-bold text-fg">Create New Category</h2>
    </div>
    
    <div class="admin-card admin-form-shell p-6">
        <form method="post" class="space-y-6">
            <div class="rounded-xl border border-line bg-gradient-to-br from-gray-50 to-white p-5">
                <h3 class="text-base font-semibold text-fg">Category setup</h3>
                <p class="mt-1 text-sm text-fg-muted">Create a root category or assign it under an existing parent.</p>
            </div>

            <div class="admin-form-grid">
                <section class="admin-form-section">
                    <label for="name" class="admin-form-label">Category name *</label>
                    <input type="text" id="name" name="name" required placeholder="e.g., Electronics, Clothing, Books" class="admin-form-input" value="{{ category.name|default('') }}">
                    <p class="mt-2 text-xs text-fg-subtle">Use a short and clear label customers immediately understand.</p>
                </section>

                <section class="admin-form-section">
                    <label for="parent" class="admin-form-label">Parent category</label>
                    <select id="parent" name="parent" class="admin-form-input">
                        <option value="">None (Root Category)</option>
                        {% for cat in allCategories %}
                            <option value="{{ cat.id }}">{{ cat.name }}</option>
                        {% endfor %}
                    </select>
                    <p class="mt-2 text-xs text-fg-subtle">Optional. Choose a parent to create a subcategory.</p>
                </section>

                <section class="admin-form-section">
                    <label for="seo_title" class="admin-form-label">SEO Title</label>
                    <input
                        type="text"
                        id="seo_title"
                        name="seo_title"
                        class="admin-form-input"
                        placeholder="Overrides the <title> tag"
                        value="{{ category.seoTitle|default('') }}"
                    >
                    <p class="mt-2 text-xs text-fg-subtle">Optional. Leave empty to use the category name.</p>

                    <label for="seo_description" class="admin-form-label mt-4">SEO Description</label>
                    <textarea
                        id="seo_description"
                        name="seo_description"
                        rows="3"
                        class="admin-form-input resize-y"
                        placeholder="Overrides the meta description"
                    >{{ category.seoDescription|default('') }}</textarea>
                    <p class="mt-2 text-xs text-fg-subtle">Optional. Leave empty to use the category name/description.</p>

                    <div class="flex items-center gap-3 mt-4">
                        <input
                            type="checkbox"
                            id="seo_noindex"
                            name="seo_noindex"
                            value="1"
                            class="rounded border-line-strong"
                            {% if category.seoNoIndex %}checked{% endif %}
                        >
                        <label for="seo_noindex" class="admin-form-label mb-0">No indexing (robots `noindex`)</label>
                    </div>
                </section>
            </div>

            {% include 'admin/components/_translations.html.twig' with {entity: category|default(null)} only %}

            <div class="flex items-center justify-end gap-3 border-t border-line pt-5">
                <a href="{{ path('admin_categories_index') }}" class="rounded-lg border border-line-strong px-4 py-2 text-sm font-medium text-fg-muted hover:bg-subtle">Cancel</a>
                <button type="submit" class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700">Create Category</button>
            </div>
        </form>
    </div>
{% endblock %}

