{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'admin.categories.page_title'|trans }}{% endblock %}

{% block body %}
    <div class="admin-page-header">
        <div>
            <h2 class="text-2xl font-bold text-gray-900">{{ 'admin.categories.heading'|trans }}</h2>
            <p class="text-gray-600 mt-1">{{ 'admin.categories.subtitle'|trans }}</p>
        </div>
        <a href="{{ path('admin_categories_new') }}" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors flex items-center space-x-2">
            <i class="fas fa-plus"></i>
            <span>{{ 'admin.categories.new'|trans }}</span>
        </a>
    </div>

    <div class="admin-card admin-table-wrap">
        <table class="admin-table min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.categories.table.id'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.categories.table.name'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.categories.table.slug'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.categories.table.parent'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.categories.table.children'|trans }}</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.categories.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% if categories|length > 0 %}
                    {% for category in categories %}
                        <tr class="hover:bg-gray-50 {% if category.parent %}bg-gray-50{% endif %}">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                #{{ category.id }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900 {% if category.parent %}pl-4{% endif %}">
                                    {% if category.parent %}<i class="fas fa-level-up-alt text-gray-400 mr-2"></i>{% endif %}
                                    {{ category.name }}
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                {{ category.slug }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                {% if category.parent %}
                                    <a href="{{ path('admin_categories_show', {id: category.parent.id}) }}" class="text-blue-600 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300">
                                        {{ category.parent.name }}
                                    </a>
                                {% else %}
                                    <span class="text-gray-400">—</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                {% set n = category.children|length %}
                                {% if n == 0 %}
                                    {{ 'admin.categories.children_0'|trans }}
                                {% elseif n == 1 %}
                                    {{ 'admin.categories.children_1'|trans }}
                                {% else %}
                                    {{ 'admin.categories.children_n'|trans({'%count%': n}) }}
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                                <a href="{{ path('admin_categories_show', {id: category.id}) }}" class="text-blue-600 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('admin_categories_edit', {id: category.id}) }}" class="text-yellow-600 hover:text-yellow-900 dark:text-yellow-400 dark:hover:text-yellow-300">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('admin_categories_delete', {id: category.id}) }}" class="inline" onsubmit="return confirm({{ 'admin.categories.delete_confirm'|trans|json_encode|raw }});">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}">
                                    <button type="submit" class="text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                            <i class="fas fa-tags text-4xl mb-4 text-gray-300 dark:text-gray-600"></i>
                            <p class="text-lg font-medium">{{ 'admin.categories.empty'|trans }}</p>
                            <p class="text-sm mt-2">{{ 'admin.categories.empty_hint'|trans }}</p>
                            <a href="{{ path('admin_categories_new') }}" class="mt-4 inline-block bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
                                {{ 'admin.categories.create_first'|trans }}
                            </a>
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
{% endblock %}
