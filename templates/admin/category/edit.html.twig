{% extends 'admin/base.html.twig' %}

{% block page_title %}Edit Category: {{ category.name }}{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('admin_categories_index') }}" class="text-gray-600 hover:text-gray-900 mb-2 inline-block">
            <i class="fas fa-arrow-left"></i> Back to Categories
        </a>
        <h2 class="text-2xl font-bold text-gray-900">Edit Category</h2>
    </div>
    
    <div class="admin-card admin-form-shell p-6">
        <form method="post" class="space-y-6">
            <div class="rounded-xl border border-gray-200 bg-gradient-to-br from-gray-50 to-white p-5">
                <h3 class="text-base font-semibold text-gray-900">Category setup</h3>
                <p class="mt-1 text-sm text-gray-600">Update name and hierarchy without changing existing product assignments.</p>
            </div>

            <div class="admin-form-grid">
                <section class="admin-form-section">
                    <label for="name" class="admin-form-label">Category name *</label>
                    <input type="text" id="name" name="name" required placeholder="e.g., Electronics, Clothing, Books" class="admin-form-input" value="{{ category.name }}">
                </section>

                <section class="admin-form-section">
                    <label for="parent" class="admin-form-label">Parent category</label>
                    <select id="parent" name="parent" class="admin-form-input">
                        <option value="">None (Root Category)</option>
                        {% for cat in allCategories %}
                            {% if cat.id != category.id %}
                                <option value="{{ cat.id }}" {% if category.parent and category.parent.id == cat.id %}selected{% endif %}>{{ cat.name }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </section>
            </div>

            <div class="flex items-center justify-end gap-3 border-t border-gray-200 pt-5">
                <a href="{{ path('admin_categories_show', {id: category.id}) }}" class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Cancel</a>
                <button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700">Update Category</button>
            </div>
        </form>
    </div>
{% endblock %}

