{% extends 'admin/base.html.twig' %}

{% block page_title %}Category: {{ category.name }}{% endblock %}

{% block body %}
    <div class="mb-6 flex items-center justify-between gap-3">
        <div>
            <a href="{{ path('admin_categories_index') }}" class="mb-2 inline-flex items-center text-sm text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200">
                <span class="mr-1">←</span> Back to Categories
            </a>
            <h2 class="text-2xl font-bold">{{ category.name }}</h2>
        </div>
        <div class="flex space-x-2">
            <a href="{{ path('admin_categories_new', {parent: category.id}) }}" class="rounded-xl bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700">
                Add subcategory
            </a>
            <a href="{{ path('admin_categories_edit', {id: category.id}) }}" class="rounded-xl bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-700">
                Edit
            </a>
            <form method="post" action="{{ path('admin_categories_delete', {id: category.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this category?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}">
                <button type="submit" class="rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">
                    Delete
                </button>
            </form>
        </div>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-admin dark:border-slate-800 dark:bg-slate-900">
                <h3 class="mb-4 text-lg font-semibold">Category Information</h3>
                <dl class="grid grid-cols-1 gap-4">
                    <div>
                        <dt class="text-sm font-medium text-slate-500">Name</dt>
                        <dd class="mt-1 text-sm">{{ category.name }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-slate-500">Slug</dt>
                        <dd class="mt-1 text-sm">{{ category.slug }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-slate-500">Parent Category</dt>
                        <dd class="mt-1 text-sm">
                            {% if category.parent %}
                                <a href="{{ path('admin_categories_show', {id: category.parent.id}) }}" class="text-primary-600 hover:text-primary-700">
                                    {{ category.parent.name }}
                                </a>
                            {% else %}
                                <span class="text-slate-400">Root category</span>
                            {% endif %}
                        </dd>
                    </div>
                </dl>
            </div>
            
            {% if category.children|length > 0 %}
                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-admin dark:border-slate-800 dark:bg-slate-900">
                    <h3 class="mb-4 text-lg font-semibold">Subcategories ({{ category.children|length }})</h3>
                    <div class="space-y-2">
                        {% for child in category.children %}
                            <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-800/60">
                                <a href="{{ path('admin_categories_show', {id: child.id}) }}" class="font-medium text-primary-600 hover:text-primary-700">
                                    {{ child.name }}
                                </a>
                                <span class="text-sm text-slate-500">{{ child.slug }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
        
        <div class="space-y-6">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-admin dark:border-slate-800 dark:bg-slate-900">
                <h3 class="mb-4 text-lg font-semibold">Metadata</h3>
                <dl class="space-y-3">
                    <div>
                        <dt class="text-sm font-medium text-slate-500">ID</dt>
                        <dd class="mt-1 text-sm">#{{ category.id }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-slate-500">Subcategories</dt>
                        <dd class="mt-1 text-sm">{{ category.children|length }}</dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>
{% endblock %}

