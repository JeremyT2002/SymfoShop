{% extends 'admin/base.html.twig' %}

{% block page_title %}API Key: {{ apiKey.name }}{% endblock %}

{% block body %}
    <div class="mb-6 flex items-center justify-between gap-3">
        <div>
            <a href="{{ path('admin_api_keys_index') }}" class="mb-2 inline-flex items-center text-sm text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200">
                <span class="mr-1">←</span> Back to API Keys
            </a>
            <h2 class="text-2xl font-bold">{{ apiKey.name }}</h2>
        </div>
        <div class="flex space-x-2">
            {% if apiKey.isActive %}
                <form method="post" action="{{ path('admin_api_keys_revoke', {id: apiKey.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to revoke this API key?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('revoke_api_key_' ~ apiKey.id) }}">
                    <button type="submit" class="rounded-xl bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-700">
                        Revoke
                    </button>
                </form>
            {% endif %}
            <form method="post" action="{{ path('admin_api_keys_delete', {id: apiKey.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this API key?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_api_key_' ~ apiKey.id) }}">
                <button type="submit" class="rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">
                    Delete
                </button>
            </form>
        </div>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Info -->
        <div class="lg:col-span-2 space-y-6">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-admin dark:border-slate-800 dark:bg-slate-900">
                <h3 class="text-lg font-semibold mb-4">API Key Information</h3>
                <dl class="grid grid-cols-1 gap-4">
                    <div>
                        <dt class="text-sm font-medium text-slate-500">Name</dt>
                        <dd class="mt-1 text-sm">{{ apiKey.name }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-slate-500">User</dt>
                        <dd class="mt-1 text-sm">{{ apiKey.user.email }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-slate-500">Status</dt>
                        <dd class="mt-1">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                {% if apiKey.isActive %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                                {{ apiKey.isActive ? 'Active' : 'Inactive' }}
                            </span>
                        </dd>
                    </div>
                    {% if apiKey.scopes %}
                        <div>
                            <dt class="text-sm font-medium text-slate-500">Scopes</dt>
                            <dd class="mt-1">
                                <div class="flex flex-wrap gap-2">
                                    {% for scope in apiKey.scopes %}
                                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">
                                            {{ scope }}
                                        </span>
                                    {% endfor %}
                                </div>
                            </dd>
                        </div>
                    {% endif %}
                    {% if apiKey.expiresAt %}
                        <div>
                            <dt class="text-sm font-medium text-slate-500">Expires At</dt>
                            <dd class="mt-1 text-sm">{{ apiKey.expiresAt|date('Y-m-d H:i') }}</dd>
                        </div>
                    {% endif %}
                </dl>
            </div>
            
            {% if plainKey %}
                <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 dark:border-amber-900/40 dark:bg-amber-900/20">
                    <h3 class="text-lg font-semibold text-amber-900 dark:text-amber-200 mb-2">
                        Important: Save Your API Key
                    </h3>
                    <p class="text-sm text-amber-800 dark:text-amber-300 mb-4">
                        This is the only time you will see the API key. Make sure to copy it now!
                    </p>
                    <div class="rounded-xl border border-amber-300 bg-white p-4 dark:border-amber-900/60 dark:bg-slate-900">
                        <code id="plain-api-key" class="text-sm font-mono break-all">{{ plainKey }}</code>
                    </div>
                    <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('plain-api-key').innerText)" class="mt-4 rounded-xl bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-700">
                        Copy to Clipboard
                    </button>
                </div>
            {% endif %}
        </div>
        
        <!-- Sidebar -->
        <div class="space-y-6">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-admin dark:border-slate-800 dark:bg-slate-900">
                <h3 class="text-lg font-semibold mb-4">Metadata</h3>
                <dl class="space-y-3">
                    <div>
                        <dt class="text-sm font-medium text-slate-500">ID</dt>
                        <dd class="mt-1 text-sm">#{{ apiKey.id }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-slate-500">Created</dt>
                        <dd class="mt-1 text-sm">{{ apiKey.createdAt|date('Y-m-d H:i') }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-slate-500">Last Used</dt>
                        <dd class="mt-1 text-sm">{{ apiKey.lastUsedAt ? apiKey.lastUsedAt|date('Y-m-d H:i') : 'Never' }}</dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>
{% endblock %}

