{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ 'admin.shipping_methods.title'|trans }}{% endblock %}

{% block body %}
    <div class="admin-page-header">
        <div>
            <h2 class="text-2xl font-bold text-gray-900">{{ 'admin.shipping_methods.title'|trans }}</h2>
            <p class="text-gray-600 mt-1">{{ 'admin.shipping_methods.subtitle'|trans }}</p>
        </div>
        <a href="{{ path('admin_shipping_methods_new') }}" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
            <i class="fas fa-plus mr-1"></i> {{ 'admin.shipping_methods.new'|trans }}
        </a>
    </div>

    <div class="admin-card admin-table-wrap">
        <table class="admin-table min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.shipping_methods.table.name'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.shipping_methods.table.code'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.shipping_methods.table.amount_cents'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.shipping_methods.table.sort'|trans }}</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.shipping_methods.table.active'|trans }}</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">{{ 'admin.shipping_methods.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for method in methods %}
                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-900">{{ method.name }}</td>
                        <td class="px-6 py-4 text-sm font-mono text-gray-700">{{ method.code }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ method.amountCents }}</td>
                        <td class="px-6 py-4 text-sm text-gray-700">{{ method.sortOrder }}</td>
                        <td class="px-6 py-4 text-sm">
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold {{ method.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}">
                                {{ method.isActive ? 'common.yes'|trans : 'common.no'|trans }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right text-sm">
                            <a href="{{ path('admin_shipping_methods_edit', {id: method.id}) }}" class="text-blue-600 hover:text-blue-900 mr-3">{{ 'common.edit'|trans }}</a>
                            <form method="post" action="{{ path('admin_shipping_methods_delete', {id: method.id}) }}" class="inline" onsubmit="return confirm({{ 'admin.shipping_methods.confirm_delete'|trans|json_encode|raw }});">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_shipping_method_' ~ method.id) }}">
                                <button type="submit" class="text-red-600 hover:text-red-900">{{ 'common.delete'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">{{ 'admin.shipping_methods.empty'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
