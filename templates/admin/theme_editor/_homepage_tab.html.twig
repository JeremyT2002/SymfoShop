<div class="max-w-2xl space-y-6">
    <div class="bg-primary-50 border border-primary-200 rounded-lg p-4">
        <p class="text-sm text-primary-800 flex items-start gap-2">
            {{ ux_icon('lucide:info', {class: 'size-4 mt-0.5 flex-shrink-0'}) }}
            <span>Drag to reorder sections. Toggle <strong>Enabled</strong> to show or hide each section on the homepage.</span>
        </p>
    </div>

    <div data-js="section-builder" data-section-types='{{ ["hero","benefits","featured_products","category_grid","testimonials","newsletter","rich_text"]|json_encode }}'>
        <ul id="section-list" class="space-y-3">
            {% for section in config.homepage.sections|default([]) %}
                <li class="section-card flex items-center gap-4 p-4 bg-panel border border-line rounded-xl shadow-sm" data-section-id="{{ section.id|default('s-' ~ loop.index) }}">
                    <span class="cursor-grab active:cursor-grabbing text-fg-subtle hover:text-fg p-1" title="Drag to reorder">{{ ux_icon('lucide:grip-vertical', {class: 'size-4'}) }}</span>
                    <div class="flex-1 min-w-0">
                        <span class="font-medium text-fg">{{ section.type|default('section')|replace({'_': ' '}) }}</span>
                        <span class="text-sm text-fg-subtle ml-2">— {{ section.settings.title|default(section.id) }}</span>
                    </div>
                    <label class="flex items-center gap-2 px-3 py-1.5 rounded-lg hover:bg-subtle cursor-pointer">
                        <input type="checkbox" class="section-enabled rounded border-line-strong text-primary-600 focus:ring-primary-500 w-4 h-4" {% if section.enabled|default(true) %}checked{% endif %}>
                        <span class="text-sm text-fg-muted">Enabled</span>
                    </label>
                    <button type="button" class="section-remove p-2 text-fg-subtle hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Remove section">
                        {{ ux_icon('lucide:trash-2', {class: 'size-4'}) }}
                    </button>
                </li>
            {% else %}
                <li class="flex flex-col items-center justify-center py-12 px-6 bg-subtle rounded-xl border-2 border-dashed border-line text-center" data-empty-placeholder>
                    {{ ux_icon('lucide:layers', {class: 'size-9 text-gray-300 mb-3'}) }}
                    <p class="text-sm font-medium text-fg-muted">No sections yet</p>
                    <p class="text-xs text-fg-subtle mt-1">Add your first section below</p>
                </li>
            {% endfor %}
        </ul>
        <div class="mt-6 p-4 bg-panel rounded-xl border border-line">
            <label class="block text-sm font-medium text-fg-muted mb-3">Add section</label>
            <div class="flex flex-wrap items-center gap-2">
                <select id="add-section-type" class="rounded-lg border border-line-strong px-3 py-2.5 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-colors"
                        style="min-width: 180px;">
                    <option value="hero">Hero</option>
                    <option value="benefits">Benefits</option>
                    <option value="featured_products">Featured Products</option>
                    <option value="category_grid">Category Grid</option>
                    <option value="testimonials">Testimonials</option>
                    <option value="newsletter">Newsletter</option>
                    <option value="rich_text">Rich Text</option>
                </select>
                <button type="button" id="add-section-btn" class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary-600 text-white rounded-lg hover:bg-primary-700 text-sm font-medium transition-colors shadow-sm">
                    {{ ux_icon('lucide:plus', {class: 'size-4'}) }}
                    Add section
                </button>
            </div>
        </div>
    </div>
    <input type="hidden" id="homepage-sections-data" name="homepage_sections" value="{{ config.homepage.sections|default([])|json_encode }}">
</div>
