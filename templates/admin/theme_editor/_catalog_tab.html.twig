<div class="max-w-2xl space-y-8">
    <section class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
            <h3 class="text-sm font-semibold text-gray-900 flex items-center gap-2">
                <i class="fas fa-th-large text-gray-500"></i>
                Catalog layout
            </h3>
            <p class="text-xs text-gray-500 mt-0.5">Product grid and filter options</p>
        </div>
        <div class="p-6 space-y-5">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-3">Grid columns</label>
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs text-gray-500 mb-1">Mobile</label>
                        <input type="number" data-theme-key="catalog.gridColumns.mobile" min="1" max="2"
                               value="{{ config.catalog.gridColumns.mobile|default(1) }}"
                               class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 mb-1">Tablet</label>
                        <input type="number" data-theme-key="catalog.gridColumns.tablet" min="1" max="4"
                               value="{{ config.catalog.gridColumns.tablet|default(2) }}"
                               class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 mb-1">Desktop</label>
                        <input type="number" data-theme-key="catalog.gridColumns.desktop" min="1" max="6"
                               value="{{ config.catalog.gridColumns.desktop|default(4) }}"
                               class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                    </div>
                </div>
            </div>
            <div class="flex flex-col gap-3">
                <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:bg-gray-50">
                    <input type="checkbox" data-theme-key="catalog.showFilters" {% if config.catalog.showFilters|default(true) %}checked{% endif %}
                           class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 w-4 h-4">
                    <span class="text-sm text-gray-700">Show filters</span>
                </label>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Filter position</label>
                    <select data-theme-key="catalog.filterPosition" class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                        <option value="sidebar" {% if (config.catalog.filterPosition|default('sidebar')) == 'sidebar' %}selected{% endif %}>Sidebar</option>
                        <option value="top" {% if (config.catalog.filterPosition|default('')) == 'top' %}selected{% endif %}>Top</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Badge style</label>
                    <select data-theme-key="catalog.badgeStyle" class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                        <option value="pill" {% if (config.catalog.badgeStyle|default('pill')) == 'pill' %}selected{% endif %}>Pill</option>
                        <option value="square" {% if (config.catalog.badgeStyle|default('')) == 'square' %}selected{% endif %}>Square</option>
                    </select>
                </div>
            </div>
        </div>
    </section>
</div>
