{% extends 'admin/base.html.twig' %}

{% block page_title %}Theme Editor{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .theme-editor-tabs { scrollbar-width: thin; }
        .theme-tab:hover { color: var(--color-text-primary); }
        .section-card { transition: box-shadow 0.2s, border-color 0.2s; }
        .section-card:hover { border-color: var(--ui-line-strong); }
        .section-card:has(.section-enabled:not(:checked)) { opacity: 0.7; }
    </style>
{% endblock %}

{% block js_page %}theme-editor{% endblock %}

{% block body %}
<div class="space-y-6" data-js="theme-editor">
    {# Sticky toolbar #}
    <div class="sticky top-16 z-10 -mx-4 -mt-6 mb-6 border-b border-line bg-canvas/95 px-4 pt-6 pb-4 backdrop-blur sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div>
                    <h2 class="text-xl font-bold text-fg">Theme: {{ theme.name }}</h2>
                    <div class="flex items-center gap-2 mt-1">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ theme.status == 'published' ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' }}">
                            {{ theme.status == 'published' ? 'Published' : 'Draft' }}
                        </span>
                        <span class="text-sm text-fg-subtle">v{{ theme.version }}</span>
                    </div>
                </div>
                <div class="h-8 w-px bg-line hidden sm:block"></div>
                <div class="flex flex-wrap items-center gap-2">
                    <a href="{{ path('catalog_home') }}?theme_preview=1" target="_blank" class="inline-flex items-center gap-2 px-3 py-2 text-sm font-medium text-fg-muted bg-panel border border-line-strong rounded-lg hover:bg-subtle hover:border-gray-400 transition-colors shadow-sm">
                        {{ ux_icon('lucide:external-link', {class: 'size-4 text-fg-subtle'}) }}
                        Preview
                    </a>
                    <div class="flex items-center gap-1">
                        <form method="post" action="{{ path('admin_theme_import') }}" enctype="multipart/form-data" class="inline">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_theme_import') }}">
                            <label class="inline-flex items-center gap-2 px-3 py-2 text-sm font-medium text-fg-muted bg-panel border border-line-strong rounded-lg hover:bg-subtle cursor-pointer transition-colors shadow-sm">
                                {{ ux_icon('lucide:upload', {class: 'size-4 text-fg-subtle'}) }}
                                Import
                                <input type="file" name="config_file" accept=".json" class="sr-only" onchange="this.form.submit()">
                            </label>
                        </form>
                        <form method="get" action="{{ path('admin_theme_export') }}" class="inline">
                            <button type="submit" class="inline-flex items-center gap-2 px-3 py-2 text-sm font-medium text-fg-muted bg-panel border border-line-strong rounded-lg hover:bg-subtle transition-colors shadow-sm">
                                {{ ux_icon('lucide:download', {class: 'size-4 text-fg-subtle'}) }}
                                Export
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <form method="post" action="{{ path('admin_theme_reset') }}" class="inline theme-reset-form" onsubmit="return confirm('Reset theme to default? All unsaved changes will be lost.');">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_theme_reset') }}">
                    <button type="submit" class="inline-flex items-center gap-2 px-3 py-2 text-sm font-medium text-fg-muted bg-panel border border-line-strong rounded-lg hover:bg-subtle hover:text-red-600 hover:border-red-200 transition-colors">
                        {{ ux_icon('lucide:undo-2', {class: 'size-4'}) }}
                        Reset
                    </button>
                </form>
                <form method="post" action="{{ path('admin_theme_save') }}" class="inline theme-save-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_theme_save') }}">
                    <input type="hidden" name="config" id="theme-config-input" value="{{ config|json_encode|e('html_attr') }}">
                    <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors shadow-md">
                        {{ ux_icon('lucide:save', {class: 'size-4'}) }}
                        Save draft
                    </button>
                </form>
                <form method="post" action="{{ path('admin_theme_publish') }}" class="inline theme-publish-form" onsubmit="return confirm('Publish theme? The storefront will use this configuration immediately.');">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_theme_publish') }}">
                    <input type="hidden" name="config" id="theme-config-publish" value="{{ config|json_encode|e('html_attr') }}">
                    <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 transition-colors shadow-md">
                        {{ ux_icon('lucide:check', {class: 'size-4'}) }}
                        Publish
                    </button>
                </form>
            </div>
        </div>
    </div>

    {# Tabs - scrollable on mobile #}
    <div class="border-b border-line -mx-6 px-6 overflow-x-auto theme-editor-tabs">
        <nav class="-mb-px flex gap-1 min-w-max" aria-label="Theme sections">
            <button type="button" data-tab="brand" class="theme-tab py-4 px-3 border-b-2 font-medium text-sm whitespace-nowrap border-fg text-fg">
                {{ ux_icon('lucide:palette', {class: 'size-4 mr-2 text-current opacity-80'}) }}Brand
            </button>
            <button type="button" data-tab="header-footer" class="theme-tab py-4 px-3 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-fg-subtle">
                {{ ux_icon('lucide:menu', {class: 'size-4 mr-2'}) }}Header & Footer
            </button>
            <button type="button" data-tab="homepage" class="theme-tab py-4 px-3 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-fg-subtle">
                {{ ux_icon('lucide:house', {class: 'size-4 mr-2'}) }}Homepage
            </button>
            <button type="button" data-tab="catalog" class="theme-tab py-4 px-3 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-fg-subtle">
                {{ ux_icon('lucide:layout-grid', {class: 'size-4 mr-2'}) }}Catalog
            </button>
            <button type="button" data-tab="product" class="theme-tab py-4 px-3 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-fg-subtle">
                {{ ux_icon('lucide:package', {class: 'size-4 mr-2'}) }}Product
            </button>
            <button type="button" data-tab="components" class="theme-tab py-4 px-3 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-fg-subtle">
                {{ ux_icon('lucide:puzzle', {class: 'size-4 mr-2'}) }}Components
            </button>
            <button type="button" data-tab="custom-css" class="theme-tab py-4 px-3 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-fg-subtle">
                {{ ux_icon('lucide:code', {class: 'size-4 mr-2'}) }}Custom CSS
            </button>
            <button type="button" data-tab="revisions" class="theme-tab py-4 px-3 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-fg-subtle">
                {{ ux_icon('lucide:history', {class: 'size-4 mr-2'}) }}Revisions
            </button>
        </nav>
    </div>

    {# Tab panels #}
    <div id="tab-brand" class="theme-tab-panel pt-6">
        {% include 'admin/theme_editor/_brand_tab.html.twig' %}
    </div>
    <div id="tab-header-footer" class="theme-tab-panel hidden pt-6">
        {% include 'admin/theme_editor/_header_footer_tab.html.twig' %}
    </div>
    <div id="tab-homepage" class="theme-tab-panel hidden pt-6">
        {% include 'admin/theme_editor/_homepage_tab.html.twig' %}
    </div>
    <div id="tab-catalog" class="theme-tab-panel hidden pt-6">
        {% include 'admin/theme_editor/_catalog_tab.html.twig' %}
    </div>
    <div id="tab-product" class="theme-tab-panel hidden pt-6">
        {% include 'admin/theme_editor/_product_tab.html.twig' %}
    </div>
    <div id="tab-components" class="theme-tab-panel hidden pt-6">
        {% include 'admin/theme_editor/_components_tab.html.twig' %}
    </div>
    <div id="tab-custom-css" class="theme-tab-panel hidden pt-6">
        {% include 'admin/theme_editor/_custom_css_tab.html.twig' %}
    </div>
    <div id="tab-revisions" class="theme-tab-panel hidden pt-6">
        {% include 'admin/theme_editor/_revisions_tab.html.twig' %}
    </div>
</div>

{% endblock %}
