{% extends 'admin/base.html.twig' %}

{% block page_title %}Theme Editor{% endblock %}

{% block body %}
<div class="space-y-6" data-js="theme-editor">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h2 class="text-lg font-semibold text-gray-900">Theme: {{ theme.name }}</h2>
            <p class="text-sm text-gray-500">Status: {{ theme.status }} | Version: {{ theme.version }}</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="{{ path('catalog_home') }}?theme_preview=1" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                <i class="fas fa-external-link-alt"></i> Preview
            </a>
            <form method="post" action="{{ path('admin_theme_import') }}" enctype="multipart/form-data" class="inline">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_theme_import') }}">
                <input type="file" name="config_file" accept=".json" class="text-sm">
                <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                    <i class="fas fa-upload"></i> Import
                </button>
            </form>
            <form method="get" action="{{ path('admin_theme_export') }}" class="inline">
                <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                    <i class="fas fa-download"></i> Export
                </button>
            </form>
            <form method="post" action="{{ path('admin_theme_reset') }}" class="inline theme-reset-form" onsubmit="return confirm('Reset theme to default?');">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_theme_reset') }}">
                <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-red-700 bg-white border border-red-300 rounded-lg hover:bg-red-50">
                    <i class="fas fa-undo"></i> Reset
                </button>
            </form>
            <form method="post" action="{{ path('admin_theme_save') }}" class="inline theme-save-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_theme_save') }}">
                <input type="hidden" name="config" id="theme-config-input" value="{{ config|json_encode|e('html_attr') }}">
                <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700">
                    <i class="fas fa-save"></i> Save draft
                </button>
            </form>
            <form method="post" action="{{ path('admin_theme_publish') }}" class="inline theme-publish-form" onsubmit="return confirm('Publish theme? Storefront will use this configuration.');">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_theme_publish') }}">
                <input type="hidden" name="config" id="theme-config-publish" value="{{ config|json_encode|e('html_attr') }}">
                <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700">
                    <i class="fas fa-check"></i> Publish
                </button>
            </form>
        </div>
    </div>

    {# Tabs #}
    <div class="border-b border-gray-200">
        <nav class="-mb-px flex gap-6" aria-label="Tabs">
            <button type="button" data-tab="brand" class="theme-tab py-4 px-1 border-b-2 font-medium text-sm whitespace-nowrap border-blue-500 text-blue-600">Brand</button>
            <button type="button" data-tab="header-footer" class="theme-tab py-4 px-1 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">Header & Footer</button>
            <button type="button" data-tab="homepage" class="theme-tab py-4 px-1 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">Homepage</button>
            <button type="button" data-tab="catalog" class="theme-tab py-4 px-1 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">Catalog</button>
            <button type="button" data-tab="product" class="theme-tab py-4 px-1 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">Product</button>
            <button type="button" data-tab="components" class="theme-tab py-4 px-1 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">Components</button>
            <button type="button" data-tab="custom-css" class="theme-tab py-4 px-1 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">Custom CSS</button>
            <button type="button" data-tab="revisions" class="theme-tab py-4 px-1 border-b-2 font-medium text-sm whitespace-nowrap border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">Revisions</button>
        </nav>
    </div>

    {# Tab panels #}
    <div id="tab-brand" class="theme-tab-panel">
        {% include 'admin/theme_editor/_brand_tab.html.twig' %}
    </div>
    <div id="tab-header-footer" class="theme-tab-panel hidden">
        {% include 'admin/theme_editor/_header_footer_tab.html.twig' %}
    </div>
    <div id="tab-homepage" class="theme-tab-panel hidden">
        {% include 'admin/theme_editor/_homepage_tab.html.twig' %}
    </div>
    <div id="tab-catalog" class="theme-tab-panel hidden">
        {% include 'admin/theme_editor/_catalog_tab.html.twig' %}
    </div>
    <div id="tab-product" class="theme-tab-panel hidden">
        {% include 'admin/theme_editor/_product_tab.html.twig' %}
    </div>
    <div id="tab-components" class="theme-tab-panel hidden">
        {% include 'admin/theme_editor/_components_tab.html.twig' %}
    </div>
    <div id="tab-custom-css" class="theme-tab-panel hidden">
        {% include 'admin/theme_editor/_custom_css_tab.html.twig' %}
    </div>
    <div id="tab-revisions" class="theme-tab-panel hidden">
        {% include 'admin/theme_editor/_revisions_tab.html.twig' %}
    </div>
</div>

<script type="module" src="{{ asset('js/admin/theme-editor.js') }}"></script>
{% endblock %}
