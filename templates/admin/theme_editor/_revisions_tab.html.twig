<div class="max-w-2xl">
    <section class="bg-panel rounded-xl border border-line shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-subtle border-b border-line">
            <h3 class="text-sm font-semibold text-fg flex items-center gap-2">
                {{ ux_icon('lucide:history', {class: 'size-4 text-fg-subtle'}) }}
                Revision history
            </h3>
            <p class="text-xs text-fg-subtle mt-0.5">Rollback to a previous version of your theme</p>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-line">
                <thead class="bg-subtle">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-fg-subtle uppercase tracking-wider">Version</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-fg-subtle uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-fg-subtle uppercase tracking-wider">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-fg-subtle uppercase tracking-wider">Comment</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-fg-subtle uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-panel divide-y divide-line">
                    {% for rev in theme.revisions|slice(0, 20) %}
                        <tr class="hover:bg-subtle transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-subtle text-fg">v{{ rev.version }}</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-fg-muted">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium {{ rev.status == 'published' ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' }}">
                                    {{ rev.status }}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-fg-subtle">{{ rev.createdAt|date('M j, Y H:i') }}</td>
                            <td class="px-6 py-4 text-sm text-fg-subtle">{{ rev.comment|default('-') }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-right">
                                <form method="post" action="{{ path('admin_theme_rollback', {version: rev.version}) }}" class="inline" onsubmit="return confirm('Rollback to version {{ rev.version }}? Current draft will be replaced.');">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_theme_rollback') }}">
                                    <button type="submit" class="text-primary-600 hover:text-primary-800 text-sm font-medium">Rollback</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center">
                                {{ ux_icon('lucide:inbox', {class: 'size-9 text-gray-300 mb-3 block'}) }}
                                <p class="text-sm text-fg-subtle">No revisions yet</p>
                                <p class="text-xs text-fg-subtle mt-1">Revisions are created when you save or publish</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
