<div class="max-w-2xl">
    <section class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
            <h3 class="text-sm font-semibold text-gray-900 flex items-center gap-2">
                <i class="fas fa-history text-gray-500"></i>
                Revision history
            </h3>
            <p class="text-xs text-gray-500 mt-0.5">Rollback to a previous version of your theme</p>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Version</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Comment</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for rev in theme.revisions|slice(0, 20) %}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">v{{ rev.version }}</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium {{ rev.status == 'published' ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' }}">
                                    {{ rev.status }}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ rev.createdAt|date('M j, Y H:i') }}</td>
                            <td class="px-6 py-4 text-sm text-gray-500">{{ rev.comment|default('-') }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-right">
                                <form method="post" action="{{ path('admin_theme_rollback', {version: rev.version}) }}" class="inline" onsubmit="return confirm('Rollback to version {{ rev.version }}? Current draft will be replaced.');">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_theme_rollback') }}">
                                    <button type="submit" class="text-blue-600 hover:text-blue-800 text-sm font-medium">Rollback</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center">
                                <i class="fas fa-inbox text-4xl text-gray-300 mb-3 block"></i>
                                <p class="text-sm text-gray-500">No revisions yet</p>
                                <p class="text-xs text-gray-400 mt-1">Revisions are created when you save or publish</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
