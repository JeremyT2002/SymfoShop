<div class="max-w-2xl">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Version</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Comment</th>
                <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            {% for rev in theme.revisions|slice(0, 20) %}
                <tr>
                    <td class="px-4 py-3 text-sm font-medium text-gray-900">{{ rev.version }}</td>
                    <td class="px-4 py-3 text-sm text-gray-500">{{ rev.status }}</td>
                    <td class="px-4 py-3 text-sm text-gray-500">{{ rev.createdAt|date('Y-m-d H:i') }}</td>
                    <td class="px-4 py-3 text-sm text-gray-500">{{ rev.comment|default('-') }}</td>
                    <td class="px-4 py-3 text-right">
                        <form method="post" action="{{ path('admin_theme_rollback', {version: rev.version}) }}" class="inline" onsubmit="return confirm('Rollback to this version?');">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_theme_rollback') }}">
                            <button type="submit" class="text-blue-600 hover:text-blue-800 text-sm font-medium">Rollback</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="px-4 py-8 text-center text-sm text-gray-500">No revisions yet.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
