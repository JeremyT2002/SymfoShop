<div class="max-w-2xl space-y-8">
    {# Brand identity #}
    <section class="bg-panel rounded-xl border border-line shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-subtle border-b border-line">
            <h3 class="text-sm font-semibold text-fg flex items-center gap-2">
                {{ ux_icon('lucide:store', {class: 'size-4 text-fg-subtle'}) }}
                Brand identity
            </h3>
            <p class="text-xs text-fg-subtle mt-0.5">Your store name and visual assets</p>
        </div>
        <div class="p-6 space-y-5">
            <div>
                <label class="block text-sm font-medium text-fg-muted mb-1.5">Site name</label>
                <input type="text" data-theme-key="brand.siteName" value="{{ config.brand.siteName|default('SymfoShop') }}"
                       class="block w-full rounded-lg border border-line-strong px-3 py-2.5 shadow-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-colors"
                       placeholder="My Shop">
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-sm font-medium text-fg-muted mb-1.5">Logo URL</label>
                    <input type="text" data-theme-key="brand.logoUrl" value="{{ config.brand.logoUrl|default('') }}"
                           placeholder="/uploads/theme/logo.png"
                           class="block w-full rounded-lg border border-line-strong px-3 py-2.5 shadow-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-colors">
                </div>
                <div>
                    <label class="block text-sm font-medium text-fg-muted mb-1.5">Logo alt text</label>
                    <input type="text" data-theme-key="brand.logoAlt" value="{{ config.brand.logoAlt|default('Shop Logo') }}"
                           class="block w-full rounded-lg border border-line-strong px-3 py-2.5 shadow-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-colors"
                           placeholder="Logo description">
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-fg-muted mb-1.5">Favicon URL</label>
                <input type="text" data-theme-key="brand.faviconUrl" value="{{ config.brand.faviconUrl|default('') }}"
                       placeholder="/uploads/theme/favicon.ico"
                       class="block w-full rounded-lg border border-line-strong px-3 py-2.5 shadow-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-colors">
            </div>
        </div>
    </section>

    {# Colors #}
    <section class="bg-panel rounded-xl border border-line shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-subtle border-b border-line">
            <h3 class="text-sm font-semibold text-fg flex items-center gap-2">
                {{ ux_icon('lucide:swatch-book', {class: 'size-4 text-fg-subtle'}) }}
                Colors
            </h3>
            <p class="text-xs text-fg-subtle mt-0.5">Primary palette and accent color</p>
        </div>
        <div class="p-6 space-y-5">
            <div>
                <label class="block text-sm font-medium text-fg-muted mb-3">Primary color scale</label>
                <div class="grid grid-cols-5 sm:grid-cols-10 gap-3">
                    {% for shade in ['50', '100', '200', '300', '400', '500', '600', '700', '800', '900'] %}
                        <div>
                            <label class="block text-xs text-fg-subtle mb-1.5 text-center">{{ shade }}</label>
                            <input type="color" data-theme-key="colors.primary.{{ shade }}"
                                   value="{{ config.colors.primary[shade]|default('#3b82f6') }}"
                                   class="block w-full h-9 rounded-lg border border-line-strong cursor-pointer hover:border-gray-400 transition-colors"
                                   title="{{ config.colors.primary[shade]|default('#3b82f6') }}">
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="flex items-center gap-4 pt-2">
                <div>
                    <label class="block text-sm font-medium text-fg-muted mb-1.5">Accent color</label>
                    <div class="flex items-center gap-2">
                        <input type="color" data-theme-key="colors.accent" value="{{ config.colors.accent|default('#22c55e') }}"
                               class="block w-12 h-10 rounded-lg border border-line-strong cursor-pointer">
                        <span class="text-sm font-mono text-fg-muted">{{ config.colors.accent|default('#22c55e') }}</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# Typography #}
    <section class="bg-panel rounded-xl border border-line shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-subtle border-b border-line">
            <h3 class="text-sm font-semibold text-fg flex items-center gap-2">
                {{ ux_icon('lucide:type', {class: 'size-4 text-fg-subtle'}) }}
                Typography
            </h3>
            <p class="text-xs text-fg-subtle mt-0.5">Font families for body and headings</p>
        </div>
        <div class="p-6">
            <div>
                <label class="block text-sm font-medium text-fg-muted mb-1.5">Font family (sans-serif)</label>
                <input type="text" data-theme-key="typography.fontFamily.sans"
                       value="{% if config.typography.fontFamily.sans is defined and config.typography.fontFamily.sans is iterable %}{{ config.typography.fontFamily.sans|join(', ') }}{% else %}Inter, system-ui, sans-serif{% endif %}"
                       placeholder="Inter, system-ui, sans-serif"
                       class="block w-full rounded-lg border border-line-strong px-3 py-2.5 shadow-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-colors">
            </div>
        </div>
    </section>
</div>
