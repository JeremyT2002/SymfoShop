<div class="max-w-2xl space-y-8">
    <section class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
            <h3 class="text-sm font-semibold text-gray-900 flex items-center gap-2">
                <i class="fas fa-box text-gray-500"></i>
                Product page
            </h3>
            <p class="text-xs text-gray-500 mt-0.5">Gallery, add-to-cart, and tabs layout</p>
        </div>
        <div class="p-6 space-y-5">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Gallery style</label>
                <select data-theme-key="product.galleryStyle" class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                    <option value="thumbnails" {% if (config.product.galleryStyle|default('thumbnails')) == 'thumbnails' %}selected{% endif %}>Thumbnails</option>
                    <option value="carousel" {% if (config.product.galleryStyle|default('')) == 'carousel' %}selected{% endif %}>Carousel</option>
                </select>
            </div>
            <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:bg-gray-50">
                <input type="checkbox" data-theme-key="product.stickyAddToCart" {% if config.product.stickyAddToCart|default(true) %}checked{% endif %}
                       class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 w-4 h-4">
                <span class="text-sm text-gray-700">Sticky add-to-cart on scroll</span>
            </label>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Tabs layout</label>
                <select data-theme-key="product.tabsLayout" class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                    <option value="accordion" {% if (config.product.tabsLayout|default('accordion')) == 'accordion' %}selected{% endif %}>Accordion</option>
                    <option value="tabs" {% if (config.product.tabsLayout|default('')) == 'tabs' %}selected{% endif %}>Tabs</option>
                </select>
            </div>
        </div>
    </section>
</div>
