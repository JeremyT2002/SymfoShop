<div class="max-w-2xl space-y-8">
    {# Header #}
    <section class="bg-panel rounded-xl border border-line shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-subtle border-b border-line">
            <h3 class="text-sm font-semibold text-fg flex items-center gap-2">
                {{ ux_icon('lucide:menu', {class: 'size-4 text-fg-subtle'}) }}
                Header
            </h3>
            <p class="text-xs text-fg-subtle mt-0.5">Navigation and header behavior</p>
        </div>
        <div class="p-6 space-y-5">
            <div class="flex flex-col gap-3">
                <label class="flex items-center gap-3 p-3 rounded-lg border border-line hover:bg-subtle">
                    <input type="checkbox" data-theme-key="header.sticky" {% if config.header.sticky|default(true) %}checked{% endif %}
                           class="rounded border-line-strong text-primary-600 focus:ring-primary-500 w-4 h-4">
                    <span class="text-sm text-fg-muted">Sticky header</span>
                </label>
                <label class="flex items-center gap-3 p-3 rounded-lg border border-line hover:bg-subtle">
                    <input type="checkbox" data-theme-key="header.showCart" {% if config.header.showCart|default(true) %}checked{% endif %}
                           class="rounded border-line-strong text-primary-600 focus:ring-primary-500 w-4 h-4">
                    <span class="text-sm text-fg-muted">Show cart icon</span>
                </label>
                <label class="flex items-center gap-3 p-3 rounded-lg border border-line hover:bg-subtle">
                    <input type="checkbox" data-theme-key="header.showLanguageSwitcher" {% if config.header.showLanguageSwitcher|default(true) %}checked{% endif %}
                           class="rounded border-line-strong text-primary-600 focus:ring-primary-500 w-4 h-4">
                    <span class="text-sm text-fg-muted">Show language switcher</span>
                </label>
            </div>
            <div>
                <label class="block text-sm font-medium text-fg-muted mb-1.5">Menu items (JSON)</label>
                <textarea data-theme-key="header.menuItems" rows="6"
                          class="block w-full rounded-lg border border-line-strong px-3 py-2.5 font-mono text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-colors"
                          placeholder='[{"label":"Home","url":"/","external":false}]'>{{ config.header.menuItems|default([])|json_encode(192) }}</textarea>
                <p class="mt-1.5 text-xs text-fg-subtle">Format: [{"label":"Home","url":"/","external":false}]</p>
            </div>
        </div>
    </section>

    {# Footer #}
    <section class="bg-panel rounded-xl border border-line shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-subtle border-b border-line">
            <h3 class="text-sm font-semibold text-fg flex items-center gap-2">
                {{ ux_icon('lucide:footprints', {class: 'size-4 text-fg-subtle'}) }}
                Footer
            </h3>
            <p class="text-xs text-fg-subtle mt-0.5">Copyright, columns, and social links</p>
        </div>
        <div class="p-6 space-y-5">
            <div>
                <label class="block text-sm font-medium text-fg-muted mb-1.5">Copyright text</label>
                <input type="text" data-theme-key="footer.copyright" value="{{ config.footer.copyright|default('© 2025 SymfoShop') }}"
                       class="block w-full rounded-lg border border-line-strong px-3 py-2.5 shadow-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-colors"
                       placeholder="© 2025 Your Shop">
            </div>
            <div>
                <label class="block text-sm font-medium text-fg-muted mb-1.5">Footer columns (JSON)</label>
                <textarea data-theme-key="footer.columns" rows="8"
                          class="block w-full rounded-lg border border-line-strong px-3 py-2.5 font-mono text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-colors">{{ config.footer.columns|default([])|json_encode(192) }}</textarea>
            </div>
            <div>
                <label class="block text-sm font-medium text-fg-muted mb-1.5">Social links (JSON)</label>
                <textarea data-theme-key="footer.socialLinks" rows="4"
                          class="block w-full rounded-lg border border-line-strong px-3 py-2.5 font-mono text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-colors"
                          placeholder='[{"platform":"facebook","url":"https://facebook.com"}]'>{{ config.footer.socialLinks|default([])|json_encode(192) }}</textarea>
                <p class="mt-1.5 text-xs text-fg-subtle">Format: [{"platform":"facebook","url":"https://..."}]</p>
            </div>
        </div>
    </section>
</div>
