<div class="max-w-2xl space-y-8">
    <section class="bg-panel rounded-xl border border-line shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-subtle border-b border-line">
            <h3 class="text-sm font-semibold text-fg flex items-center gap-2">
                {{ ux_icon('lucide:puzzle', {class: 'size-4 text-fg-subtle'}) }}
                Component styles
            </h3>
            <p class="text-xs text-fg-subtle mt-0.5">Buttons, badges, and form inputs</p>
        </div>
        <div class="p-6 space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-sm font-medium text-fg-muted mb-1.5">Button variant</label>
                    <select data-theme-key="components.button.variant" class="block w-full rounded-lg border border-line-strong px-3 py-2.5 shadow-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20">
                        <option value="rounded" {% if (config.components.button.variant|default('rounded')) == 'rounded' %}selected{% endif %}>Rounded</option>
                        <option value="square" {% if (config.components.button.variant|default('')) == 'square' %}selected{% endif %}>Square</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-fg-muted mb-1.5">Button size</label>
                    <select data-theme-key="components.button.size" class="block w-full rounded-lg border border-line-strong px-3 py-2.5 shadow-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20">
                        <option value="sm" {% if (config.components.button.size|default('')) == 'sm' %}selected{% endif %}>Small</option>
                        <option value="md" {% if (config.components.button.size|default('md')) == 'md' %}selected{% endif %}>Medium</option>
                        <option value="lg" {% if (config.components.button.size|default('')) == 'lg' %}selected{% endif %}>Large</option>
                    </select>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-sm font-medium text-fg-muted mb-1.5">Badge style</label>
                    <select data-theme-key="components.badge.style" class="block w-full rounded-lg border border-line-strong px-3 py-2.5 shadow-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20">
                        <option value="pill" {% if (config.components.badge.style|default('pill')) == 'pill' %}selected{% endif %}>Pill</option>
                        <option value="square" {% if (config.components.badge.style|default('')) == 'square' %}selected{% endif %}>Square</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-fg-muted mb-1.5">Form input radius</label>
                    <select data-theme-key="components.form.inputRadius" class="block w-full rounded-lg border border-line-strong px-3 py-2.5 shadow-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20">
                        <option value="sm" {% if (config.components.form.inputRadius|default('')) == 'sm' %}selected{% endif %}>Small</option>
                        <option value="md" {% if (config.components.form.inputRadius|default('md')) == 'md' %}selected{% endif %}>Medium</option>
                        <option value="lg" {% if (config.components.form.inputRadius|default('')) == 'lg' %}selected{% endif %}>Large</option>
                    </select>
                </div>
            </div>
        </div>
    </section>
</div>
