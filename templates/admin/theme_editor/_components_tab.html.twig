<div class="max-w-2xl space-y-8">
    <section class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
            <h3 class="text-sm font-semibold text-gray-900 flex items-center gap-2">
                <i class="fas fa-puzzle-piece text-gray-500"></i>
                Component styles
            </h3>
            <p class="text-xs text-gray-500 mt-0.5">Buttons, badges, and form inputs</p>
        </div>
        <div class="p-6 space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Button variant</label>
                    <select data-theme-key="components.button.variant" class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                        <option value="rounded" {% if (config.components.button.variant|default('rounded')) == 'rounded' %}selected{% endif %}>Rounded</option>
                        <option value="square" {% if (config.components.button.variant|default('')) == 'square' %}selected{% endif %}>Square</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Button size</label>
                    <select data-theme-key="components.button.size" class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                        <option value="sm" {% if (config.components.button.size|default('')) == 'sm' %}selected{% endif %}>Small</option>
                        <option value="md" {% if (config.components.button.size|default('md')) == 'md' %}selected{% endif %}>Medium</option>
                        <option value="lg" {% if (config.components.button.size|default('')) == 'lg' %}selected{% endif %}>Large</option>
                    </select>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Badge style</label>
                    <select data-theme-key="components.badge.style" class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                        <option value="pill" {% if (config.components.badge.style|default('pill')) == 'pill' %}selected{% endif %}>Pill</option>
                        <option value="square" {% if (config.components.badge.style|default('')) == 'square' %}selected{% endif %}>Square</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Form input radius</label>
                    <select data-theme-key="components.form.inputRadius" class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                        <option value="sm" {% if (config.components.form.inputRadius|default('')) == 'sm' %}selected{% endif %}>Small</option>
                        <option value="md" {% if (config.components.form.inputRadius|default('md')) == 'md' %}selected{% endif %}>Medium</option>
                        <option value="lg" {% if (config.components.form.inputRadius|default('')) == 'lg' %}selected{% endif %}>Large</option>
                    </select>
                </div>
            </div>
        </div>
    </section>
</div>
