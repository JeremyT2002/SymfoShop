{% extends 'base.html.twig' %}

{% block page_title %}{{ 'return_request.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'return_request.meta_description'|trans }}{% endblock %}

{% block body %}
<div class="container-page max-w-2xl py-10 lg:py-16">
    <span class="flex size-12 items-center justify-center rounded-full bg-subtle">{{ ux_icon('lucide:rotate-ccw', {class: 'size-6'}) }}</span>
    <h1 class="mt-5 text-3xl font-semibold sm:text-4xl">{{ 'return_request.heading'|trans }}</h1>
    <p class="mt-3 leading-7 text-fg-muted">{{ 'return_request.intro'|trans }}
        <a href="{{ path('legal_returns') }}" class="link">{{ 'footer.returns'|trans }}</a></p>

    <div class="card card-body mt-8">
        {{ form_start(form, {attr: {class: 'space-y-5'}}) }}
            <div class="grid gap-5 sm:grid-cols-2">
                {{ form_row(form.orderNumber, {attr: {placeholder: 'ORD-…', class: 'font-mono'}}) }}
                {{ form_row(form.email, {attr: {autocomplete: 'email'}}) }}
            </div>
            {{ form_row(form.reason, {attr: {rows: 5}}) }}
            {{ form_rest(form) }}
            <button type="submit" class="btn btn-primary w-full sm:w-auto">{{ 'return_request.submit'|trans }}</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
