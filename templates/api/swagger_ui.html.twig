{% extends 'base.html.twig' %}

{% block page_title %}{{ 'ui.api.title'|trans }}{% endblock %}
{% block robots_meta %}<meta name="robots" content="noindex,follow">{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14/swagger-ui.css">
    <style>
        .swagger-ui .topbar { display: none; }
    </style>
{% endblock %}

{% block body %}
<div class="container-page py-10">
    <h1 class="text-3xl font-semibold">{{ 'ui.api.title'|trans }}</h1>
    <p class="mt-2 text-fg-muted">{{ 'ui.api.intro'|trans }}</p>
    {# Swagger UI ships its own light theme — keep it on a light surface in dark mode too #}
    <div id="swagger-ui" class="mt-8 overflow-hidden rounded-2xl border border-line bg-white p-2 text-zinc-900"></div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14/swagger-ui-bundle.js" defer></script>
    <script type="application/json" id="openapi-spec">{{ openApiSpec|raw }}</script>
    <script>
        window.addEventListener('load', function () {
            window.ui = SwaggerUIBundle({
                spec: JSON.parse(document.getElementById('openapi-spec').textContent),
                dom_id: '#swagger-ui',
                deepLinking: true,
                persistAuthorization: true,
                tryItOutEnabled: true,
                filter: true,
                docExpansion: 'list',
                defaultModelsExpandDepth: 1,
            });
        });
    </script>
{% endblock %}
