{% extends 'security/_layout.html.twig' %}

{%- set auth_icon = 'lucide:key-round' -%}

{% block page_title %}{{ 'ui.auth.reset_title'|trans }}{% endblock %}
{% block auth_title %}{{ 'ui.auth.reset_title'|trans }}{% endblock %}
{% block auth_subtitle %}{{ 'ui.auth.reset_request_intro'|trans }}{% endblock %}

{% block auth_content %}
    {{ form_start(requestForm, {attr: {class: 'space-y-5'}}) }}
        {{ form_row(requestForm.email, {label: 'security.login.email'|trans, attr: {autocomplete: 'email', autofocus: true}}) }}
        <button type="submit" class="btn btn-primary btn-lg w-full">{{ 'ui.auth.reset_request_submit'|trans }}</button>
    {{ form_end(requestForm) }}
{% endblock %}

{% block auth_footer %}
    <a href="{{ path('login') }}" class="inline-flex items-center gap-1.5 font-medium hover:text-fg">{{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }}{{ 'ui.auth.back_to_login'|trans }}</a>
{% endblock %}
