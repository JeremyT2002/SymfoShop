{% extends 'security/_layout.html.twig' %}

{%- set auth_icon = 'lucide:lock-keyhole' -%}

{% block page_title %}{{ 'ui.auth.reset_title'|trans }}{% endblock %}
{% block auth_title %}{{ 'ui.auth.reset_title'|trans }}{% endblock %}
{% block auth_subtitle %}{{ 'ui.auth.reset_intro'|trans }}{% endblock %}

{% block auth_content %}
    {{ form_start(resetForm, {attr: {class: 'space-y-5'}}) }}
        {{ form_row(resetForm.plainPassword.first, {label: 'ui.auth.new_password'|trans, help: 'ui.auth.password_hint'|trans, attr: {autocomplete: 'new-password'}}) }}
        {{ form_row(resetForm.plainPassword.second, {label: 'security.register.confirm_password'|trans, attr: {autocomplete: 'new-password'}}) }}
        <button type="submit" class="btn btn-primary btn-lg w-full">{{ 'ui.auth.reset_submit'|trans }}</button>
    {{ form_end(resetForm) }}
{% endblock %}

{% block auth_footer %}
    <a href="{{ path('login') }}" class="inline-flex items-center gap-1.5 font-medium hover:text-fg">{{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }}{{ 'ui.auth.back_to_login'|trans }}</a>
{% endblock %}
