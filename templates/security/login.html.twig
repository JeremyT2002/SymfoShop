{% extends 'security/_layout.html.twig' %}

{%- set auth_icon = 'lucide:log-in' -%}

{% block page_title %}{{ 'security.login.submit'|trans }}{% endblock %}
{% block auth_title %}{{ 'security.login.title'|trans }}{% endblock %}

{% block auth_content %}
    {% if error %}
        <div class="alert alert-error mb-6" role="alert">
            {{ ux_icon('lucide:circle-alert', {class: 'mt-0.5 size-4'}) }}
            <p>{{ error.messageKey|trans(error.messageData, 'security') }}</p>
        </div>
    {% endif %}

    <form method="post" class="space-y-5" x-data="{ busy: false, show: false }" @submit="busy = true">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div>
            <label for="inputEmail" class="label">{{ 'security.login.email'|trans }}</label>
            <input id="inputEmail" name="_username" type="email" autocomplete="email" required autofocus value="{{ last_username }}" class="input">
        </div>

        <div>
            <div class="mb-1.5 flex items-center justify-between">
                <label for="inputPassword" class="text-sm font-medium">{{ 'security.login.password'|trans }}</label>
                <a href="{{ path('reset_password_request') }}" class="text-sm font-medium text-fg-muted hover:text-fg">{{ 'security.login.forgot_password'|trans }}</a>
            </div>
            <div class="relative">
                <input id="inputPassword" name="_password" :type="show ? 'text' : 'password'" type="password" autocomplete="current-password" required class="input pr-11">
                <button type="button" class="absolute inset-y-0 right-0 flex w-11 items-center justify-center text-fg-subtle hover:text-fg" @click="show = !show"
                        :aria-pressed="show" aria-label="{{ 'ui.auth.show_password'|trans }}">
                    <span x-show="!show">{{ ux_icon('lucide:eye', {class: 'size-4'}) }}</span>
                    <span x-show="show" x-cloak>{{ ux_icon('lucide:eye-off', {class: 'size-4'}) }}</span>
                </button>
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-full" :disabled="busy">
            <span x-show="busy" x-cloak class="spinner"></span>{{ 'security.login.submit'|trans }}
        </button>
    </form>
{% endblock %}

{% block auth_footer %}
    {{ 'security.login.dont_have_account'|trans }}
    <a href="{{ path('register') }}" class="link">{{ 'security.login.register_here'|trans }}</a>
{% endblock %}
