{% extends 'security/_layout.html.twig' %}

{%- set auth_icon = 'lucide:user-round-plus' -%}

{% block page_title %}{{ 'security.register.title'|trans }}{% endblock %}
{% block auth_title %}{{ 'security.register.title'|trans }}{% endblock %}
{% block auth_subtitle %}{{ 'ui.auth.register_benefits'|trans }}{% endblock %}

{% block auth_content %}
    {{ form_start(registrationForm, {attr: {class: 'space-y-5', 'x-data': '{ busy: false }', '@submit': 'busy = true'}}) }}
        <div class="grid gap-5 sm:grid-cols-2">
            {{ form_row(registrationForm.firstName, {label: 'account.dashboard.profile.first_name'|trans, attr: {autocomplete: 'given-name'}}) }}
            {{ form_row(registrationForm.lastName, {label: 'account.dashboard.profile.last_name'|trans, attr: {autocomplete: 'family-name'}}) }}
        </div>
        {{ form_row(registrationForm.email, {label: 'security.register.email'|trans, attr: {autocomplete: 'email'}}) }}
        {{ form_row(registrationForm.plainPassword.first, {label: 'security.register.password'|trans, help: 'ui.auth.password_hint'|trans, attr: {autocomplete: 'new-password'}}) }}
        {{ form_row(registrationForm.plainPassword.second, {label: 'security.register.confirm_password'|trans, attr: {autocomplete: 'new-password'}}) }}
        {{ form_row(registrationForm.agreeTerms, {label: 'ui.auth.agree_terms'|trans({'%terms%': path('legal_terms'), '%privacy%': path('legal_privacy')}), label_html: true}) }}
        {{ form_row(registrationForm.submit, {label: 'security.register.submit'|trans, attr: {class: 'btn-primary btn-lg w-full', ':disabled': 'busy'}}) }}
    {{ form_end(registrationForm) }}
{% endblock %}

{% block auth_footer %}
    {{ 'security.register.already_have_account'|trans }}
    <a href="{{ path('login') }}" class="link">{{ 'security.register.sign_in_here'|trans }}</a>
{% endblock %}
