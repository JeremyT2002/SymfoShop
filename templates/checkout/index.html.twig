{% extends 'catalog/base.html.twig' %}

{% block title %}{{ 'checkout.page_title'|trans }} - SymfoShop{% endblock %}
{% block meta_description %}{{ 'checkout.meta_description'|trans }}{% endblock %}
{% block js_page %}checkout{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-8">{{ 'checkout.title'|trans }}</h1>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-6 flex items-center">
                        <i class="fas fa-user-circle mr-2 text-blue-600"></i>
                        {{ 'checkout.customer_information'|trans }}
                    </h2>
                    {{ form_start(customerForm, {'attr': {'id': 'customer-form', 'method': 'POST', 'action': path('checkout'), 'class': 'space-y-4'}}) }}
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                {{ form_label(customerForm.firstName, 'checkout.fields.first_name'|trans, {'label_attr': {'class': 'flex items-center text-sm font-medium text-gray-700 mb-2'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <i class="fas fa-user text-gray-400"></i>
                                    </div>
                                    {{ form_widget(customerForm.firstName, {'attr': {'class': 'w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors', 'placeholder': 'checkout.placeholders.first_name'|trans}}) }}
                                </div>
                                {{ form_errors(customerForm.firstName) }}
                            </div>
                            <div>
                                {{ form_label(customerForm.lastName, 'checkout.fields.last_name'|trans, {'label_attr': {'class': 'flex items-center text-sm font-medium text-gray-700 mb-2'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <i class="fas fa-user text-gray-400"></i>
                                    </div>
                                    {{ form_widget(customerForm.lastName, {'attr': {'class': 'w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors', 'placeholder': 'checkout.placeholders.last_name'|trans}}) }}
                                </div>
                                {{ form_errors(customerForm.lastName) }}
                            </div>
                        </div>
                        <div>
                            {{ form_label(customerForm.email, 'checkout.fields.email'|trans, {'label_attr': {'class': 'flex items-center text-sm font-medium text-gray-700 mb-2'}}) }}
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fas fa-envelope text-gray-400"></i>
                                </div>
                                {{ form_widget(customerForm.email, {'attr': {'class': 'w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors', 'placeholder': 'checkout.placeholders.email'|trans, 'autocomplete': 'email'}}) }}
                            </div>
                            {{ form_errors(customerForm.email) }}
                        </div>
                        <div>
                            {{ form_label(customerForm.phone, 'checkout.fields.phone'|trans, {'label_attr': {'class': 'flex items-center text-sm font-medium text-gray-700 mb-2'}}) }}
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fas fa-phone text-gray-400"></i>
                                </div>
                                {{ form_widget(customerForm.phone, {'attr': {'class': 'w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors', 'placeholder': 'checkout.placeholders.phone'|trans, 'autocomplete': 'tel'}}) }}
                            </div>
                            <p class="mt-1 text-xs text-gray-500">{{ 'checkout.phone_hint'|trans }}</p>
                            {{ form_errors(customerForm.phone) }}
                        </div>
                    {{ form_end(customerForm) }}
                </div>

                <div class="bg-white rounded-lg shadow p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-6 flex items-center">
                        <i class="fas fa-map-marker-alt mr-2 text-blue-600"></i>
                        {{ 'checkout.shipping_address'|trans }}
                    </h2>
                    {{ form_start(addressForm, {'attr': {'id': 'address-form', 'class': 'space-y-4'}}) }}
                        <div>
                            {{ form_label(addressForm.street, 'checkout.fields.street'|trans, {'label_attr': {'class': 'flex items-center text-sm font-medium text-gray-700 mb-2'}}) }}
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fas fa-road text-gray-400"></i>
                                </div>
                                {{ form_widget(addressForm.street, {'attr': {'class': 'w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors', 'placeholder': 'checkout.placeholders.street'|trans, 'autocomplete': 'street-address'}}) }}
                            </div>
                            {{ form_errors(addressForm.street) }}
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                {{ form_label(addressForm.city, 'checkout.fields.city'|trans, {'label_attr': {'class': 'flex items-center text-sm font-medium text-gray-700 mb-2'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <i class="fas fa-city text-gray-400"></i>
                                    </div>
                                    {{ form_widget(addressForm.city, {'attr': {'class': 'w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors', 'placeholder': 'checkout.placeholders.city'|trans, 'autocomplete': 'address-level2'}}) }}
                                </div>
                                {{ form_errors(addressForm.city) }}
                            </div>
                            <div>
                                {{ form_label(addressForm.postalCode, 'checkout.fields.postal_code'|trans, {'label_attr': {'class': 'flex items-center text-sm font-medium text-gray-700 mb-2'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <i class="fas fa-mail-bulk text-gray-400"></i>
                                    </div>
                                    {{ form_widget(addressForm.postalCode, {'attr': {'class': 'w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors', 'placeholder': 'checkout.placeholders.postal_code'|trans, 'autocomplete': 'postal-code'}}) }}
                                </div>
                                {{ form_errors(addressForm.postalCode) }}
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                {{ form_label(addressForm.country, 'checkout.fields.country'|trans, {'label_attr': {'class': 'flex items-center text-sm font-medium text-gray-700 mb-2'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <i class="fas fa-globe text-gray-400"></i>
                                    </div>
                                    {{ form_widget(addressForm.country, {'attr': {'class': 'w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors appearance-none bg-white', 'autocomplete': 'country'}}) }}
                                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                        <i class="fas fa-chevron-down text-gray-400"></i>
                                    </div>
                                </div>
                                {{ form_errors(addressForm.country) }}
                            </div>
                            <div>
                                {{ form_label(addressForm.state, 'checkout.fields.state'|trans, {'label_attr': {'class': 'flex items-center text-sm font-medium text-gray-700 mb-2'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <i class="fas fa-map text-gray-400"></i>
                                    </div>
                                    {{ form_widget(addressForm.state, {'attr': {'class': 'w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors', 'placeholder': 'checkout.placeholders.state'|trans, 'autocomplete': 'address-level1'}}) }}
                                </div>
                                <p class="mt-1 text-xs text-gray-500">{{ 'checkout.state_hint'|trans }}</p>
                                {{ form_errors(addressForm.state) }}
                            </div>
                        </div>
                    {{ form_end(addressForm) }}
                </div>
            </div>

            <div class="lg:col-span-1">
                <div class="bg-white rounded-lg shadow p-6 sticky top-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-6 flex items-center">
                        <i class="fas fa-receipt mr-2 text-blue-600"></i>
                        {{ 'checkout.order_summary'|trans }}
                    </h2>
                    
                    <div class="space-y-3 mb-4">
                        {% if shippingMethods is not empty %}
                            <div>
                                <span class="block text-sm font-medium text-gray-700 mb-2">{{ 'checkout.shipping_method'|trans }}</span>
                                <div class="space-y-2">
                                    {% for method in shippingMethods %}
                                        <label class="flex items-start gap-2 cursor-pointer text-sm text-gray-800">
                                            <input type="radio" name="shipping_method" value="{{ method.code }}" form="customer-form"
                                                   class="mt-1 border-gray-300 text-blue-600 focus:ring-blue-500"
                                                   {% if selectedShippingMethod == method.code %}checked{% endif %}>
                                            <span>
                                                <span class="font-medium">{{ method.name }}</span>
                                                <span class="text-gray-600">
                                                    {% if method.amountCents > 0 %}
                                                        — {{ (method.amountCents / 100)|number_format(2, '.', ',') }} {{ totals.currency|escape }}
                                                    {% else %}
                                                        — {{ 'checkout.shipping_free'|trans }}
                                                    {% endif %}
                                                </span>
                                            </span>
                                        </label>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                        <div>
                            <label for="payment_method" class="block text-sm font-medium text-gray-700 mb-2">
                                {{ 'checkout.payment_method'|trans }}
                            </label>
                            <select id="payment_method" name="payment_method" form="customer-form"
                                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                {% for method in paymentMethods %}
                                    <option value="{{ method.code }}" {% if selectedPaymentMethod == method.code %}selected{% endif %}>
                                        {{ method.name }}
                                    </option>
                                {% else %}
                                    <option value="stripe">{{ 'checkout.fallback_method_stripe'|trans }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">{{ 'checkout.subtotal'|trans }}:</span>
                            <span class="font-medium">{{ (totals.subtotal / 100)|number_format(2, '.', ',') }} {{ totals.currency|escape }}</span>
                        </div>
                        {% if totals.shippingAmount is defined and (totals.shippingMethodLabel is defined and totals.shippingMethodLabel) %}
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-600">{{ 'checkout.shipping_amount'|trans }}:</span>
                                <span class="font-medium">
                                    {% if totals.shippingAmount > 0 %}
                                        {{ (totals.shippingAmount / 100)|number_format(2, '.', ',') }} {{ totals.currency|escape }}
                                    {% else %}
                                        {{ 'checkout.shipping_free'|trans }}
                                    {% endif %}
                                </span>
                            </div>
                        {% endif %}
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">{{ 'checkout.tax'|trans }}:</span>
                            <span class="font-medium">{{ (totals.taxTotal / 100)|number_format(2, '.', ',') }} {{ totals.currency|escape }}</span>
                        </div>
                    </div>

                    <div class="border-t-2 border-gray-200 pt-4 mt-4">
                        <div class="flex justify-between text-lg font-bold mb-6">
                            <span>{{ 'checkout.total'|trans }}:</span>
                            <span class="text-blue-600">{{ (totals.grandTotal / 100)|number_format(2, '.', ',') }} {{ totals.currency|escape }}</span>
                        </div>
                    </div>

                    <button type="button" id="place-order-btn" class="w-full bg-blue-600 text-white py-3 px-4 rounded-lg hover:bg-blue-700 transition-colors font-medium flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed">
                        <span class="place-order-text">{{ 'checkout.place_order'|trans }}</span>
                    </button>

                    <p class="text-xs text-gray-500 mt-4 text-center">
                        <i class="fas fa-shield-alt mr-1"></i>
                        {{ 'checkout.terms_agreement'|trans }}
                        <a href="{{ path('legal_terms') }}" class="text-primary-600 hover:underline ml-1">{{ 'footer.terms'|trans }}</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

