{% extends 'base.html.twig' %}

{% block page_title %}{{ 'checkout.page_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'checkout.meta_description'|trans }}{% endblock %}
{% block js_page %}checkout{% endblock %}
{% block robots_meta %}<meta name="robots" content="noindex,nofollow">{% endblock %}

{% block body %}
{%- set step_class = 'flex size-7 shrink-0 items-center justify-center rounded-full bg-fg text-xs font-semibold text-canvas' -%}
{%- set choice_class = 'flex cursor-pointer items-center gap-4 rounded-xl border border-line-strong p-4 transition has-[:checked]:border-fg has-[:checked]:ring-1 has-[:checked]:ring-fg has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-primary-500 hover:border-fg-subtle' -%}

<div class="container-page py-8 lg:py-12">
    <div class="flex items-center justify-between">
        <h1 class="text-3xl font-semibold sm:text-4xl">{{ 'checkout.title'|trans }}</h1>
        <a href="{{ path('cart_show') }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-fg-muted hover:text-fg">
            {{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }}{{ 'ui.checkout.back_to_cart'|trans }}
        </a>
    </div>

    <form method="post" action="{{ path('checkout') }}" data-checkout-form data-totals-url="{{ path('checkout_totals') }}"
          class="mt-8 grid gap-10 lg:grid-cols-12 lg:items-start">
        <div class="space-y-10 lg:col-span-7">
            {# 1. Contact #}
            <section aria-labelledby="checkout-contact">
                <h2 id="checkout-contact" class="flex items-center gap-3 text-lg font-semibold"><span class="{{ step_class }}">1</span>{{ 'checkout.customer_information'|trans }}</h2>
                <div class="mt-6 grid gap-5 sm:grid-cols-2">
                    <div class="sm:col-span-2">{{ form_row(customerForm.email, {label: 'checkout.fields.email'|trans, attr: {autocomplete: 'email', placeholder: 'checkout.placeholders.email'|trans}}) }}</div>
                    {{ form_row(customerForm.firstName, {label: 'checkout.fields.first_name'|trans, attr: {autocomplete: 'given-name'}}) }}
                    {{ form_row(customerForm.lastName, {label: 'checkout.fields.last_name'|trans, attr: {autocomplete: 'family-name'}}) }}
                    <div class="sm:col-span-2">{{ form_row(customerForm.phone, {label: 'checkout.fields.phone'|trans, help: 'checkout.phone_hint'|trans, attr: {autocomplete: 'tel'}}) }}</div>
                </div>
                {% if not app.user %}
                    <p class="mt-4 text-sm text-fg-muted">{{ 'ui.checkout.have_account'|trans }} <a href="{{ path('login') }}" class="link">{{ 'nav.login'|trans }}</a></p>
                {% endif %}
            </section>

            {# 2. Address #}
            <section aria-labelledby="checkout-address" class="border-t border-line pt-10">
                <h2 id="checkout-address" class="flex items-center gap-3 text-lg font-semibold"><span class="{{ step_class }}">2</span>{{ 'checkout.shipping_address'|trans }}</h2>
                <div class="mt-6 grid gap-5 sm:grid-cols-6">
                    <div class="sm:col-span-6">{{ form_row(addressForm.street, {label: 'checkout.fields.street'|trans, attr: {autocomplete: 'street-address'}}) }}</div>
                    <div class="sm:col-span-2">{{ form_row(addressForm.postalCode, {label: 'checkout.fields.postal_code'|trans, attr: {autocomplete: 'postal-code'}}) }}</div>
                    <div class="sm:col-span-4">{{ form_row(addressForm.city, {label: 'checkout.fields.city'|trans, attr: {autocomplete: 'address-level2'}}) }}</div>
                    <div class="sm:col-span-3">{{ form_row(addressForm.country, {label: 'checkout.fields.country'|trans, attr: {autocomplete: 'country', 'data-checkout-country': ''}}) }}</div>
                    <div class="sm:col-span-3">{{ form_row(addressForm.state, {label: 'checkout.fields.state'|trans, attr: {autocomplete: 'address-level1'}}) }}</div>
                </div>
            </section>

            {# 3. Shipping #}
            {% if shippingMethods is not empty %}
                <section aria-labelledby="checkout-shipping" class="border-t border-line pt-10">
                    <h2 id="checkout-shipping" class="flex items-center gap-3 text-lg font-semibold"><span class="{{ step_class }}">3</span>{{ 'checkout.shipping_method'|trans }}</h2>
                    <div class="mt-6 grid gap-3">
                        {% for method in shippingMethods %}
                            <label class="{{ choice_class }}">
                                <input type="radio" name="shipping_method" value="{{ method.code }}" class="radio" {{ selectedShippingMethod == method.code ? 'checked' }}>
                                <span class="flex-1 text-sm font-medium">{{ method.name }}</span>
                                <span class="text-sm font-semibold tabular-nums">{{ method.amountCents > 0 ? method.amountCents|money(totals.currency) : 'checkout.shipping_free'|trans }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            {# 4. Payment #}
            <section aria-labelledby="checkout-payment" class="border-t border-line pt-10">
                <h2 id="checkout-payment" class="flex items-center gap-3 text-lg font-semibold"><span class="{{ step_class }}">{{ shippingMethods is not empty ? 4 : 3 }}</span>{{ 'checkout.payment_method'|trans }}</h2>
                <div class="mt-6 grid gap-3">
                    {% for method in paymentMethods %}
                        <label class="{{ choice_class }}">
                            <input type="radio" name="payment_method" value="{{ method.code }}" class="radio" {{ selectedPaymentMethod == method.code or (selectedPaymentMethod == '' and loop.first) ? 'checked' }}>
                            <span class="flex-1 text-sm font-medium">{{ method.name }}</span>
                            {{ ux_icon(method.code == 'paypal' ? 'simple-icons:paypal' : 'lucide:credit-card', {class: 'size-5 text-fg-muted'}) }}
                        </label>
                    {% else %}
                        <div class="alert alert-warning">{{ ux_icon('lucide:triangle-alert', {class: 'mt-0.5 size-4'}) }}<p>{{ 'ui.checkout.no_payment_methods'|trans }}</p></div>
                    {% endfor %}
                </div>
                <p class="mt-3 flex items-center gap-2 text-xs text-fg-subtle">{{ ux_icon('lucide:lock', {class: 'size-3.5'}) }}{{ 'ui.checkout.payment_next_step'|trans }}</p>
            </section>

            {{ form_rest(customerForm) }}
            {{ form_rest(addressForm) }}
        </div>

        {# Summary #}
        <aside class="lg:sticky lg:top-28 lg:col-span-5" aria-labelledby="checkout-summary-heading">
            <div class="card card-body transition-opacity aria-busy:opacity-60" data-checkout-summary>
                <h2 id="checkout-summary-heading" class="text-lg font-semibold">{{ 'checkout.order_summary'|trans }}</h2>

                <ul class="mt-6 divide-y divide-line" role="list">
                    {% for item in items %}
                        {%- set image = item.variant.product.media|first -%}
                        <li class="flex items-center gap-4 py-3">
                            <span class="relative size-14 shrink-0 rounded-lg bg-subtle">
                                {% if image %}<img src="{{ image_url(image.path, 320) }}" alt="" loading="lazy" class="size-full rounded-lg object-cover">{% endif %}
                                <span class="absolute -top-1.5 -right-1.5 flex size-5 items-center justify-center rounded-full bg-fg text-[0.6875rem] font-semibold text-canvas tabular-nums">{{ item.quantity }}</span>
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-sm font-medium">{{ item.variant.product.name }}</span>
                                {% if item.variant.attributes is not empty %}
                                    <span class="block truncate text-xs text-fg-subtle">{{ item.variant.attributes|map((v, k) => k|capitalize ~ ': ' ~ v)|join(' · ') }}</span>
                                {% endif %}
                            </span>
                            <span class="text-sm font-medium tabular-nums">{{ item.itemTotal|money(totals.currency) }}</span>
                        </li>
                    {% endfor %}
                </ul>

                <dl class="mt-4 space-y-3 border-t border-line pt-4 text-sm">
                    <div class="flex justify-between"><dt class="text-fg-muted">{{ 'checkout.subtotal'|trans }}</dt><dd class="tabular-nums" data-checkout-total="subtotal">{{ totals.subtotal|money(totals.currency) }}</dd></div>
                    {% if totals.discount > 0 %}
                        <div class="flex justify-between text-emerald-700 dark:text-emerald-400"><dt>{{ 'coupon.discount'|trans }}{% if totals.couponCode %} ({{ totals.couponCode|upper }}){% endif %}</dt><dd class="tabular-nums" data-checkout-total="discount">−{{ totals.discount|money(totals.currency) }}</dd></div>
                    {% endif %}
                    <div class="flex justify-between"><dt class="text-fg-muted">{{ 'checkout.shipping_amount'|trans }}</dt><dd class="tabular-nums" data-checkout-total="shippingAmount">{{ totals.shippingAmount > 0 ? totals.shippingAmount|money(totals.currency) : 'checkout.shipping_free'|trans }}</dd></div>
                    <div class="flex justify-between border-t border-line pt-4 text-base font-semibold"><dt>{{ 'checkout.total'|trans }}</dt><dd class="tabular-nums" data-checkout-total="grandTotal">{{ totals.grandTotal|money(totals.currency) }}</dd></div>
                    {# VAT contained in the gross total, one row per rate (re-rendered by checkout.js) #}
                    <div class="space-y-1 text-xs text-fg-subtle" data-checkout-tax-rows
                         data-label-included="{{ 'ui.checkout.vat_included'|trans({'%rate%': '__RATE__'}) }}"
                         data-label-export="{{ 'ui.checkout.vat_export'|trans }}">
                        {% for row in totals.taxBreakdown %}
                            <div class="flex justify-between"><dt>{{ 'ui.checkout.vat_included'|trans({'%rate%': (row.rate * 100)|number_format(row.rate * 100 == (row.rate * 100)|round ? 0 : 1, ',', '.')}) }}</dt><dd class="tabular-nums">{{ row.amount|money(totals.currency) }}</dd></div>
                        {% else %}
                            {% if not totals.pricesIncludeTax %}<p>{{ 'ui.checkout.vat_export'|trans }}</p>{% endif %}
                        {% endfor %}
                    </div>
                </dl>

                <button type="submit" class="btn btn-primary btn-lg mt-6 w-full" data-place-order {{ paymentMethods is empty ? 'disabled' }}>
                    {{ ux_icon('lucide:lock', {class: 'size-4'}) }}<span data-label>{{ 'ui.checkout.place_order_binding'|trans }}</span>
                </button>
                <p class="mt-4 text-center text-xs leading-5 text-fg-subtle">
                    {{ 'checkout.terms_agreement'|trans }}
                    <a href="{{ path('legal_terms') }}" class="underline hover:text-fg">{{ 'footer.terms'|trans }}</a> ·
                    <a href="{{ path('legal_privacy') }}" class="underline hover:text-fg">{{ 'footer.privacy'|trans }}</a>
                </p>
            </div>
        </aside>
    </form>
</div>
{% endblock %}
