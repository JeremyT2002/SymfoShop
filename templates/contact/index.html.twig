{% extends 'base.html.twig' %}

{% block page_title %}{{ 'contact.meta_title'|trans }}{% endblock %}
{% block meta_description %}{{ 'contact.meta_description'|trans }}{% endblock %}

{% block body %}
<div class="container-page py-10 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
            <h1 class="text-3xl font-semibold sm:text-4xl">{{ 'contact.heading'|trans }}</h1>
            <p class="mt-4 leading-7 text-fg-muted">{{ 'contact.intro'|trans }}</p>
            <ul class="mt-8 space-y-4 text-sm" role="list">
                <li class="flex items-start gap-3">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-subtle">{{ ux_icon('lucide:circle-help', {class: 'size-5'}) }}</span>
                    <span><span class="block font-semibold">{{ 'footer.faq'|trans }}</span><a href="{{ path('legal_faq') }}" class="text-fg-muted hover:text-fg hover:underline">{{ 'ui.contact.faq_hint'|trans }}</a></span>
                </li>
                <li class="flex items-start gap-3">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-subtle">{{ ux_icon('lucide:rotate-ccw', {class: 'size-5'}) }}</span>
                    <span><span class="block font-semibold">{{ 'footer.returns'|trans }}</span><a href="{{ path('return_request') }}" class="text-fg-muted hover:text-fg hover:underline">{{ 'ui.contact.returns_hint'|trans }}</a></span>
                </li>
            </ul>
        </div>
        <div class="lg:col-span-7">
            <div class="card card-body">
                {{ form_start(form, {attr: {class: 'space-y-5'}}) }}
                    <div class="grid gap-5 sm:grid-cols-2">
                        {{ form_row(form.name, {attr: {autocomplete: 'name'}}) }}
                        {{ form_row(form.email, {attr: {autocomplete: 'email'}}) }}
                    </div>
                    {{ form_row(form.message, {attr: {rows: 6}}) }}
                    {{ form_rest(form) }}
                    <button type="submit" class="btn btn-primary w-full sm:w-auto">{{ ux_icon('lucide:send-horizontal', {class: 'size-4'}) }}{{ 'contact.submit'|trans }}</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
