{% extends 'catalog/base.html.twig' %}

{% block page_title %}{{ 'contact.meta_title'|trans }}{% endblock %}
{% block page_meta_description %}{{ 'contact.meta_description'|trans }}{% endblock %}

{% block catalog_body %}
<div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">{{ 'contact.heading'|trans }}</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">{{ 'contact.intro'|trans }}</p>

    {{ form_start(form, { attr: { class: 'space-y-5' } }) }}
        <div>
            {{ form_label(form.name, null, { label_attr: { class: 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1' } }) }}
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
        </div>
        <div>
            {{ form_label(form.email, null, { label_attr: { class: 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1' } }) }}
            {{ form_widget(form.email) }}
            {{ form_errors(form.email) }}
        </div>
        <div>
            {{ form_label(form.message, null, { label_attr: { class: 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1' } }) }}
            {{ form_widget(form.message) }}
            {{ form_errors(form.message) }}
        </div>
        <button type="submit" class="w-full sm:w-auto px-6 py-3 rounded-lg bg-primary-600 text-white font-medium hover:bg-primary-700 transition-colors">
            {{ 'contact.submit'|trans }}
        </button>
    {{ form_end(form) }}
</div>
{% endblock %}
