<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #4CAF50;
            color: white;
            padding: 20px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }
        .content {
            background-color: #f9f9f9;
            padding: 20px;
            border: 1px solid #ddd;
        }
        .order-info {
            background-color: white;
            padding: 15px;
            margin: 15px 0;
            border-radius: 5px;
        }
        .footer {
            text-align: center;
            padding: 20px;
            color: #666;
            font-size: 12px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }
        th, td {
            padding: 10px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        th {
            background-color: #f2f2f2;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>{{ 'email.order_confirmation.title'|trans }}</h1>
    </div>

    <div class="content">
        <p>{{ 'email.order_confirmation.greeting'|trans }}</p>

        <p>{{ 'email.order_confirmation.intro'|trans }}</p>

        <div class="order-info">
            <h2>{{ 'email.order_confirmation.details_heading'|trans }}</h2>
            <p><strong>{{ 'email.order_confirmation.order_number'|trans }}:</strong> {{ order.orderNumber }}</p>
            <p><strong>{{ 'email.order_confirmation.invoice_number'|trans }}:</strong> {{ invoice.invoiceNumber }}</p>
            <p><strong>{{ 'email.order_confirmation.order_date'|trans }}:</strong> {{ order.createdAt|date('Y-m-d') }}</p>
            <p><strong>{{ 'email.order_confirmation.email_label'|trans }}:</strong> {{ order.email }}</p>
        </div>

        <h3>{{ 'email.order_confirmation.items_heading'|trans }}</h3>
        <table>
            <thead>
                <tr>
                    <th>{{ 'email.order_confirmation.col_item'|trans }}</th>
                    <th>{{ 'email.order_confirmation.col_qty'|trans }}</th>
                    <th>{{ 'email.order_confirmation.col_unit'|trans }}</th>
                    <th>{{ 'email.order_confirmation.col_total'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for item in order.items %}
                <tr>
                    <td>{{ item.nameSnapshot }}</td>
                    <td>{{ item.quantity }}</td>
                    <td>{{ (item.unitPriceAmount / 100)|number_format(2) }} {{ order.currency }}</td>
                    <td>{{ (item.totalAmount / 100)|number_format(2) }} {{ order.currency }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="order-info">
            <p><strong>{{ 'email.order_confirmation.subtotal'|trans }}:</strong> {{ (order.subtotal / 100)|number_format(2) }} {{ order.currency }}</p>
            <p><strong>{{ 'email.order_confirmation.tax'|trans }}:</strong> {{ (order.taxTotal / 100)|number_format(2) }} {{ order.currency }}</p>
            <p><strong>{{ 'email.order_confirmation.grand_total'|trans }}:</strong> {{ (order.grandTotal / 100)|number_format(2) }} {{ order.currency }}</p>
        </div>

        <p>{{ 'email.order_confirmation.invoice_attached'|trans }}</p>

        <p>{{ 'email.order_confirmation.shipping_notice'|trans }}</p>

        <p>{{ 'email.order_confirmation.support'|trans }}</p>

        <p>{{ 'email.order_confirmation.closing'|trans|nl2br }}</p>
    </div>

    <div class="footer">
        <p>{{ 'email.order_confirmation.automated'|trans }}</p>
    </div>
</body>
</html>
