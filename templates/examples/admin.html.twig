{#
  Admin Dashboard Example Page
  ============================

  Demonstrates an admin interface with:
  - Dashboard metrics and KPIs
  - Data tables with sorting and filtering
  - Charts and visualizations
  - Action buttons and bulk operations
  - Responsive admin layout
  - Navigation sidebar
#}

{% extends 'base-modern.html.twig' %}

{% block title %}Admin Dashboard - SymfoShop{% endblock %}
{% block meta_description %}Admin dashboard and management interface{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50">
    <!-- Admin Header -->
    <header class="bg-white border-b border-neutral-200 sticky top-0 z-40">
        <div class="max-w-full px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo and Title -->
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <h1 class="text-xl font-bold text-neutral-900">SymfoShop Admin</h1>
                    </div>
                </div>

                <!-- Header Actions -->
                <div class="flex items-center gap-4">
                    <!-- Notifications -->
                    <button class="p-2 text-neutral-400 hover:text-neutral-600 hover:bg-neutral-100 rounded-lg transition-colors relative" title="Notifications">
                        <i class="fas fa-bell"></i>
                        <span class="absolute -top-1 -right-1 h-4 w-4 bg-red-500 text-white text-xs rounded-full flex items-center justify-center">3</span>
                    </button>

                    <!-- User Menu -->
                    <div class="relative" x-data="{ open: false }">
                        <button @click="open = !open" class="flex items-center gap-3 p-2 rounded-lg hover:bg-neutral-100 transition-colors">
                            <div class="w-8 h-8 bg-primary-600 rounded-full flex items-center justify-center">
                                <span class="text-white text-sm font-medium">JD</span>
                            </div>
                            <div class="hidden sm:block text-left">
                                <p class="text-sm font-medium text-neutral-900">John Doe</p>
                                <p class="text-xs text-neutral-500">Administrator</p>
                            </div>
                            <i class="fas fa-chevron-down text-neutral-400 text-sm"></i>
                        </button>

                        <!-- Dropdown Menu -->
                        <div x-show="open" @click.away="open = false" x-transition class="absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-lg border border-neutral-200 py-1 z-50">
                            <a href="#" class="block px-4 py-2 text-sm text-neutral-700 hover:bg-neutral-100">Profile Settings</a>
                            <a href="#" class="block px-4 py-2 text-sm text-neutral-700 hover:bg-neutral-100">Account Settings</a>
                            <div class="border-t border-neutral-200 my-1"></div>
                            <a href="#" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50">Sign Out</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="flex">
        <!-- Sidebar -->
        <aside class="w-64 bg-white border-r border-neutral-200 min-h-screen sticky top-16">
            <nav class="p-4 space-y-2">
                {% set menuItems = [
                    {'name': 'Dashboard', 'icon': 'fa-tachometer-alt', 'active': true, 'href': '#'},
                    {'name': 'Orders', 'icon': 'fa-shopping-cart', 'active': false, 'href': '#', 'badge': '12'},
                    {'name': 'Products', 'icon': 'fa-box', 'active': false, 'href': '#'},
                    {'name': 'Customers', 'icon': 'fa-users', 'active': false, 'href': '#'},
                    {'name': 'Categories', 'icon': 'fa-tags', 'active': false, 'href': '#'},
                    {'name': 'Analytics', 'icon': 'fa-chart-line', 'active': false, 'href': '#'},
                    {'name': 'Settings', 'icon': 'fa-cog', 'active': false, 'href': '#'}
                ] %}

                {% for item in menuItems %}
                <a href="{{ item.href }}" class="flex items-center px-3 py-2 rounded-lg text-sm font-medium transition-colors {{ item.active ? 'bg-primary-50 text-primary-700 border-r-2 border-primary-600' : 'text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900' }}">
                    <i class="fas {{ item.icon }} w-5 mr-3"></i>
                    {{ item.name }}
                    {% if item.badge %}
                    <span class="ml-auto bg-red-100 text-red-800 text-xs px-2 py-0.5 rounded-full">{{ item.badge }}</span>
                    {% endif %}
                </a>
                {% endfor %}
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-6">
            <!-- Page Header -->
            <div class="mb-8">
                <h2 class="text-2xl font-bold text-neutral-900">Dashboard Overview</h2>
                <p class="mt-1 text-neutral-600">Welcome back! Here's what's happening with your store today.</p>
            </div>

            <!-- Metrics Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                {% for metric in [
                    {'title': 'Total Revenue', 'value': '$45,231.89', 'change': '+20.1%', 'changeType': 'positive', 'icon': 'fa-dollar-sign'},
                    {'title': 'Orders', 'value': '2,350', 'change': '+15.3%', 'changeType': 'positive', 'icon': 'fa-shopping-cart'},
                    {'title': 'Customers', 'value': '12,234', 'change': '+7.2%', 'changeType': 'positive', 'icon': 'fa-users'},
                    {'title': 'Conversion Rate', 'value': '3.2%', 'change': '-2.1%', 'changeType': 'negative', 'icon': 'fa-chart-line'}
                ] %}
                {% include 'components/card.html.twig' with {
                    class: 'p-6'
                } %}
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-neutral-600">{{ metric.title }}</p>
                            <p class="text-2xl font-bold text-neutral-900 mt-1">{{ metric.value }}</p>
                            <p class="text-sm mt-1 {{ metric.changeType == 'positive' ? 'text-green-600' : 'text-red-600' }}">
                                <i class="fas {{ metric.changeType == 'positive' ? 'fa-arrow-up' : 'fa-arrow-down' }} mr-1"></i>
                                {{ metric.change }} from last month
                            </p>
                        </div>
                        <div class="p-3 bg-primary-100 rounded-full">
                            <i class="fas {{ metric.icon }} text-primary-600 text-xl"></i>
                        </div>
                    </div>
                {% endinclude %}
                {% endfor %}
            </div>

            <!-- Charts Row -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                <!-- Sales Chart -->
                {% include 'components/card.html.twig' with {
                    class: 'p-6'
                } %}
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-semibold text-neutral-900">Sales Overview</h3>
                        <select class="text-sm border border-neutral-300 rounded-lg px-3 py-1 focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                            <option>Last 7 days</option>
                            <option>Last 30 days</option>
                            <option>Last 3 months</option>
                        </select>
                    </div>
                    <div class="h-64 flex items-center justify-center bg-neutral-50 rounded-lg">
                        <div class="text-center">
                            <i class="fas fa-chart-line text-4xl text-neutral-400 mb-2"></i>
                            <p class="text-neutral-500">Chart visualization would go here</p>
                            <p class="text-sm text-neutral-400">Integration with Chart.js or similar library</p>
                        </div>
                    </div>
                {% endinclude %}

                <!-- Top Products -->
                {% include 'components/card.html.twig' with {
                    class: 'p-6'
                } %}
                    <h3 class="text-lg font-semibold text-neutral-900 mb-4">Top Products</h3>
                    <div class="space-y-4">
                        {% for product in [
                            {'name': 'Wireless Bluetooth Headphones', 'sales': 145, 'revenue': '$28,854.55'},
                            {'name': 'Smart Watch Series 7', 'sales': 98, 'revenue': '$39,199.02'},
                            {'name': 'Professional Camera Lens', 'sales': 67, 'revenue': '$60,283.33'},
                            {'name': 'Ergonomic Office Chair', 'sales': 54, 'revenue': '$16,145.46'},
                            {'name': 'Portable Power Bank', 'sales': 43, 'revenue': '$3,427.57'}
                        ] %}
                        <div class="flex items-center justify-between">
                            <div class="flex-1">
                                <p class="text-sm font-medium text-neutral-900">{{ product.name }}</p>
                                <p class="text-xs text-neutral-600">{{ product.sales }} sales</p>
                            </div>
                            <span class="text-sm font-semibold text-neutral-900">{{ product.revenue }}</span>
                        </div>
                        {% endfor %}
                    </div>
                {% endinclude %}
            </div>

            <!-- Recent Orders Table -->
            {% include 'components/card.html.twig' with {
                class: 'p-6'
            } %}
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-lg font-semibold text-neutral-900">Recent Orders</h3>
                    <div class="flex gap-2">
                        {% include 'components/button.html.twig' with {
                            variant: 'secondary',
                            size: 'sm',
                            content: 'Export',
                            icon: 'fa-download'
                        } %}
                        <a href="#">
                            {% include 'components/button.html.twig' with {
                                variant: 'primary',
                                size: 'sm',
                                content: 'View All',
                                icon: 'fa-arrow-right'
                            } %}
                        </a>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-neutral-200">
                                <th class="text-left py-3 px-4 font-medium text-neutral-700">Order ID</th>
                                <th class="text-left py-3 px-4 font-medium text-neutral-700">Customer</th>
                                <th class="text-left py-3 px-4 font-medium text-neutral-700">Status</th>
                                <th class="text-left py-3 px-4 font-medium text-neutral-700">Total</th>
                                <th class="text-left py-3 px-4 font-medium text-neutral-700">Date</th>
                                <th class="text-left py-3 px-4 font-medium text-neutral-700">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in [
                                {'id': '#ORD-001', 'customer': 'John Doe', 'status': 'completed', 'total': '$299.99', 'date': '2024-01-15'},
                                {'id': '#ORD-002', 'customer': 'Jane Smith', 'status': 'processing', 'total': '$149.50', 'date': '2024-01-15'},
                                {'id': '#ORD-003', 'customer': 'Bob Johnson', 'status': 'shipped', 'total': '$89.99', 'date': '2024-01-14'},
                                {'id': '#ORD-004', 'customer': 'Alice Brown', 'status': 'pending', 'total': '$459.99', 'date': '2024-01-14'},
                                {'id': '#ORD-005', 'customer': 'Charlie Wilson', 'status': 'cancelled', 'total': '$199.99', 'date': '2024-01-13'}
                            ] %}
                            <tr class="border-b border-neutral-100 hover:bg-neutral-50">
                                <td class="py-3 px-4 font-medium text-neutral-900">{{ order.id }}</td>
                                <td class="py-3 px-4 text-neutral-700">{{ order.customer }}</td>
                                <td class="py-3 px-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ order.status == 'completed' ? 'bg-green-100 text-green-800' : order.status == 'processing' ? 'bg-yellow-100 text-yellow-800' : order.status == 'shipped' ? 'bg-blue-100 text-blue-800' : order.status == 'pending' ? 'bg-orange-100 text-orange-800' : 'bg-red-100 text-red-800' }}">
                                        {{ order.status|title }}
                                    </span>
                                </td>
                                <td class="py-3 px-4 font-semibold text-neutral-900">{{ order.total }}</td>
                                <td class="py-3 px-4 text-neutral-600">{{ order.date }}</td>
                                <td class="py-3 px-4">
                                    <div class="flex gap-2">
                                        <button class="text-primary-600 hover:text-primary-700 text-sm" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="text-neutral-600 hover:text-neutral-700 text-sm" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="text-red-600 hover:text-red-700 text-sm" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Bulk Actions -->
                <div class="mt-4 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="select-all" class="rounded border-neutral-300 text-primary-600 focus:ring-primary-500">
                        <label for="select-all" class="text-sm text-neutral-600">Select all</label>
                    </div>
                    <div class="flex gap-2">
                        {% include 'components/button.html.twig' with {
                            variant: 'secondary',
                            size: 'sm',
                            content: 'Bulk Actions',
                            icon: 'fa-ellipsis-h',
                            attributes: 'disabled'
                        } %}
                    </div>
                </div>
            {% endinclude %}

            <!-- Quick Actions -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {% for action in [
                    {'title': 'Add New Product', 'description': 'Create a new product listing', 'icon': 'fa-plus', 'color': 'primary'},
                    {'title': 'Process Orders', 'description': 'Review and fulfill pending orders', 'icon': 'fa-shopping-cart', 'color': 'green'},
                    {'title': 'Customer Support', 'description': 'Handle customer inquiries', 'icon': 'fa-headset', 'color': 'blue'}
                ] %}
                {% include 'components/card.html.twig' with {
                    hover: true,
                    class: 'p-6 cursor-pointer group'
                } %}
                    <div class="flex items-center">
                        <div class="p-3 bg-{{ action.color }}-100 rounded-full mr-4 group-hover:bg-{{ action.color }}-200 transition-colors">
                            <i class="fas {{ action.icon }} text-{{ action.color }}-600 text-xl"></i>
                        </div>
                        <div>
                            <h4 class="font-semibold text-neutral-900 group-hover:text-{{ action.color }}-600 transition-colors">{{ action.title }}</h4>
                            <p class="text-sm text-neutral-600 mt-1">{{ action.description }}</p>
                        </div>
                    </div>
                {% endinclude %}
                {% endfor %}
            </div>
        </main>
    </div>
</div>

<script>
// Table interactions
document.addEventListener('DOMContentLoaded', function() {
    // Select all checkbox
    const selectAllCheckbox = document.getElementById('select-all');
    const rowCheckboxes = document.querySelectorAll('tbody input[type="checkbox"]');

    if (selectAllCheckbox) {
        selectAllCheckbox.addEventListener('change', function() {
            rowCheckboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });
    }

    // Row checkboxes
    rowCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            const checkedBoxes = document.querySelectorAll('tbody input[type="checkbox"]:checked');
            selectAllCheckbox.checked = checkedBoxes.length === rowCheckboxes.length;
            selectAllCheckbox.indeterminate = checkedBoxes.length > 0 && checkedBoxes.length < rowCheckboxes.length;
        });
    });
});
</script>
{% endblock %}