{#
  Cards/Grid Listing Example Page
  ===============================

  Demonstrates a product catalog layout with:
  - Responsive grid system
  - Product cards with hover effects
  - Filtering and sorting options
  - Pagination
  - Empty states
  - Loading states
#}

{% extends 'base-modern.html.twig' %}

{% block title %}Product Catalog - SymfoShop{% endblock %}
{% block meta_description %}Browse our complete product catalog{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50">
    <!-- Page Header -->
    <div class="bg-white border-b border-neutral-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
                <div class="mb-6 lg:mb-0">
                    <h1 class="text-3xl font-bold text-neutral-900">Product Catalog</h1>
                    <p class="mt-2 text-neutral-600">Discover our complete collection of premium products.</p>
                </div>

                <!-- Search and Filters -->
                <div class="flex flex-col sm:flex-row gap-4">
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="fas fa-search text-neutral-400"></i>
                        </div>
                        <input type="text"
                               placeholder="Search products..."
                               class="pl-10 pr-4 py-2 border border-neutral-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 w-full sm:w-64">
                    </div>

                    <div class="flex gap-2">
                        {% include 'components/button.html.twig' with {
                            variant: 'ghost',
                            size: 'sm',
                            content: 'Filters',
                            icon: 'fa-filter',
                            attributes: 'data-filters-toggle'
                        } %}

                        <div class="relative">
                            <select class="appearance-none bg-white border border-neutral-300 rounded-xl px-4 py-2 pr-8 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-sm">
                                <option>Sort by: Featured</option>
                                <option>Price: Low to High</option>
                                <option>Price: High to Low</option>
                                <option>Newest First</option>
                                <option>Best Rated</option>
                            </select>
                            <div class="absolute inset-y-0 right-0 flex items-center px-2 pointer-events-none">
                                <i class="fas fa-chevron-down text-neutral-400 text-xs"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Active Filters -->
            <div class="mt-6 flex flex-wrap gap-2" id="active-filters">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-primary-100 text-primary-800">
                    Electronics
                    <button class="ml-2 hover:bg-primary-200 rounded-full p-0.5">
                        <i class="fas fa-times text-xs"></i>
                    </button>
                </span>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-primary-100 text-primary-800">
                    Price: $100 - $500
                    <button class="ml-2 hover:bg-primary-200 rounded-full p-0.5">
                        <i class="fas fa-times text-xs"></i>
                    </button>
                </span>
                <button class="text-sm text-primary-600 hover:text-primary-700 underline ml-2">
                    Clear all filters
                </button>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex gap-8">
            <!-- Sidebar Filters (Hidden on mobile, toggleable) -->
            <aside class="hidden lg:block w-64 flex-shrink-0" id="filters-sidebar">
                <div class="bg-white rounded-2xl shadow-soft border border-neutral-200 p-6 sticky top-24">
                    <h3 class="font-semibold text-neutral-900 mb-4">Filters</h3>

                    <!-- Categories -->
                    <div class="mb-6">
                        <h4 class="font-medium text-neutral-900 mb-3">Categories</h4>
                        <div class="space-y-2">
                            {% for category in ['Electronics', 'Clothing', 'Home & Garden', 'Sports', 'Books'] %}
                            <label class="flex items-center">
                                <input type="checkbox" class="rounded border-neutral-300 text-primary-600 focus:ring-primary-500" {{ loop.first ? 'checked' }}>
                                <span class="ml-2 text-sm text-neutral-700">{{ category }}</span>
                            </label>
                            {% endfor %}
                        </div>
                    </div>

                    <!-- Price Range -->
                    <div class="mb-6">
                        <h4 class="font-medium text-neutral-900 mb-3">Price Range</h4>
                        <div class="space-y-3">
                            <input type="range" min="0" max="1000" value="100" class="w-full">
                            <div class="flex justify-between text-sm text-neutral-600">
                                <span>$0</span>
                                <span>$500</span>
                                <span>$1000</span>
                            </div>
                        </div>
                    </div>

                    <!-- Rating -->
                    <div class="mb-6">
                        <h4 class="font-medium text-neutral-900 mb-3">Rating</h4>
                        <div class="space-y-2">
                            {% for rating in [4, 3, 2, 1] %}
                            <label class="flex items-center">
                                <input type="checkbox" class="rounded border-neutral-300 text-primary-600 focus:ring-primary-500">
                                <span class="ml-2 text-sm text-neutral-700 flex items-center">
                                    {% for i in 1..5 %}
                                    <i class="fas fa-star {{ i <= rating ? 'text-yellow-400' : 'text-neutral-300' }} text-xs"></i>
                                    {% endfor %}
                                    <span class="ml-2">& up</span>
                                </span>
                            </label>
                            {% endfor %}
                        </div>
                    </div>

                    <!-- Availability -->
                    <div>
                        <h4 class="font-medium text-neutral-900 mb-3">Availability</h4>
                        <div class="space-y-2">
                            <label class="flex items-center">
                                <input type="checkbox" class="rounded border-neutral-300 text-primary-600 focus:ring-primary-500" checked>
                                <span class="ml-2 text-sm text-neutral-700">In Stock</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" class="rounded border-neutral-300 text-primary-600 focus:ring-primary-500">
                                <span class="ml-2 text-sm text-neutral-700">Out of Stock</span>
                            </label>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="flex-1">
                <!-- Results Header -->
                <div class="flex items-center justify-between mb-6">
                    <p class="text-neutral-600">Showing <span class="font-medium">24</span> of <span class="font-medium">156</span> products</p>
                    <div class="flex items-center gap-2">
                        <span class="text-sm text-neutral-600">View:</span>
                        <button class="p-2 text-neutral-400 hover:text-primary-600 hover:bg-neutral-100 rounded-lg transition-colors" title="Grid view">
                            <i class="fas fa-th"></i>
                        </button>
                        <button class="p-2 text-primary-600 bg-primary-50 rounded-lg" title="List view">
                            <i class="fas fa-list"></i>
                        </button>
                    </div>
                </div>

                <!-- Products Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8">
                    {% for product in [
                        {'name': 'Wireless Bluetooth Headphones', 'price': 199.99, 'original_price': 249.99, 'rating': 4.5, 'reviews': 128, 'image': 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=400', 'badge': 'Sale'},
                        {'name': 'Smart Watch Series 7', 'price': 399.99, 'rating': 4.8, 'reviews': 256, 'image': 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400', 'badge': 'New'},
                        {'name': 'Professional Camera Lens', 'price': 899.99, 'rating': 4.9, 'reviews': 89, 'image': 'https://images.unsplash.com/photo-1606983340126-99ab4feaa64a?w=400'},
                        {'name': 'Ergonomic Office Chair', 'price': 299.99, 'original_price': 349.99, 'rating': 4.3, 'reviews': 167, 'image': 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=400', 'badge': 'Sale'},
                        {'name': 'Wireless Charging Pad', 'price': 49.99, 'rating': 4.2, 'reviews': 203, 'image': 'https://images.unsplash.com/photo-1586953208448-b95a79798f07?w=400'},
                        {'name': 'Portable Power Bank', 'price': 79.99, 'rating': 4.6, 'reviews': 312, 'image': 'https://images.unsplash.com/photo-1609594040201-1646b22e1c0d?w=400', 'badge': 'Bestseller'},
                        {'name': 'Mechanical Keyboard', 'price': 159.99, 'original_price': 199.99, 'rating': 4.7, 'reviews': 145, 'image': 'https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=400', 'badge': 'Sale'},
                        {'name': 'USB-C Hub', 'price': 89.99, 'rating': 4.4, 'reviews': 98, 'image': 'https://images.unsplash.com/photo-1625842268584-8f3296236761?w=400'}
                    ] %}
                    {% include 'components/card.html.twig' with {
                        hover: true,
                        class: 'group overflow-hidden'
                    } %}
                        <div class="relative">
                            <div class="aspect-square overflow-hidden rounded-t-xl">
                                <img src="{{ product.image }}"
                                     alt="{{ product.name }}"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                            </div>
                            {% if product.badge %}
                            <span class="absolute top-3 left-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ product.badge == 'Sale' ? 'bg-red-100 text-red-800' : product.badge == 'New' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800' }}">
                                {{ product.badge }}
                            </span>
                            {% endif %}
                            <button class="absolute top-3 right-3 p-2 bg-white/80 hover:bg-white rounded-full opacity-0 group-hover:opacity-100 transition-opacity" title="Add to wishlist">
                                <i class="fas fa-heart text-neutral-600 hover:text-red-500"></i>
                            </button>
                        </div>

                        <div class="p-4">
                            <h3 class="font-medium text-neutral-900 mb-2 line-clamp-2 group-hover:text-primary-600 transition-colors">
                                {{ product.name }}
                            </h3>

                            <div class="flex items-center mb-2">
                                <div class="flex items-center">
                                    {% for i in 1..5 %}
                                    <i class="fas fa-star {{ i <= product.rating ? 'text-yellow-400' : 'text-neutral-300' }} text-sm"></i>
                                    {% endfor %}
                                </div>
                                <span class="ml-2 text-sm text-neutral-600">({{ product.reviews }})</span>
                            </div>

                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="text-lg font-bold text-neutral-900">${{ product.price }}</span>
                                    {% if product.original_price %}
                                    <span class="text-sm text-neutral-500 line-through">${{ product.original_price }}</span>
                                    {% endif %}
                                </div>
                                {% include 'components/button.html.twig' with {
                                    variant: 'primary',
                                    size: 'sm',
                                    content: 'Add to Cart',
                                    icon: 'fa-cart-plus',
                                    class: 'opacity-0 group-hover:opacity-100 transition-opacity'
                                } %}
                            </div>
                        </div>
                    {% endinclude %}
                    {% endfor %}
                </div>

                <!-- Pagination -->
                <div class="flex items-center justify-between">
                    <p class="text-sm text-neutral-600">
                        Showing <span class="font-medium">1</span> to <span class="font-medium">24</span> of <span class="font-medium">156</span> results
                    </p>

                    <nav class="flex items-center space-x-1" aria-label="Pagination">
                        <a href="#" class="px-3 py-2 text-sm font-medium text-neutral-500 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50 disabled:opacity-50 disabled:cursor-not-allowed" aria-label="Previous page">
                            <i class="fas fa-chevron-left mr-1"></i>
                            Previous
                        </a>

                        <a href="#" class="px-3 py-2 text-sm font-medium text-white bg-primary-600 border border-primary-600 rounded-lg" aria-current="page">1</a>
                        <a href="#" class="px-3 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50">2</a>
                        <a href="#" class="px-3 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50">3</a>
                        <span class="px-3 py-2 text-sm font-medium text-neutral-700">...</span>
                        <a href="#" class="px-3 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50">7</a>

                        <a href="#" class="px-3 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50" aria-label="Next page">
                            Next
                            <i class="fas fa-chevron-right ml-1"></i>
                        </a>
                    </nav>
                </div>
            </main>
        </div>
    </div>
</div>

<!-- Mobile Filters Modal -->
{% include 'components/modal.html.twig' with {
    id: 'filters-modal',
    title: 'Filters',
    size: 'md'
} %}
    <div class="space-y-6">
        <!-- Mobile filter content would go here -->
        <p class="text-neutral-600">Mobile filter interface would be implemented here.</p>
        <div class="flex justify-end gap-3">
            {% include 'components/button.html.twig' with {
                variant: 'secondary',
                content: 'Reset',
                attributes: 'data-modal-close'
            } %}
            {% include 'components/button.html.twig' with {
                variant: 'primary',
                content: 'Apply Filters',
                attributes: 'data-modal-close'
            } %}
        </div>
    </div>
{% endinclude %}

<script>
// Mobile filters toggle
document.querySelector('[data-filters-toggle]')?.addEventListener('click', function() {
    // Show mobile filters modal
    const modal = document.getElementById('filters-modal');
    if (modal) {
        modal.classList.remove('hidden');
        modal.setAttribute('aria-hidden', 'false');
    }
});
</script>
{% endblock %}