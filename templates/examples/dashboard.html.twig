{#
  Dashboard Example Page
  ======================

  Demonstrates a modern dashboard layout with:
  - Clean grid layout
  - Statistics cards
  - Recent activity feed
  - Quick actions
  - Responsive design
#}

{% extends 'base-modern.html.twig' %}

{% block title %}Dashboard - SymfoShop{% endblock %}
{% block meta_description %}Your personal dashboard overview{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50">
    <!-- Page Header -->
    <div class="bg-white border-b border-neutral-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h1 class="text-3xl font-bold text-neutral-900">Dashboard</h1>
                    <p class="mt-2 text-neutral-600">Welcome back! Here's what's happening with your store.</p>
                </div>
                <div class="mt-4 sm:mt-0 flex space-x-3">
                    {% include 'components/button.html.twig' with {
                        variant: 'secondary',
                        content: 'Export Data',
                        icon: 'fa-download'
                    } %}
                    {% include 'components/button.html.twig' with {
                        variant: 'primary',
                        content: 'Add Product',
                        icon: 'fa-plus'
                    } %}
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Statistics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            {% include 'components/card.html.twig' with {
                hover: true,
                class: 'p-6'
            } %}
                <div class="flex items-center">
                    <div class="p-3 bg-primary-100 rounded-xl">
                        <i class="fas fa-shopping-cart text-primary-600 text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-neutral-600">Total Sales</p>
                        <p class="text-2xl font-bold text-neutral-900">$12,345</p>
                        <p class="text-sm text-green-600 flex items-center">
                            <i class="fas fa-arrow-up mr-1"></i>
                            +12.5%
                        </p>
                    </div>
                </div>
            {% endinclude %}

            {% include 'components/card.html.twig' with {
                hover: true,
                class: 'p-6'
            } %}
                <div class="flex items-center">
                    <div class="p-3 bg-green-100 rounded-xl">
                        <i class="fas fa-users text-green-600 text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-neutral-600">Customers</p>
                        <p class="text-2xl font-bold text-neutral-900">1,234</p>
                        <p class="text-sm text-green-600 flex items-center">
                            <i class="fas fa-arrow-up mr-1"></i>
                            +8.2%
                        </p>
                    </div>
                </div>
            {% endinclude %}

            {% include 'components/card.html.twig' with {
                hover: true,
                class: 'p-6'
            } %}
                <div class="flex items-center">
                    <div class="p-3 bg-yellow-100 rounded-xl">
                        <i class="fas fa-box text-yellow-600 text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-neutral-600">Products</p>
                        <p class="text-2xl font-bold text-neutral-900">89</p>
                        <p class="text-sm text-neutral-600 flex items-center">
                            <i class="fas fa-minus mr-1"></i>
                            0.0%
                        </p>
                    </div>
                </div>
            {% endinclude %}

            {% include 'components/card.html.twig' with {
                hover: true,
                class: 'p-6'
            } %}
                <div class="flex items-center">
                    <div class="p-3 bg-red-100 rounded-xl">
                        <i class="fas fa-exclamation-triangle text-red-600 text-xl"></i>
                    </div>
                    <div class="ml-4">
                        <p class="text-sm font-medium text-neutral-600">Low Stock</p>
                        <p class="text-2xl font-bold text-neutral-900">3</p>
                        <p class="text-sm text-red-600 flex items-center">
                            <i class="fas fa-arrow-up mr-1"></i>
                            +2 items
                        </p>
                    </div>
                </div>
            {% endinclude %}
        </div>

        <!-- Main Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Recent Orders -->
            <div class="lg:col-span-2">
                {% include 'components/card.html.twig' with {
                    class: 'p-6'
                } %}
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-semibold text-neutral-900">Recent Orders</h2>
                        <a href="#" class="text-primary-600 hover:text-primary-700 text-sm font-medium">
                            View all
                        </a>
                    </div>

                    <div class="space-y-4">
                        {% for i in 1..5 %}
                        <div class="flex items-center justify-between p-4 bg-neutral-50 rounded-xl hover:bg-neutral-100 transition-colors">
                            <div class="flex items-center space-x-4">
                                <div class="w-10 h-10 bg-primary-100 rounded-full flex items-center justify-center">
                                    <i class="fas fa-shopping-bag text-primary-600 text-sm"></i>
                                </div>
                                <div>
                                    <p class="font-medium text-neutral-900">Order #{{ 1000 + i }}</p>
                                    <p class="text-sm text-neutral-600">John Doe • {{ ['2 hours ago', '1 day ago', '3 days ago', '1 week ago', '2 weeks ago'][i-1] }}</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="font-semibold text-neutral-900">${{ [89.99, 156.50, 234.00, 67.25, 312.75][i-1] }}</p>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ ['bg-green-100 text-green-800', 'bg-yellow-100 text-yellow-800', 'bg-blue-100 text-blue-800', 'bg-green-100 text-green-800', 'bg-red-100 text-red-800'][i-1] }}">
                                    {{ ['Completed', 'Processing', 'Shipped', 'Completed', 'Refunded'][i-1] }}
                                </span>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                {% endinclude %}
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Quick Actions -->
                {% include 'components/card.html.twig' with {
                    class: 'p-6'
                } %}
                    <h3 class="text-lg font-semibold text-neutral-900 mb-4">Quick Actions</h3>
                    <div class="space-y-3">
                        {% include 'components/button.html.twig' with {
                            variant: 'primary',
                            size: 'sm',
                            fullWidth: true,
                            content: 'Add New Product',
                            icon: 'fa-plus'
                        } %}

                        {% include 'components/button.html.twig' with {
                            variant: 'secondary',
                            size: 'sm',
                            fullWidth: true,
                            content: 'Manage Inventory',
                            icon: 'fa-boxes'
                        } %}

                        {% include 'components/button.html.twig' with {
                            variant: 'ghost',
                            size: 'sm',
                            fullWidth: true,
                            content: 'View Reports',
                            icon: 'fa-chart-bar'
                        } %}
                    </div>
                {% endinclude %}

                <!-- Recent Activity -->
                {% include 'components/card.html.twig' with {
                    class: 'p-6'
                } %}
                    <h3 class="text-lg font-semibold text-neutral-900 mb-4">Recent Activity</h3>
                    <div class="space-y-4">
                        {% for activity in [
                            {'icon': 'fa-user-plus', 'color': 'text-green-600', 'bg': 'bg-green-100', 'text': 'New customer registered', 'time': '5 min ago'},
                            {'icon': 'fa-shopping-cart', 'color': 'text-blue-600', 'bg': 'bg-blue-100', 'text': 'Order #1024 completed', 'time': '1 hour ago'},
                            {'icon': 'fa-box', 'color': 'text-yellow-600', 'bg': 'bg-yellow-100', 'text': 'Product restocked', 'time': '2 hours ago'},
                            {'icon': 'fa-star', 'color': 'text-purple-600', 'bg': 'bg-purple-100', 'text': 'New review received', 'time': '4 hours ago'}
                        ] %}
                        <div class="flex items-start space-x-3">
                            <div class="p-2 {{ activity.bg }} rounded-lg">
                                <i class="fas {{ activity.icon }} {{ activity.color }} text-sm"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm text-neutral-900">{{ activity.text }}</p>
                                <p class="text-xs text-neutral-500">{{ activity.time }}</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                {% endinclude %}
            </div>
        </div>
    </div>
</div>
{% endblock %}