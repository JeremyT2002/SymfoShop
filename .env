# Symfony Environment Files (loaded in order, later overrides earlier):
#   .env  →  .env.local  →  .env.$APP_ENV  →  .env.$APP_ENV.local
# Do not put production secrets here. Use .env.local (gitignored) or real env vars.
# See https://symfony.com/doc/current/configuration.html#configuration-based-on-environment-variables

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base URL for CLI/cron (e.g. links in emails)
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# MySQL: mysql://user:pass@127.0.0.1:3306/dbname?serverVersion=8.0&charset=utf8mb4
# PostgreSQL: postgresql://user:pass@127.0.0.1:5432/dbname?serverVersion=16&charset=utf8
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> payment ###
# Provider: dev (simulator, no keys), stripe, paypal, klarna. Default in config is dev.
# Set STRIPE_* in .env.local when using stripe. See .env.example for all payment vars.
# PAYMENT_PROVIDER=dev
###< payment ###

###> checkout (local testing) ###
# Nur in APP_ENV=dev|test: Bestellung ohne Zahlungsseite sofort als bezahlt abschließen (Dev-Provider).
CHECKOUT_SKIP_PAYMENT=1
###< checkout (local testing) ###
